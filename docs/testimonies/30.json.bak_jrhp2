{"3017": [["", "صدوق", "д", "قال (١): وحدث عُمَر بْن شبة قال: حَدَّثَنِي عَبد اللَّهِ بْن مُحَمَّد التوزي الصدوق العفيف مَا علمت، قال:", "تهذيب الكمال", "3722", -1, "", 0], ["ابن أبي إسحاق وعلمه", "يهم", "ж", "سمعت رجلا يسأل يُونُس عَنْ ابْن أَبي إِسْحَاق وعلمه، قال: هُوَ والنحو سواء، أي: هُوَ الغاية. قال: فأين علمه من علم النَّاس اليوم؟ قال: لو كَانَ فِي النَّاس اليو", "تهذيب الكمال", "3722", -1, "", 0], ["الفرزدق", "لين", "ж", "قال الفرزدق فِي قصيدة يمدح فِيهَا يَزِيد بْن عَبد المَلِك: مستقبلين شمال الشام تضربنا • بحاصب كنديف القطن منثور عَلَى عمائمنا تلقى وأرحلنا • عَلَى زواحف تزجى مخ", "تهذيب الكمال", "3722", -1, "", 0], ["أبو حاتم", "مجهول", "ж", "قال أبو حاتم (٦): مجهول. _________ (١) أخبار النحويين: ٢٢. (٢) في المطبوع: أشد الناس تسليما. (٣) ٥ / ٦١. (٤)", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة فاضل", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة فاضل مخضرم", "д", "قال في التقريب : ثقة فاضل مخضرم", "sunnah.com", "", "", "", 1], ["يحيى بن معين", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["محمد بن سعد كاتب الواقدي", "ثقة متشيع", "д", "ثقة متشيع", "sunnah.com", "", "", "", 1], ["أبو بكر البزار", "ذكره في البحر الزخار ، وقال : رجل من أهل البصرة مشهور", "д", "ذكره في البحر الزخار ، وقال : رجل من أهل البصرة مشهور", "sunnah.com", "", "", "", 1]], "3080": [["يحيى بن معين", "ثقة", "д", "وَقَال إسحاق بْن منصور (١)، عَن يحيى بْن مَعِين: ثقة. و", "تهذيب الكمال", "3722", -1, "9148", 1], ["ابن سعد", "ثقة", "д", "وَقَال ابن سعد: كان ثقة له أحاديث (طبقاته: ٦ / ١٨٢) .", "تهذيب الكمال", "3722", 8437, "117008", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي: كوفي تابعي ثقة (ثقاته، الورقة ٤٣) .", "تهذيب