{"13100": [["", "لين", "ж", "ابن عديب بأشار ابن عدي إلى لينه في ترجمة نصر بن طريفب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "13103": [["", "ثقة", "д", "ابن أبي حاتم الرازيب بسمعنا منه وهو ثقة رضاب بالجرح والتعديل لابن أبي حاتم …ااا بأحمد بن الفرات الضبيب بحدثنا عبد الرحمن نا أبو بكر أحمد بن عمرو بن أبي عاصم الن", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""]], "13112": [["", "صدوق", "д", "ابن أبي حاتم الرازيب بصدوقب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""]], "13120": [["", "مجهول", "ж", "ابن حبانب بوذكره ابن حبان في الثقاتب بلسان الميزان …ااا بأبو حاتم الرازيب بمجهولب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "حوارى بْن زِيَاد يروي عَن بْن عمر روى عَنهُ جَعْفَر بن إِيَاس", "الثقات لابن حبان", "5816", "1308", "13088", 1], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "13121": [["", "وثقه", "ж", "ابن يونس المصريب بوعنه أبو سعيد بن يونس ووثقهب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "13126": [["", "مجهول", "ж", "ابن القطان الفاسيب بقال ابن القطان حاله مجهولةب بلسان الميزان …ااا بالذهبىب بأرسل حديثاب بلسان الميزان …ااا بسفيان بن عيينةب بوحكى البخاري عن ابن المديني قال قل", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "مُحَمَّد بْن عَمْرو بْن سَعِيد بْن الْعَاصِ يروي عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ قَالَ إِذَا صَلَّى أَحَدُكُمْ بِأَرْضِ فَلاةٍ فَلْيَنْصُبْ تِلْقَا", "الثقات لابن حبان", "5816", "3005", "30058", 1]], "13138": [["", "ثقة", "д", "أبو حاتم الرازيب بكتب عنه أبي بمصر وسألته عنه فقال كان ثقةب بالجرح والتعديل لابن أبي حاتم …ااا بابن حبانب بمستقيم الأمر في الحديثب بالثقات …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "مُحَمَّد بن عَليّ بن مُحرز من أهل الْفسْطَاط يروي عَن أبي أُسَامَة حَدَّثنا عَنهُ عَلان بن الصيقل وَغَيره", "الثقات لابن حبان", "5816", "3933", "39338", 1], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "13140": [["", "لا بأس به", "д", "الدارقطنيب بوذكره الدارقطني فقال لا بأس بهب بتاريخ بغداد …اااان", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "لا باس به", "itqan", "لا بأس به", "التاريخ الكبير", 0, -1, "", "", ""]], "13143": [["", "ثقة", "д", "البرقانيب بحدثنا عنه أبو بكر البرقاني وسألته عنه فقال ثقةب بتاريخ بغداد …ااا بالحاكمب بوعنه الحاكم أبو عبد الله وقال هو من أجلاء الشهودب بتاريخ الإسلام …ااا بال", "موسوعة الرواة (джарх)", "", ""]], "13150": [["", "إمام", "д", "الذهبىب بالمحدث الرحال الإمامب بسير أعلام النبلاء …ااا بالحاكمب بقال الحاكم كان محدث خراساني وما أظنه جلس في حانوت قط ? فإنه كان ينادم آل سامان لأدبه وفصاحته وت", "موسوعة الرواة (джарх)", "", ""]], "13156": [["", "صدوق", "д", "الذهبىب بالشيخ الصدوق النبيلب بسير أعلام النبلاء …ااا بالحاكمب بقال الحاكم هو أبو الفضل العدل كان هو وأبوه من ذوي اليسار والثروة له خطة ومسجد وبساتين فأنفق هذه ", "موسوعة الرواة (джарх)", "", ""]], "13168": [["", "وثقه", "д", "الخطيب البغداديب بوثقه الخطيبب بتاريخ الإسلام …ا بوكان ثقةب بتاريخ بغداد …ااا بالذهبىب بسمع عبد الوهاب بن عطاء وأسود بن عامر شاذان وحجاج بن محمد الأعوري وعنه اب", "موسوعة الرواة (джарх)", "", ""]], "13180": [["", "صدوق", "д", "الحاكمب بوكان فيما قال الحاكم صدوقا ? سمعته يقول أقمت ببغداد سنة أربع وثمانين على التجارة فلم أسمع بها شيئايب بتاريخ الإسلام …ا بقال الحاكم كان صدوقاب بسير أعلا", "موسوعة الرواة (джарх)", "", ""]], "13182": [["", "لين", "ж", "الخطيب البغداديب بولم تقع إلينا أحاديثه ولا عرفناه إلا من جهة بكرب بتاريخ بغداد …ااا بالذهبىب بسمع أحمد بن منيع والحسن بن عرفة وإبراهيم بن يعقوب الجوزجاني ومحمد", "موسوعة الرواة (джарх)", "", ""]], "13183": [["", "ليس بالقوي", "ж", "الذهبىب بقلت مات قبل الثلاث مائة بسنة وكان كبير الشأن يعد من الأبدالب بلسان الميزان …ااا بالدارقطنيب بقال الدارقطني ليس بالقوي يأتي بالمعضلاتيب بلسان الميزان …ا", "موسوعة الرواة (джарх)", "", ""]], "13194": [["", "حافظ", "д", "الذهبىب بحافظ رحالب بتاريخ الإسلام …ا بالإمام الحافظ المحققب بسير أعلام النبلاء …ا بوعاش نيفا وثمانين سنة مات في سنة ثلاث وثلاثمائة وكان من علماء الأثر رحمه الل", "موسوعة الرواة (джарх)", "", ""]], "13196": [["", "ضعيف", "ж", "ابن حبانب بوقال ابن حبان لا يجوز الاحتجاج بما انفرد به من المناكيريب بلسان الميزان …ااا بالذهبىب بضعيفب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "13198": [["", "صالح الحديث", "д", "الذهبىب بسمع المقدام بن معدي كرب رضي الله عنه ومكحولا وعروة بن رويمي وعنه يحيى بن حمزة والوليد بن مسلم وعبد الكريم بن محمد اللخميي ما علمت فيه جرحا فهو صالح الح", "موسوعة الرواة (джарх)", "", ""]], "13195": [["ابن حبان", "ذكره في الثقات", "д", "عباد بْن كسيب يروي عَنِ الطُّفَيْل بْن عَمْرو روى عَنْهُ الْعَلَاء بْن الْفضل", "الثقات لابن حبان", "5816", "2765", "27658", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "13119": [["ابن حبان", "ذكره في الثقات", "д", "مُسلم بْن سكرة يروي المقاطيع روى عَنهُ سُفْيَان بن عُيَيْنَة", "الثقات لابن حبان", "5816", "3055", "30558", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "13151": [["ابن حبان", "ذكره في الثقات", "д", "يَحْيَى بْن السباق يروي عَن رجل عَن بْن مَسْعُود روى عَنهُ سعيد بن أَبى هِلَال", "الثقات لابن حبان", "5816", "3210", "32108", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "13102": [["النسائي", "متروك الحديث", "ж", "ر بن حكيم متروك الحديث", "الضعفاء والمتروكون للنسائي", "10805", "79", "798", 1], ["البخاري", "منكر الحديث", "ж", "ابن عمر، منكر الحديث. _________ = الضعفاء. قال الذهبي في الميزان", "الضعفاء الصغير للبخاري", "8632", "11", "118", 1], ["ابن أبي حاتم", "متروك", "itqan", "متروك الحديث", "الجرح والتعديل", 0, -1, "", "", ""]], "13114": [["الذهبي", "متروك", "itqan", "متروك", "تذكرة الحفاظ", 0, -1, "", "", ""]], "13164": [["ابن أبي حاتم", "ضعيف", "itqan", "ضعيف الحديث", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "له 