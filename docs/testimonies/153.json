{"15309": [["", "واه", "ж", "ابن حجرب بقلت كذا وقع في المسند عن أبي سعيد مولى بني هاشم عن مطر بن عبد الرحمن عن هند ورواه أبو داود عن موسى بن إسماعيل عن مطر عن هند بنت أبي الوازع الزارع بن ع", "موسوعة الرواة (джарх)", "", ""]], "15310": [["", "ثبت", "д", "ابن السكنب بذكره ابن السكن وقال لم يثبت حديثهب بالإصابة في تمييز الصحابة …اااان", "موسوعة الرواة (джарх)", "", ""]], "15313": [["", "ضعيف", "ж", "ابن حبانب بمن المهاجراتب بالثقات …ااا بابن حجرب بوجبارة ضعيف وتابعه معاوية بن حفص عن ابن المبارك لكن قال عن عبيد الله عن أم خالد بنت الأسود أخرجه ابن أبي عاصم ف", "موسوعة الرواة (джарх)", "", ""]], "15327": [["", "ثبت", "д", "ابن عبد البرب بذكرهما الصغاني ممن في صحبته نظر وأثبت ابن عبد البر صحبة حبيب بن خماشةب بتحفة التحصيل في المراسيل …ااا بالحسن بن محمد الصغانيب بذكرهما الصغاني ممن", "موسوعة الرواة (джарх)", "", ""]], "15335": [["", "لين", "ж", "أبو حاتم الرازيب بقال بعض الناس إنه من المهاجرين الأولين ولم يصح الرواية عنه سمعت أبي يقول ذلكب بالجرح والتعديل لابن أبي حاتم …ااا بابن حجرب بوإسناده إلى سعيد ب", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "لين", "itqan", "لين", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن سعد", "صحابي", "itqan", "صحابي", "الطبقات الكبرى", 0, -1, "", "", ""]], "15341": [["", "صالح", "д", "أبو يعلى الموصليب ببل سلمة معروف ذكره في الصحابة الحسن بن سفيان وأبو يعلى والطبراني وابن حبان وابن مندهب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بأحمد بن", "موسوعة الرواة (джарх)", "", ""]], "15348": [["", "صالح", "д", "يحيى بن معينب بنا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال سمعت يحيى بن معين يقول لم يرو عن صالح بن بشير بن فديكا إلا الزهريب بالجرح والتعديل لابن أبي ح", "موسوعة الرواة (джарх)", "", ""], ["يحيى بن معين", "صالح", "д", "لم يرو عن صالح بن بشير الا الزهري", "الجرح والتعديل", "2170", "1979", "", 0], ["ابن حجر العسقلاني", "ضعيف", "itqan", "ضعيف", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "متروك", "itqan", "متروك الحديث", "تهذيب التهذيب", 0, -1, "", "", ""]], "15375": [["", "ثقة", "д", "ابن حبانب بوكان من عباد أهل الكوفة وكان إذا صلى تقع العصافير على ظهره تحسبه جذم حائطب بالثقات …ااا بيحيى بن معينب بنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور ", "موسوعة الرواة (джарх)", "", ""], ["العجلي", "ثقة", "д", "س بن عقبة ثقة من أصحاب عبد الله حدثنا أبو نعيم ثنا الأعمش عن يزير", "معرفة الثقات للعجلي", "5825", "496", "4968", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "15392": [["", "مجهول", "ж", "الذهبىب بشيخب بلسان الميزان …ا بلا نعرفهب بلسان الميزان …ااا بعلي ابن المدينيب بوقال علي بن المديني في العلل يزيد بن زيد في قوله تعالى ونخل طلعها هضيم مجهول لم ", "موسوعة الرواة (джарх)", "", ""]], "15396": [["ابن حبان", "ذكره في الثقات", "д", "يزِيد بْن حُصَيْن بْن نمير يروي عَنْ أَبِيهِ روى عَنهُ مُحَمَّد بن الزبير", "الثقات لابن حبان", "5816", "3226", "32268", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "15383": [["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""]], "15331": [["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""], ["ابن سعد", "صحابي", "itqan", "صحابي", "الطبقات الكبرى", 0, -1, "", "", ""]], "15384": [["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""]], "15351": [["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""]], "15379": [["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""], ["ابن سعد", "صحابي", "itqan", "صحابي", "الطبقات الكبرى", 0, -1, "", "", ""]], "15337": [["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""]], "15332": [["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""]], "15378": [["ابن أبي حاتم", "له صحبة", "itqan", "له صحبة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "15349": [["ابن حبان", "ثقة",