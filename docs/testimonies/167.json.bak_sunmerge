{"16703": [["", "حافظ", "д", "الذهبىب بوكان محدثا مكثرا حافظا متوددا مكرما للطلبة ذا مروءة سهلا في إعادة أصوله محبا للرواية واسع الصدرب بتاريخ الإسلام …ا بوكان حافظا مكثرا مكرما للطلبة ذا مر", "موسوعة الرواة (джарх)", "", ""]], "16704": [["", "وثقه", "д", "الخليليب بوثقه أبو يعلى الخليليب بتاريخ الإسلام …ا بوثقه أبو يعلى الخليليب بسير أعلام النبلاء …ااا بالذهبىب بالإمام الحافظ الثقةب بسير أعلام النبلاء …اااان", "موسوعة الرواة (джарх)", "", ""]], "16705": [["", "يخطئ", "ж", "ابن حبانب بوفي قلبي من حديثهب بالثقات …ا بيخطئ ويخالفب بالثقات …ا بوذكره ابن حبان في ?بالثقات?ب فقال ابن ابنة مالك بن مغول من أهل الكوفة يروي عن ابن إدريس روى ع", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "يضع الحديث", "itqan", "يضع الحديث", "التاريخ الكبير", 0, -1, "", "", ""]], "16707": [["", "منكر الحديث", "ж", "البخاريب بوقال البخاري منكر الحديث", "موسوعة الرواة (джарх)", "", ""]], "16708": [["", "ثقة", "д", "عمر بن أحمد بن إبراهيم العبدوييب بقال الخطيب سمعت أبا حازم العبدوي ذكره فقال لا أعلمه إلا ثقة ولا أعرف أحدا تكلم فيهيب بلسان الميزان …ااا بمحمد بن العباس البغدا", "موسوعة الرواة (джарх)", "", ""]], "16709": [["", "صدوق", "д", "الذهبىب بالمحدث الصدوقب بسير أعلام النبلاء …ا بوكان صدوقا مقبولاب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "16711": [["", "لا بأس به", "д", "محمد بن محمود ابن النجار البغداديب بقال ابن النجار كتبت عنه ولا بأس بهب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "16712": [["", "ثقة", "д", "أبو حاتم الرازيب بحدثنا عبد الرحمن أنا عبد الله بن أحمد بن محمدا بن حنبل فيما كتب إلي قال أملى علي أبي قال أبو حازم نبتل روى عنه إسماعيل بن أبي خالد ثقةب بالجرح", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "16716": [["", "مجهول", "ж", "أبو حاتم الرازيب بلا يعرفب بلسان الميزان …ااا بعلي ابن المدينيب بحدثنا عبد الرحمن نا محمد بن أحمد بن البراء قال قال علي ابن المديني أبو الحكم مولى عثمان بن أبي ", "موسوعة الرواة (джарх)", "", ""]], "16718": [["", "مجهول", "ж", "الدارقطنيب بقال الدارقطني مجهوليب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "16733": [["", "صدوق", "д", "الذهبىب بالشيخ الصدوق العالم المحدثب بسير أعلام النبلاء …ا بوكان أسند من بقي بما وراء النهرب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "16737": [["", "إمام", "д", "الذهبىب ببغدادي نبيلب بتاريخ الإسلام …ا بالإمام المحدث الثقةب بسير أعلام النبلاء …اااان", "موسوعة الرواة (джарх)", "", ""]], "16739": [["", "حافظ", "д", "الحاكمب بوروى عنه الحاكم وقال قل ما رأيت في المحدثين أورع منه وكان محدث بلخ في وقتهب بتاريخ الإسلام …ا بأخبرني محمد بن علي المقرئ عن محمد بن عبد الله النيسابوري", "موسوعة الرواة (джарх)", "", ""]], "16744": [["", "ثقة", "д", "الذهبىب بوكان ثقةب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "16745": [["", "ثقة", "д", "أحمد بن محمد البغداديب بقال السمعاني سألت أبا سعد البغدادي عنه فأثنى عليه وقال كان من المعمرين سمعته يقول ولدت سنة خمس وسبعيني وعاش مائة سنةب بتاريخ الإسلام …ا ", "موسوعة الرواة (джарх)", "", ""]], "16749": [["", "صدوق", "д", "ابن أبي حاتم الرازيب بوقال ابن أبي حاتم الرازي كتبت عنه وهو صدوقب بتاريخ بغداد …اااان", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "حجة", "itqan", "حجة", "التاريخ الكبير", 0, -1, "", "", ""]], "16755": [["", "ثقة", "д", "أبو حاتم الرازيب بسألت أبي عن بدر بن الخليل فقال شيخب بالجرح والتعديل لابن أبي حاتم …ااا بيحيى بن معينب بحدثنا عبد الرحمن قال قرئ على العباس بن محمد الدوري قال ", "موسوعة الرواة (джарх)", "", ""]], "16761": [["", "مجهول", "ж", "العقيليب بقال العقيلي حديثه غير محفوظ وشيخه مجهولب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "16774": [["", "صالح", "д", "يحيى بن معينب بنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنها قال عبد الله بن المستورد صالحب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "مستور", "itqan", "مستور", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16777": [["", "صالح", "д", "ابن حبانب بوأحسبه بن جري بن كليبب بالثقات …ااا بمحمد بن الحسن الطوسيب بذكره الطوسي في رجال الشيعة وقال روى عن الصادق ويقال إنه أدرك الباقريب بلسان الميزان …ااا ", "موسوعة الرواة (джарх)", "", ""]], "16782": [["", "مجهول", "ж", "أبو حاتم الرازيب ب? سفيان ووهب ابنا قيس بن أبان طائفيان لهما صحبة روت أميمة بنت رقيقة عن رقيقة عنهما سمعت أبي يقول ذلكب بالجرح والتعديل لابن أبي حاتم …ا بسمعت أ", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "له صحبة", "itqan", "له صحبة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16756": [["أبو حاتم الرازي", "شيخ", "д", "شيخ", "الجرح والتعديل", "2170", "2002", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "صَالح بن هِلَال يروي عَن أبي الْمليح روى عَنهُ سوَادَة بن أبي الْأسود", "الثقات لابن حبان", "5816", "2577", "25778", 1], ["ابن أبي حاتم", "شيخ", "itqan", "شيخ", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16771": [["أبو حاتم الرازي", "لا أعرفه", "ж", "لا أعرفه، وهذا حديث باطل", "الجرح والتعديل", "2170", "2286", "22868", 1], ["أبو حاتم الرازي", "لا أعرفه", "ж", "فقال: لا أعرفه، وهذا حديث باطل", "الجرح والتعديل", "2170", "2286", "22868", 1], ["ابن أبي حاتم", "لا أعرفه", "itqan", "لا أعرفه", "الجرح والتعديل", 0, -1, "", "", ""]], "16760": [["أبو حاتم الرازي", "منكر الحديث", "ж", "منكر الحديث", "الجرح والتعديل", "2170", "2315", "698", 1], ["أبو حاتم الرازي", "منكر الحديث", "ж", "عن عبد الرحمن بن حماد الطلحي فقال: منكر الحديث", "الجرح والتعديل", "2170", "2315", "23158", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن أبي حاتم", "منكر الحديث", "itqan", "منكر الحديث", "الجرح والتعديل", 0, -1, "", "", ""]], "16789": [["ابن حبان", "ذكره في الثقات", "д", "مَنْصُور بن أبي سُلَيْمَان يروي عَن جُبَير بن مطعم روى عَنهُ كلاب بن عَليّ", "الثقات لابن حبان", "5816", "1946", "19468", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16795": [["ابن حبان", "ذكره في الثقات", "д", "وَائِل بن ربيعَة يروي عَن بْن مَسْعُود عِدَادُهُ فِي أهل الْكُوفَة روى عَنهُ شمر بن عَطِيَّة", "الثقات لابن حبان", "5816", "2012", "20128", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16781": [["العجلي", "ثقة", "д", "وفي تابعي ثقة رجل صالح", "معرفة الثقات للعجلي", "5825", "265", "2648", 1]], "16736": [["البخاري", "لين", "itqan", "لين", "التاريخ الكبير", 0, -1, "", "", ""]], "16794": [["ابن أبي حاتم", "شيخ", "itqan", "شيخ", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16769": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["البخاري", "ثقة", "itqan", "ثقة", "التاريخ الكبير", 0, -1, "", "", ""]], "16757": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16780": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16758": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16719": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16765": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""]], "16713": [["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "16753": [["ابن أبي حاتم", "منكر الحديث", "itqan", "منكر الحديث", "الجرح والتعديل", 0, -1, "", "", ""]], "16762": [["ابن أبي حاتم", "منكر الحديث", "itqan", "منكر الحديث", "الجرح والتعديل", 0, -1, "", "", ""]]}