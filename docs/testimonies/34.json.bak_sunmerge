{"3440": [["يحيى بن معين", "ليس بشيء", "ж", "قال عباس الدروي (١)، عَنْ يحيى بْن مَعِين: ليس بشيءٍ (٢) .", "تهذيب الكمال", "3722", 5806, "90698", 1], ["إبراهيم بن يعقوب الجوزجاني", "ثقة", "д", "وَقَال إبراهيم بن يعقوب الجوزجاني (٣): غير ثقة.", "تهذيب الكمال", "3722", 5806, "90698", 1], ["أبو زرعة", "واه", "ж", "وَقَال أَبُو زُرْعَة (٤): واهي، ضعيف الحديث.", "تهذيب الكمال", "3722", 5806, "90698", 1], ["أبو حاتم", "منكر الحديث", "ж", "وَقَال أبو حاتم (٥): ترك حديثه، منكر الحديث، كان يفسد أباه يحدث عنه بالطامات. _________ (١) تاريخه: ٢ \\ ٣٦٢. (٢)", "تهذيب الكمال", "3722", 5806, "90698", 0], ["ابن معين", "تركوه", "ж", "وَقَال ابن المعمر الصنعاني، عن ابن مَعِين: تركوه (ضعفاء العقيلي: الورقة ١٣٠) .", "تهذيب الكمال", "3722", 5806, "90698", 1], ["ابن معين", "كذاب", "ж", "وَقَال أَبُو دَاوُدَ عَنِ ابْنِ مَعِين: رأيته في جامع الرصافة فلم آخذ عنه (تاريخ بغداد: ١١ \\ ٨٣) . ونقل ابن الجوزي أن يحيى ابن مَعِين قال: كذاب (الضعفاء: الورقة", "تهذيب الكمال", "3722", 5806, "90698", 1], ["البخاري", "تركوه", "ж", "قَال البُخارِيُّ: (١): تركوه.", "تهذيب الكمال", "3722", -1, "90708", 1], ["أبو داود", "ضعيف", "ж", "وَقَال أَبُو داود (٢): ضعيف (٣) .", "تهذيب الكمال", "3722", -1, "6038", 1], ["النسائي", "متروك", "ж", "وَقَال النَّسَائي (٤): متروك الحديث.", "تهذيب الكمال", "3722", -1, "5048", 1], ["", "ليس بثقة", "ж", "وَقَال في موضع آخر: ليس بثقة ولا مأمون، ولا يكتب حديثه.", "تهذيب الكمال", "3722", 5807, "90708", 1], ["أبو أحمد بن عدي", "منكر", "ж", "وَقَال أبو أحمد بن عدي (٥): يروي عَن أَبِيهِ، عن شقيق، عَنْ عَبد اللَّهِ غير حديث منكر، وله أحاديث لا يتابعه الثقات عليها (٦) .", "تهذيب الكمال", "3722", 5807, "90708", 1], ["ابن حجر العسقلاني", "متروك", "ж", "متروك", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "تركوه", "ж", "تركوه", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ضعيف", "itqan", "ضعيف الحديث", "الجرح والتعديل", 0, -1, "", "", ""], ["الذهبي", "تركوه", "itqan", "تركوه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "كذاب", "itqan", "كذاب", "تهذيب الته