دوق ربما غلط", "تقريب التهذيب", "8609", 277, "2778", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["", "يخطئ", "д", "ابن حبانب بيخطئب بالثقات …ا بذكره ابن حبان في ? الثقات ? وقال يخطئب بتهذيب التهذيب …ا بذكره ابن حبان في كتاب ?ب الثقات ?ب وقال يخطئب بتهذيب الكمال …ااا بابن حجر", "موسوعة الرواة (джарх)", "", ""]], "3472": [["أبو محمد نصر بن أحمد البغدادي الحافظ", "ثقة", "д", "وَقَال أَبُو مُحَمَّد نصر بْن أَحْمَد البغدادي الْحَافِظ: حَدَّثَنَا مُحَمَّد بْن إسماعيل الْبُخَارِيّ قال: حَدَّثَنَا الفضل بْن مقاتل بلخي ثقة - فذكر عنه حديثا", "تهذيب الكمال", "3722", 8879, "121428", 1], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["", "صدوق", "д", "أبو حاتم الرازيب بسألت أبي عنه فقال هو شيخب بالجرح والتعديل لابن أبي حاتم …ا بقال أبو حاتم شيخب بتهذيب التهذيب …ا بقال أبو حاتم شيخب بتهذيب الكمال …ااا بابن حجر", "موسوعة الرواة (джарх)", "", ""], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "صدوق", "itqan", "صدوق", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "شيخ", "itqan", "شيخ", "تهذيب التهذيب", 0, -1, "", "", ""]], "3461": [["أبا مسهر وزعم أن عبد العزيز بن عمربن عبد ا", "ضعيف", "ж", "سمعت أبا مسهر وزعم أن عبد العزيز بن عُمَربن عبد العزيز ضعيف، وكل شيء من أمره.", "تهذيب الكمال", "3722", 5948, "92118", 1], ["أبي مسهر", "ضعيف", "ж", "وَقَال ميمون بن الأصبع (١)، عَن أبي مسهر: ضعيف الحديث.", "تهذيب الكمال", "3722", 5948, "92118", 1], ["أبي نعيم", "لين", "ж", "وَقَال أَبُو زُرْعَة الدمشقي (٢)، عَن أَبِي نعيم: قدم علينا عبد العزيز بن عُمَربن عبد العزيز، وجعفر بن برقان الكوفة سنة أربع وأربعين ومئة، وفي نسخة: سنة سبع وأر", "تهذيب الكمال", "3722", 5948, "92118", 1], ["ابن حبان. و", "يخطئ", "ж", "ذكره ابنُ حِبَّان. وَقَال: يخطئ يعتبر بحديثه إذا كان دونه ثقة (٥ / ١١٤) . وحكى الخطابي عن أَحْمَد بْن حنبل، قال: ليس هو من أهل الحفظ والاتقان (تهذيب التهذيب: ٦ ", "تهذيب الكمال", "3722", 5949, "92128", 1], ["ابن حجر العسقلاني", "وثقه", "ж", "وثقه ابن حبان", "تقريب التهذيب", "8609", 14, "1048", 1]], "3475": [["أبو حاتم", "صالح الحديث", "д", "قال أَبُو حاتم (١): صالح الحديث صدوق. _________ (١) الجرح والتعديل: ٨ / الترجمة ٥٥٩. و", "تهذيب الكمال", "3722", -1, "143468", 2], ["مسلمة", "ثقة", "д", "قال مسلمة: بصري ثقة، وسمى جده مهران، ونسبه زبيديا من زبيد اليمن (٩ / ٥٠٩) .", "تهذيب الكمال", "3722", 11096, "143598", 1], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""]], "3477": [["أبو زرعة (١)، والنسائي", "ثقة", "д", "قال أَبُو زُرْعَة (١)، والنَّسَائي: ثقة.", "تهذيب الكمال", "3722", -1, "39188", 1], ["محمد بن إسحاق الثق", "ثقة", "д", "وَقَال مُحَمَّد بْن إسحاق الثقفي: ثقة مأمون.", "تهذيب الكمال", "3722", 13643, "171248", 1], ["غيره", "وثقه", "д", "وَقَال غيره: مات فِي رمضان سنة تسع وثلاثين ومئتين بعد إِبْرَاهِيم بْن يوسف البلخي بمئة يوم (٦) . _________ (١) الجرح والتعديل: ٩ / الترجمة ٧٨١. (٢) المؤتلف: ٢ /", "تهذيب الكمال", "3722", 13643, "171248", 3], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""]], "3463": [["ابن معين", "ليس به بأس", "д", "وَقَال ابن الجنيد عن ابن مَعِين: ليس به بأس ثقة (سؤالاته: الورقة ٥) . (٣) الجرح والتعديل: ٥ \\ الترجمة ١٧٨٩. (٤) نفسه. (٥) ٧ \\ ١١٤.", "تهذيب الكمال", "3722", 5917, "91808", 1], ["ابن حجر", "وثقه", "д", "وَقَال ابن حجر: وثقه العجلي وابن نمير ويعقوب بن سفيان (تهذيب التهذيب: ٦ \\ ٣٤١) .", "تهذيب الكمال", "3722", 5917, "91808", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق يتشيع. (٦) تاريخ البخاري الكبير: ٦ \\ الترجمة ١٥٤٥، والجرح والتعديل: ٥ \\ الترجمة ١٧٩٥، وثقات ابن حبان: ٧ \\ ١١١، والكاشف: ٢ \\ ال", "تهذيب الكمال", "3722", 5917, "91808", 1], ["ابن حجر العسقلاني", "لا بأس به", "д", "لا بأس به", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "عبد الْعَزِيز بْن أبي الصعبة يروي عَنِ الْحسن روى عَنْهُ يزِيد بْن أبي حبيب", "الثقات لابن حبان", "5816", "2718", "27188", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "3476": [["محمد بن سعد", "ثقة", "д", "وَقَال مُحَمَّد بْن سعد: كان ثقة كثير العلم، يرحل إليه.", "تهذيب الكمال", "3722", 2057, "20588", 1], ["محمد بن عبد الله بن عمار الموصلي", "حجة", "д", "وَقَال مُحَمَّد بْن عَبْدِ اللَّهِ بْن عمار الموصلي: حجة، كانت كتبه صحاحا، وإن لم يكن، كنت إذا نظرت إليه فِي بزته، ما كنت ترى أنه محدث، ولكنه كان إذا حدث ... أي", "تهذيب الكمال", "3722", 2057, "20588", 1], ["عبد الرحمن", "إمام", "д", "قال عبد الرحمن: ولقد حَدَّثَنَا يوما سُلَيْمان بن حرب بأحاديث _________ = بن أمية بن عبد غنم بن نصر بن عبد مناة بْن بكر بْن سعد بْن ضبة. (١) علق الإمام الذهبي ع", "تهذيب الكمال", "3722", 2057, "20588", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة معمر", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "3469": [["يحيى بن معين، وأبو داود", "ثقة", "д", "قال أبو طالب (١) عَن أحمد بْن حنبل وعباس الدوري (٢) عَنْ يحيى بْن مَعِين، وأبو داود (٣): ثقة (٤) . _________ (١) الجرح والتعديل: ٥ \\ الترجمة ١٧٩١. (٢) تاريخه: ٢", "تهذيب الكمال", "3722", 5914, "91778", 0], ["أبو حاتم", "ثقة", "д", "قال عَبد اللَّهِ بْن أَحْمَد عَن أبيه: شيخ ثقة (علل أحمد: ١ \\ ١٨٧) .", "تهذيب الكمال", "3722", 5914, "91778", 1], ["ابن معين", "ثقة", "д", "وَقَال ابن محرز عن ابن مَعِين: ثقة (سؤالاته: الترجمة ٥١٤) .", "تهذيب الكمال", "3722", 5914, "91778", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "3479": [["عبد الله بن أحمد بن حنبل", "يهم", "ж", "قال عَبد الله بْن أحمد بْن حنبل (١): سألت يحيى بْن مَعِين عَنْ عَبْد الْعَزِيزِ بْن صهيب ويحيى بْن أَبي إِسْحَاق، أيهما أوثق؟ فَقَالَ: كلاهما ثقة (٢) .", "تهذيب الكمال", "3722", -1, "11078", 2], ["محمد بن سعد", "ثقة", "д", "وَقَال مُحَمَّد بْن سعد (٣): كَانَ ثقة، وله أحاديث، وكَانَ صاحب قرآن وعلم بالعربية والنحو.", "تهذيب الكمال", "3722", -1, "", 0], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة _________ (١) العلل: ٢ / ١١٨، والجرح والتعديل: ٩ / الترجمة ٥٣١. (٢)", "تهذيب الكمال", "3722", -1, "", 0], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في \" الكاشف\" و\" الميزان\" وغيرهما: ثقة.", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر: صدوق ربما أخطأ ٦٧٨٤ - ق: يَحْيَى بن أَبي أمامة أسعد بن زرارة الأَنْصارِيّ المدني (١)، مختلف فِي صحبته. رَوَى عَنه: ابْن أخيه مُحَمَّد بْن عَبْد ", "تهذيب الكمال", "3722", -1, "33888", 2], ["الحافظ ابن عساكر", "حافظ", "д", "وَقَال الحافظ ابن عساكر: إن كان هو ابن سعد بن زرارة لصلبه فلا ريب في صحبته لان أباه مات فِي السنة الأولى من الهجرة (تهذيب: ١١ / ١٧٨) لذلك", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "حجة", "д", "حجة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "حجة", "itqan", "حجة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة ثقة", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""]], "3484": [["معاوية بن صالح", "صالح", "д", "قال مُعَاوِيَة بْن صالح:", "تهذيب الكمال", "3722", -1, "5398", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد اللَّهِ العجلي (٢): أمية بْن عَبْد الرَّحْمَنِ بْن خَالِد، مدني، تابعي، ثقة.", "تهذيب الكمال", "3722", 1349, "13508", 1], ["الحافظ أبو القاسم", "حافظ", "д", "وَقَال الحافظ أَبُو القاسم (٢): بلغني أن أمية بْن خَالِد، وخالد بْن يزيد بْن مُعَاوِيَة، وروح بْن زنباع، ماتوا بالصنبرة، فِي عام واحد. وبلغني من وجه آخر: أن روح", "تهذيب الكمال", "3722", 1350, "13518", 1], ["ابن حجر ا