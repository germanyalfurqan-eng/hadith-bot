8268", 1], ["ابن معين", "ثقة", "д", "قال ابن الجنيد عن ابن مَعِين: ثقة (سؤالاته: ٤٩) . (٣) سؤالاته: ٥ / الورقة ٣٣. (٤) ٨ / ٤٣١. (٥) رجال صحيح مسلم: الورقة ١١٧. (٦) منهم ابن سعد (طبقاته: ٦ / ٤١٤)، و", "تهذيب الكمال", "3722", 6563, "98268", 1], ["ابن سعد", "ثقة", "д", "وَقَال ابن سعد: كان ثقة (طبقاته: ٦ / ٤١٤) .", "تهذيب الكمال", "3722", 6563, "98268", 1], ["ابن قانع", "صالح", "д", "وَقَال ابن قانع: صالح.", "تهذيب الكمال", "3722", -1, "98198", 1], ["مسلمة بن قاسم", "ثقة", "д", "وَقَال مسلمة بن قاسم: ثقة (تهذيب التهذيب: ٧ / ٧٩) .", "تهذيب الكمال", "3722", 6563, "98268", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي: تابعي ثقة (ثقاته: الورقة ٣٧) . (٣) المعجم ال", "تهذيب الكمال", "3722", 6564, "98278", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""]], "5796": [["أبي", "صدوق", "д", "سمعت أَبِي يَقُول: أَبُو بَكْر بْن أَبي شَيْبَة، صدوق، وهو أحب إلي من عُثْمَان.", "تهذيب الكمال", "3722", -1, "", 0], ["أبي", "لين", "ж", "قَالَ أبي: أَبُو بَكْر أعجب إلينا من عُثْمَان.", "تهذيب الكمال", "3722", -1, "", 0], ["العجلي (٤)، وأبو حاتم (٥)، وابن خراش", "ثقة", "д", "وَقَال الْعَجَلِيّ (٤)، وأَبُو حَاتِم (٥)، وابن خراش (٦): ثقة. زاد الْعَجَلِيّ: وكَانَ حافظا للحديث.", "تهذيب الكمال", "3722", -1, "3048", 2], ["سماع أبي بكر بن أبي شيبة من شريك، ف", "صدوق", "д", "سمعت يحيى بْن مَعِين، وسألته عَنْ سماع أبي بكر بْن أَبي شَيْبَة من شَرِيك، فَقَالَ: أَبُو بَكْر عندنا صدوق، ولو ادعى السماع من أجل من شَرِيك لكان مصدقا فِيهِ. و", "تهذيب الكمال", "3722", -1, "", 0], ["عمرو بن علي", "لين", "ж", "وَقَال عَمْرو بْن عَلِيّ: ما رأيت أحفظ من ابْن أَبي شَيْبَة، قدم علينا مع علي ابن المديني، فسرد للشيباني أربع مئة حديث حفظا، وقام.", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "متروك", "ж", "متروك", "تقريب التهذيب", "8609", "", "", 0]], "5788": [["أبو حاتم", "صدوق", "д", "قال أبو حاتم (١): صدوق.", "تهذيب الكمال", "3722", -1, "3168", 1], ["أبي داود", "حجة", "д", "وَقَال أبو عُبَيد الآجري عَن أبي دَاوُد: ابن حساب فوق الزُّهْرِيّ بكثير، ابن حساب عندي حجة.", "تهذيب الكمال", "3722", 10547, "138108", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة.", "تهذيب الكمال", "3722", -1, "3168", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "5792": [["مسلمة", "ثقة", "д", "قال مسلمة: ثقة،", "تهذيب الكمال", "3722", -1, "2688", 1], ["الدارقطني", "ثقة", "д", "وَقَال الدَّارَقُطْنِيُّ: ثقة صدوق. (٩ / ٣٣١) .", "تهذيب الكمال", "3722", 10555, "138188", 1], ["الذهبي", "وثقه", "ж", "وثقه ابن حبان", "الكاشف / سير أعلام النبلاء", "2171", 27, "5541", 1]], "5786": [["أبي أمية الثغري، ف", "ثقة", "д", "سئل أَبُو داود عَن أَبِي أمية الثغري، فَقَالَ: ثقة.", "تهذيب الكمال", "3722", 9578, "128418", 1], ["أبو بكر أحمد (٢) بن محمد بن هارون الخلال ا", "إمام", "д", "وَقَال أَبُو بَكْر أَحْمَد (٢) بْن مُحَمَّد بْن هارون الخلال الحنبلي: أَبُو أمية مُحَمَّد بْن إِبْرَاهِيم رجل رفيع القدر جدا، كَانَ إماما في الحديث، مقدما في زم", "تهذيب الكمال", "3722", 9578, "128418", 1], ["الحاكم أبو عبد الله بن الربيع", "صدوق", "д", "وَقَال الحاكم أَبُو عَبْد اللَّهِ بن الربيع: صدوق كَثِير الوهم.", "تهذيب الكمال", "3722", 9578, "128418", 1], ["", "ثقة", "д", "وَقَال في موضع آخر: روى عنه غير واحد وهو ثقة ومما وهم فيه ما رواه الدَّارَقُطنِيّ عَن أبي بكر بن زياد النيسابوري عنه عَن أبي عاصم عن ابن جُرَيْج، عن الزُّهْرِيّ", "تهذيب الكمال", "3722", 9579, "128428", 1], ["أبو بكر", "واه", "ж", "قال أبو بكر: وهم أبو أمية في ذكر سَعِيد، فقد رواه غيره عَن أبي عاصم ولم يذكره. (٩ / ١٦) .", "تهذيب الكمال", "3722", 9579, "128428", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق صاحب حديث يهم. (٣) تاريخ الدوري: ٢ / ٥٣٩، وعلل أحمد: ١ / ١٥٧، وتاريخ البخاري الكبير: ١ / الترجمة ٢٠، والكنى لمسلم، الورقة ٤، و", "تهذيب الكمال", "3722", 9579, "128428", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة يحفظ", "تقريب التهذيب", "8609", "", "", 0]], "5791": [["النسائي", "لا بأس به", "д", "قال النَّسَائي (١): لا بأس به. و", "تهذيب الكمال", "3722", -1, "2138", 1], ["ابن حجر العسقلاني",