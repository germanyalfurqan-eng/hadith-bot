", 10367, "136308", 1], ["عبد الرحمن (٤) بن أبي حاتم", "صدوق", "д", "وَقَال عَبْد الرَّحْمَنِ (٤) بْن أَبي حَاتِم: كتب أبي عنه، وهو _________ (١) بضم الباء وفتح الجيم المعجمة، وبعدها ياء آخر الحروف ثم راء مهملة، قيده الذهبي في \"ا", "تهذيب الكمال", "3722", -1, "136308", 0], ["أبي عنه ف", "ثقة", "д", "سئل أَبِي عَنْهُ فقال: ثقة.", "تهذيب الكمال", "3722", -1, "136318", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي (١): ثقة (٢) .", "تهذيب الكمال", "3722", -1, "3168", 1], ["الدارقطني", "ثقة", "д", "وَقَال الدَّارَقُطنِيّ (٣): ثقة كان حافظا. و", "تهذيب الكمال", "3722", 10368, "136318", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة حافظ", "تقريب التهذيب", "8609", "", "", 0]], "5771": [["ابن عدي", "حافظ", "д", "وَقَال ابن عدي: كان حافظا.", "تهذيب الكمال", "3722", -1, "136338", 1], ["الدارقطني", "ثقة", "д", "وَقَال البرقاني عن الدَّارَقُطنِيّ: ثقة جليل متقن (٩ / ٢٧٢ - ٢٧٤) .", "تهذيب الكمال", "3722", 10370, "136338", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "قال أبو حاتم صدوق لم أر من الأئمة إلا هو وأحمد وسليمان بن داود الهاشميي وقال ابن معين ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن سعد", "صدوق", "itqan", "صدوق", "الطبقات الكبرى", 0, -1, "", "", ""], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "5768": [["", "ثقة", "д", "ذكره فِي \" الكبير\" فِي الطبقة السادسة، وَقَال: كَانَ ثقة، كثير الحديث. _________ (١) إنما أخذ المؤلف الاقوال والاخبار الآتية من\" تاريخ دمشق\" لابن عساكر، فتراجع ", "تهذيب الكمال", "3722", 13377, "166408", 3], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "5774": [["الذهبي", "منكر", "ж", "وَقَال الذهبي في \"الميزان \": له حديث منكر، وهو جائز الحديث (٣ / الترجمة ٧٧٧٠) .", "تهذيب الكمال", "3722", 10397, "136608", 1], ["علي (٣) بن الحسين بن الجنيد", "يهم", "ж",