, "д", "ثقة يغر", "تقريب التهذيب", "8609", "", "", 0], ["", "ثقة", "д", "ابن حبانب بذكره ابن حبان في كتاب ?بالثقات?بي وقال ربما أخطأب بتهذيب الكمال …ا بربما أخطأيب بالثقات …ا بذكره ابن حبان في ?ب الثقات ?ب وقال ربما أخطأب بتهذيب الته", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "5710": [["ابن عدي", "ضعيف", "ж", "وَقَال ابن عدي في \"الكامل \": مُحَمَّد بْن عَبْد الرَّحْمَنِ بْن طلحة القرشي يسرق الحديث ضعيف (٣ / الورقة ٦٥) .", "تهذيب الكمال", "3722", 10443, "137068", 1], ["الدارقطني", "متروك", "ж", "وَقَال البرقاني عن الدَّارَقُطنِيّ: متروك ولا أدري من أين هو (سؤالاته، الورقة ٤٤٤) .", "تهذيب الكمال", "3722", 10443, "137068", 1], ["علي بن الحسين بن الجنيد", "ثقة", "д", "قال علي بن الحسين بن الجنيد (١): كان ثقة. و", "تهذيب الكمال", "3722", 10445, "137088", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "مستقيم الحديث", "itqan", "مستقيم الحديث", "الثقات", 0, -1, "", "", ""]], "5709": [["يحيى بن معين", "ليس بثقة", "ж", "قال عَبَّاس الدُّورِيُّ (١) عَنْ يحيى بْن مَعِين: ليس بثقة.", "تهذيب الكمال", "3722", 7777, "110408", 1], ["", "ليس بشيء", "ж", "وَقَال في موضع آخر (٢): ليس بشيءٍ، وقد رأيته وقد روى عنه (٣) مروان بْن معاوية.", "تهذيب الكمال", "3722", 7777, "110408", 1], ["أبيه شبيب المسلي. قلت ليحيى", "ثقة", "д", "سمعت مِنْهُ ولم يكن بثقة، روى مروان الفزاري عَن أبيه شبيب المسلي. قلت ليحيى: وكان شبيبب ثقة؟ قال: نعم. و", "تهذيب الكمال", "3722", 7778, "110418", 1], ["أبو زرعة", "لين", "ж", "وَقَال أَبُو زُرْعَة (٣): لين الحديث.", "تهذيب الكمال", "3722", -1, "35108", 1], ["", "واه", "ж", "وَقَال في موضع آخر (٤): واهي الحديث.", "تهذيب الكمال", "3722", -1, "110328", 1], ["أبو حاتم", "لا يحتج به", "ж", "وَقَال أبو حاتم (٥): شيخ يكتب حديثه، ولا يحتج به.", "تهذيب الكمال", "3722", 7778, "110418", 1], ["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي (٦): ليس بالقوي.", "تهذيب الكمال", "3722", -1, "3268", 1], ["أبو حاتم بن حبان", "صدوق", "д", "وَقَال أبو حاتم بْن حبان (٧): كان شيخًا صدوقًا (٨)، ولكنه كان يخطئ كثيرا حتى خرج عن حد الاحتجاج بِهِ إِذَا انفرد عَلَى قلة روايته (٩) . _________ (١) سؤالاته: ٢", "تهذيب الكمال", "3722", 7778, "110418", 3], ["الدارقطني", "ضعيف", "ж", "وَقَال الدَّارَقُطْنِيُّ: ضعيف الحديث لا يحتج بروايته (سننه: ٤ / ٣٩)، وذَكَره ابن الجوزي في \"الضعفاء \" (الورقة: ١١٤) .", "تهذيب الكمال", "3722", 7779, "110428", 1], ["ابن حجر", "ضعيف", "ж", "وَقَال ابن حجر في \"التقريب\": ضعيف. (١) ابن ماجة (٢٠٧٩) . (٢) تاريخ واسط: ١٩٧، وتهذيب التهذيب: ٧ / ٤٦٢، والتقريب: ٢ / ٥٧، وخلاصة الخزرجي: ٢ / الترجمة ٥١٨٣.", "تهذيب الكمال", "3722", 7779, "110428", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق يحفظ وله غرائ", "تقريب التهذيب", "8609", 418, "4188", 1]], "5708": [["النسائي", "صدوق", "д", "قال النَّسَائي: صدوق (٧ / ٥٨)", "تهذيب الكمال", "3722", -1, "97538", 1], ["الدارقطني", "ثقة", "д", "قال الحاكم عن الدارقطني: ثقة (٧ / ٥٩)", "تهذيب الكمال", "3722", 6499, "97628", 1]], "5720": [["سعيد بن المسيب؟ ف", "ليس بثقة", "ж", "قال سألت مالكا عَنْ مُحَمَّد بْن عَبْد الرحمن الذي يروي عن سَعِيد بْن المُسَيَّب؟ فقال: ليس بثقة (تقدمة الجرح والتعديل: ٢٤) .", "تهذيب الكمال", "3722", 10452, "137158", 1], ["أبو زرعة", "متروك", "ж", "قال أبو زُرْعَة: مُحَمَّد بْن عَبْد الرَّحْمَنِ بْن لبيبة عن علي مرسل (المراسيل: ١٨٤)، وذَكَره الدارقطني في \"الضعفاء والمتروكين \"وَقَال: بمراسيل عن سعد وابن عُم", "تهذيب الكمال", "3722", 10452, "137158", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف كثير الإرسال", "تقريب التهذيب", "8609", 418, "4188", 1], ["الذهبي", "ليس بشيء", "ж", "قال ابن معين ليس بشيء", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "5711": [["يحيى بن معين. يضعف يحيى بن سعيد العطار صاح", "منكر", "ж", "سمعت يَحْيَى بْن مَعِين. يضعف يَحْيَى بْن سَعِيد العطار صاحبنا، وذكر أنه أخرج (٢) كتبه وأنه روى أحاديث منكرة.", "تهذيب الكمال", "3722", 13413, "168948", 1], ["عثمان بن سعيد الدارمي", "ليس بشيء", "ж", "وَقَال عثمان بْن سَعِيد الدارمي (٣): قلت ليحيى بْن مَعِين: يَحْيَى بْن سَعِيد العطار الحمصي؟ قال: ليس بشيءٍ.", "تهذيب الكمال", "3722", 13413, "168948", 1], ["إبراهيم بن يعقوب الجوزجاني (٤)، وأبو جعفر", "منكر الحديث", "ж", "وَقَال إبراهيم بن يعقوب الجوزجاني (٤)، وأَبُو جَعْفَر العقيلي (٥): منكر الحديث.", "تهذيب الكمال", "3722", 13413, "168948", 1], ["أبو بكر بن أبي عاصم", "ثقة", "д", "وَقَال أَبُو بَكْر بْن أَبي عَاصِم: حَدَّثَنَا ابْن مصفى (٦)، قال: حَدَّثَنَا يَحْيَى بْنُ سَعِيد العطار ثقة، فذكر عنه حديثا.", "تهذيب الكمال", "3722", 13413, "168948", 1], ["الدارقطني", "ضعيف", "ж", "وَقَال الدَّارَقُطْنِيُّ: ضعيف.", "تهذيب الكمال", "3722", -1, "6378", 1], ["ابن حبان", "ضعفه", "ж", "ذكره ابنُ حِبَّان في \" المجروحين\" وَقَال: كَانَ مِمَّن يَرْوِي الموضوعات عَنِ الاثبات والمعضلات عن الثقات لا يجوز الاحتجاج به ولا الرواية عنه إِلا على سبيل الاع", "تهذيب الكمال", "3722", 13414, "168958", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "واه", "itqan", "واه", "الثقات", 0, -1, "", "", ""]], "5707": [["أبو حاتم", "صالح", "д", "قال صالح بْن أحمد بْن حَنْبَل (١)، عَن أَبِيهِ: لَيْسَ بحَدِيثه بأس.", "تهذيب الكمال", "3722", -1, "2338", 2], ["أحمد بن حنبل", "ثقة", "д", "وَقَال أَبُو طَالِب (٢)، عَنْ أَحْمَد بْن حنبل: ثقة. وكذلك", "تهذيب الكمال", "3722", -1, "154638", 1], ["أحمد يثبته.", "ثبت", "д", "سمعت أَحْمَد يثبته.", "تهذيب الكمال", "3722", -1, "458", 3], ["يحيى بن معين", "صدوق", "д", "وَقَال أَبُو بَكْر بْن أَبي خيثمة (٤)، عَنْ يحيى بْن مَعِين: ليس بِهِ بأس، صدوق، وليس بثبت (٥) .", "تهذيب الكمال", "3722", 5964, "92278", 0], ["أبو حاتم (٦)، والنسائي", "ليس به بأس", "д", "وَقَال أَبُو حاتم (٦)، والنَّسَائي: ليس به بأس. _________ (١) الجرح والتعديل: ٥ / الترجمة ١٠٠. (٢) نفسه. (٣) ثقاته، الورقة ٢٨. (٤) الجرح والتعديل: ٥ / الترجمة ١", "تهذيب الكمال", "3722", -1, "53128", 2], ["يحيى بن معين", "ثقة", "д", "وَقَال الدارمي عَنه: ثقة (تاريخه ٥٨٨)،", "تهذيب الكمال", "3722", -1, "", 0], ["يحيى بن معين", "ليس به بأس", "д", "وَقَال ابن محرز عنه. ليس به بأس (سؤالاته، الترجمة ٣٠١) . (٦) الجرح والتعديل: ٥ / الترجمة ١٠٠.", "تهذيب الكمال", "3722", -1, "", 0], ["ابن سعد كان كثير