{"5736": [["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التهذيب \": ثقة جليل القدر في نحو إبراهيم، يعني الجوزجاني،", "تهذيب الكمال", "3722", 9592, "128558", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "5731": [["الذهبي", "مجهول", "ж", "وَقَال الذهبي في \"الميزان \": مجهول (٣ / الترجمة ٧٧٧٣) .", "تهذيب الكمال", "3722", 10283, "135468", 1], ["يحيى بن معين", "ليس به بأس", "д", "قال أَبُو بَكْر بْن أَبي خيثمة (١)، عَنْ يحيى بْن مَعِين: ليس به بأس.", "تهذيب الكمال", "3722", 10284, "135478", 1], ["أبو حاتم", "ليس بالقوي", "ж", "وَقَال أبو حاتم (٢): ليس بالقوي، في حديثه نظر. و", "تهذيب الكمال", "3722", 10284, "135478", 1], ["ابن حجر العسقلاني", "لين", "ж", "لين", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "مُحَمَّد بن عبد الله بن إِنْسَان يروي عَن أَبِيه عَن عُرْوَة بن الزبير روى عَنهُ عَبْد الله بْن الْحَارِث المَخْزُومِي", "الثقات لابن حبان", "5816", "3839", "38398", 1], ["ابن أبي حاتم", "ليس به بأس", "itqan", "ليس به بأس", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ليس بالقوي", "itqan", "ليس بالقوي", "تهذيب التهذيب", 0, -1, "", "", ""]], "5741": [["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التهذيب \": وثقة مسلمة بن قاسم (٩ / ٢٤٩)", "تهذيب الكمال", "3722", 10287, "135508", 1], ["", "ثقة", "д", "وَقَال في \"التقريب\": ثقة. (٢) الجرح والتعديل: ٧ / الترجمة ١٥٩٨، والمعجم المشتمل، الترجمة ٨٥٩، والكاشف: ٣ / الترجمة ٥٠١٣، وتذهيب التهذيب: ٣ / الورقة ٢١٦، وتاريخ ", "تهذيب الكمال", "3722", 10287, "135508", 1], ["عبد الرحمن بن أبي حاتم", "صدوق", "д", "قال عبد الرحمن بْن أَبي حَاتِم (١): روى عنه أبي، وهو صدوق (٢) . وممن يسمى مُحَمَّد بْن عبد اللَّه الصنعاني:", "تهذيب الكمال", "3722", 10288, "135518", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "5733": [["يحيى بن معين", "ثقة", "д", "قال إِسْحَاق بْن مَنْصُور (٢)، عَنْ يحيى بْن مَعِين: ثقة. و", "تهذيب الكمال", "3722", -1, "7838", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. الصَّيْدَلانِيُّ فِي جَمَاعَةٍ، قَالُوا: أَخْبَرَتْنا فَاطِمَةُ بِنْتُ عَبد اللَّهِ، قَالَتْ: أَخْبَرَنَا مُحَمَّد بْن عَبد ال", "تهذيب الكمال", "3722", -1, "3728", 2], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه ابن معين", "الكاشف / سير أعلام النبلاء", "2171", 27, "5541", 1], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""]], "5740": [["يحيى بن معين", "ثقة", "д", "وَقَال عثمان بْن سَعِيد الدارمي (٣)، عَنْ يحيى بْن مَعِين: ثقة.", "تهذيب الكمال", "3722", -1, "7948", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي (٤): كوفي ثقة. _________ (١) تاريخ بغداد: ١٤ / ١٥٧. (٢) الجرح والتعديل: ٩ / الترجمة ٥٥٧. (٣) تاريخه، الترجمة ٨٧٧. (٤) ثقاته، الورقة ٥٧", "تهذيب الكمال", "3722", -1, "", 0], ["أبو حاتم", "صدوق", "д", "وَقَال أَبُو حاتم (١): صدوق. و", "تهذيب الكمال", "3722", -1, "6248", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""]], "5739": [["أبو حاتم", "ثبت", "д", "قال عَبد اللَّهِ (٢) بْن أَحْمَد بْن حنبل عَن أبيه: ما أرى به _________ = وتهذيب التهذيب: ٩ / ٣٥٨، والتقريب: ٢ / ١٩٣ وخلاصة الخزرجي: ٢ / الترجمة ٦٥٢٨. (•) بضم ا", "تهذيب الكمال", "3722", -1, "139018", 2], ["علي بن المديني", "ثقة", "д", "وَقَال علي بن المديني: ثقة.", "تهذيب الكمال", "3722", -1, "115618", 1], ["أبو حاتم", "ثقة", "д", "وَقَال عَبد اللَّهِ بْن أَحْمَد أيضا عَن أبيه: ثقة. (العلل ومعرفة الرجال: ٢ / ٣١٣) . (٢) تاريخه: ٢ / ٥٣٢. (٣)", "تهذيب الكمال", "3722", 10651, "139148", 1], ["الدارمي", "يخطئ", "ж", "وَقَال الدارمي: قلت: فمحمد بن عمار، الذي يروي عنه معن؟ فقال: لا أعرفه. (تاريخه، الترجمة ٧٧٩) . (٤) الجرح والتعديل: ٨ / الترجمة ١٩٧. (٥) ٧ / ٤٣٦. وَقَال: كان ممن", "تهذيب الكمال", "3722", 10651, "139148", 1], ["", "صالح", "д", "وَقَال في المؤذن: وهذه الاحاديث يرويها محمد بن عمار المؤذن عن صالح مولى التؤمة عن المقبري، وهذه الاحاديث تعرف بمحمد بن عمار هذا.", "تهذيب الكمال", "3722", 10651, "139148", 1], ["الذهبي", "حسن الحديث", "д", "وَقَال الذهبي في \"الميزان \": تكلم فيه البخاري وغيره ولم يترك. أفرد ابن عدي محمد بن عمار هذا عن محمد بن عمار الأَنْصارِيّ المدني، وكلاهما واحد وهو حسن الحديث في ", "تهذيب الكمال", "3722", 10651, "139148", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "صدوق", "д", "أبو حاتم الرازيب بسئل أبي عنه فقال صدوقب بالجرح والتعديل لابن أبي حاتم …ا بقال أبو حاتم صدوقب بتهذيب الكمال …ا بقال أبو حاتم صدوقب بتهذيب التهذيب …ااا بابن حجرب", "موسوعة الرواة (джарх)", "", ""], ["ابن حجر العسقلاني", "صدوق", "itqan", "صدوق", "تهذيب التهذيب", 0, -1, "", "", ""]], "5743": [["أبو حاتم", "صالح", "д", "قال صالح بْن أحمد بْن حَنْبَل (١)، عَن أَبِيهِ: لَيْسَ بحَدِيثه بأس.", "تهذيب الكمال", "3722", -1, "2338", 2], ["أحمد بن حنبل", "ثقة", "д", "وَقَال أَبُو طَالِب (٢)، عَنْ أَحْمَد بْن حنبل: ثقة. وكذلك", "تهذيب الكمال", "3722", -1, "154638", 1], ["أحمد يثبته.", "ثبت", "д", "سمعت أَحْمَد يثبته.", "تهذيب الكمال", "3722", -1, "458", 3], ["يحيى بن معين", "صدوق", "д", "وَقَال أَبُو بَكْر بْن أَبي خيثمة (٤)، عَنْ يحيى بْن مَعِين: ليس بِهِ بأس، صدوق، وليس بثبت (٥) .", "تهذيب الكمال", "3722", 5964, "92278", 0], ["أبو حاتم (٦)، والنسائي", "ليس به بأس", "д", "وَقَال أَبُو حاتم (٦)، والنَّسَائي: ليس به بأس. _________ (١) الجرح والتعديل: ٥ / الترجمة ١٠٠. (٢) نفسه. (٣) ثقاته، الورقة ٢٨. (٤) الجرح والتعديل: ٥ / الترجمة ١", "تهذيب الكمال", "3722", -1, "53128", 2], ["يحيى بن معين", "ثقة", "д", "وَقَال الدارمي عَنه: ثقة (تاريخه ٥٨٨)،", "تهذيب الكمال", "3722", -1, "", 0], ["يحيى بن معين", "ليس به بأس", "д", "وَقَال ابن محرز عنه. ليس به بأس (سؤالاته، الترجمة ٣٠١) . (٦) الجرح والتعديل: ٥ / الترجمة ١٠٠.", "تهذيب الكمال", "3722", -1, "", 0], ["ابن سعد كان كثيرا الحديث صالحا (الطبقات", "صالح", "д", "وَقَال ابن سعد كان كثيرا الحديث صالحا (الطبقات: ٩ / الورقة ٢٥٧) . (٥) طبقات ابن سعد: ٩ / الورقة ٢٥٦. (٦) في النسخة المخطوطة\"مَا عزل قاض عَنِ الْمَدِينَة أو مات.", "تهذيب الكمال", "3722", -1, "", 0], ["البخاري", "صدوق", "д", "قَال البُخارِيُّ: صدوق ثقة (العلل الكبير للترمذي الورقة ٣٠) .", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه النسائي وقال البخاري لا يتابع على حديثه", "الكاشف / سير أعلام النبلاء", "2171", 870, "8718", 1], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "5745": [["النسائي", "ثقة", "д", "قال النَّسَائي (١): ثقة، صاحب حديث (٢) .", "تهذيب الكمال", "3722", 10934, "141978", 1], ["منه، وهو", "صدوق", "д", "سمعت منه، وهو صدوق، ثقة، وجدت في كتب أبي زرعة (٤) قد كتب عَنْهُ، ورأيت أبا زرعة يبجله ويكرمه. _________ (١) تاريخ الخطيب: ٣ / ٢٥٩، والمعجم المشتمل، الترجمة ٩٥٥.", "تهذيب الكمال", "3722", 10934, "141978", 2], ["", "لا بأس به", "д", "وَقَال فِي موضع آخر: لا بأس به. (المعجم المشتمل، الترجمة ٩٥٥) . (٣) الجرح والتعديل: ٨ / الترجمة ٣٣٢. (٤) في المطبوع من الجرح والتعديل زاد في هذا الموضع كلمة \"بخ", "تهذيب الكمال", "3722", 10934, "141978", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "صدوق", "д", "ابن حجرب بصدوقب بتقريب التهذيب …ااا بابن شاهينب بقلت قال ابن شاهين في ?ب الثقات ?ب قال ابن معين ليس به بأسب بتهذيب التهذيب …اااان", "موسوعة الرواة (джарх)", "", ""]], "5753": [["ابن حبان", "صالح", "д", "وَقَال ابْن حبان فِي كتاب \"الثقات\" (١): مُحَمَّد بْن عَبد اللَّهِ بْن عَبَّادِ بْنِ عَبد اللَّهِ بْنِ الزبير. روى فليح بْن سُلَيْمان عن صالح بْن عجلان عنه - كذا", "تهذيب الكمال", "3722", 10321, "135848", 1], ["الذهبي", "مجهول", "ж", "وَقَال الذهبي في \"الميزان مجهول (٣ / الترجمة ٧٧٨٨) وكذلك", "تهذيب الكمال", "3722", 10321, "135848", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "مجهول", "ж", "مجهول", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "5754": [["النسائي", "ثقة", "д", "قال النَّسَائي (١): ثقة.", "تهذيب الكمال", "3722", -1, "2708", 1], ["", "صدوق", "д", "وَقَال فِي موضع آخر (٢): صدوق لا بأس به.", "تهذيب الكمال", "3722", 10330, "135938", 1], ["عبد الرحمن (١) بن أبي حاتم", "صدوق", "д", "وَقَال عَبْد الرَّحْمَنِ (١) بْن أَبي حاتم: كتبت عنه وهو صدوق ثقة أحد فقهاء مصر من أصحاب مالك.", "تهذيب الكمال", "3722", 10331, "135948", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "5763": [["عبد الرحمن بن أبي حاتم", "ثقة", "д", "وَقَال عَبْد الرَّحْمَنِ بْن أَبي حَاتِم: سَأَلتُ أَبِي عَنْهُ، فَقَالَ: ثقة (الجرح والتعديل: ٧ / الترجمة ١٦٣٣) .", "تهذيب الكمال", "3722", 10340, "136038", 1], ["ابن قانع", "صالح", "д", "قال ابن قانع: صالح (٩ / ٢٦٥) .", "تهذيب الكمال", "3722", -1, "136038", 1], ["محمد بن غالب", "ثقة", "д", "سمعت مُحَمَّد بْن غالب يقول: حَدَّثَنِي مُحَمَّد بْن عَبد اللَّهِ بْن عمار الثقة كان من أهل الحديث.", "تهذيب الكمال", "3722", 10342, "136058", 1], ["أبو العباس", "ثقة", "д", "قال أَبُو العباس: وسألت عَبد اللَّه بْن أَحْمَد عنه فقال: ثقة.", "تهذيب الكمال", "3722", 10342, "136058", 1], ["أبو زكريا يزيد بن محمد بن إياس الأزدي", "لين", "ж", "وَقَال أَبُو زكريا يزيد بْن مُحَمَّد بْن إياس الأزدي (٣) في كتاب _________ (١) تاريخ الخطيب: ٥ / ٤١٨. (٢) نفسه. (٣) تاريخ الخطيب: ٥ / ٤١٧ - ٤١٨. وكتاب الأزدي هذ", "تهذيب الكمال", "3722", 10342, "136058", 2], ["يعقوب بن سفيان (١) وصالح بن محمد الأسدي، و", "صالح", "д", "وَقَال يعقوب بْن سُفْيَان (١) وصالح بْن مُحَمَّد الأسدي، والنَّسَائي (٢): ثقة. زاد صالح: كيس. وزاد النَّسَائي (٣): صاحب حديث.", "تهذيب الكمال", "3722", 10343, "136068", 1], ["أبو حاتم", "لا بأس به", "д", "وَقَال أَبُو حاتم (٤): لا بأس به (٥) . و", "تهذيب الكمال", "3722", 10343, "136068", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة حافظ", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "حافظ", "д", "الحافظ", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""], ["البخاري", "ثقة",