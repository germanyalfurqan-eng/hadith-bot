{"16900": [["", "ثقة", "д", "الخطيب البغداديب بحدث عنه أبو بكر الخطيب وقال كان ثقة من أهل القرآنب بسير أعلام النبلاء …ا بوكان صدوقا ثقة من أهل القرآن حسن الاعتقادب بتاريخ بغداد …ا بروى عنه ", "موسوعة الرواة (джарх)", "", ""]], "16906": [["", "ثقة", "д", "ابن عساكرب بروى عنه أبو القاسم بن عساكر وقال كان ثقة مستورا سهلا قرأت عليه الكثيرب بتاريخ الإسلام …ا بقال الحافظ ابن عساكر كان شيخا ثقة مستورا سهلا قرأت عليه ال", "موسوعة الرواة (джарх)", "", ""]], "16908": [["", "ثقة", "д", "عبد العزيز بن أحمد الكتانيب بقال عبد العزيز الكتاني كان ثقةب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "16909": [["", "مجهول", "ж", "أبو حاتم الرازيب بمجهولب بلسان الميزان …ا بسمعت أبي يقول هو مجهولب بالجرح والتعديل لابن أبي حاتم …ااا بالدارقطنيب بقال الدارقطني ليس بالقويب بلسان الميزان …اااا", "موسوعة الرواة (джарх)", "", ""]], "16911": [["", "مجهول", "ж", "أبو حاتم الرازيب بسئل أبي عنه فقال لا أعلم روى عنه إلا ابن أبي أويس وأرى في حديثه ضعف وهو مجهولب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "16919": [["", "إمام", "д", "الذهبىب بالشيخ الإمام الصدوقب بسير أعلام النبلاء …ااا بمحمد بن إبراهيم الأصبهانيب بقال الكتاني كان ثقةب بسير أعلام النبلاء …ا بووثقه الكتانيب بتاريخ الإسلام …اا", "موسوعة الرواة (джарх)", "", ""]], "16924": [["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "زَكَرِيَّا بن حَكِيم يروي عَن الْحسن روى عَنهُ عَنْبَسَة بن عبد الْوَاحِد", "الثقات لابن حبان", "5816", "2447", "24478", 1], ["النسائي", "ليس بثقة", "ж", "حكيم كوفي ليس بثقة", "الضعفاء والمتروكون للنسائي", "10805", "33", "338", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["البخاري", "ثقة", "itqan", "ليس بثقة", "التاريخ الكبير", 0, -1, "", "", ""]], "16925": [["", "صدوق", "д", "الذهبىب بالشيخ الصدوقب بسير أعلام النبلاء …ااا بعبد الرحمن بن صابرب بقال السلفي سمعت عبد الرحمن بن صابر سمعت سهل بن بشر يقول اجتمعنا بمصر فلم يأذن لنا علي بن من", "موسوعة الرواة (джарх)", "", ""]], "16927": [["", "صدوق", "д", "محمد بن محمود ابن النجار البغداديب بقال ابن النجار قرأ عليه الناس القراءات فأكثروا وكان صدوقا نزها عفيفاب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "16933": [["", "يهم", "ж", "ابن حبانب بيهم ويغرب كذا قال ابن حبان في ?بالثقات?بيب بلسان الميزان …ا بوكان راويا لأبي قرةب بالثقات …ا بيهم ويغربب بالثقات …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16939": [["", "ثقة", "д", "الذهبىب بأحد محدثي دمشق الثقاتب بتاريخ الإسلام …ا بمحدث ثقة مفيدب بسير أعلام النبلاء …اااان", "موسوعة الرواة (джарх)", "", ""]], "16944": [["", "مجهول", "ж", "مسلمة بن القاسمب بمجهولي قاله مسلمةب بلسان الميزان …ااا بابن حجرب بقلت روى عنه أبو جعفر الطحاوي ووجيه بن الحسن بن يوسف وأبو عمرو عثمان بن محمد السمرقندي فليس بم", "موسوعة الرواة (джарх)", "", ""]], "16947": [["", "ضعيف", "ж", "ابن حجرب بأتى عن الأوزاعي بخبر باطلب بلسان الميزان …ا بقلت وما أدري لم حكم على هذا الحديث بالبطلان ولم يحك تضعيف عنبسة عن غيره ?ب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "16952": [["", "صالح", "д", "الذهبىب بالرجل الصالحي أحد حفاظ الحديثب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "16957": [["", "صالح", "д", "أبو حاتم الرازيب بسألت أبي عنه فقال لا أعرفه وحديثه صحاحب بالجرح والتعديل لابن أبي حاتم …ا بقال أبو حاتم لا أعرفه وحديثه صالحب بتهذيب التهذيب …ااا بأحمد بن محمد", "موسوعة الرواة (джарх)", "", ""], ["أبو حاتم الرازي", "لا أعرفه", "ж", "لا أعرفه وحديثه صحاح", "الجرح والتعديل", "2170", "2332", "23328", 1], ["أبو حاتم الرازي", "لا أعرفه", "ж", "فقال: لا أعرفه وحديثه صحاح", "الجرح والتعديل", "2170", "2332", "23328", 1], ["ابن حجر العسقلاني", "لا أعرفه", "itqan", "لا أعرفه", "تهذيب التهذيب", 0, -1, "", "", ""]], "16966": [["", "صالح", "д", "أحمد بن حنبلب بنا عبد الرحمن أنا عبد الله بن أحمد بن محمدا بن حنبل فيما كتب إلي قال سألت أبي عن عبد الله بن سبرة فقال صالحي روى عنه هشيمب بالجرح والتع