{"601": [["أبو حاتم", "صدوق", "д", "قال أبو حاتم (١): صدوق. كان حيا سنة خمس وخمسين ومئتين.", "تهذيب الكمال", "3722", "969", "9718"], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "", ""]], "605": [["الترمذي", "واه", "ж", "وَقَال التِّرْمِذِيّ: ليس إسناده بمتصل، عون بن عَبد الله بن عتبة لم يلق ابن مسعود. قلت (القائل شعيب): لكن للحديث شواهد يقوى بها، فعند الدارقطني ١ / ٣٤١، والطحاو", "تهذيب الكمال", "3722", "976", "9768"], ["هذان الإمامان فقط، والله أعلم\"، ولكن", "إمام", "д", "ذكره هذان الإمامان فقط، والله أعلم\"، ولكن", "تهذيب الكمال", "3722", "976", "9768"], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "", ""], ["", "مجهول", "ж", "ابن حبانب بقلت ذكره ابن حبان في الثقاتب بتهذيب التهذيب …ا بذكره أبو حاتم ابن حبان في كتاب ? الثقات ?ب بإكمال تهذيب الكمال …ااا بابن حجرب بمجهولب بتقريب التهذيب ", "موسوعة الرواة (джарх)", "", ""]], "604": [["الدارقطني حين سأله الحاكم", "صالح", "д", "وَقَال الدَّارَقُطْنِيُّ حين سأله الحاكم: أحاديثه صالحة، ومحمد يستشهد به ولا يعتده في الاصول (سؤالات الحاكم)، وذَكَره ابنُ حِبَّان في (الثقات: ١ / الورقة: ٢٩) و", "تهذيب الكمال", "3722", "975", "9758"], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول الحال", "تقريب التهذيب", "", ""]], "602": [["أبو حاتم", "صالح", "д", "وَقَال صالح بْن أحمد بْن حنبل، عَن أبيه (٣): منكر الحديث ليس بشيءٍ. _________ (١) رواه ابن أَبي حاتم في الجرح والتعديل: ١ / ١ / ٢٣٦ عن صالح بْن أَحْمَد بْن حنبل", "تهذيب الكمال", "3722", "971", "9728"], ["أبو حاتم", "متروك", "ж", "وَقَال عَبد اللَّهِ بْن أَحْمَد بْن حنبل، عَن أبيه (١): متروك الحديث.", "تهذيب الكمال", "3722", "971", "9738"], ["يحيى بن معين", "صالح", "д", "وَقَال معاوية بْن صالح، عَن يحيى بْن مَعِين (٢): ضعيف. وكذلك", "تهذيب الكمال", "3722", "971", "9738"], ["يحيى، وزاد", "ليس بشيء", "ж", "قال عباس الدُّورِيُّ، (٣) عَن يحيى، وزاد: ليس بشيءٍ لا يكتب حديثه.", "تهذيب الكمال", "3722", "971", "9738"], ["عمرو بن علي", "متروك", "ж", "وَقَال عَمْرو بْن علي (٤): متروك الحديث، منكر الحديث. و", "تهذيب الكمال", "3722", "971", "9738"], ["النسائي", "ليس بثقة", "ж", "وَقَال النَّسَائي (٧): ليس بثقة.", "تهذيب الكمال", "3722", "971", "9738"], ["", "متروك", "ж", "وَقَال في موضع آخر (٨): متروك الحديث.", "تهذيب الكمال", "3722", "971", "9738"], ["أبو زرعة", "واه", "ж", "وَقَال أبو زُرْعَة (٩): واهي الحديث.", "تهذيب الكمال", "3722", "971", "9738"], ["يعقوب بن شيبة", "لا بأس به", "д", "وَقَال يعقوب بْن شَيْبَة: لا بأس به. وحديثه مضطرب جدا.", "تهذيب الكمال", "3722", "971", "9748"], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "", ""]], "606": [["أحمد بن عبد الله العجلي", "ثقة", "д", "قال أَحْمَد بْن عَبْد اللَّهِ العجلي (١): عفان بن مسلم بصري ثقة ثبت صاحب سنة، وكان على مسائل معاذ بن معاذ القاضي فجعل له عشرة آلاف دينار على أن يقف عن تعديل رجل", "تهذيب الكمال", "3722", ""], ["لي", "عدل", "д", "قال لي: لك من هذا المال الذي لي على هذا الرجل نصفه وهو ألفا دينار وتعدل شاهدي. فقلت: استحييت لك، وشهوده عندنا غير مستورين. قال: وكان عفان على مسألة معاذ بن معاذ", "تهذيب الكمال", "3722", ""], ["ابن حجر العسقلاني", "وثقه", "ж", "وثقه النسائي", "تقريب التهذيب", "", ""], ["الذهبي", "وثقه", "ж", "وثقه النسائي", "الكاشف / سير أعلام النبلاء", "", ""], ["", "وثقه", "д", "الذهبىب بووثقهب بالكاشف في معرفة من له رواية في الكتب الستة …ااا بالنسائيب بوعنه النسائي وقال ثقةب بتهذيب التهذيب …ا بالنسائي وقال ثقةب بتهذيب الكمال …ا بوثقه ا", "موسوعة الرواة (джарх)", "", ""]], "607": [["فيه\"لا يحتج به\"، ولم يبينه (الميزان", "لا يحتج به", "ж", "قال فيه\"لا يحتج به\"، ولم يبينه (الميزان: ١ / ٢٠٥) . وترجم له ابن سعد في \"الطبقات: ٩ / الورقة: ١٦٣\"، والبخاري في تاريخه الكبير: ١ / ١ / ٤٠٥ وغيرهما. (٢) تاريخ ال", "تهذيب الكمال", "3722", "978", "9788"], ["أحمد بن حنبل", "يهم", "ж", "سمعت أَحْمَد بْن حنبل يَقُول: إسحاق، يعني الأزرق - وعباد بْن العوام ويزيد، كتبوا عَن شَرِيك بواسط من كتابه. قال: قدم عليهم في حفر نهر، وكان شَرِيك رجلا له عقل، ", "تهذيب الكمال", "3722", "978", "9808"], ["أحمد", "ثقة", "д", "قال أحمد: سماع هؤلاء أصح عنه. قيل: إسحاق الأزرق ثقة؟ قال: إي والله ثقة.", "تهذيب الكمال", "3722", "978", "9808"], ["أحمد بن علي الأبار", "يهم", "ж", "وَقَال أحمد بن علي الأبار (٢): سألت عبد الحميد بْن بيان عَن إسحاق الأزرق، وكيف سمع من شَرِيك. قال: سمع منه بواسط. قلت له: في أي شيء جاء إلى واسط؟ قال: جاء في كر", "تهذيب الكمال", "3722", "978", "9808"], ["يحيى بن معين", "ثقة", "д", "وَقَال عثمان بْن سَعِيد الدارمي (٤)، عَن يحيى بن مَعِين: ثقة. _________ (١) تاريخ الخطيب: ٦ / ٣٢٠ - ٣٢١. (٢) نفسه: ٦ / ٣٢٠. (٣) في تاريخ بغداد للخطيب: خمسة. (٤)", "تهذيب الكمال", "3722", "978", "9808"], ["ثقة. قلت", "ثقة", "д", "قال ثقة. قلت: إسحاق أحب إليك أو ابْن مسهر؟ فقال: ابن مسهر أحب إلي\". وانظر أيضا الجرح والتعديل لابن أَبي حاتم (١ / ١ / ٢٣٨)، وتاريخ الخطيب (٦ / ٣٢١) . وكذلك", "تهذيب الكمال", "3722", "978", "9808"], ["أبو حاتم", "صدوق", "д", "وَقَال أبو حاتم (٢): صحيح الحديث، صدوق، لا بأس به.", "تهذيب الكمال", "3722", "978", "9818"], ["يعقوب بن شيبة", "واه", "ж", "وَقَال يعقوب بْن شَيْبَة في حديث رواه معاوية بْن هشام عَن شَرِيك: وكان من أعلمهم بحديث شَرِيك هو وإسحاق الأزرق.", "تهذيب الكمال", "3722", "978", "9818"], ["", "حافظ", "д", "وَقَال الحافظ أبو نعيم فيما أَخْبَرَنَا يوسف بْن يعقوب، عَن", "تهذيب الكمال", "3722", "978", "9818"], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "", ""], ["الذهبي", "ثقة", "д", "ثقة عابد رفيع القدر إمام", "الكاشف / سير أعلام النبلاء", "", ""]], "613": [["ابن حبان", "وثقه", "д", "ذكره ابنُ حِبَّان في \"الثقات: ١ / الورقة: ٣٠\"، وذكر مغلطاي أن ابن خلفون وثقه. (وراجع ميزان الذهبي: ١ / ٢١١ وتصحف فيه إلى\"أسفع\"بالفاء.) من اسمه أسلم", "تهذيب الكمال", "3722", "1009", "10098"], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "الْأَسْقَع بْن الأسلع يروي عَن سَمُرَة بْن جُنْدُب روى عَنهُ سُوَيْد بْن حُجَيْر", "الثقات لابن حبان", "5816", "1174", "11748"]], "611": [["يحيى بن معين أنه", "ثقة", "д", "ذكره أبي عن إسحاق الكوسج، عَن يحيى بْن مَعِين أنه قال:..ثقة.", "تهذيب الكمال", "3722", "997", "9978"], ["أبي", "لا بأس به", "д", "سمعت أبي يقول: إسرائيل بن موسى لا بأس به. (٢) و", "تهذيب الكمال", "3722", "997", "9978"], ["ابن حجر العسقلاني",