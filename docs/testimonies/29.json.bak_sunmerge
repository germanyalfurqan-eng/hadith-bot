{"2914": [["العجلي", "ثقة", "д", "وَقَال العجلي: مكية تابعية ثقة (ثقاته، الورقة ٦٦) . وروت عَن: القاسم بن محمد بن أَبي بكر الصديق، وحفصة بنت عُمَر (م س ق)، وعائشة (م د س ق)، وأم سلمة (د س): أزوا", "تهذيب الكمال", "3722", -1, "188128", 0], ["ابن حجر العسقلاني", "ثقة", "д", "قيل لها إدراك وأنكره الدارقطنيي وقال العجلي ثقة", "تقريب التهذيب", "8609", "", "", 0]], "2900": [["ابن حجر العسقلاني", "ثقة", "д", "له صحبة وقيل إنه مخضرمي ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "صحابي", "itqan", "صحابي", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "له صحبة", "itqan", "له صحبة", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "واه", "itqan", "واه", "الطبقات الكبرى", 0, -1, "", "", ""]], "2901": [["ابن حجر العسقلاني", "صدوق", "д", "صدوق يهمي وكان زاهد", "تقريب التهذيب", "8609", 202, "2028", 3], ["الذهبي", "ثقة", "д", "ثقة عابد", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ليس بالقوي", "itqan", "ليس بالقوي", "تهذيب التهذيب", 0, -1, "", "", ""]], "2904": [["ابن حجر العسقلاني", "ثقة", "д", "ثقة مفت عابد رمي بالقدر", "تقريب التهذيب", "8609", 202, "2028", 1], ["الذهبي", "ثقة", "д", "يقال إنه لم يضع جنبه أربعين سنة وقيل إن جبهته ثقبت من كثرة السجود وكان قانعا لا يقبل جوائز السلطان ثقة حجة", "الكاشف / سير أعلام النبلاء", "2171", 494, "4948", 1], ["العجلي", "ثقة", "д", "سليم مدني ثقة رجل صالح", "معرفة الثقات للعجلي", "5825", "289", "2898", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "يضع", "itqan", "يضع", "الكاشف", 0, -1, "", "", ""]], "2905": [["ابن حجر العسقلاني", "ثقة", "д", "ثقةي وكان يدلس تدل