 أعلم له غير هذا. انتهى. وانما", "تهذيب الكمال", "3722", 12627, "158908", 1], ["ابن معين", "ثقه", "jarh", "ابن مَعِين فيه انه: ثقة", "تهذيب الكمال", "3722", -1, "158908", 1]], "6524": [["ابن حبان", "منكر الحديث", "ж", "ذكره ابنُ حِبَّان في كتاب\" المجروحين\" وَقَال: منكر الحديث جدا، يأتي عن عكرمة بما ليس من حديثه حتى يسبق إلي القلب أنه كان المتعمد لها لا يجوز الاحتجاج به بحال. (", "تهذيب الكمال", "3722", 12643, "159068", 1], ["العجلي", "ثقة", "д", "قال العجلي (١): كوفي، تابعي، ثقة، من كبار التابعين. و", "تهذيب الكمال", "3722", 12644, "159078", 1], ["ابن سعد", "ثقة", "д", "ذكره ابن سعد في الطبقة الأولى من تابعي أهل الكوفة، وَقَال: كان ثقة وله احاديث (طبقاته: ٦ / ٨٥) .", "تهذيب الكمال", "3722", 12644, "159078", 1], ["يحيى بن معين", "ثقة", "д", "ذكره أبي عن إسحاق بْن مَنْصُور عَنْ يحيى بْن مَعِين، قال: النزال بن سبرة ثقة من ي", "تهذيب الكمال", "3722", 12644, "159078", 1], ["النزال بن سبرة ف", "لا بأس به", "д", "سئل أبي عن النزال بن سبرة فقال: لا بأس به. (الجرح والتعديل: ٨ / الترجمة ٢٢٧٩) .", "تهذيب الكمال", "3722", 12644, "159078", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة، وقيل ان له صحبة. مَيْسَرَةَ، قال:", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "قيل له صحبة ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""], ["الذهبي", "له صحبة", "itqan", "له صحبة", "الكاشف", 0, -1, "", "", ""]], "6534": [["يحيى بن معين", "لا بأس به", "д", "قال إِبْرَاهِيم بْن عَبد اللَّهِ بْن الجنيد (٢)، عَنْ يحيى بْن مَعِين: لا بأس به.", "تهذيب الكمال", "3722", 12655, "159188", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في \" الكاشف\": ثقة (٣ / الترجمة ٥٩٠٨) .", "تهذيب الكمال", "3722", 12655, "159188", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق. (٥) تذهيب التهذيب: ٤ / الورقة ٩٤، ونهاية السول، الورقة ٣٩٨، وتهذيب التهذيب: =", "تهذيب الكمال", "3722", 12655, "159188", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "نصر بن زيد يروي عَن يَعْقُوب القمي روى عَنْهُ مُحَمَّد بْن عِيسَى بن الطباع", "الثقات لابن حبان", "5816", "4023", "40238", 1]], "6529": [["العجلي", "ثقة", "д", "وَقَال العجلي: تابعه ثقة\".", "تهذيب الكمال", "3722", -1, "17398", 1], ["ابن سعد", "وثقه", "д", "وَقَال ابن سعد: روى عن الصحابة، وهو قليل الحديث\". ووثقه ابن خلفون، والذهبي، وابن حجر. وترجمه الذهبي في الطبقة الحادية عشرة (١٠١ - ١١٠) من\"تاريخ الاسلام\". ٧٥٥ - ", "تهذيب الكمال", "3722", 1740, "17418", 1], ["ابن السكن", "صالح", "д", "وَقَال ابن السكن: له حديث واحد بإسناد صالح\".", "تهذيب الكمال", "3722", 1741, "17428", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق لم يصب من ضعفه", "تقريب التهذيب", "8609", 485, "4858", 1], ["ابن حبان", "ذكره في الثقات", "д", "نسير بْن ذعلوق يروي عَنْ جمَاعَة من التَّابِعين روى عَنهُ أهل الْكُوفَة كنيته أَبُو طعمة الثَّوْريّ", "الثقات لابن حبان", "5816", "3154", "31548", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "لا شيء", "itqan", "لا شيء", "تهذيب التهذيب", 0, -1, "", "", ""]], "6533": [["العقيلي", "متروك", "ж", "ذكره العقيلي في \" الضعفاء\" وَقَال: متروك. (الضعفاء والمتروكون، الورقة ٢٢٠)،", "تهذيب الكمال", "3722", 12654, "159178", 1]], "6532": [["يحيى بن معين", "كذاب", "ж", "سمعت يحيى بْن مَعِين يَقُول: نصر بن حماد كذاب (٣) .", "تهذيب الكمال", "3722", 12652, "159158", 1], ["يعقوب بن شيببة", "ليس بشيء", "ж", "وَقَال يعقوب بن شيببة (٤): ليس بشيءٍ. _________ (١) بالشين المعجمة جوده المؤلف في نسخته التي بخطه وصحح عليه، وقد تقدم. (٢) ضعفاء العقيلي، الورقة ٢٢٠. (٣)", "تهذيب الكمال", "3722", -1, "159158", 0], ["ابن الجنيد", "ليس بثقة", "ж", "وَقَال ابن الجنيد: وسألته عَن أبي الحارث الوراق؟ فقال: ليس بثقة. (سؤالاته، الترجمة ٦٧٧) . (٤) تاريخ الخطيب: ١٣ / ٢٨١. و", "تهذيب الكمال", "3722", 12652, "159158", 0], ["النسائي", "ليس بثقة", "ж", "وَقَال النَّسَائي (٣): ليس بثقة.", "تهذيب الكمال", "3722", -1, "8528", 1], ["أبو زرعة (٤)، وصالح بن محمد الحافظ", "صالح", "д", "وَقَال أَبُو زُرْعَة (٤)، وصالح بن مُحَمَّد الحافظ (٥): لا يكتب حديثه.", "تهذيب الكمال", "3722", 12653, "159168", 1], ["أبو حاتم (٦)، وأبو الفتح الأزدي", "متروك", "ж", "وَقَال أَبُو حاتم (٦)، وأَبُو الفتح الأزدي: متروك الحديث.", "تهذيب الكمال", "3722", 12653, "159168", 1], ["ابن حبان", "يخطئ", "ж", "وَقَال ابن حبان (٧): كان يخطئ كثيرا، ويهم فِي الإسناد، فلما كثر ذلك منه بطل الاحتجاج بِهِ.", "تهذيب الكمال", "3722", 12653, "159168", 1], ["الدارقطني", "متروك", "ж", "ذكره الدارقطني في \" الضعفاء والمتروكون\" (الترجمة ٥٤٦) . (١١) الكامل: ٣ / الورقة ١٧٧. وهذه الأحاديث التي ذكرتها عَنِ نصر، عَنْ شُعْبَةَ، ولَهُ غيرها عَنْ شُعْبَة", "تهذيب الكمال", "3722", 12653, "159168", 0], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف أفرط الأزدي فزعم أنه يضع", "تقريب التهذيب", "8609", 485, "4858", 1], ["الذهبي", "حافظ", "ж", "حافظ متهمي قال أبو زرعة لا يكتب حديثه", "الكاشف / سير أعلام النبلاء", "2171", 1002, "10038", 3], ["الذهبي", "يكتب حديثه", "itqan", "يكتب حديثه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "كذاب", "itqan", "كذاب", "تهذيب التهذيب", 0, -1, "", "", ""], ["البخاري", "كذاب", "itqan", "كذاب", "التاريخ الكبير", 0, -1, "", "", ""]], "6539": [["النسائي", "ثقة", "д", "وَقَال النَّسَائي (٣): ثقة. _________ (١) الجرح والتعديل: ٨ / الترجمة ٢١٦٣. (٢) في المطبوع من الجرح والتعديل: يحفظ ما يحدث به. (٣) المعجم المشتمل، الترجمة ١٠٨٣.", "تهذيب الكمال", "3722", -1, "159238", 2], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "شيخ", "itqan", "شيخ", "الجرح والتعديل", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""]], "6540": [["ابن سعد", "ثقة", "д", "قال ابْن سَعْد (٢): وكان ثقة.", "تهذيب الكمال", "3722", -1, "126628", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي (٣): شامي تابعي ثقة.", "تهذيب الكمال", "3722", 9409, "126728", 1], ["النسائي", "لا بأس", "д", "وَقَال النَّسَائي: لا بأس بِهِ.", "تهذيب الكمال", "3722", -1, "2178", 1], ["ابن خراش", "صدوق", "д", "وَقَال ابْن خراش: صدوق _________ (١) طبقاته: ٧ / ٤٤٨. (٢) نفسه. (٣) ثقاته، الورقة ٤٦. و", "تهذيب الكمال", "3722", -1, "126628", 2], ["كثير بن مرة الحضرمي", "صالح", "д", "وَقَال مُعَاوِيَة بْن صَالِح، عَن أَبِي الزاهرية، عَنْ كَثِير بْن مُرَّةَ الحضرمي: دخلت المسجد يَوْم الجمعة، فمررت بعوف بْن مَالِك الأشجعي وهُوَ باسط رجليه، قال", "تهذيب الكمال", "3722", 9410, "126738", 1], ["أبو زرعة الدمشقي", "إمام", "д", "وَقَال أَبُو زُرْعَة الدِّمَشْقِيّ (٣): قلت، يَعْنِي لدحيم: فمن يكون معهم في طبقتهم من أصحابنا، يَعْنِي جُبَيْر بْن نُفَيْر وأَبَا إدريس الخولاني - فَقَالَ: كَث", "تهذيب الكمال", "3722", 9410, "126738", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\"ثقة وهم من عده في الصحابة. (٢) المعرفة ليعقوب: ٢ / ٧٠٢، والجرح والتعديل: ٧ / الترجمة ٨٧١، وثقات ابن حبان ٥ / ٣٣١، والكاشف: ٣ / الترجم", "تهذيب الكمال", "3722", 9411, "126748", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "6550": [["النسائي", "ثقة", "д", "قال النَّسَائي (٢): ثقة.", "تهذيب الكمال", "3722", -1, "2698", 1], ["أبو حاتم الرازي", "ثقة", "д", "وَقَال أبو حاتم الرازي: ثقة. (الجرح والتعديل: ٨ / الترجمة ٢٢٥٨) .", "تهذيب الكمال", "3722", 12679, "159428", 1], ["أبو علي الجياني", "ثقة", "д", "وَقَال أبو علي الجياني: ثقة. (تسمية شيوخ أبي داود، الورقة ٩٥) .", "تهذيب الكمال", "3722", -1, "159288", 1], ["مسلمة", "ثقة", "д", "قال مسلمة: شامي ثقة. (١٠ / ٤٣٤) .", "تهذيب الكمال", "3722", 12679, "159428", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة.", "تهذيب الكمال", "3722", -1, "15928", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["", "ثقة", "д", "أبو حاتم الرازيب بسئل … ك? أبي عنه فقال ثقةيب بالجرح والتعديل لابن أبي حاتم …ااا بابن حجرب بثقةب بتقريب التهذيب …ااا بالذهبىب بثقةب بالكاشف في معرفة من له رواية", "موسوعة الرواة (джарх)", "", ""], ["النسايي", "ثقه", "jarh", "النَّسَائي (٢): ثقة", "تهذيب الكمال", "3722", -1, "159428", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "6545": [["ابن حجر", "متروك", "ж", "وَقَال ابن حجر في \"التقريب\": متروك. (٣) تذهيب التهذيب: ٣ / الورقة ١٢٦، ونهاية السول، الورقة ٢٨٧، وتهذيب التهذيب: ٨ / ١٩٢، والتقريب: ٢ / ٩٣، وخلاصة الخزرجي: ٢ / ", "تهذيب الكمال", "3722", 8532, "117958", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["", "مجهول", "ж", "ابن حجرب بمجهولب بتقريب التهذيب …ااا بالبخاريب بحديثه موضوع قاله البخاريب بالكاشف في معرفة من له رواية في الكتب الستة …اااان", "موسوعة الرواة (джарх)", "", ""]], "6548": [["أحمد بن حنبل", "حافظ", "д", "قال أَبُو طَالِب (١)، عَنْ أحمد بْن حنبل: كَانَ حافظا متقنا للحديث، صحيح الحديث عَن حجاج بْن أرطاة، قاهرا لَهَا حافظا.", "تهذيب الكمال", "3722", 13900, "173818", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال إسحاق بْن منصور (٢)، عَنْ يحيى بْن مَعِين: ثقة (٣) . _________ (١) الجرح والتعديل: ٩ / الترجمة ١٢٥٧. (٢) نفسه. (٣) وكذلك", "تهذيب الكمال", "3722", -1, "173678", 2], ["العجلي", "ثقة", "д", "وَقَال العجلي (٣): ثقة، ثبت فِي الحديث، وكان متعبدا حسن الصلاة جدا، وكان قد عمي، كَانَ يصلي الضحى ست عشرة ركعة بها من الجودة غير قليل.", "تهذيب الكمال", "3722", 13901, "173828", 1], ["أبو حاتم", "ثقة", "д", "وَقَال أَبُو حاتم (٤): ثقة، إمام صدوق، لا يسأل عن مثله (٥) .", "تهذيب الكمال", "3722", 13901, "173828", 1], ["", "ثقة", "д", "وَقَال في \" العلل\" (٨١٢): ثقة. (٦) الجرح والتعديل: ٩ / الترجمة ١٢٥٧.", "تهذيب الكمال", "3722", 13901, "173828", 1], ["يحيى بن يحيى النيسابوري", "لين", "ж", "وَقَال يحيى بْن يحيى النيسابوري (٢): كَانَ بالعراق من الحفاظ شيخان وكهلان، فأما الشيخان فهشيم ويزيد بْن زريع، وأما الكهلان فوكيع ويزيد بْن هارون، ويزيد أحفظ الك", "تهذيب الكمال", "3722", 13902, "173838", 1], ["محمد بن سعد", "ثقة", "д", "وَقَال مُحَمَّد بْن سعد (٣): كان ثقة كثير الحديث، ولد سنة ثماني عشرة ومئة. وَقَال: طلبت الحديث وحصين حي، كَانَ بالمبارك (٤) يقرأ عَلَيْهِ، وكان قد نسي. قال: ورب", "تهذيب الكمال", "3722", 13903, "173848", 1], ["يزيد", "مأمون", "д", "قال يزيد فِي سنة (٥) تسع وتسعين، يعني ومئة: أَنَا ابْن إحدى أو اثنتين وثمانين. وتوفي فِي خلافة المأمون وهو ابْن سبع أو ثمان وثمانين سنة وأشهر.", "تهذيب الكمال", "3722", 13903, "173848", 1], ["الحافظ أبو بكر الخطيب", "حافظ", "д", "قال الحافظ أبو بكر الخطيب (٦): حدث عنه بقية بْن الوليد، وأحمد بْن عَبْد الرحمن السقطي وبين وفاتيهما ثمان وتسعون سنة أو أكثر (٧) . _________ (١) المعرفة: ١ / ١٩٥", "تهذيب الكمال", "3722", 13903, "173848", 3], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة حافظ", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "6551": [["يحيى بن معين", "ليس بشيء", "ж", "وَقَال عَباس الدُّورِيُّ (٣)، ويعقوب بن شَيْبَة (٤) عَن يحيى بْن مَعِين: ليس بشيءٍ.", "تهذيب الكمال", "3722", 12683, "159468", 1], ["يحيى بن معين", "ضعيف", "ж", "وَقَال مُحَمَّد (٧) بْن عثمان بْن أَبي شَيْبَة، عَن يحيى بْن مَعِين: كَانَ ضعيفا.", "تهذيب الكمال", "3722", 12683, "159468", 1], ["يحيى بن معين", "صدوق", "д", "وَقَال الليث بن عبدة المِصْرِي (٨)، عن يَحْيَى بن مَعِين: كَانَ صدوقا، وكَانَ لا يدري ما يحدث بِهِ.", "تهذيب الكمال", "3722", 12683, "159468", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي (٩): كوفي ثقة، وكان امام مسجد الجامع. _________ (١) تاريخه الكبير: ٨ / الترجمة ٢٢٩٨. (٢) انظر تاريخ الخطيب: ١٣ / 