2694, "159578", 2], ["أبو سلمة", "ضعيف", "ж", "قال أبو سلمة: حَدَّثني أبي ... \" فذكره. وقد جزم جماعة من الأئمة بان أبا سلمة لم يصح سماعه من ابيه، فتضعيف النضر على هذا متعين. وقد", "تهذيب الكمال", "3722", 12694, "159578", 1], ["ابن حجر", "لين", "ж", "وَقَال ابن حجر في \"التقريب\": لين الحديث. (١) النَّسَائي: ٤ / ١٥٨، وابن ماجة (١٣٢٨) . (٢) المجتبى: ٤ / ١٥٨. عَن أَبِي هُرَيْرة.", "تهذيب الكمال", "3722", 12695, "159588", 0], ["ابن حجر العسقلاني", "لين", "ж", "لين الحديث", "تقريب التهذيب", "8609", 8, "148", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "واه", "itqan", "واه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "صحابي", "itqan", "صحابي", "تهذيب التهذيب", 0, -1, "", "", ""]], "6557": [["أبو حاتم", "صدوق", "д", "وَقَال أَبُو حاتم (٣): صدوق، عابد، شبهته بالقعنبي.", "تهذيب الكمال", "3722", 12701, "159648", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال ابن محرز عَنه: كان ثقة. (ابن محرز، الترجمة ٤٥٠) . (٣) الجرح والتعديل: ٨ / الترجمة ٢١٩٧. (٤) نفسه. ما أخذته إجازة ولست أميز بين ذين، فَ", "تهذيب الكمال", "3722", 12701, "159648", 0], ["ابن حبان", "صالح", "д", "ذكره ابنُ حِبَّان في كتاب \"الثقات\" (١)، وَقَال: روى عنه أَحْمَد بن صالح وأهل بلده.", "تهذيب الكمال", "3722", 12702, "159658", 1], ["أبو سعيد بن يونس", "حجة", "д", "قال أَبُو سَعِيد بْن يونس: توفي يوم الأربعاء لخمس بقين من ذي الحجة سنة تسع عشرة ومئتين، وصلى عَلَيْهِ هارون بن عَبد اللَّهِ الْقَاضِي وكَانَ مولده فِي سنة خمس و", "تهذيب الكمال", "3722", 12702, "159658", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "قال أبو حاتم صدوق عابد شبهته بالقعنبي", "الكاشف / سير أعلام النبلاء", "2171", 1006, "10078", 1], ["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "صدوق", "itqan", "صدوق", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "حجة", "itqan", "حجة", "تهذيب التهذيب", 0