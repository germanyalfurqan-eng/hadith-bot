{"6503": [["أبو حاتم", "صدوق", "д", "وَقَال أَبُو حاتم: صدوق صالح الحديث. (الجرح والتعديل: ٨ / الترجمة ٢٠٨٩) .", "تهذيب الكمال", "3722", 12593, "158568", 1], ["ابن سعد", "ثبت", "д", "قال ابن سعد: كان ثبتا", "تهذيب الكمال", "3722", -1, "158418", 1], ["الساجي", "صدوق", "д", "وَقَال الساجي: صدوق اختلف فيه أحمد ويحيى ف", "تهذيب الكمال", "3722", 12593, "158568", 1], ["أحمد", "منكر الحديث", "ж", "قال أحمد: منكر الحديث،", "تهذيب الكمال", "3722", -1, "158428", 1], ["يحيى", "ثقة", "д", "وَقَال يحيى: ثقة. (١٠ / ٤٠٨) . كذا نقل ابن حجر عن ابن سعد ونظرنا في كتاب ابن سعد فلم نجد فيه هذا القول وانما", "تهذيب الكمال", "3722", 12593, "158568", 1], ["ابن سعد", "ثبت", "д", "قال ابن سعد: كان ثبتا\" في الترجمة التي تلي ترجمة نافع وهي ترجمة سلمة بن بخت (طبقاته: ٩ / الورقة ٢٥٥)، ويحتمل ان يكون سقط من نسخة ابن حجر من طبقات ابن سعد صدر تر", "تهذيب الكمال", "3722", 12593, "158568", 1], ["ابن حجر العسقلاني", "صحابي", "itqan", "صحابي", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن أبي حاتم", "له صحبة", "itqan", "له صحبة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن سعد", "صحابي", "itqan", "صحابي", "الطبقات الكبرى", 0, -1, "", "", ""], ["البخاري", "من الصحابة", "itqan", "من الصحابة", "التاريخ الكبير", 0, -1, "", "", ""]], "6507": [["ابن عبد البر", "مجهول", "ж", "وَقَال ابن عَبد الْبَرِّ: نافع مجهول. (١٠ / ٤١٠) .", "تهذيب الكمال", "3722", 12601, "158648", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["", "ثقة", "д", "ابن حبانب بذكره ابن حبان في كتاب ?ب الثقاتب بتهذيب الكمال …ااا بالذهبىب بثقةب بالكاشف في معرفة من له رواية في الكتب الستة …ااا بابن حجرب بمستورب بتقريب التهذيب ", "موسوعة الرواة (джарх)", "", ""]], "6508": [["أبو حاتم", "لا بأس به", "д", "وَقَال أَبُو حَاتِم (١): لا بأس به (٢) .", "تهذيب الكمال", "3722", -1, "3758", 1], ["النسائي", "ليس به بأس", "д", "وَقَال النَّسَائي: ليس به بأس.", "تهذيب الكمال", "3722", -1, "4478", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة ع