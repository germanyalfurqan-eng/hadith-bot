ُّورِيُّ (٢)، عَنْ يحيى بْن مَعِين: هشام بن يوسف أثبت من عبد الرزاق فِي حديث ابن جُرَيْج، وكان أقرأ لكتب ابن جُرَيْج من عبد الرزاق، وكان أعلم بح", "تهذيب الكمال", "3722", 13071, "163348", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي (١): ثقة.", "تهذيب الكمال", "3722", -1, "2738", 1], ["أبو حاتم", "ثقة", "д", "وَقَال أَبُو حاتم (٤): ثقة، متقن. و", "تهذيب الكمال", "3722", 13072, "163358", 1], ["ابن عدي", "ثقة", "д", "ذكره ابن عدي في \" الكامل\" وَقَال: وهشام بن يوسف هذا له أحاديث حسان وغرائب، وقد روى عنه الأئمة من الناس وهو ثقة. (٣ / الورقة ٢٠٠) .", "تهذيب الكمال", "3722", 13072, "163358", 1], ["الحاكم", "ثقة", "д", "وَقَال الحاكم: ثقة مأمون.", "تهذيب الكمال", "3722", -1, "91308", 1], ["الخليلي", "ثقة", "д", "وَقَال الخليلي: ثقة متفق عليه روى عنه الأئمة كلهم. (١١ / ٥٨) .", "تهذيب الكمال", "3722", 13072, "163358", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. روى له الجماعة سوى مسلم. ٦٥٩٣ - سي: هشام بن يوسف السلمي الحمصي (١)، نزيل واسط. رَوَى عَن: عَبد اللَّهِ بْن بسر المازني (سي)، و", "تهذيب الكمال", "3722", -1, "163198", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة مأمون", "itqan", "ثقة مأمون", "تهذيب التهذيب", 0, -1, "", "", ""]], "6569": [["ابن حجر", "مجهول", "ж", "وَقَال ابن حجر في \"التقريب\": مقبولة. لكن الذهبي ذكرها ضمن المجهولات (الميزان: ٤ / الترجمة ١٠٩٥٢) . (٢) في المطبوع من\"التقريب\": ذفرة\" مصحف وانتقل هذا التصحيف إلى", "تهذيب الكمال", "3722", 15287, "187688", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة من أبناء كبار الصحابة", "الكاشف / سير أعلام النبلاء", "2171", 1007, "10088", 1]], "6576": [["أحمد بن حنبل", "ثقة", "д", "قال أبو الحسن الميموني (٢)، عَن أحمد بْن حنبل: ثقة صدوق.", "تهذيب الكمال", "3722", 7205, "104688", 1], ["يحيى بن معين، وأبو داود", "ثقة", "д", "وَقَال إسحاق بن منصور (٤)، وعثمان بْن سَعِيد (٥) عن يَحْيَى بْن مَعِين، وأَبُو دَاوُدَ (٦): ثقة.", "تهذيب الكمال", "3722", 7205, "104688", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال عَبْد الخالق بْن منصور (٧)، عَنْ يحيى بْن مَعِين: ثقة إذا _________ (١) سقط الرقم من نسخة ابن المهندس. (٢) تاريخ الخطيب: ١١ / ٣٥٧. (٣) نفسه. (٤) الجرح وا", "تهذيب الكمال", "3722", 7205, "104688", 2], ["إبراهيم بن عبد الله بن الجنيد", "واه", "ж", "وَقَال إبراهيم بْن عَبْد اللَّهِ بْن الجنيد (٢): ذكر ليحيى بن مَعِين، وأنا شاهد، حديث عن عبد الحميد بن جعفر: تخرج نار من حبس سيل (٣)، فقال: رواه عثمان بن عُمَر ", "تهذيب الكمال", "3722", 7206, "104698", 1], ["يحيى", "ثبت", "д", "قال يحيى: علي بن ثابت أثبت هؤلاء وأكيس (٤) .", "تهذيب الكمال", "3722", 7206, "104698", 1], ["جعفر بن محمد الفريابي (٥)، وسألته، يعني", "ثقة", "д", "وَقَال جَعْفَر بْن مُحَمَّد الفريابي (٥)، وسألته، يعني: مُحَمَّد بْن عَبْد اللَّهِ بن نمير، عَن علي بن ثابت، فقال: كان يكون ببغداد، وكان من أهل خراسان، وهوژ ثقة", "تهذيب الكمال", "3722", 7206, "104698", 1], ["من علي بن ثابت على باب هشيم، قلت", "ثقة", "д", "سمعت من علي بن ثابت على باب هشيم، قلت: هو ثقة؟ قال: يقول أهل بغداد: إنه ثقة، إنما", "تهذيب الكمال", "3722", 7206, "104698", 1], ["يحيى", "ليس به بأس", "д", "وَقَال ابن محرز عَن يحيى: ليس به بأس إذا حدث عن ثقة. (سؤالاته، الترجمة ٢٤٧) . (٥) تاريخ الخطيب: ١١ / ٣٥٧ - ٣٥٨. (٦) تاريخ الخطيب: ١١ / ٣٥٨.", "تهذيب الكمال", "3722", 7206, "104698", 1], ["محمد بن سعد", "ثقة", "д", "وَقَال مُحَمَّد بْن سعد (١): كَانَ أصله من الجزيزة، وقدم بغداد، فنزلها إلى أن مات بها، وكان ثقة صدوقا.", "تهذيب الكمال", "3722", 7207, "104708", 1], ["أبو زرعة", "ثقة", "д", "وَقَال أبو زُرْعَة (٢): ثقة لا بأس به.", "تهذيب الكمال", "3722", 7207, "104708", 1], ["صالح بن محمد الأسدي", "صالح", "д", "وَقَال صالح بْن مُحَمَّد الأسدي: لا بأس به (٤) . و", "تهذيب الكمال", "3722", 7207, "104708", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["", "مجهول", "ж", "ابن حبانب بذكره ابن حبان في كتاب ?ب الثقات ?بب بتهذيب الكمال …ا بذكره ابن حبان في ?ب الثقاتب بتهذيب التهذيب …ااا بالذهبىب بوثقب بالكاشف في معرفة من له رواية في ", "موسوعة الرواة (джарх)", "", ""]], "6578": [["الأوزاعي", "لين", "ж", "وَقَال أبو أسامة، عن الأَوزاعِيّ: لم يقدم علينا من العراق أحد أفضل من عبدة بن أَبي لبابة، والحسن بن الحر، وكانا شَرِيكين جميعا.", "تهذيب الكمال", "3722", 6314, "95778", 1], ["يعقوب بن سفيان (٢)، وأبو حاتم (٣)، والنسائ", "ثقة", "д", "وَقَال يعقوب بْن سُفْيَان (٢)، وأَبُو حاتم (٣)، والنَّسَائي، وابن خراش: ثقة. زاد يعقوب: من ثقات أهل الكوفة. _________ (١) طبقاته: ٦ / ٣٢٨. (٢) المعرفة والتاريخ:", "تهذيب الكمال", "3722", 6314, "95778", 3], ["عبدة بن أبي لبابة", "يهم", "ж", "وَقَال ابن ثوبان، عن عبدة بن أَبي لبابة: كنت في سبعين من أصحاب ابن مسعود، وقرأت عليهم القرآن ما رأيت منهم اثنين يختلفان يحمدون الله على الخير، ويستغفرونه من الذ", "تهذيب الكمال", "3722", 6315, "95788", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة.", "تهذيب الكمال", "3722", -1, "15928", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق رمي بالقدر", "تقريب التهذيب", "8609", 47, "5874", 1], ["الذهبي", "صدوق", "д", "صدوق قدري", "الكاشف / سير أعلام النبلاء", "2171", 1008, "10098", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "صدوق", "itqan", "صدوق", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ليس بذاك", "itqan", "ليس بذاك", "تهذيب التهذيب", 0, -1, "", "", ""]], "6580": [["النسائي", "ثقة", "д", "وَقَال النَّسَائي: قيس أَبُو مريم الحنفي ثقة.", "تهذيب الكمال", "3722", 14918, "183998", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق له أوهام", "تقريب التهذيب", "8609", 3, "38", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["العجلي", "ثقة", "д", "م بن حكيم ثقة من أهل المدائن", "معرفة الثقات للعجلي", "5825", "617", "6178", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الك