 بن عبد البر", "يهم", "ж", "قال أَبُو عُمَر بْن عَبد الْبَرِّ (١): هاجر إِلَى رَسُول اللَّهِ ﷺ، وأسلم فِي الخندق، وهُوَ الذي خذل المشركين وبني قريظة حَتَّى صرف الله المشركين بعد أن أرسل عل", "تهذيب الكمال", "3722", 12801, "160648", 1], ["أخبرنا رضوان بن أحمد بن جالينوس الصيدلاني", "لين", "ж", "قال أَخبرنا رضوان بْن أَحْمَدَ بْنِ جالينوس الصيدلاني، قال: أَخبرنا أَحْمَدُ بْنُ عَبْدِ الجبار العطاردي، قال: حَدَّثَنَا يونس بْن بكير، عَنْ مُحَمَّدِ بْنِ إِس", "تهذيب الكمال", "3722", 12802, "160658", 1]], "6590": [["", "ثقة", "д", "وَقَال (١): كَانَ ثقة.", "تهذيب الكمال", "3722", -1, "7008", 1], ["", "ثقة", "д", "وَقَال في موضع آخر: ثقة (٤) .", "تهذيب الكمال", "3722", -1, "7058", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق نحوي", "تقريب التهذيب", "8609", 305, "3058", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["احمد بن حنبل", "لا باس به", "jarh", "حرب بْن إِسماعيل (٢) ، عَن أحمد بْن حنبل: لا بأس به", "تهذيب الكمال", "3722", 12803, "160668", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""], ["البخاري", "ليس به بأس", "itqan", "ليس به بأس", "التاريخ الكبير", 0, -1, "", "", ""]], "6579": [["يحيى بن معين، وأحمد بن عبد الله العجلي", "ثقة", "д", "قال إِسْحَاق بْن مَنْصُور (١) عَنْ يحيى بْن مَعِين، وأحمد بْن عَبد الله العجلي: ثقة.", "تهذيب الكمال", "3722", -1, "7038", 3], ["علي بن صالح بن حي", "صالح", "д", "وَقَال عَبد اللَّهِ بْن داود الخريبي، عَنْ علي بْن صالح بن حي: بلغ _________ (١) الجرح والتعديل: ٤ / الترجمة ١٠٠١. (٢) حلية الاولياء: ٤ / ١٧٦. (٣) حلية الاولياء", "تهذيب الكمال", "3722", -1, "", 0], ["العجلي", "ثقة", "д", "وَقَال العجلي: كوفي، تابعي، ثقة، وكان جاهليا يكنى أبا أمية، سمع من عَبد الله\" (ثقاته، الورقة ٢٣) .", "تهذيب الكمال", "3722", -1, "", 0], ["الذهبي", "ثقة", "д", "وَقَال الذهبي: ثقة، إمام، زاهد، قوام\" (الكاشف: ١ / الترجمة ٢٢١٨) .", "ته