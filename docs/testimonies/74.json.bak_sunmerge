{"7403": [["شعيب وتمامه", "وثقه", "д", "قال شعيب وتمامه: وهو قائم، فقامت أم سليم إلى رأس القربة، فقطعتها\". وهو في \"شمائل التِّرْمِذِيّ\"برقم (٢١٥) وأخرجه أحمد ٣ / ١١٩ من طريق وكيع عن سفيان عن عبد الكري", "تهذيب الكمال", "3722", 1548, "15498", 1], ["ابن حزم - فيما نقل مغلطاي وابن حجر", "مجهول", "ж", "وَقَال ابن حزم - فيما نقل مغلطاي وابن حجر: مجهول. و", "تهذيب الكمال", "3722", 1548, "15498", 1], ["", "مجهول", "ж", "ابن حبانب بذكره ابن حبان في الثقاتب بتهذيب التهذيب …ااا بابن حجرب بمقبولب بتقريب التهذيب …ااا بابن حزمب بوقال ابن حزم مجهولب بتهذيب التهذيب …ااا بالذهبىب بوذكره", "موسوعة الرواة (джарх)", "", ""], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "مجهول", "itqan", "مجهول", "تهذيب التهذيب", 0, -1, "", "", ""]], "7425": [["أبو حاتم", "لا بأس", "д", "قال أَبُو حاتم (٢): لا بأس بِهِ، وهو من قدماء أصحاب الحسن.", "تهذيب الكمال", "3722", 3034, "32398", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة.", "تهذيب الكمال", "3722", -1, "3168", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["النسائي", "متروك الحديث", "ж", "ة بن مرثد متروك الحديث", "الضعفاء والمتروكون للنسائي", "10805", "21", "218", 1], ["ابن حجر العسقلاني", "ضعيف", "itqan", "ضعيف", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "7421": [["أبو حاتم", "ثقة", "д", "وَقَال عَبد اللَّهِ بْن أَحْمَد بْن حنبل (٢) عَن أبيه: شيخ ثقة ما بِهِ بأس. وكذلك", "تهذيب الكمال", "3722", 7630, "108938", 1], ["يحيى بن معين", "صالح", "д", "وَقَال إسحاق بْن منصور (٣)، عَن يحيى بْن مَعِين: صالح (٤) . و", "تهذيب الكمال", "3722", 7630, "108938", 1], ["", "حجة", "д", "وَقَال فِي موضع آخر: قلتُ لأبي داود: كم حج عمارة بْن زاذان؟ قال: سبعا وخمسين حجة (٧) .", "تهذيب الكمال", "3722", 7630, "108938", 1], ["يعقوب بن سفيان", "ثقة", "д", "وَقَال يعقوب بْن سفيان (٨): ثقة.", "تهذيب الكمال", "3722", 7630, "108938", 1], ["أبو زرعة", "لا بأس به", "д", "وَقَال أبو زُرْعَة (٩): لا بأس به، _________ (١) الجرح والتعديل: ٦ / الترجمة ٢٠١٦. (٢) علل أحمد: ١ / ٨٥، ٢١٦. (٣) الجرح والتعديل: ٦ / الترجمة ٢٠١٦. (٤)", "تهذيب الكمال", "3722", -1, "108848", 2], ["ابن معين", "ثقة", "д", "وَقَال الدوري عن ابن مَعِين: ثقة (تاريخه: ٢ / ٤٢٥) . وكذا", "تهذيب الكمال", "3722", 7630, "108938", 1], ["يحيى بن معين", "ليس به بأس", "д", "وَقَال ابن طهمان عَنه: ليس به بأس (سؤالاته: الترجمة ٣٨٠) . (٥) تاريخه الكبير: ٦ / الترجمة ٣١٢٨. (٦) سؤالاته: ٣ / الترجمة ٢٤٩. (٧)", "تهذيب الكمال", "3722", 7630, "108938", 1], ["أبو حاتم", "لا يحتج به", "ж", "وَقَال أبو حاتم (١): يكتب حديثه، ولا يحتج به، ليس بالمتين.", "تهذيب الكمال", "3722", 7631, "108948", 1], ["أبو أحمد بن عدي", "لا بأس به", "д", "وَقَال أَبُو أَحْمَد بْن عَدِيّ (٢): وهُوَ عندي لا بأس به، ممن يكتب حديثه.", "تهذيب الكمال", "3722", 7631, "108948", 1], ["الدارقطني", "ضعيف", "ж", "وَقَال الدَّارَقُطْنِيُّ (٣): ضعيف. و", "تهذيب الكمال", "3722", -1, "6378", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي: ثقة (ثقاته: الورقة ٤٠)، وذَكَره العقيلي في \"الضعفاء \" (الورقة: ١٦٠)، و", "تهذيب الكمال", "3722", 7631, "108948", 1], ["ابن عمار الموصلي", "ضعيف", "ж", "وَقَال ابن عمار الموصلي: ضعيف (تهذيب التهذيب: ٧ / ٤١٧) .", "تهذيب الكمال", "3722", 7631, "108948", 1], ["ابن السكن", "ثبت", "д", "وَقَال ابن السكن: لم تثبت صحبته.", "تهذيب الكمال", "3722", 7633, "108968", 1], ["ابن حجر العسقلاني", "لا بأس به", "д", "لا بأس به عابد", "تقريب التهذيب", "8609", 335, "3358", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "7427": [["أبو حاتم", "متروك", "ж", "وَقَال أبو حاتم (٢): متروك الحديث.", "تهذيب الكمال", "3722", -1, "107098", 1], ["النسائي", "ليس بثقة", "ж", "وَقَال النَّسَائي: ليس بثقة، ولا يكتب حديثه.", "تهذيب الكمال", "3722", -1, "5568", 1], ["يونس بن عبيد", "يكذب", "ж", "وَقَال أبو داود الطيالسي (٦) عَن شعبة، عَنْ يونس بْن عُبَيد: كان عَمْرو بْن عُبَيد يكذب في الحديث.", "تهذيب الكمال", "3722", 8116, "113798", 1], ["", "متروك", "ж", "ذكره في \"الضعفاء والمتروكين \"وَقَال: متروك الحديث (الترجمة ٤٤٥) . (٦) الجرح والتعديل: ٦ / الترجمة ١٣٦٥، وضعفاء العقيلي، الورقة ١٥٤. (٧) انظر تاريخ الخطيب: ١٢ / ", "تهذيب الكمال", "3722", 8116, "113798", 1], ["لي حميد", "يكذب", "ж", "قال لي حميد: لا تأخذ عَنْ هذا شيئا فإنه يكذب على الحسن.", "تهذيب الكمال", "3722", 8117, "113808", 1], ["الرجل", "يكذب", "ж", "قال الرجل: عَمْرو ابن عُبَيد يقول عَنِ الحسن كذا وكذا. فقال: ما لنا ولعَمْرو بْن عُبَيد، عَمْرو يكذب على الحسن.", "تهذيب الكمال", "3722", 8117, "113808", 1], ["لي عمرو", "لين", "ж", "قال لي عَمْرو: وما يمنع صاحبك أن يسلم علينا؟ قلت: هُوَ أعلم.", "تهذيب الكمال", "3722", 8118, "113818", 1], ["يحيى بن معين", "ليس بشيء", "ж", "وَقَال ابن الجنيد عَنْ يحيى بْن مَعِين: ليس بشيءٍ رجل سوء. (سؤالاته، الورقة ٤٢) . ونقل ابن حبان في \"المجروحين \"عن أحمد بن زهير أَنَّهُ قال:", "تهذيب الكمال", "3722", 8118, "113818", 1], ["يحيى بن معين", "لا يكتب حديثه", "ж", "سمعت يَحْيَى بْن مَعِين يقول: كان عَمْرو بن عُبَيد رجل سوء من الدهرية. قلت وما الدهرية؟ قال: الذين يقولون لا شيء إنما الناس مثل الزرع، وكان يرى السبت (٢ / ٧٠) .", "تهذيب الكمال", "3722", 8118, "113818", 1]], "7415": [["أبو حاتم", "ثقة", "д", "قال أبو حاتم: ثقة (١) .", "تهذيب الكمال", "3722", -1, "3588", 1], ["النسائي", "ليس بثقة", "ж", "وَقَال النَّسَائي: ليس بثقة (٢) . و", "تهذيب الكمال", "3722", -1, "8798", 1], ["عبد الرحمن بن أبي حاتم", "ثقة", "д", "قال عَبْد الرَّحْمَنِ بْن أَبي حاتم: سألت أبا زرعة عن مُحَمَّد بن الْحَسَن بن أتش، فقال: ثقة (٧ / الترجمة ١٢٥٢) ولم يشر ابن حجر في \"التهذيب \"إلى ذلك ولم ينقل كل", "تهذيب الكمال", "3722", 9888, "131518", 1], ["لنا ابن حماد", "متروك", "ж", "قال لنا ابن حماد: هو متروك الحديث أظنه ذكره، عن أحمد بن شعيب النَّسَائي. (الكامل: ٣ / الورقة ٥٧) . (٣) ٩ / ٦٩.", "تهذيب الكمال", "3722", 9888, "131518", 1], ["الدارقطني", "ليس بالقوي", "ж", "وَقَال الدَّارَقُطنِيّ: ليس بالقوي (الضعفاء والمتروكون، الترجمة ٤٧٤) .", "تهذيب الكمال", "3722", 9888, "131518", 1], ["النسائي", "متروك", "ж", "قال النَّسَائي في موضع آخر، وأبو الفتح الأزدي، وابن حماد: متروك.", "تهذيب الكمال", "3722", 9888, "131518", 1], ["أحمد بن صالح", "صالح", "д", "قال أحمد بن صالح: هو ثقة، وكلام النَّسَائي فيه غير مقبول لان أحمد وعلي بن المديني لا يرويان إلا عن مقبول مع قول أحمد بن صالح فيه (٩ / ١١٤)", "تهذيب الكمال", "3722", 9888, "131518", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق فيه لين رمي بالقدر. قلت: وكلام أبي العرب القيرواني أن أحمد وعلي لا يرويان إلا عن مقبول فهو مردود لان أحمد وعليا لم يصرحا أو لم", "تهذيب الكمال", "3722", 9888, "131518", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق فيه لين ورمي بالقدر", "تقريب التهذيب", "8609", 29, "3242", 1]], "7411": [["", "ثقة", "д", "وَقَال (١): كان ثقة إن شاء اللَّه.", "تهذيب الكمال", "3722", -1, "112218", 1], ["أبيه، ثقة. وكذلك", "ثقة", "д", "وَقَال عَبد اللَّهِ بْن أحمد بْن حنبل (٢)، عَن أبيه، ثقة. وكذلك", "تهذيب الكمال", "3722", 13735, "172168", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""]], "7400": [["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["", "مجهول", "ж", "ابن حجرب بمجهولب بتقريب التهذيب …ااا بالبزارب بأبو نصيرةي عن مولى لأبي بكر عن أبي بكر حديث ما أصر من استغفري روي عن أبي نصيرة عن أبي رجاء مولى أبي بكري قلت تقدم", "موسوعة الرواة (джарх)", "", ""]], "7409": [["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["أحمد بن حنبل", "صالح", "д", "وسألته عن صالح بن حيان قال ليس هو بذاك وأنكر حديثه", "العلل ومعرفة الرجال (المروذي)", "6044", "57", "578", 1]], "741