{"19800": [["", "مجهول", "ж", "ابن حبانب بوذكره ابن حبان في ?ب الثقاتب بلسان الميزان …ااا بأبو حاتم الرازيب بمجهولب بلسان الميزان …ا بروى عن عتبة بن أبي عتبة والحسن روى عنه مروان بن معاوية ال", "موسوعة الرواة (джарх)", "", ""]], "19801": [["", "وثقه", "ж", "النسائيب بوثقه النسائيب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "19808": [["", "صالح", "д", "أبو حاتم الرازيب بنا عبد الرحمن قال سألت أبي عن عمرو بن عبيد الله الأنصاري فقال صالح محله الصدقب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "19819": [["", "إمام", "д", "الذهبىب بالشيخ الإمام العلامة المفتي المفسر الخطيب البارع عالم حران وخطيبها وواعظها فخر الدينب بسير أعلام النبلاء …ا بوكان فخر الدين إماما في التفسير إماما في ا", "موسوعة الرواة (джарх)", "", ""]], "19827": [["", "لا بأس به", "д", "أبو حاتم الرازيب بنا عبد الرحمن قال سألت أبي عنه فقال لا بأس بهب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "19828": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …اااان", "موسوعة الرواة (джарх)", "", ""]], "19846": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …اااان", "موسوعة الرواة (джарх)", "", ""]], "19848": [["", "لا بأس به", "д", "أبو حاتم الرازيب بروى عن يزيد بن أبي مريم روى عنه يحيى بن سعيد القطان ومحمد بن حمران وقال عمارة بن مطرف سمعت أبي يقول ذلك وسألت أبي عنه فقال لا بأس بهب بالجرح و", "موسوعة الرواة (джарх)", "", ""]], "19849": [["", "منكر", "ж", "الذهبىب بيجهل حاله وأتى بخبر منكر أخرجه الحاكم في مستدركه وأظنه موضوعا من طريق جندل بن والق حدثنا عمرو بن أوس حدثنا سعيد بن أبي عروبة عن قتادة عن سعيد بن المسيب", "موسوعة الرواة (джарх)", "", ""]], "19850": [["", "صدوق", "д", "أبو حاتم الرازيب بنا عبد الرحمن قال سئل أبي عنه فقال صدوقب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""]], "19867": [["", "مجهول", "ж", "ابن حبانب بوذكره ابن حبان في ?ب الثقات ?ب وقال يروي عن حبيب بن يزيديب بلسان الميزان …ااا بأبو حاتم الرازيب بمجهولب بلسان الميزان …ا بسمع أبا ليلى وحبيب بن يزيد ", "موسوعة الرواة (джарх)", "", ""]], "19868": [["", "صدوق", "д", "الخطيب البغداديب بكتبت عنه وكان صدوقاب بتاريخ بغداد …ااا بالذهبىب بصدوقب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "19889": [["", "ثقة", "д", "الذهبىب بوكان ثقةي أملى زماناب بتاريخ الإسلام …ا بوكان ثقة صادقا معمراب بسير أعلام النبلاء …اااان", "موسوعة الرواة (джарх)", "", ""]], "19896": [["", "إمام", "д", "الذهبىب بالشيخ الإمام الصدقب بسير أعلام النبلاء …اااان", "موسوعة الرواة (джарх)", "", ""]], "19898": [["", "وثقه", "д", "الدارقطنيب بوثقه الدارقطنيب بتاريخ الإسلام …ا بحدثني علي بن محمد بن نصر قال سمعت حمزة بن يوسف يقول وسألت أبا الحسن الدارقطني عن أبي بكر أحمد بن محمد بن هلال الش", "موسوعة الرواة (джарх)", "", ""]], "19899": [["", "منكر الحديث", "ж", "ابن أبي حاتم الرازيب بقال ابن أبي حاتم شيخ ليس بمنكر الحديثب بتاريخ الإسلام …ااا بالذهبىب بمحله الصدق إن شاء اللهب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "19812": [["أبو حاتم الرازي", "لا أعرفه", "ж", "لا أعرفه", "الجرح والتعديل", "2170", "2614", "", 0]], "19809": [["ابن حبان", "ذكره في الثقات", "д", "عَبْد الْوَاحِد بْن عرْفجَة يروي عَن على عداده فِي أهل الْكُوفَة روى عَنهُ ابْنه عرْفجَة بْن عَبْد الْوَاحِد", "الثقات لابن حبان", "5816", "1645", "16458", 1]], "19845": [["ابن حبان", "ذكره في الثقات", "д", "عمَارَة بْن يحيى بن عرفطة يروي عَن خَالِد بْن عرفطة رَوَى عَنْهُ شَقِيق بْن أَبِي عَبْد اللَّه", "الثقات لابن حبان", "5816", "1761", "17618", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "19852": [["ابن حبان", "ذكره في الثقات", "д", "عبد ربه بْن مُوسَى بْن الأحدب من أهل الْيَمَامَة يرْوى عَن أمه روى عَنْهُ عِكْرِمَة بْن عمار", "الثقات لابن حبان", "5816", "2761", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "19830": [["ابن حبان", "ذكره في الثقات", "д", "عَمْرو بْن حبيب يروي عَنْ عبيد اللَّه بْن حر روى شريك عَنْ جَابر عَنْهُ", "الثقات لابن حبان", "5816", "2827", "2