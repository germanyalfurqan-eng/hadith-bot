", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["أحمد بن حنبل", "شيخ ثقة ، وفي رواية : كان ثبتا", "д", "شيخ ثقة ، وفي رواية : كان ثبتا", "sunnah.com", "", "", "", 1], ["أحمد بن شعيب النسائي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["أبو زرعة الرازي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["علي بن المديني", "عده من أثبت أصحاب يحيى بن أبي كثير", "д", "عده من أثبت أصحاب يحيى بن أبي كثير", "sunnah.com", "", "", "", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["محمد بن سعد كاتب الواقدي", "ثقة إن شاء الله تعالى", "д", "ثقة إن شاء الله تعالى", "sunnah.com", "", "", "", 1], ["يحيى بن سعيد القطان", "فطن صحيح كيس", "д", "فطن صحيح كيس", "sunnah.com", "", "", "", 1], ["أبو بكر البزار", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["أبو حفص عمر بن شاهين", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["أبو عيسى الترمذي", "ذكره في الجامع ، وقال : ثقة حافظ عند أهل الحديث ، ومرة : ثقة فطن كيس", "д", "ذكره في الجامع ، وقال : ثقة حافظ عند أهل الحديث ، ومرة : ثقة فطن كيس", "sunnah.com", "", "", "", 1], ["محمد بن إسحاق بن خزيمة", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["محمد بن يحيى الذهلي", "حجاج الصواف متين قال ابن خزيمة : يريد أنه ثقة حافظ", "д", "حجاج الصواف متين قال ابن خزيمة : يريد أنه ثقة حافظ", "sunnah.com", "", "", "", 1], ["يزيد بن زريع العيشي", "ليس به بأس", "д", "ليس به بأس", "sunnah.com", "", "", "", 1], ["أبو الوليد الباجي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1]], "1309": [["ابن حجر العسقلاني", "صدوق", "д", "صدوق كثير الخطأ والتدليس", "تقريب التهذيب", "8609", 78, "788", 1], ["الذهبي", "لين", "ж", "أحد الأعلام على لين فيه", "الكاشف / سير أعلام النبلاء", "2171", 303, "3038", 3], ["", "صدوق", "д", "أبو حاتم الرازيب بوقال أبو حاتم صدوق يدلس عن الضعفاء يكتب حديثه ? فإذا قال حدثنا فهو صالح لا يرتاب في صدقه وحفظه إذا بين السماع ? لا يحتج بحديثه لم يسمع من الزه", "موسوعة الرواة (джарх)", "", ""], ["الذهبي", "لين", "itqan", "لين", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "متروك", "itqan", "متروك", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ضعيف", "itqan", "ضعيف", "الطبقات الكبرى", 0, -1, "", "", ""], ["البخاري", "يضع", "itqan", "يضع", "التاريخ الكبير", 0, -1, "", "", ""], ["الذهبي", "لين", "itqan", "لين", "تذكرة الحفاظ", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات ، وذكره في المجروحين ، وقال : كان صلفا ، تركه ابن المبارك وابن مهدي ويحيى القطان ويحيى بن معين وأحمد بن ح", "д", "ذكره في الثقات ، وذكره في المجروحين ، وقال : كان صلفا ، تركه ابن المبارك وابن مهدي ويحيى القطان ويحيى بن معين وأحمد بن حنبل قال الذهبي : هذا القول فيه مجازفة ، وأكثر ما نقم عليه التدليس ، وكان فيه تيه لا يليق بأهل العلم", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : أحد الفقهاء وهو صدوق كثير الخطأ والتدليس ، وذكره في المطالب العالية ، وقال : ضعيف مدلس ، ومرة فيه ضعف", "д", "قال في التقريب : أحد الفقهاء وهو صدوق كثير الخطأ والتدليس ، وذكره في المطالب العالية ، وقال : ضعيف مدلس ، ومرة فيه ضعف", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "صدوق يدلس عن الضعفاء يكتب حديثه ، وإذا قال حدثنا فهو صالح لا يرتاب في صدقه وحفظه إذا بين السماع ولا يحتج بحديثه لم يسمع ", "д", "صدوق يدلس عن الضعفاء يكتب حديثه ، وإذا قال حدثنا فهو صالح لا يرتاب في صدقه وحفظه إذا بين السماع ولا يحتج بحديثه لم يسمع من الزهري ولا من هشام بن عروة ولا من عكرمة ، ومرة : كان الحجاج مدلسا عمن رآه وعمن لم يره ، وكان يقول إذا حدثتني أنت بشيء عن شيخ لم أبال أن أرويه عن ذلك الشيخ", "sunnah.com", "", "", "", 1], ["يحيى بن معين", "قال أحمد بن زهير عن يحيى بن معين : ضعيف ضعيف ، ومرة : صدوق ليس بالقوي يدلس عن محمد بن عبيد الله العرزمي عن عمرو بن شعيب ", "д", "قال أحمد بن زهير عن يحيى بن معين : ضعيف ضعيف ، ومرة : صدوق ليس بالقوي يدلس عن محمد بن عبيد الله العرزمي عن عمرو بن شعيب ، ومرة : ليس بذاك القوي وهو مثل ابن أبي ليلى ومجالد ، ومرة : لا يحتج بحديثه ، ومرة : قال عباس بن محمد ليحيى بن معين ما يعني الحجاج بقوله : أسند لي إبراهيم والشعبي الحديث حدثاني فأسند لي ، قال : نعم ، قال يحيى : وهذا عندنا خطأ أخطأ فيه معمر عن حجاج ، قال يحيى : ولم يسمع حجاج من الزهري شيئا وحجاج النخعي هو حجاج بن أرطاة ولا يحتج بحديثه ، ومرة : في رواية عثمان بن سعيد الدارمي : حجاج بن أرطأة عن قتادة صالح ، ومرة برواية ابن محرز : ليس به بأس", "sunnah.com", "", "", "", 1], ["أحمد بن حنبل", "كان من الحفاظ ، قيل فلم ليس هو عند الناس بذاك ؟ قال لأن في حديثه زيادة علي حديث الناس ، ليس يكاد له حديث إلا فيه زيادة ،", "д", "كان من الحفاظ ، قيل فلم ليس هو عند الناس بذاك ؟ قال لأن في حديثه زيادة علي حديث الناس ، ليس يكاد له حديث إلا فيه زيادة ، ومرة : يقولون لم يلق الزهري ، وكان يروي عن رجال لم يلقهم ، ومرة : سمعت يحيى بن معين يذكر أن حجاجا لم ير الزهري ، وكان سيئ الرأي فيه جدا ما رأيته أسوأ رأيا في أحد منه في حجاج ، ومحمد بن إسحاق ، وليث ، وهمام ، لا يستطيع أحد أن يراجعه فيهم ، ومرة : في رواية الحسن بن علي سئل أحمد بن حنبل : يحتج بحديث حجاج بن أرطاة ، فقال : لا", "sunnah.com", "", "", "", 1], ["الدارقطني", "ضعيف لا يحتج به", "д", "ضعيف لا يحتج به", "sunnah.com", "", "", "", 1], ["أحمد بن شعيب النسائي", "ضعيف لا يحتج بحديثه ، ليس بالقوي", "д", "ضعيف لا يحتج بحديثه ، ليس بالقوي", "sunnah.com", "", "", "", 1], ["أبو زرعة الرازي", "صدوق ، مدلس", "д", "صدوق ، مدلس", "sunnah.com", "", "", "", 1], ["الخطيب البغدادي", "الحجاج أحد العلماء بالحديث والحفاظ له ، وكان مدلسا يروي عمن لم يلقه", "д", "الحجاج أحد العلماء بالحديث والحفاظ له ، وكان مدلسا يروي عمن لم يلقه", "sunnah.com", "", "", "", 1], ["علي بن المديني", "تركته عمدا", "д", "تركته عمدا", "sunnah.com", "", "", "", 1], ["أحمد بن عبد الله العجلي", "كان فقيها ، وكان أحد مفتي الكوفة ، وكان فيه تيه ، وكان جائز الحديث إلا أنه كان صاحب إرسال ، ثم قال : فإنما يعيب الناس من", "д", "كان فقيها ، وكان أحد مفتي الكوفة ، وكان فيه تيه ، وكان جائز الحديث إلا أنه كان صاحب إرسال ، ثم قال : فإنما يعيب الناس منه التدليس", "sunnah.com", "", "", "", 1], ["أبو أحمد بن عدي الجرجاني", "إنما عاب الناس عليه تدليسه عن الزهري وغيره وربما أخطأ في بعض الروايات فأما أن يتعمد الكذب فلا وهو ممن يكتب حديثه", "д", "إنما عاب الناس عليه تدليسه عن الزهري وغيره وربما أخطأ في بعض الروايات فأما أن يتعمد الكذب فلا وهو ممن يكتب حديثه", "