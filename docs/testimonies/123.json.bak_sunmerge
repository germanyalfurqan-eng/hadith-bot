{"12300": [["", "صالح", "д", "محمد بن الحسن الطوسيب بوذكره أبو جعفر الطوسي في ?برجال الشيعة?بي وقال كان صالحا ورعايب بلسان الميزان …ااا بالدارقطنيب بقال الدارقطني لا يحتج بحديثهب بلسان الميز", "موسوعة الرواة (джарх)", "", ""]], "12301": [["ابن حجر العسقلاني", "متروك", "ж", "متروك", "تقريب التهذيب", "8609", "", "", 0], ["ابن أبي حاتم", "كذاب", "itqan", "كذاب", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["البخاري", "لين", "itqan", "لين", "التاريخ الكبير", 0, -1, "", "", ""]], "12302": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقة حافظاب بتاريخ بغداد …ااا بالذهبىب بكان يوصف بالحفظب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "12305": [["", "ثقة", "д", "يحيى بن معينب بحدثنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين قال جميل بن عبيد الطائي ثقةب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "12306": [["", "ثقة", "д", "أبو زرعة الرازيب بحدثنا عبد الرحمن قال وسئل أبو زرعة عنه فقال مديني ثقةب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن عدي", "لا يتابع عليه", "д", "لا يتابع عليه", "الكامل في الضعفاء", "12579", "934", "2278", 1], ["ابن حبان", "ذكره في الثقات", "д", "الْحَارِث بْن مُحَمَّد يروي عَن أبي الطُّفَيْل إِن سمع مِنْهُ روى عَنهُ زَافِر بن سُلَيْمَان", "الثقات لابن حبان", "5816", "1253", "12538", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""]], "12310": [["", "ضعيف", "ж", "ابن حبانب بوذكره ابن حبان في الثقاتب بلسان الميزان …ااا بابن حجرب بوروى عنه أبو العطوف وهو ضعيفب بلسان الميزان …ااا بأبو حاتم الرازيب بمجهولب بلسان الميزان …ا ب", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "حبيب بن نجيح يروي عَن عبد الرَّحْمَن بن غنم روى عَنهُ الْجراح بن الْمنْهَال", "الثقات لابن حبان", "5816", "2296", "22968", 1], ["ابن أبي حاتم", "مجهول", "itqan", "مجهول", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "ا