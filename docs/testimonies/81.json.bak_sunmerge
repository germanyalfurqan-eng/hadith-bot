{"8177": [["يحيى بن معين:", "ثقة", "д", "وَقَال إسحاق بْن منصور (١)، وأحمد بْن سعد بْن أَبي مريم (٢) . وعثمان بْن سَعِيد الدارمي، (٣) عَن يحيى بْن مَعِين: ثقة.", "تهذيب الكمال", "3722", 5132, "55328", 1], ["أبو حاتم", "لا بأس به", "д", "قال أَبُو حَاتِم (٤): لا بأس به.", "تهذيب الكمال", "3722", -1, "3768", 1], ["أبو داود السجستاني", "ضعفه", "ж", "وَقَال أَبُو عُبَيد الآجُرِّيّ (٥): سألت أبا داود عنه فضعفه.", "تهذيب الكمال", "3722", 5132, "55328", 1], ["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي (٦): ليس بالقوي. و", "تهذيب الكمال", "3722", -1, "3268", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي: ثقة وأبوه ثقة.", "تهذيب الكمال", "3722", -1, "55328", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "8103": [["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0]], "8112": [["", "لا بأس به", "д", "أبو زرعة الرازيب بقال أبو زرعة مصري لا بأس بهب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ا بنا عبد الرحمن قال سئل أبو زرعة عن مالك بن سعد التجيبي فقال مصري لا ", "موسوعة الرواة (джарх)", "", ""]], "8125": [["", "فيه نظر", "ж", "ابن حجرب بفيه نظرب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8135": [["", "مجهول", "ж", "ابن حبانب بوذكره ابن حبان في الثقات وقال روى عنه عبد الجليل شيخ منهمب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بأبو حاتم الرازيب بقال أبو حاتم مجهولب بتعج", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "مجهول", "itqan", "مجهول", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "شيخ", "itqan", "شيخ", "الثقات", 0, -1, "", "", ""]], "8162": [["", "وثقه", "ж", "ابن حبانب بوثقه ابن حبانب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8164": [["", "ثقة", "д", "أبو زرعة الرازيب بحدثنا عبد الرحمن قال سئل أبو زرعة عن سعيد بن شفي قال كوفي همداني ثقةب بالجرح والتعديل لابن أبي حاتم …ا بقال أبو زرعة الرازي كوفي همداني ثقةب ب", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "سَعِيد بن شفى يروي عَن بْن عَبَّاس روى عَنْهُ أَبُو إِسْحَاق السبيعِي", "الثقات لابن حبان", "5816", "1400", "14008", 1], ["العجلي", "ثقة", "д", "امي تابعي ثقة", "معرفة الثقات للعجلي", "5825", "222", "488", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8166": [["", "وثقه", "ж", "ابن حبانب وثقه ابن حبانب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "8174": [["", "مجهول", "ж", "ابن حبانب بوذكره ابن حبان في ?ب الثقات ?ب وغفل الحسيني فقال مجهول لا يعرفيب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بالبخاريب بقال البخاري بصري روى عن يو", "موسوعة الرواة (джарх)", "", ""]], "8179": [["", "مجهول", "ж", "الحسينيب بمجهول قاله الحسينيب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "8185": [["", "وثقه", "ж", "ابن حبانب بووثقه ابن حبانب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بالبخاريب بقال البخاري سمع حذيفةب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااا ب…ن…", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8186": [["", "وثقه", "д", "ابن حبانب بوثقه ابن حبان وقال شهد غزوة طبرستانب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بابن حجرب بوهم ثلاثة إخوة سليم بن عبد وعمارة بن عبد وزيد بن عبد ث", "موسوعة الرواة (джарх)", "", ""]], "8189": [["", "وثقه", "ж", "ابن حبانب بخاله مالك بن عبد الله الخثعمي وله صحبةب بالثقات …ا بوثقه ابن حبانب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بأبو حاتم الرازيب بخاله مالك بن عبد", "موسوعة الرواة (джарх)", "", ""]], "8190": [["", "مجهول", "ж", "الحسينيب بلا يدرى من هما وقال في ?ب الإكمال ?ب مجهولب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "8194": [["", "مجهول", "ж", "أبو حاتم الرازيب بمجهول قاله أبو حاتمب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ا بمجهولب بلسان الميزان …ا بروى عن حاتم بن عديي روى عنه سالم بن غيلان سمعت أبي", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "مجهول", "itqan", "مجهول", "الجرح والتعديل", 0, -1, "", "", ""]], "8128": [["ابن حبان", "ذكره في الثقات", "д", "مخمل بن دماث يروي عَن حُذَيْفَة عداده فِي أهل الْكُوفَة روى عَنهُ أَبُو روق الْهَمدَانِي", "الثقات لابن حبان", "5816", "1980", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8102": [["ابن حبان", "ذكره في الثقات", "д", "مُحَمَّد بْن مساحق يروي عَن عَامر بن عبد الله بْن الزبير روى عَنْهُ فليح بْن سُلَيْمَان", "الثقات لابن حبان", "5816", "3027", "30278", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8172": [["العجلي", "ثقة", "д", "صري تابعي ثقة (باب سكين)", "معرفة الثقات للعجلي", "5825", "240", "", 0], ["ابن أبي حاتم", "له صحبة", "itqan", "له صحبة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""]], "8181": [["ابن أبي حاتم", "له صحبة", "itqan", "له صحبة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8157": [["ابن أبي حاتم", "له صحبة", "itqan", "له صحبة", "الجرح والتعديل", 0, -1, "", "", ""]], "8173": [["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""]], "8175": [["ابن أبي حاتم", "شيخ", "itqan", "شيخ", "الجرح والتعديل", 0, -1, "", "", ""]], "8104": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8163": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8161": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8184": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8