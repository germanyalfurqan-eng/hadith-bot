{"22219": [["عبد الله (١) بن أحمد بن حنبل", "صالح", "д", "قال عَبد اللَّهِ (١) بْن أَحْمَد بْن حنبل: سَأَلتُ أبي عن مُحَمَّد ابن قيس الذي روى عن ابن عُمَر، قال: صالح، أرجو أن يكون ثقة، وهو الهمداني، روى عنه الثوري، وإس", "تهذيب الكمال", "3722", 10808, "140718", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال إسحاق بْن منصور (٣) عَن يحيى بْن مَعِين: ثقة.", "تهذيب الكمال", "3722", -1, "4948", 1], ["العجلي", "ثقة", "д", "امي تابعي ثقة", "معرفة الثقات للعجلي", "5825", "552", "488", 1]], "22207": [["", "مجهول", "ж", "ابن حبانب بوذكره ابن حبان في الثقات وقال روى عنه شريح بن عبيد وأهل الشام وقول الذهبي بالحركات يفهم أن الذي قبله بالسكون وليس كذلك فإن الأمير ذكرهما معا في ترجمة", "موسوعة الرواة (джарх)", "", ""], ["", "مجهول", "ж", "لسان الميزان …ا بمجهوليب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "22209": [["", "مجهول", "ж", "ابن القطان الفاسيب بقال ابن القطان بقية أروى الناس عن المجهولين وهذا منهب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "22221": [["يحيى بن معين", "ثقة", "д", "قلت ليحيى: نهشل؟ قال: نهشل الضبي، كوفي ثقة", "سؤالات ابن الجنيد", "12698", "178", "1788", 2], ["النسائي", "متروك الحديث", "ж", "عن الضحاك متروك الحديث خراساني (باب الواو)", "الضعفاء والمتروكون للنسائي", "10805", "93", "938", 1], ["البخاري", "كذاب", "ж", "إسحاق: هو كذاب", "الضعفاء الصغير للبخاري", "8632", "12", "135", 1]], "22225": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]]}