{"16006": [["", "ضعفه", "ж", "ابن حبانب بضعفه ابن حبان فقال كان قذافا للمحصنات فيجب مجانبة روايتهب بلسان الميزان …ااا بمحمد بن عمران المرزبانيب بقال المرزباني كان الفرزدق سيدا جوادا فاضلا وج", "موسوعة الرواة (джарх)", "", ""]], "16016": [["", "مجهول", "ж", "أبو حاتم الرازيب بنا عبد الرحمن قال سألت أبي عنه فقال هو مجهولب بالجرح والتعديل لابن أبي حاتم …ا بمجهولب بلسان الميزان …ااا بالذهبىب بتابعي أرسل حديثا", "موسوعة الرواة (джарх)", "", ""]], "16084": [["", "ليس بالقوي", "ж", "ابن حبانب بوذكره ابن حبان في الثقات لكن لم يذكر اسم جدهب بلسان الميزان …ااا بأبو حاتم الرازيب بنا عبد الرحمن قال سألت أبي عنه فقال ليس بقوييب بالجرح والتعديل لا", "موسوعة الرواة (джарх)", "", ""]], "16026": [["ابن حبان", "ذكره في الثقات", "д", "خشرم بن حسان يروي الْمَرَاسِيل روى عَنهُ مسعر بن كدام", "الثقات لابن حبان", "5816", "2387", "23878", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16037": [["ابن أبي حاتم", "له صحبة", "itqan", "له صحبة", "الجرح والتعديل", 0, -1, "", "", ""]], "16056": [["ابن أبي حاتم", "له صحبة", "itqan", "له صحبة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""]], "16051": [["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""]], "16046": [["ابن سعد", "حجة", "itqan", "حجة", "الطبقات الكبرى", 0, -1, "", "", ""]], "16005": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16039": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "16050": [["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "16009": [["ابن حبان", "مستقيم الحديث", "itqan", "مستقيم الحديث", "الثقات", 0, -1, "", "", ""]], "16066": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]]}