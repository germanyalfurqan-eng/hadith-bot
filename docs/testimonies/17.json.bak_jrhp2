َى بن منية، أفيحتمل خالد بن دريك إذ لقي ابن عُمَر أن يسأل يَعْلَى بن منية؟ فاسترابه، وذكر خالدا فقدم أمره وسنه، ولم ينكر رواية قتادة عن", "تهذيب الكمال", "3722", 3562, "37678", 1], ["ابن الدريك", "واه", "ж", "سمعت أبي وذكر حديثًا رواه أبو توبة عن بشير بن طلحة عن ابن الدريك، قال:", "تهذيب الكمال", "3722", 3562, "37678", 1], ["معاوية بن صالح", "صالح", "д", "قال معاوية بْن صالح:", "تهذيب الكمال", "3722", -1, "5398", 1], ["أبو مسهر", "متهم", "ж", "قال أَبُو مسهر: كان غير متهم، كان ثقة.", "تهذيب الكمال", "3722", 3563, "37688", 1], ["أبو مسهر", "ثقة", "д", "قال أَبُو مسهر: كان خالد بْن دهقان ثقة، كانت عنده أربعة أحاديث وأشباهها.", "تهذيب الكمال", "3722", 3563, "37688", 1], ["دحيم", "ثقة", "д", "وَقَال عثمان بْن سَعِيد الدارمي، عَنْ دحيم: ثقة.", "تهذيب الكمال", "3722", -1, "15358", 1], ["الذهبي", "ثقة", "д", "ثقةي", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "خَالِد بن دهقان من أهل الشَّام يروي عَن عَبْد الله بن أبي زَكَرِيَّا روى عَنهُ صَدَقَة بن خَالِد وَمُحَمّد بن شُعَيْب بن شَابُور", "الثقات لابن حبان", "5816", "2367", "23678", 1], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "1720": [["أبو حاتم الرازي - فيما روى ابنه عبد الرحمن", "لا بأس به", "д", "وَقَال أبو حاتم الرازي - فيما روى ابنه عبد الرحمن في الجرح والتعديل: لا بأس به.", "تهذيب الكمال", "3722", 3552, "37578", 1], ["الدولابي", "ثقة", "д", "وَقَال الدولابي: أخبرني أحمد بن شعيب، أخبرنا عَمْرو بن منصور، حَدَّثَنَا علي بن الحسن النَّسَائي، حدثني خالد بن حيان أبو يزيد الرَّقِّيّ، وكان ثقة\".", "تهذيب الكمال", "3722", 3552, "37578", 1], ["أبو حفص عمرو بن علي", "ضعيف", "ж", "قال أبو حفص عَمْرو بن علي: وأبو يزيد الخزاز الرَّقِّيّ ضعيف\". وذكر له ابن خزيمة في صحيحه أحاديث منها ما استنكره،", "تهذيب الكمال", "3