{"1706": [["أحمد بن حنبل (٢)، ضعيف الحديث.", "ضعيف", "ж", "قال أبو طالب، عَن أحمد بن حنبل (٢)، ضعيف الحديث.", "تهذيب الكمال", "3722", 3522, "37278", 1], ["أبو حاتم", "صالح", "д", "وَقَال أبو حاتم (١): شيخ، حديثه صالح.", "تهذيب الكمال", "3722", 3523, "37288", 1], ["أبو أحمد بن عدي", "لا بأس", "д", "وَقَال أَبُو أَحْمَد بْن عدي (٢): لا بأس بِهِ وبرواياته عندي، وإن كان ينفرد عَنْ يزيد بْن رومان بما", "تهذيب الكمال", "3722", 3523, "37288", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق له أوهامي", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ضعفه", "д", "ضعفه أحمد وقال ابن معين ليس به بأسي", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["", "صدوق", "д", "ابن حبانب بوكذا أرخه ابن حبان في ?ب الثقات ?بب بتهذيب التهذيب …ااا بابن حجرب بصدوق له أوهام", "موسوعة الرواة (джарх)", "", ""], ["ابن حجر العسقلاتي", "قال في التقريب : صدوق له أوهام", "д", "قال في التقريب : صدوق له أوهام", "sunnah.com", "", "", "", 1], ["يحيى بن معين", "ليس به بأس", "д", "ليس به بأس", "sunnah.com", "", "", "", 1], ["الدارقطني", "ضعيف", "д", "ضعيف", "sunnah.com", "", "", "", 1], ["أبو داود السجستاني", "شيخ", "д", "شيخ", "sunnah.com", "", "", "", 1], ["أبو الفتح الأزدي", "اختلفوا فيه ولا بأس به ، وحديثه مقبول كثير المنكر وهو إلى الصدق أقرب", "д", "اختلفوا فيه ولا بأس به ، وحديثه مقبول كثير المنكر وهو إلى الصدق أقرب", "sunnah.com", "", "", "", 1]], "1710": [["ابن عمار", "ضعيف", "ж", "قال ابن عمار: هو ضعيف، وفي كتاب ابن الجارود: ليس بشيءٍ ...", "تهذيب الكمال", "3722", 3540, "37458", 1], ["الساجي", "ليس بشيء", "ж", "وَقَال الساجي: ليس بشيءٍ، و", "تهذيب الكمال", "3722", -1, "37428", 1], ["أبويحيى", "حجة", "д", "قال أبويحيى: بل هو قرشي وليس بحجة في الاحكام ...", "تهذيب الكمال", "3722", 3540, "37458", 1], ["البزار", "ليس بالقوي", "ж", "وَقَال البزار في مسنده: ليس بالقوي\". (١ / الورقة ٣٠٩) .", "تهذيب الكمال", "3722", 3540, "37458", 1], ["ابن حبان أيضا", "يخطئ", "ж", "وَقَال ابن حبان أيضا: يخطئ\"وما كان ينبغي للمؤلف أن يغفل مثل هذا.", "تهذيب الكمال", "3722", 3540, "37458", 1], ["ابن سعد", "واه", "ж", "وَقَال ابن سعد: كان كثير الحديث والرواية. (٢) في صفة الجنة (٢٥٤٨) . (٣) في المطبوع من الجامع: الجواد\". وعَنه: بحير بْن سعد (ق) . هكذا رواه ابْن مَاجَهْ (١) عَنْ", "تهذيب الكمال", "3722", 3541, "37468", 1], ["ابن حجر العسقلاني", "لين", "ж", "فيه ليني", "تقريب التهذيب", "8609", "", "", 0], ["", "يخطئ", "ж", "تقريب التهذيب …ااا بالبخاريب بوقال الترمذي سمعت محمدا يقول لخالد بن أبي بكر مناكير عن سالمب بتهذيب التهذيب …ا بقال البخاري له مناكيرب بالكاشف في معرفة من له روا", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "يكتب حديثه", "itqan", "يكتب حديثه", "تهذيب التهذيب", 0, -1, "", "", ""]], "1707": [["الدارقطني", "ضعيف", "ж", "وَقَال الدَّارَقُطنِيّ في كتاب\"الضعفاء\": مدني ضعيف\"", "تهذيب الكمال", "3722", 3523, "37288", 1], ["أبو الفتح الأزدي", "لا بأس به", "д", "قال أبو الفتح الأزدي: اختلفوا فيه، ولا بأس به، وحديثه مقبول، كثير المنكر، وهو إلى الصدق أقرب\".", "تهذيب الكمال", "3722", 3523, "37288", 1], ["أحمد بن حنبل", "لا يكتب حديثه", "ж", "وَقَال أبو بكر الأثرم (٢)، عَن أحمد بْن حنبل: لا يكتب حديثه. _________ (١) الطبقات: ٢٢٣. الجرح والتعديل: ٣ / الترجمة ١٧١٦.", "تهذيب الكمال", "3722", 3525, "37308", 2], ["ابن حجر العسقلاني", "متروك", "ж", "متروك وكان يدلس عن الكذابيني", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "واه", "ж", "واهي", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["أبو حاتم بن حبان البستي", "كان يدلس عن غياث بن إبراهيم وغيره ، ويروي ما يسمع منهم مما وضعوه علي الثقات عن الثقات الذين رآهم ، لا يجوز الاحتجاج بخبر", "д", "كان يدلس عن غياث بن إبراهيم وغيره ، ويروي ما يسمع منهم مما وضعوه علي الثقات عن الثقات الذين رآهم ، لا يجوز الاحتجاج بخبره ، ومرة : ذكره في الثقات", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : متروك ، وكان يدلس عن الكذابين", "д", "قال في التقريب : متروك ، وكان يدلس عن الكذابين", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "مضطرب الحديث ليس بقوي يكتب حديثه ولا يحتج به مثل مسلم بن خالد الزنجي لم يكن محله محل الكذب", "д", "مضطرب الحديث ليس بقوي يكتب حديثه ولا يحتج به مثل مسلم بن خالد الزنجي لم يكن محله محل الكذب", "sunnah.com", "", "", "", 1], ["البخاري", "كان يدلس عن غياث بن إبراهيم ، ولا يعرف صحيح حديثه من غيره", "д", "كان يدلس عن غياث بن إبراهيم ، ولا يعرف صحيح حديثه من غيره", "sunnah.com", "", "", "", 1], ["يحيى بن معين", "قال في رواية معاوية : ليس بثقة ، ومرة : ليس بشيء ، ومرة : ضعيف ، وفي رواية عباس الدوري : كذاب وليس بشيء", "д", "قال في رواية معاوية : ليس بثقة ، ومرة : ليس بشيء ، ومرة : ضعيف ، وفي رواية عباس الدوري : كذاب وليس بشيء", "sunnah.com", "", "", "", 1], ["أحمد بن شعيب النسائي", "ضعيف ، ومرة : ليس بثقة ، ومرة : متروك الحديث", "д", "ضعيف ، ومرة : ليس بثقة ، ومرة : متروك الحديث", "sunnah.com", "", "", "", 1], ["أبو جعفر العقيلي", "ذكره في الضعفاء", "д", "ذكره في الضعفاء", "sunnah.com", "", "", "", 1], ["أبو زرعة الرازي", "ذكره في الضعفاء والكذابين والمتروكين ، وقال : منكر الحدبث ، يحدث بكذا ، وبكذا ، فجعل يعدد", "д", "ذكره في الضعفاء والكذابين والمتروكين ، وقال : منكر الحدبث ، يحدث بكذا ، وبكذا ، فجعل يعدد", "sunnah.com", "", "", "", 1], ["أبو داود السجستاني", "ضعيف ، ومرة : ليس بشيء ، ومرة : خارجة أودع كتبه عند غياث بن إبراهيم فأفسدها عليه", "д", "ضعيف ، ومرة : ليس بشيء ، ومرة : خارجة أودع كتبه عند غياث بن إبراهيم فأفسدها عليه", "sunnah.com", "", "", "", 1], ["علي بن المديني", "ذكره في سؤالات عثمان بن محمد بن أبي شيبة ، وقال : هو عندنا ضعيف", "д", "ذكره في سؤالات عثمان بن محمد بن أبي شيبة ، وقال : هو عندنا ضعيف", "sunnah.com", "", "", "", 1], ["أبو أحمد بن عدي الجرجاني", "هو ممن يكتب حديثه وعندي أنه إذا خالف في الإسناد أو في المتن فإنه يغلط ولا يتعمد وإذا روى حديثا منكرا فيكون البلاء ممن رو", "д", "هو ممن يكتب حديثه وعندي أنه إذا خالف في الإسناد أو في المتن فإنه يغلط ولا يتعمد وإذا روى حديثا منكرا فيكون البلاء ممن رواه عنه فيكون ضعيفا وليس هو ممن يتعمد الكذب", "sunnah.com", "", "", "", 1], ["محمد بن سعد كاتب الواقدي", "اتقي الناس حديثه فتركوه", "д", "اتقي الناس حديثه فتركوه", "sunnah.com", "", "", "", 1], ["أبو عبد الله الحاكم", "ذكره في المستدرك ، وقال : لم ينقم عليه إلا روايته عن المجهولين ، و إذا روى عن الثقات الأثبات فروايته مقبولة", "д", "ذكره في المستدرك ، وقال : لم ينقم عليه إلا روايته عن المجهولين ، و إذا روى عن الثقات الأثبات فروايته مقبولة", "sunnah.com", "", "", "", 1], ["يعقوب بن سفيان الفسوي", "ذكره في باب من يرغب عن الرواية عنهم ، وقال : كنت أسمع أصحابنا يضعفونه", "д", "ذكره في باب من يرغب عن الرواية عنهم ، وقال : كنت أسمع أصحابنا يضعفونه", "sunnah.com", "", "", "", 1], ["وكيع بن الجراح", "تركه", "д", "تركه", "sunnah.com", "", "", "", 1], ["إبراهيم بن يعقوب الجوزجاني", "كان يرمى بالإرجاء", "д", "كان يرمى بالإرجاء", "sunnah.com", "", "", "", 1], ["أبو بكر البزار", "ذكره في البحر الزخار ، وقال : ليس بالحافظ", "д", "ذكره في البحر الزخار ، وقال : ليس بالحافظ", "sunnah.com", "", "", "", 1], ["أبو أحمد الحاكم", "متروك الحديث", "д", "متروك الحديث", "sunnah.com", "", "", "", 1], ["يعقوب بن شيبة السدوسي", "ورد في الموسوعة العليمة الشاملة عن الحافظ يعقوب بن شيبة ، وقال هو ضعيف الحديث عند جميع أصحابنا", "д", "ورد في الموسوعة العليمة الشاملة عن الحافظ يعقوب بن شيبة ، وقال هو ضعيف الحديث عند جميع أصحابنا", "sunnah.com", "", "", "", 1], ["عبد الرحمن بن يوسف بن خراش", "متروك الحديث", "д", "متروك الحديث", "sunnah.com", "", "", "", 1], ["محمد بن عبد الله المخرمي", "كيف أحدث عن رجل حدث نكد الحديث منكر ، وقد رأيت منه سهولة في أشياء ، فلم آمن أن يكون أخذه للحديث علي ذلك", "д", "كيف أحدث عن رجل حدث نكد الحديث منكر ، وقد رأيت منه سهولة في أشياء ، فلم آمن أن يكون أخذه للحديث علي ذلك", "sunnah.com", "", "", "", 1], ["ابن الجارود", "ذكره في الضعفاء", "д", "ذكره في الضعفاء", "sunnah.com", "", "", "", 1], ["أبو علي بن السكن", "ذكره في الضعفاء", "д", "ذكره في الضعفاء", "sunnah.com", "", "", "", 1], ["أبو زرعة الدمشقي", "ذكره في الضعفاء", "д", "ذكره في الضعفاء", "sunnah.com", "", "", "", 1], ["البرهان الحلبي", "ذكره في التبيين لأسماء المدلسين", "д", "ذكره في التبيين لأسماء المدلسين", "sunnah.com", "", "", "", 1], ["أبو العرب القيرواني", "ذكره في الضعفاء", "д", "ذكره في الضعفاء", "sunnah.com", "", "", "", 1], ["يحيى بن يحيى الليثي", "خ