{"904": [["ياقوت", "حافظ", "д", "قال ياقوت في معجمه: أبو سَعِيد يقول بفتح الجيم، وأبو نعيم الحافظ بكسرها، والصاد عندهما مكسورة مشددة وياء ساكنة، وهي محلة بمرو. (٣)", "تهذيب الكمال", "3722", 1569, "15708", 1], ["شعيب", "ضعيف", "ж", "قال شعيب: إسناده ضعيف جدا، أَوْسُ بْنُ عَبْدِ اللَّهِ بْنِ بريدة", "تهذيب الكمال", "3722", 1569, "15708", 1], ["البخاري", "فيه نظر", "ж", "قال الْبُخَارِيّ: فيه نظر،", "تهذيب الكمال", "3722", -1, "15708", 1], ["الدارقطني", "متروك", "ж", "وَقَال الدَّارَقُطنِيّ: متروك، وأخوه سهل،", "تهذيب الكمال", "3722", 1569, "15708", 1], ["ابن حبان", "منكر الحديث", "ж", "قال ابن حبان: منكر الحديث. وأخرجه الخطيب البغدادي في \"تاريخه\"١ / ١٢٧، ١٢٨ من طريق آخر في سنده مُحَمَّد بْن الفضل بْن عطية،", "تهذيب الكمال", "3722", 1569, "15708", 1], ["غير واحد", "متروك", "ж", "وَقَال غير واحد: متروك،", "تهذيب الكمال", "3722", -1, "15708", 1], ["الفلاس", "كذاب", "ж", "وَقَال الفلاس: كذاب، و", "تهذيب الكمال", "3722", -1, "15708", 1], ["البخاري", "فيه نظر", "ж", "قال الْبُخَارِيّ: فيه نظر.", "تهذيب الكمال", "3722", -1, "6388", 1], ["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي: ليس بالقوي فِي الحديث.", "تهذيب الكمال", "3722", 1570, "15718", 1], ["أبو أحمد بن عدي", "منكر", "ж", "وَقَال أَبُو أحمد بْن عدي: ليس له كبير رواية، ولم أر لَهُ شيئا منكرا (٢) . روى لَهُ النَّسَائي حديثًا واحدًا. _________ (١) ويُ", "تهذيب الكمال", "3722", 1570, "15718", 0], ["أبو حاتم الرازي", "ضعيف", "ж", "وَقَال أبو حاتم الرازي: ضعيف الحديث\".", "تهذيب الكمال", "3722", 1570, "15718", 1], ["الدارقطني", "متروك", "ж", "وَقَال الدَّارَقُطنِيّ: متروك.", "تهذيب الكمال", "3722", -1, "5258", 1], ["أبو داود السجستاني", "وثقه", "д", "قال الآجري: قلتُ لأبي داود: كان يتكلم في عثمان؟ قال: نعم. ولكن وثقه أبو حفص بن شاهين وابن حبان،", "تهذيب الكمال", "3722", 1570, "15718", 1], ["أحمد بن صالح المصري - فيما نقل العقيلي", "صالح", "д", "وَقَال أحمد بن صالح المِصْرِي - فيما نقل العقيلي: هو صاحب مغاز له شأن وأبوه سفيان بن فروة له شأن من تابعي أهل المدينة. \"", "تهذيب الكمال", "3722", 1570, "15718", 1], ["الحافظ أبو موسى المديني", "حافظ", "д", "ذكره الحافظ أبو موسى المديني في كتابه\"معرفة الصحابة\"، وَقَال:", "تهذيب الكمال", "3722", 1570, "15718", 1], ["ابن حجر العسقلاني", "ليس بالقوي", "ж", "ليس بالقوي وفيه رفض", "تقريب التهذيب", "8609", 47, "5874", 1], ["الذهبي", "فيه نظر", "ж", "قال البخاري فيه نظر", "الكاشف / سير أعلام النبلاء", "2171", 258, "2588", 1], ["النسائي", "ليس بالقوي", "ж", "ن بن فروة ليس بالقوي", "الضعفاء والمتروكون للنسائي", "10805", "15", "158", 1], ["ابن أبي حاتم", "ضعيف", "itqan", "ضعيف الحديث", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "له صحبة", "itqan", "له صحبة", "تهذيب التهذيب", 0, -1, "", "", ""]], "906": [["يحيى بن معين، صالح.", "صالح", "д", "قال إِسْحَاق بْن منصور، عَن يحيى بْن مَعِين، صالح.", "تهذيب الكمال", "3722", 1573, "15748", 1], ["يحيى", "ثقة", "д", "وَقَال عباس، عَنْ يَحْيَى: ثقة (١) .", "تهذيب الكمال", "3722", -1, "15728", 1], ["أبو حاتم", "صالح الحديث", "д", "وَقَال أبو حاتم: صالح الحديث، لا بأس به (٢) . روى له النَّسَائي حديثين (٣) .", "تهذيب الكمال", "3722", 1573, "15748", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "907": [["شعيب", "واه", "ж", "قال شعيب: هذا الحديث لم يخرجه مسلم في صحيحه، لا عن بسر، ولا عن ابنه عبد الله وإنما انفرد النَّسَائي في \"الكرى\"من بين الكتب الستة كما نص عليه المؤلف في \"تحفة الا", "تهذيب الكمال", "3722", 1584, "15858", 1], ["عبد الله بن بسر", "صالح", "д", "قال عبد الله بن بسر: إن شككتم فلوا أختي قال: فمشى إليها خالد بن معدان فسألها عما ذكر عبد الله، فحدثته ذلك. وأخرجه ابن خزيمة في \"صحيحه\" (٢١٦٤) من طريق معاوية بن ", "تهذيب الكمال", "3722", 1584, "15858", 1], ["ابن خزيمة", "صالح", "д", "قال ابن خزيمة: خالف معاوية بن صالح ثور بن يزيد في هذا الإسناد، ف", "تهذيب الكمال", "3722", 1584, "15858", 1], ["الحافظ ابن حجر", "حافظ", "д", "قال الحافظ ابن حجر: إنما الخلاف في المذكور عند النَّسَائي فقط، وأما مسلم فليس فيه إلا عن عبد الله بن بسر، قال: نزل النبي صلى الله على أبي سأله طعاما ... الحديث،", "تهذيب الكمال", "3722", 1584, "15858", 1], ["أحد غير صاحب \"الكمال\"", "واه", "ж", "ذكره أحد غير صاحب \"الكمال\" في رجال المسلم، والله أعلم. وأما الحديث الذي رواه النَّسَائي وحده في صوم يوم السبت فمختلف فيه على عبد الله بن بسر قيل ز عنه، وقيل: عن", "تهذيب الكمال", "3722", 1584, "15858", 1], ["الحافظ", "حافظ", "д", "وَقَال الحافظ في \"الاصابة\": ثبت", "تهذيب الكمال", "3722", 1584, "15858", 1], ["بشار بن عواد", "حافظ", "д", "قال بشار بن عواد: اعتراض الحافظ ابن حجر صحيح، والمزي يعرف جيدا أن الحديث المذكور لم يروه عبد الله بن بسر عَن أبيه في صحيح مسلم. ودليلنا على ذلك أن الحافظ المزي ", "تهذيب الكمال", "3722", 1584, "15858", 1]], "914": [["مغلطاي", "وثقه", "д", "قال مغلطاي: ذكر ابن يونس في \"تاريخ الغرباء\"أن سَعِيد بن كثير بن عفير روى عنه، قال: حَدَّثَنَا يونس بن عُبَيد، فذكر حديثًا\". وقد وثقه أبو داود فيما روى الآجري، و", "تهذيب الكمال", "3722", 1592, "15938", 1], ["الذهبي", "مجهول", "ж", "قال الذهبي في \"الميزان\": مجهول الحال\"؟.", "تهذيب الكمال", "3722", 1592, "15938", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. (٤)", "تهذيب الكمال", "3722", -1, "15938", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "بسطَام بن حُرَيْث يروي عَن حميد بن الْأَعْرَج روى عَنهُ مُوسَى بن إِسْمَاعِيل", "الثقات لابن حبان", "5816", "3433", "34338", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "910": [["ابن حبان", "يهم", "ж", "قال ابن حبان في ثقاته: كان ينزل في دار الحضرمي في جدلة قيس فنسب إليهم. سلمة بْن عَبْد الرحمن بْن عوف (خ م دت س) .", "تهذيب الكمال", "3722", 1587, "15888", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال إِسْحَاق بْن مَنْصُور. عَنْ يحيى بْن مَعِين: ثقة. وكذلك", "تهذيب الكمال", "3722", 1588, "15898", 1], ["محمد بن سعد", "ثقة", "д", "وَقَال مُحَمَّد بْن سعد: كان من العباد المنقطعين، وأهل الزهد فِي الدنيا. وكان ثقة كثير الحديث. ورعا وكان قد أتى البصرة فِي حاجة. ثم أراد الرجوع إلى المدينة وفرا", "تهذيب الكمال", "3722", 1588, "15898", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة جليل", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة جليل", "д", "قال في التقريب : ثقة جليل", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "لا يسأل عن مثله", "д", "لا يسأل عن مثله", "sunnah.com", "", "", "", 1], ["الدارقطني", "في سؤالات أبي عبد الرحمن السلمي ، قال : روى عن زيد بن خالد وأبي هريرة", "д", "في سؤالات أبي عبد الرحمن السلمي ، قال : روى عن زيد بن خالد وأبي هريرة", "sunnah.com", "", "", "", 1], ["أحمد بن شعيب النسائي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["يحيى بن سعيد القطان", "أحب إلى من عطاء بن يسار ، ومرة : كان يذكر بخير", "д", "أحب إلى من عطاء بن يسار ، ومرة : كان يذكر بخير", "sunnah.com", "", "", "", 1], ["أبو علي الغساني", "ثقة من كبار التابعين في المدينة", "д", "ثقة من كبار التابعين في المدينة", "sunnah.com", "", "", "", 1]], "911": [["خليفة", "حافظ", "д", "قال خليفة في تاريخه وطبقاته وابن حبان وابن القيسراني والذهبي وذكر الحافظ ابن حجر في \"التهذيب\"نقلا عن المزي\"وقيل مات سنة ١٠١\"ولا أدرى من ابن جاء بها. (٢) ووثقه ا", "تهذيب الكمال", "3722", 1589, "15908", 1], ["",