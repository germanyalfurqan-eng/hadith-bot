, "ثقه", "jarh", "النَّسَائي: ثقة (١)", "تهذيب الكمال", "3722", -1, "17068", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "له صحبة", "itqan", "له صحبة", "تهذيب التهذيب", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة", "д", "قال في التقريب : ثقة", "sunnah.com", "", "", "", 1]], "968": [["ابن حجر العسقلاني", "صدوق", "д", "صدوق كثير التدليس عن الضعفاء", "تقريب التهذيب", "8609", 52, "6598", 1], ["الذهبي", "حافظ", "д", "الحافظ وثقه الجمهور فيما سمعه من الثقات وقال النسائي إذا قال حدثنا وأخبرنا فهو ثقة", "الكاشف / سير أعلام النبلاء", "2171", 265, "2658", 3], ["البخاري", "ضعيف", "itqan", "ضعيف", "التاريخ الكبير", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ثقة مأمونا ، ولكنه كان مدلسا", "д", "ثقة مأمونا ، ولكنه كان مدلسا", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : صدوق كثير التدليس عن الضعفاء ، وقال في هدي الساري : مشهور مختلف فيه وله موضع معلق", "д", "قال في التقريب : صدوق كثير التدليس عن الضعفاء ، وقال في هدي الساري : مشهور مختلف فيه وله موضع معلق", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "يكتب حديث بقية ، ولا يحتج به", "д", "يكتب حديث بقية ، ولا يحتج به", "sunnah.com", "", "", "", 1], ["يحيى بن معين", "صالح ، ومرة : إذا حدث عن الثقات مثل صفوان بن عمرو وغيره فأما إذا حدث عن أولئك المجهولين فلا وإذا كنى ولم يسم اسم الرجل ف", "д", "صالح ، ومرة : إذا حدث عن الثقات مثل صفوان بن عمرو وغيره فأما إذا حدث عن أولئك المجهولين فلا وإذا كنى ولم يسم اسم الرجل فليس يساوى شيئا وقال مرة : علي بن ثابت وإسماعيل بن عياش وبقية ومروان بن معاوية وزيد بن حباب ثقات في أنفسهم الا أنهم يحدثون عن الكل ويأتونا بالعجائب ، وفي رواية ابن محرز قال : إذا حدث عن ثقة فهو صدوق", "sunnah.com", "", "", "", 1], ["أحمد بن حنبل", "إذا حدث عن قوم ليسوا بمعروفين فلا تقبلوه ، وإذا حدث بقية عن المعروفين مثل بحير بن سعيد وغيره قبل ، ومرة : روي بقية عن عب", "д", "إذا حدث عن قوم ليسوا بمعروفين فلا تقبلوه ، وإذا حدث بقية عن المعروفين مثل بحير بن سعيد وغيره قبل ، ومرة : روي بقية عن عبيد الله بن عمر مناكير ومرة : سئل عن ضمرة وبقية أيهما أحب إليه؟ فقال : لا ضمرة أحب إلينا بقية ما كان يبالي عن من حدث ، ومرة : كان إسماعيل صاحب حديث وكان بقية وكان وكان وفخم أمره وذكر بقية فقال كان بقية أذكاهما أي كأنه يشتهي الحديث", "sunnah.com", "", "", "", 1], ["الدارقطني", "ذكره في الضعفاء والمتروكين وقال يروي عن قوم متروكين ، وفي سؤالات أبي عبد الرحمن السلمي ، قال : يروي عن قوم متروكين مثل م", "д", "ذكره في الضعفاء والمتروكين وقال يروي عن قوم متروكين ، وفي سؤالات أبي عبد الرحمن السلمي ، قال : يروي عن قوم متروكين مثل مجاشع بن عمرو ، وعبد الله بن يحيى ، ولا أعرفه ، ولا أعلم له راويا غير بقية", "sunnah.com", "", "", "", 1], ["أحمد بن شعيب النسائي", "إذا قال حدثني وحدثنا فلا بأس ، ومرة إن قال أخبرنا أو حدثنا فهو ثقة ، وإن قال عن فلا يأخذ عنه لا يدرى عمن أخذه", "д", "إذا قال حدثني وحدثنا فلا بأس ، ومرة إن قال أخبرنا أو حدثنا فهو ثقة ، وإن قال عن فلا يأخذ عنه لا يدرى عمن أخذه", "sunnah.com", "", "", "", 1], ["أبو جعفر العقيلي", "صدوق اللهجة ، إلا أنه يأخذ عمن أقبل وأدبر ، فليس بشيء", "д", "صدوق اللهجة ، إلا أنه يأخذ عمن أقبل وأدبر ، فليس بشيء", "sunnah.com", "", "", "", 1], ["أبو زرعة الرازي", "إذا ذكره في الجرح والتعديل وقال : روى عن الثقات فهو ثقة", "д", "إذا ذكره في الجرح والتعديل وقال : روى عن الثقات فهو ثقة", "sunnah.com", "", "", "", 1], ["الخطيب البغدادي", "في حديثه مناكير ، إلا أن أكثرها عن المجاهيل ، وكان صدوقا", "д", "في حديثه مناكير ، إلا أن أكثرها عن المجاهيل ، وكان صدوقا", "sunnah.com", "", "", "", 1], ["علي بن المديني", "صالح فيما روي عن أهل الشام ، وأما عن أهل الحجاز ، والعراق ، فضعيف جدا ، روى عن عبيد الله بن عمر أحاديث منكرة", "д", "صالح فيما روي عن أهل الشام ، وأما عن أهل الحجاز ، والعراق ، فضعيف جدا ، روى عن عبيد الله بن عمر أحاديث منكرة", "sunnah.com", "", "", "", 1], ["أحمد بن عبد الله العجلي", "ثقة ما روي عن المعروفين وما روي عن المجهولين فليس بشيء", "д", "ثقة ما روي عن المعروفين وما روي عن المجهولين فليس بشيء", "sunnah.com", "", "", "", 1], ["أبو أحمد بن عدي الجرجاني", "في بعض رواياته يخالف الثقات وإذا روى عن أهل الشام فهو ثبت وإذا روى عن غيرهم خلط كإسماعيل بن عياش إذا روى عن الشامين فهو ", "д", "في بعض رواياته يخالف الثقات وإذا روى عن أهل الشام فهو ثبت وإذا روى عن غيرهم خلط كإسماعيل بن عياش إذا روى عن الشامين فهو ثبت وإذا روى عن أهل الحجاز والعراق خالف الثقات في روايته عنهم", "sunnah.com", "", "", "", 1], ["محمد بن سعد كاتب الواقدي", "ثقة في روايته عن الثقات ضعيف في روايته عن غير الثقات", "д", "ثقة في روايته عن الثقات ضعيف في روايته عن غير الثقات", "sunnah.com", "", "", "", 1], ["أبو عبد الله الحاكم", "ثقة مأمون ، ومرة ذكره في المستدرك ، وقال : إذا روى عن المشهورين فإنه مأمون مقبول", "д", "ثقة مأمون ، ومرة ذكره في المستدرك ، وقال : إذا روى عن المشهورين فإنه مأمون مقبول", "sunnah.com", "", "", "", 1], ["يعقوب بن سفيان الفسوي", "قد قال أهل العلم بقية إذا لم يسم الذي يروي عنه وكناه فلا يساوي حديثه شيئا", "д", "قد قال أهل العلم بقية إذا لم يسم الذي يروي عنه وكناه فلا يساوي حديثه شيئا", "sunnah.com", "", "", "", 1], ["شعبة بن الحجاج بن الورد", "كان مبجلا له ومرة : قال له : يا أبا يحمد ما أحسن حديثك ولكن ليس له أركان", "д", "كان مبجلا له ومرة : قال له : يا أبا يحمد ما أحسن حديثك ولكن ليس له أركان", "sunnah.com", "", "", "", 1], ["سفيان بن عيينة", "لا تسمعوا من بقية ما كان في سنة واسمعوا منه ما كان في ثواب وغيره", "д", "لا تسمعوا من بقية ما كان في سنة واسمعوا منه ما كان في ثواب وغيره", "sunnah.com", "", "", "", 1], ["إبراهيم بن يعقوب الجوزجاني", "رحم الله بقية ما كان يبالي إذا وجد خرافة عمن يأخذ وإذا حدث عن الثقات فلا بأس به ، ومرة : إذا تفرد بالرواية فغير محتج به ", "д", "رحم الله بقية ما كان يبالي إذا وجد خرافة عمن يأخذ وإذا حدث عن الثقات فلا بأس به ، ومرة : إذا تفرد بالرواية فغير محتج به لكثرة وهمه", "sunnah.com", "", "", "", 1], ["عبد الغني بن سعيد الأزدي", "ذكره في مشتبه النسبة ، وقال : نسبه الميتمي", "д", "ذكره في مشتبه النسبة ، وقال : نسبه الميتمي", "sunnah.com", "", "", "", 1], ["أبو بكر البيهقي", "أجمعوا علي أن بقية ليس بحجة", "д", "أجمعوا علي أن بقية لي