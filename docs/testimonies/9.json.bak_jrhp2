 "ثقة", "sunnah.com", "", "", "", 1], ["أبو أحمد بن عدي الجرجاني", "له غرائب من الحديث عن الثوري ومسعر وغيرهما وهو حسن الحديث ممن يكتب حديثه ويقع في أحاديثه من النكرة لأنه يروي عن شيخ محتم", "д", "له غرائب من الحديث عن الثوري ومسعر وغيرهما وهو حسن الحديث ممن يكتب حديثه ويقع في أحاديثه من النكرة لأنه يروي عن شيخ محتمل فأما هو في نفسه فلا بأس به", "sunnah.com", "", "", "", 1], ["محمد بن سعد كاتب الواقدي", "ثقة كثير الحديث", "д", "ثقة كثير الحديث", "sunnah.com", "", "", "", 1], ["عبد الرحمن بن مهدي", "وثقه", "д", "وثقه", "sunnah.com", "", "", "", 1], ["عمرو بن علي الفلاس", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["ابن حزم الأندلسي", "طعن فيه برأي جهم ثم اعتذر وتاب", "д", "طعن فيه برأي جهم ثم اعتذر وتاب", "sunnah.com", "", "", "", 1], ["عبد الله بن الزبير الحميدي", "جهمي لا يحل أن يكتب عنه", "д", "جهمي لا يحل أن يكتب عنه", "sunnah.com", "", "", "", 1]], "931": [["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات ، وقال : كان متقنا وبعض سماعه عن أبيه مناولة ، ثم غفلة شديدة فذكره في الضعفاء ، ونقل عن البخاري أنه قال :", "д", "ذكره في الثقات ، وقال : كان متقنا وبعض سماعه عن أبيه مناولة ، ثم غفلة شديدة فذكره في الضعفاء ، ونقل عن البخاري أنه قال : تركناه", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة ، وقال في هدي الساري : سقط من نسخة ابن حبان في كتاب الثقات فيما نقله عن البخاري أنه قال : تركناه نش", "д", "قال في التقريب : ثقة ، وقال في هدي الساري : سقط من نسخة ابن حبان في كتاب الثقات فيما نقله عن البخاري أنه قال : تركناه نشأ عن حذف فقوله هو تركناه حيا سنة اثنتي عشرة فسقط لفظة حيا فتغير المعنى", "sunnah.com", "", "", "", 1], ["البخاري", "قال في تاريخه تركناه حيا سنة اثنتي عشرة", "д", "قال في تاريخه تركناه حيا سنة اثنتي عشرة", "sunnah.com", "", "", "", 1], ["يحيى بن معين", "في رواية ابن محرز : ساق فيها قصة عن سفيان أنه لم يسمع من أبيه", "д", "في رواية ابن محرز : ساق فيها قصة عن سفيان أ