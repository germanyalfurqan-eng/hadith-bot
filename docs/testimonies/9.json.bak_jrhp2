д", "وَقَال الحافظ أَبُو نعيم: لَهُ ولأبويه صحبة، توفي النبي ﷺ ولَهُ ثماني سنين وسبعة أشهر، كَانَ أميرا للك", "تهذيب الكمال", "3722", 12723, "159868", 1], ["ابن حجر العسقلاني", "صحابي", "itqan", "صحابي", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن أبي حاتم", "له صحبة", "itqan", "له صحبة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "واه", "itqan", "واه", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "صحابي", "itqan", "صحابي", "الطبقات الكبرى", 0, -1, "", "", ""]], "958": [["مع أن السائبة مولاة الفاكه لم ي", "وثقه", "д", "قال مع أن السائبة مولاة الفاكه لم يوثقها غير ابن حبان، ولم يرو عنها غير نافع، وله شاهد من حديث أم شَرِيك عند البخاري ٦ / ٢٨١، ومسلم (٢٢٣٧)، ومن حديث أبي هُرَيْر", "تهذيب الكمال", "3722", 1688, "16898", 1], ["مسلمة بن قاسلم الاندلسي", "مجهول", "ж", "وَقَال مسلمة بن قاسلم الاندلسي: مجهول\". وذكر مغلطاي وابن حجر أن ابن حبان", "تهذيب الكمال", "3722", 1688, "16898", 1], ["", "ساقط", "ж", "ذكره في أتباع التابعين من \"الثقات\" وَقَال: روى عن رجل ٧ عن عبد الله بن عَمْرو\". ولم أجده في ترتيب الهيثمي، فلعله ساقط من النسخة.", "تهذيب الكمال", "3722", 1688, "16898", 1], ["ابن حجر", "مجهول", "ж", "وَقَال ابن حجر في \"التقريب\"\"مجهول\". مُطَرِّفِ بْنِ طَرِيفٍ، عَنْ بَشِيرٍ أَبِي عَبْدِ اللَّهِ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرو، قال:", "تهذيب الكمال", "3722", -1, "16908", 0], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "شيخ", "itqan", "شيخ", "تهذيب التهذيب", 0, -1, "", "", ""]], "963": [["أحمد بن عبد الله العجلي، والنسائي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبْد اللَّهِ العجلي، والنَّسَائي: ثقة.", "تهذيب الكمال", "3722", 1696, "16978", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "لا يحتج بحديثه", "itqan", "لا يحتج بحديثه", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "لا يحتج بحديثه", "itqan", "لا يحتج بحديثه", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة ، وقال في هدي الساري : له في البخاري حديثان ، وتعنت أبو حاتم في قوله لا يحتج به", "д", "قال في التقريب : ثقة ، وقال في هدي الساري : له في البخاري حديثان ، وتعنت أبو حاتم في قوله لا يحتج به", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "لا يحتج بحديثه", "д", "لا يحتج بحديثه", "sunnah.com", "", "", "", 1], ["أحمد بن حنبل", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["أحمد بن شعيب النسائي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["أبو داود السجستاني", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["محمد بن سعد كاتب الواقدي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1]], "966": [["الحافظ ابن ناصر الدين", "حافظ", "д", "وَقَال الحافظ ابن ناصر الدين في توضيحه: وقيل: بصرة - بضم أوله مع الاهمال - وقيل: بسرة - بالضم أيضا مع سكون السين المهملة - وقيل: نضلة - بنون ومعجمة - واختلف في ", "تهذيب الكمال", "3722", 1703, "17048", 1]], "964": [["العجلي", "ثقة", "д", "وَقَال العجلي: بصري تابعي ثقة\".", "تهذيب الكمال", "3722", 1701, "17028", 1], ["الدارقطني", "ثقة", "д", "وَقَال الحاكم أَبُو عَبْد اللَّهِ، عن الدَّارَقُطنِيّ: ثقة، جليس ابْن عَبَّاس وعِمْران بْن حصين. و", "تهذيب الكمال", "3722", 1701, "17028", 1], ["أبو أحمد العسكري، ف", "وثقه", "д", "ذكره أبو أحمد العسكري، فقال: كان أحد الزهاد. ووثقه ابن حبان وخرج حديثه في صحيحه، ووثقه الذهبي، وابن حجر. و", "تهذيب الكمال", "3722", 1701, "17028", 1], ["يحيى بن معين", "ثقة", "д", "قال عَبَّاس الدُّورِيُّ، عَنْ يحيى بْن مَعِين: ثقة، وليس بأخي سُلَيْمان بْن يسار.", "تهذيب الكمال", "3722", 1702, "17038", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة (٢) . روى له الجماعة. _________ (١) بكسر النون بعدها الياء خفيفة، كما في \"التقريب\"وغيره. (٢) ووثقه ابن شاهين، وابن حبان، والذهبي، وابن حج", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة فقيه", "تقريب التهذيب", "8609", "", "", 0], ["ابن أبي حاتم", "واه", "itqan", "واه", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن سعد", "شيخ", "itqan", "شيخ", "الطبقات الكبرى", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة فقيه", "д", "قال في التقريب : ثقة فقيه", "sunnah.com", "", "", "", 1], ["محمد بن سعد كاتب الواقدي", "كان شيخا كبيرا فقيها وكان قد أدرك عامة أصحاب رسول الله صلي الله عليه وسلم وكان قليل الحديث", "д", "كان شيخا كبيرا فقيها وكان قد أدرك عامة أصحاب رسول الله صلي الله عليه وسلم وكان قليل الحديث", "sunnah.com", "", "", "", 1]], "971": [["البزاز", "ثقة", "д", "وَقَال البزاز في مسنده\"حَدَّثَنَا هل بن حجر\"حَدَّثَنَا سَعِيد بن محمد الجرمي، حدينا أبو بشر المزلق - وكان ثقة، عَن ثابت - فذكر حديثًا.", "تهذيب الكمال", "3722", 1718, "17198", 1], ["الإمام الذهبي", "إمام", "д", "وَقَال الإمام الذهبي: لين\".", "تهذيب الكمال", "3722", -1, "17188", 1], ["الحافظ ابن حجر", "حافظ", "д", "وَقَال الحافظ ابن حجر: صدوق فيه لين. (٤)", "تهذيب الكمال", "3722", 1718, "17198", 1], ["ابن الاثير", "لين", "ж", "قال ابن الاثير في \"النهاية\": الذكارة بكسر الذال المعجمة، وراء، ما يصلح للرجال كالمسك والعنبر والعود والكافور، وهي جمع ذكر، وهو مالا لون له، وهو في سنن النَّسَائ", "تهذيب الكمال", "3722", 1718, "17198", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق فيه لين", "تقريب التهذيب", "8609", 21, "2051", 1], ["الذهبي", "لين", "ж", "لين", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "970": [["يعقوب بن سفيان الفسوي", "ضعيف", "ж", "ذكره يعقوب بن سفيان الفسوي فِي بَابِ\"مَنْ يُرْغَبُ عَنِ الرواية عنهم وكنت أسمع أصحابنا يضعفونهم\"من كتاب\"المعرفة\"وَقَال: وبكار بْن عَبْد الْعَزِيزِ بْن أَبي بكرة", "تهذيب الكمال", "3722", 1716, "17178", 1], ["مرة", "ضعيف", "ж", "وَقَال مرة: ضعيف\".", "تهذيب الكمال", "3722", -1, "17178", 1], ["الذهبي", "لين", "ж", "وَقَال الذهبي: فيه لين\"", "تهذيب الكمال", "3722", -1, "17178", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر: صدوق يهم. (٢) ثقان ابن حبان (في اتباع التابعين): ١ / الورقة: ٥٤، وتذهيب الذهبي: ١ / الورقة: ٨٨، والكاشف: ١ / ١٦٠، والميزان: ١ / ٣٤٢، وإكمال مغلط", "تهذيب الكمال", "3722", 1716, "17178", 1], ["يحيي بن معين", "ليس بشيء", "ж", "قال عباس الدُّورِيُّ، عن يحيي بن مَعِين: ليس بشيءٍ.", "تهذيب الكمال", "3722", -1, "17188", 1], ["أبو حاتم", "ليس بالقوي", "ж", "وَقَال عبد الرحمن بن أَبي حاتم، عَن أبيه: ليس بالقوي.", "تهذيب الكمال", "3722", 1717, "17188", 1], ["النسائي", "ليس بثقة", "ж", "وَقَال النَّسَائي: ليس بثقة.", "تهذيب الكمال", "3722", -1, "8528", 1], ["", "ليس بالقوي", "ж", "وَقَال في موضع آخر: ليس بالقوي.", "تهذيب الكمال", "3722", -1, "17188", 1], ["أبو عاصم الضحاك بن مخلد النبيل", "ثقة", "д", "وَقَال أبو عاصم الضحاك بن مخلد النبيل: ثقة.", "تهذيب الكمال", "3722", 1717, "17188", 1], ["ابن عدي", "منكر", "ж", "وَقَال ابن عدي: أحاديثه ليست بالمنكرة جدا. و", "تهذيب الكمال", "3722", 1717, "17188", 1], ["أبو نعيم الحافظ", "حافظ", "д", "وَقَال أبو نعيم الحافظ في \"أخبار أصبهان\": قدم بكر أصبهان سنة ست ومئتين، وحدث بها في سنة سبع ومئتين.", "تهذيب الكمال", "3722", 1717, "17188", 1], ["الإمام الذهبي", "إمام", "д", "ذكره الإمام الذهبي في \"الكاشف\"فقال: س: بكر بن بكار، عن حمزة الزيات، وغيره، وعنه ... توفي سنة ٢٩٠ (كذا والصحيح ٢٠٩) ساق له النَّسَائي في الكبير، وَقَال: ليس ثقة.", "تهذيب الكمال", "3722", 1717, "17188", 1], ["الحافظ ابن حجر", "حافظ", "д", "وقال الحافظ ابن حجر في \"التهذيب\": روى له النَّسَائي أثرا واحدًا في أثناء الصلاة في \"السنن الكبرى\"رواية ابن الاحمر، من روايته عن سفيان بن حسين، عن الزُّهْرِيّ، ع", "تهذيب الكمال", "3722", 1717, "17188", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8