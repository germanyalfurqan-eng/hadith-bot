{"6701": [["إبراهيم بن يعقوب الجوزجاني", "يهم", "ж", "وَقَال إبراهيم بن يعقوب الجوزجاني: وكان قوم يتكلمون في القدر منهم من يزن ويتوهم عليه احتمل الناس حديثهم لما عرفوا من اجتهادهم في الدين وصدق ألسنتهم وأمانتهم في ", "تهذيب الكمال", "3722", "16290", "162908", 1], ["ونحا به نحو الثقة والثبت.", "ثقة", "д", "ذكره ونحا به نحو الثقة والثبت.", "تهذيب الكمال", "3722", "16290", "162908", 1], ["أحمد بن حنبل يسأل", "ثبت", "д", "سمعت أحمد بن حنبل يسأل: من أثبت الناس في يحيى بن أَبي كثير؟ قال: هشام الدستوائي، ثم ذكر هؤلاء الأربعة: علي بن المبارك وأبان، وهشام وحرب بن شداد يعني بعد هشام. (", "تهذيب الكمال", "3722", "16290", "162908", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق ربما وهم", "تقريب التهذيب", "8609", 22, "2193", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6702": [["ابن سعد", "ثقة", "д", "وَقَال ابن سعد: كان ثقة حجة ثبتا. (طبقاته: ٧ / ٣٠٠) .", "تهذيب الكمال", "3722", "16299", "162998", 1], ["أبي", "ثبت", "д", "سمعت أبي يقول: هما كثيرا الكتاب، عَن أبي عوانة: يحيى ابن حماد، وهشام بن عَبد المَلِك، إلا أن يحيى بن حماد كان أروى منه. قلت له: هشام كان ثبتا؟ قال: في حديث شعبة", "تهذيب الكمال", "3722", "16299", "162998", 1], ["عبد الله بن أحمد أيضا", "ثبت", "д", "وَقَال عَبد الله بن أحمد أيضا: قلتُ لأبي: كان أبو الوليد ثبتا؟ قال: لا، ما كان كتابه منقوطا ولا مشكولا، ولكنه في حديث شعبة متقن.", "تهذيب الكمال", "3722", "16299", "162998", 1], ["يحيى", "ثقة", "д", "قال يحيى: هشام بن عَبد المَلِك الطيالسي بصري ثقة. (الترجمة ١٥٣٥) .", "تهذيب الكمال", "3722", "16299", "162998", 1], ["ابن قانع", "ثقة", "д", "قال ابن قانع: ثقة مأمون ثبت.", "تهذيب الكمال", "3722", "16299", "162998", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة فقيه ربما دلس", "تقريب التهذيب", "8609", 499, "4998", 1], ["الذهبي", "ثقة", "д", "أحد الأعلام قال أبو حاتم ثقة إمام في الحديث", "الكاشف / سير أعلام النبلاء", "2171", 1022, "10238", 3]], "6736": [["يحيى بن معين", "ثقة", "д", "قال إسحاق بْن مَنْصُور (٢)، عَنْ يحيى بْن مَعِين: ثقة. و", "تهذيب الكمال", "3722", "16364", "7838", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة عابد", "تقريب التهذيب", "8609", "", "", 0]], "6737": [["العجلي", "ثقة", "д", "وَقَال العجلي: من أصحاب عَبد الله ثقة (ثقاته، الورقة ٥٦) .", "تهذيب الكمال", "3722", "16365", "163658", 1], ["يحيى بن معين", "ثقة", "д", "قال إسحاق بْن مَنْصُور، عَنْ يحيى بْن مَعِين: ثقة (١) . و", "تهذيب الكمال", "3722", "16365", "7838", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6738": [["العجلي", "ثقة", "д", "وَقَال العجلي: يماني تابعي ثقة. (ثقاته، الورقة ٥٦) .", "تهذيب الكمال", "3722", 13091, "163538", 1], ["يحيى بن معين", "ثقة", "д", "قال إسحاق بْن منصور (١)، عَن يحيى بْن مَعِين: ثقة (٢) . و", "تهذيب الكمال", "3722", 782, "7828", 1], ["عبد الرزاق", "حجة", "д", "قال يَحْيَى بْن مُوسَى عَنْ عبد الرزاق: حج أبي أكثر من ستين حجة (٥) . _________ = والمغني: ٢ / الترجمة ٦٧٦٧، وتذهيب التهذيب: ٤ / الورقة ١٢٢، وتاريخ الاسلام: ٦ /", "تهذيب الكمال", "3722", "", "", 0], ["عباس بن محمد الدوري يقول ليحيى وأنا أسمع", "ليس به بأس", "д", "سمعت عباس بن محمد الدوري يقول ليحيى وأنا أسمع: همام بن نافع أبو عبد الرزاق سمع من عكرمة؟ قال: نعم سمع أبوه من عكرمة وأرجو أن يكون أبوه ليس به بأس. (العلل ومعرفة", "تهذيب الكمال", "3722", 13091, "163538", 1]], "6744": [["الذهبي", "ثقة", "д", "وَقَال الذهبي في الكاشف: ثقة. وبذلك عده تابعيا. (٣) تاريخ البخاري الكبير: ٨ / الترجمة ٢٨٨٠، وثقات العجلي، الورقة ٥٦، والجرح = رَوَى عَن: عَلْقَمَة بْن قَيْس الن", "تهذيب الكمال", "3722", "16384", "7178", 2], ["العجلي", "ثقة", "д", "وَقَال العجلي: كوفي ثقة. (الورقة ٥٦)", "تهذيب الكمال", "3722", "16384", "163858", 1]], "6719": [["النسائي", "ثقة", "д", "قال النَّسَائي (١): ثقة. و", "تهذيب الكمال", "3722", "16392", "2708", 1], ["ابن حبان", "متقن", "д", "ذكره ابنُ حِبَّان فِي كتاب \"الثقات\" (٢)، وَقَال: متقن للحديث.", "تهذيب الكمال", "3722", "16392", "163938", 1], ["الجياني", "لا بأس به", "д", "وَقَال الجياني في شيوخ أبي داود: بصري لا بأس به (الورقة ٩٦) ووثقه الذهبي =", "تهذيب الكمال", "3722", "16392", "163938", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6746": [["", "صدوق", "д", "وَقَال في المغني: صدوق\" ثم استدرك فقال: قلت: لا يكاد يعرف\" له حديث واحد: دخل ﵇ يوم الفتح وعلى سيفه ذهب وفضة\" (٢ / الترجمة ٦٧٧٠) وذكر ابن حجر في التهذيب أن ابن ا", "تهذيب الكمال", "3722", "16387", "163878", 1], ["أبو عبد الله", "صدوق", "д", "قال أَبُو عَبد الله: أرجو أن يكون صدوقا إن شاء الله.", "تهذيب الكمال", "3722", "16387", "163898", 1], ["يحيى بن معين", "ضعيف", "ж", "سمعت يحيى بْن مَعِين يقول: هوذة عَنْ عوف ضعيف.", "تهذيب الكمال", "3722", "16387", "163908", 1]], "6727": [["يحيى بن معين", "ثقة", "д", "قال إسحاق بْن مَنْصُور (٣)، عَنْ يحيى بْن مَعِين: ثقة. و", "تهذيب الكمال", "3722", "16407", "7838", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6720": [["يحيى بن معين، وأبو حاتم، والنسائي", "ثقة", "д", "قال أبو بكر الأثرم، عَن أحمد بْن حنبل، وإسحاق بْن مَنْصُور عَنْ يحيى بْن مَعِين، وأبو حاتم، والنَّسَائي: ثقة، زاد أحمد: صالح الحديث، مقارب الحديث (٤) .", "تهذيب الكمال", "3722", 4154, "45538", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد اللَّهِ العجلي: ثقة ثبت من أصحاب إبراهيم، وكان مع قتيبة بْن مسلم بخراسان، وكان إبراهيم يقول له: اتق الله، لا تقتل مع قتيبة. ويُقال: إن ا", "تهذيب الكمال", "3722", 4154, "45538", 1], ["الدارقطني", "متروك", "ж", "قال الدارقطني في الضعفاء: بشر بن حسين أصبهاني متروك، عن الزبير بن عدي بواطيل، وله عنه نسخة موضوعة، قال: والزبير ثقة\" (الترجمة ١٢٦) . (٢) جاء في حاشية النسخة تعل", "تهذيب الكمال", "3722", 4154, "45538", 1]], "6724": [["النسائي (٢)، وأبو حاتم", "منكر الحديث", "ж", "وَقَال النَّسَائي (٢)، وأَبُو حاتم (٣): منكر الحديث. زاد النَّسَائي: ليس بثقة. وذكر له أَبُو أحمد بْن عدي أحاديث، ثم", "تهذيب الكمال", "3722", 13125, "163878", 1], ["إسناد ضعيف\" روى له ابن ماجه حديثا واحدا", "ضعيف", "ж", "قال إسناد ضعيف\" روى له ابن ماجه حديثا واحدا فِي فضل الطواف فِي المطر. ولهم شيخ آخر ي", "تهذيب الكمال", "3722", 13126, "163888", 1], ["ابن حجر العسقلاني", "متروك", "ж", "متروك", "تقريب التهذيب", "8609", "", "", 0]], "6728": [["يحيى بن معين", "ثقة", "д", "قال أَبُو بكر بْن أَبي خيثمة (١)، عَن يَحْيَى بْن مَعِين: ثقة مأمون.", "تهذيب الكمال", "3722", 7657, "109198", 1], ["العجلي", "ثبت", "д", "وَقَال العجلي (٢): كان يسكن البصرة في دار كبيرة، وإنما معه أخته، وكانت عجوزا كبيرة، كان أصحاب الحديث إذا أرادوا أن يغيظوه قالوا: أختك قدرية، فيقول: لا والله إلا", "تهذيب الكمال", "3722", 11605, "148678", 1], ["عبد الرحمن (١) بن أبي حاتم", "ثقة", "д", "وَقَال عَبْد الرَّحْمَنِ (١) بْن أَبي حَاتِم: سَأَلتُ أَبِي عنه، فَقَالَ: ثقة صدوق.", "تهذيب الكمال", "3722", 11605, "148678", 1], ["ابن حجر العسقلاني", "متروك", "ж", "متروك", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "منكر الحديث", "ж", "قال البخاري منكر الحديث", "الكاشف / سير أعلام النبلاء", "2171", 320, "3208", 1]], "6730": [["النسائي", "ثقة", "д", "قال النَّسَائي (١): ثقة. و", "تهذيب الكمال", "3722", 269, "2698", 1], ["ابن حبان", "متقن", "д", "ذكره ابنُ حِبَّان فِي كتاب \"الثقات\" (٢)، وَقَال: متقن للحديث.", "تهذيب الكمال", "3722", 13116, "163788", 1], ["الجياني", "لا بأس به", "д", "وَقَال الجياني في شيوخ أبي داود: بصري لا بأس به (الورقة ٩٦) ووثقه الذهبي = ٦٦١٢ - ق: هلال بن جبير (١)، ويُقال: ابن جبر، بصري. رَوَى عَن: أنس بن مالك (ق)، عَن ال", "تهذيب الكمال", "3722", 13116, "163788", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "6732": [["أحمد بن حنبل", "ثبت", "д", "قال أَبُو بَكْر الأسدي (١) عَنْ أَحْمَد بْن حنبل: ثبت حافظ.", "تهذيب الكمال", "3722", 11523, "147858", 1], ["أحمد بن حنبل", "ثقة", "д", "وَقَال أَبُو دَاوُدَ (٢) عن أَحْمَد بن حنبل: ثقة، ماكان أحفظه، كان يحفظ حديثه.", "تهذيب الكمال", "3722", 11523, "147858", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال عثمان بْن سَعِيد الدارمي (٣) عَن يحيى بْن مَعِين: ثقة (٤) . وكذلك", "تهذيب الكمال", "3722", 11523, "147858", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6751": [["النسائي", "ثقة", "д", "قال النَّسَائي (١): ثقة.", "تهذيب الكمال", "3722", 269, "2698", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة نبيل", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6748": [["يحيى بن معين", "ضعيف", "ж", "قال عباس الدُّورِيُّ (١)، عَنْ يحيى بْن مَعِين: ضعيف الحديث، ليس بشيءٍ.", "تهذيب الكمال", "3722", "16424", "164268", 1], ["أبو داود", "ليس بشيء", "ж", "وَقَال أَبُو داود (٢): تركوا حديثه، ليس بشيءٍ.", "تهذيب الكمال", "3722", "16424", "164268", 1], ["أبو حاتم", "لا يحتج به", "ж", "وَقَال أبو حاتم (٥): يكتب حديثه، ولا يحتج به.", "تهذيب الكمال", "3722", "16424", "15228", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف روى عنه ابنه خالد منكرات شديدة", "تقريب التهذيب", "8609", 502, "5028", 1], ["الذهبي", "ضعيف", "ж", "ضعيف", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["يحيى بن معين", "ليس بشيء", "ж", "وسألته عن هياج بن بسطام فقال ليس بشيء", "تاريخ الدارمي عن ابن معين", "148", "182", "1828", 1]], "6755": [["يحيى بن معين", "ثقة", "д", "قال عَبَّاس الدُّورِيُّ (٣)، عَنْ يحيى بن مَعِين: الهيثم بن رافع الطاطري بصري، ثقة (٤) . وكذلك", "تهذيب الكمال", "3722", 13172, "164348", 1], ["أبو عبيد", "منكر", "ж", "قال أَبُو عُبَيد: سمعته يقول: روى حديثا منكرا عَنْ عثمان (١) فِي الحكرة (٢) . روى له ابن ماجه حديثا واحدا حديث الحكرة، وقد كتبناه فِي ترجمة فروخ مولى عثمان.", "تهذيب الكمال", "3722", 13173, "164358", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق ربما أخطأ", "تقريب التهذيب", "8609", 9, "310", 1], ["الذهبي", "صدوق", "д", "صدوق أنكروا حديثه في الحكرة", "الكاشف / سير أعلام النبلاء", "2171", 1028, "10298", 1]], "6753": [["أحمد بن سيار المروزي", "ثقة", "д", "قال أَحْمَد بْن سيار المروزي فِي ذكر مشايخ نيسابور: وأَبُو عَبْد اللَّهِ أَحْمَد بْن نصر المقرئ، كَانَ ثقة، أبيض الرأس واللحية، قصيرا أصلع، صاحب سنة، محبا لأهل ", "تهذيب الكمال", "3722", 460, "4608", 1], ["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة\"ولا نظن أنه من أصل النص لعدم وجود إشارة لموضعه من النسخة أولا، ولعدم نقل ابن المهندس أو غيره له ثانيا، ولان المستدركين والمختصرين استدركوه ع", "تهذيب الكمال", "3722", 461, "4618", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "حافظ", "д", "الحافظ", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6756": [["الحسين بن الحسن الرازي", "ثقة", "д", "قال الْحُسَيْن بْن الحسن الرازي (٣): سألت يحيى بْن مَعِين عنه فقال: ثقة.", "تهذيب الكمال", "3722", 5492, "58918", 1], ["ابن شاهين", "ثقة", "д", "ذكره ابن شاهين في \"الثقات\" وَقَال: ثقة (الترجمة ٥٠٧) ووثقه ابن خلفون (إكمال مغلطاي: ٢ / الورقة ١٣٧)، والذهبي، وابن حجر. (٢) مسند أحمد: ٥ / ٦٢. (٣) نفسه. (٤) في ", "تهذيب الكمال", "3722", 5494, "58938", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0]], "6765": [["أبو زرعة", "ثقة", "д", "قال أَبُو زُرْعَة (١): مدني ثقة. و", "تهذيب الكمال", "3722", "16463", "33678", 1], ["ابن حجر العسقلاني", "ثقة", "д", "صحابي ابن صحابي وقيل بل ثقة من الثانية", "تقريب التهذيب", "8609", 504, "5048", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6766": [["يحيى بن معين، وأبو داود (٢)، والنسائي", "ثقة", "д", "قال إسحاق بْن منصور (١) عَن يَحْيَى بْن مَعِين، وأَبُو دَاوُدَ (٢)، والنَّسَائي: ثقة.", "تهذيب الكمال", "3722", "16467", "101818", 1], ["يحيى بن معين", "ثبت", "д", "وَقَال عَبد اللَّهِ بْن شعيب الصابوني، عَن يحيى بن مَعِين: ثبت.", "تهذيب الكمال", "3722", "16467", "164688", 1], ["أبو حاتم", "صدوق", "д", "وَقَال أبو حاتم (٣): صدوق، صَالِح الحَدِيث. و", "تهذيب الكمال", "3722", "16467", "164688", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة ثبت", "تقريب التهذيب", "8609", "", "", 0], ["يحيى بن معين", "ضعيف", "ж", "سألت يحيى عن واصل بن حيان، فقال: كوفي ضعيف الحديث", "سؤالات ابن الجنيد", "12698", "95", "958", 2]], "6773": [["الحافظ ابن حجر تعقيبا على حديث", "حافظ", "д", "وَقَال الحافظ ابن حجر تعقيبا على حديث: \" لا ترجعوا بعدي كفارا\": رويناه في الاول من الكبير من حديث ابن السماك من طريق عفان، عن شعبة، كما", "تهذيب الكمال", "3722", "16478", "164788", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "وَاقد بن عبد الرَّحْمَن بن سعد بن معَاذ يروي عَن جَابر بْن عَبْد الله روى عَنهُ مُحَمَّد بن إِسْحَاق", "الثقات لابن حبان", "5816", "2012", "20128", 1]], "6767": [["يحيى بن معين", "ليس بثقة", "ж", "وَقَال ابن طهمان عَنه: ليس بثقة (سؤالاته، ٢٣)،", "تهذيب الكمال", "3722", 13193, "164558", 1], ["", "ضعيف", "ж", "وَقَال في موضع آخر: ضعيف الحديث (سؤالاته، ٢٤٩)،", "تهذيب الكمال", "3722", 13193, "164558", 1], ["يحيى بن معين", "ليس بشيء", "ж", "وَقَال ابن محرز عَنه: ليس بشيءٍ. قيل لابن مَعِين: أيهما أحب إليك هو أو طلحة بن عَمْرو؟ قال: طلحة لا بأس به، ليس منهما أحدًا أحبه (ابن محرز، الترجمة ٥٥٩) .", "تهذيب الكمال", "3722", 13193, "164558", 1], ["أبو بكر بن أبي شيبة", "ضعيف", "ж", "وَقَال أَبُو بَكْر بْن أَبي شَيْبَة (١): ضعيف.", "تهذيب الكمال", "3722", 13193, "164558", 1], ["أبو زرعة", "ضعيف", "ж", "وَقَال أَبُو زُرْعَة (٢): ضعيف الحديث مثل أشعث بن سوار، وليث بن أَبي سليم، وأشباههما. و", "تهذيب الكمال", "3722", 13193, "164558", 1], ["البخاري (٣)، وأبو حاتم", "منكر الحديث", "ж", "قَال البُخارِيُّ (٣)، وأَبُو حاتم (٤): منكر الحديث.", "تهذيب الكمال", "3722", 5863, "91258", 1], ["النسائي", "متروك", "ж", "وَقَال النَّسَائي (٥): متروك الحديث.", "تهذيب الكمال", "3722", 503, "5038", 1], ["يعقوب", "منكر الحديث", "ж", "قال يعقوب: منكر الحديث ضعيف\" (المعرفة: ٣ / ١٤١) .", "تهذيب الكمال", "3722", 13194, "164568", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "واه", "ж", "واه", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["النسائي", "متروك الحديث", "ж", "بن السائب متروك الحديث", "الضعفاء والمتروكون للنسائي", "10805", "93", "778", 1]], "6775": [["أبيه، وأبو داود", "ثقة", "д", "قال عَبد الله بن أحمد بْن حنبل (٢) عَن أبيه، وأَبُو داود: ثقة. وكذلك", "تهذيب الكمال", "3722", 13204, "164668", 1], ["يحيي", "لا بأس به", "д", "وَقَال ابن طهمان عن يحيي: لا بأس به (سؤالاته، ١٢٦) .", "تهذيب الكمال", "3722", 13205, "164678", 1], ["أبو حاتم", "لا بأس به", "д", "وَقَال أَبُو حَاتِم (١): لا بأس به، ثقة، يحتج بحديثه (٢) . روى له البخاري، ومسلم، وأبو داود، والنَّسَائي.", "تهذيب الكمال", "3722", 13205, "164678", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6777": [["يحيى بن معين", "ثقة", "д", "قال إِسْحَاق بْن منصور (٢)، عَنْ يحيى بْن مَعِين: ثقة (٣) .", "تهذيب الكمال", "3722", 782, "7828", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6780": [["العجلي", "لا بأس به", "д", "قال العجلي (٣): لا بأس به.", "تهذيب الكمال", "3722", "16495", "109898", 1], ["صالح بن محمد البغدادي", "صالح", "д", "وَقَال صالح بْن مُحَمَّد البغدادي: لا يشتغل به ولا بأبيه (٤) . روى له أَبُو داود، وابْن مَاجَهْ حديثا واحدا، وقد كتبناه فِي ترجمة أبيه حرب بن وحشي. _________ (١", "تهذيب الكمال", "3722", "16495", "164958", 0], ["الذهبي", "لين", "ж", "وَقَال الذهبي في \" الكاشف\": لين.", "تهذيب الكمال", "3722", "16495", "36398", 1], ["الذهبي", "لين", "ж", "لين", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6787": [["ابن حبان. (٢) تاريخ بغداد", "وثقه", "д", "قال ابن حبان. (٢) تاريخ بغداد: ١٣ / ٤٨٤. (٣) ووثقه ابن شاهين (ثقاته، الترجمة ١٥١٧)،", "تهذيب الكمال", "3722", "16520", "165208", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في \" الكاشف\": ثقة وبعضهم ضعفه.", "تهذيب الكمال", "3722", "16520", "165208", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق سئ الحفط ورمي بالقدر. (٤) تاريخ البخاري الكبير: ٨ / الترجمة ٢٦٥٦، والجرح والتعديل: ٩ / الترجمة ٢١٥، وثقات ابن حبان: ٧ / ٥٦٥، و", "تهذيب الكمال", "3722", "16520", "165208", 1], ["الحافظ ابن حجر", "حافظ", "д", "قال الحافظ ابن حجر في \"التقريب\": مقبول. من اسمه وفاء ووقاء ووقاص ووقدان", "تهذيب الكمال", "3722", "16520", "", 0]], "6783": [["أبو حاتم", "صدوق", "д", "قال أَبُو حَاتِم (١): صدوق.", "تهذيب الكمال", "3722", 315, "3158", 1], ["أبي داود", "حجة", "д", "وَقَال أبو عُبَيد الأجري (٢)، عَن أبي داود: حجة. و", "تهذيب الكمال", "3722", "", "", 0], ["الترمذي", "ثقة", "д", "وَقَال التِّرْمِذِيّ: ثقة عند أهل الحديث (الجامع: ٥ / ٥٣١) .", "تهذيب الكمال", "3722", "", "", 0], ["أبا زرعة الدمشقي", "صالح", "д", "سمعت أَبَا زرعة الدمشقي يقول: كان صفوان بن صالح ومحمد بن المصفى يسويان الحديث (المجروحين: ١ / ٩٤) .", "تهذيب الكمال", "3722", "", "", 0], ["الغساني", "ثقة", "д", "وَقَال الغساني: ثقة (تسمية شيوخ أبي داود، الورقة ٨٢) . ووثقه مسلمة بن قاسم الاندلسي (تهذيب التهذيب: ٤ / ٤٢٧) .", "تهذيب الكمال", "3722", "", "", 0], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة، وكان يدلس تدليس التسوية. الْمَقْدِسِيُّ، قال: أَنْبَأَنَا أَبُو جَعْفَرٍ الصَّيْدَلانِيُّ، قال: أَخْبَرَنَا أَبُو عَلِيٍّ الحد", "تهذيب الكمال", "3722", 1781, "17818", 2], ["الذهبي", "ليس بشيء", "д", "قال دحيم ليس بشيءي وقال أبو حاتم صالح الحديث", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6782": [["أحمد وقيل له", "ثقة", "д", "سمعت أحمد وقيل له: ورقاء؟ قال: ثقة. صاحب سنة. قيل له: كان مرجئا؟ قال: لا أدري.", "تهذيب الكمال", "3722", "16500", "165028", 1], ["أبو عبد الله", "ضعفه", "ж", "قال أَبُو عبد الله: وهو يصحف فِي غير حرف، وكأن أبا عَبد الله ضعفه فِي التفسير.", "تهذيب الكمال", "3722", "16500", "165028", 1], ["حرب بن إسماعيل", "ثقة", "д", "وَقَال حرب بْن إِسْمَاعِيلَ (٣): قلت لأحمد بْن حنبل: ورقاء أحب إليك فِي \" تفسير\" ابن أَبي نجيح أو شبل؟ قال: كلاهما ثقة، وورقاء أوثقهما إلا أن ورقاء يقولون لم يس", "تهذيب الكمال", "3722", "16500", "165028", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق في حديثه عن منصور لين", "تقريب التهذيب", "8609", 506, "5068", 1], ["الذهبي", "صدوق", "д", "صدوق صالح", "الكاشف / سير أعلام النبلاء", "2171", 296, "2968", 1]], "6786": [["أبيه، وعثمان بن سعيد _________ (١) جاء", "ثقة", "д", "وَقَال عَبد اللَّهِ بْن أَحْمَد بْن حنبل (٤) عَن أَبِيهِ، وعثمان بْن سَعِيد _________ (١) جاء في حاشية نسخة المؤلف بخطه من تعقباته على صاحب\" الكمال\" قوله: كان ف", "تهذيب الكمال", "3722", "16516", "165178", 0], ["أبو حاتم", "ليس به بأس", "д", "وَقَال عَبد الله بْن أحمد (١)، عَن أبيه فِي رواية أخرى: ليس به بأس، كان يرى القدر.", "تهذيب الكمال", "3722", "16516", "165188", 1], ["يحيى بن معين", "لا بأس به", "д", "وَقَال مُحَمَّد بْن عوف الطائي، عن يحيى بْن مَعِين: لا بأس به.", "تهذيب الكمال", "3722", "16516", "165188", 1], ["محمد بن سعد", "ضعيف", "ж", "وَقَال مُحَمَّد بْن سعد (٣): كَانَ ضعيفا فِي الحديث.", "تهذيب الكمال", "3722", "16516", "13178", 1], ["إبراهيم بن يعقوب السعدي الجوزجاني", "واه", "ж", "وَقَال إبراهيم بْن يعقوب السعدي الجوزجاني (٤): واهي الحديث.", "تهذيب الكمال", "3722", "16516", "165188", 1], ["عبد الباقي بن قانع", "ضعيف", "ж", "وَقَال عبد الباقي بن قانع (٧): ضعيف.", "تهذيب الكمال", "3722", "16516", "165188", 1], ["أبو زرعة الدمشقي", "ثقة", "д", "وَقَال أبو زُرْعَة الدمشقي (١): قلت لبعد الرحمن بن إبراهيم: فما تقول فِي أبي معيد حفص بن غيلان؟ قال: ثقة. قلت: فما تقول فِي الوضين بن عطاء؟ قال: ثقة. قلت: فأين ", "تهذيب الكمال", "3722", "16516", "165198", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق سيئ الحفظ ورمي بالقدر", "تقريب التهذيب", "8609", 403, "4038", 3], ["الذهبي", "ثقة", "д", "ثقة وبعضهم ضعفه", "الكاشف / سير أعلام النبلاء", "2171", 1033, "10348", 1]], "6785": [["عبد الله (١) بن أحمد بن حنبل", "ثقة", "д", "قال عَبد اللَّه (١) بْن أَحْمَد بْن حنبل: قلتُ لأبي: أيما أحب إليك أبو إسحاق أو السدي؟ فقال: أبو إسحاق ثقة، ولكن هؤلاء الذين حملوا عنه بأخرة.", "تهذيب الكمال", "3722", 8093, "113558", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال إسحاق بْن مَنْصُور (٢)، عَنْ يحيى بْن مَعِين: ثقة. وكذلك", "تهذيب الكمال", "3722", 914, "9148", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد اللَّهِ العجلي (١): كوفي، تابعي، ثقة، سمع ثمانية وثلاثين من أصحاب النَّبِيُّ ﷺ، والشعبي أكبر منه بسنتين، ولم يسمع أبو إسحاق من علقمة شيئ", "تهذيب الكمال", "3722", 8094, "113568", 1], ["أبو حاتم", "ثقة", "д", "وَقَال أَبُو حاتم (٢): ثقة، وهو أحفظ من أَبِي إسحاق الشيباني، ويشبه الزُّهْرِيّ في كثرة الرواية واتساعه في الرجال.", "تهذيب الكمال", "3722", 8094, "113568", 1], ["إبراهيم بن يعقوب الجوزجاني", "يهم", "ж", "وَقَال إبراهيم بن يعقوب الجوزجاني: وكان قوم من أهل الكوفة لا يحمد الناس مذاهبهم هم رؤوس محدثي الكوفة مثل أبي إسحاق ومنصور والأعمش أما أبو إسحاق فروى عن قوم لا ي", "تهذيب الكمال", "3722", 8095, "113578", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة ثبت من السابعة", "تقريب التهذيب", "8609", 59, "7663", 1], ["الذهبي", "ثقة", "д", "ثقة متقن لكتابه", "الكاشف / سير أعلام النبلاء", "2171", 1033, "10348", 1]], "6790": [["يعقوب بن سفيان", "لا بأس به", "д", "وَقَال يعقوب بن سفيان: كوفي لا بأس به (المعرفة: ٣ / ١٠٨، ٢٣١) .", "تهذيب الكمال", "3722", 13248, "165108", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في \" الكاشف\" تبعا لابن حبان: ثقة.", "تهذيب الكمال", "3722", 13249, "165118", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "وَقاص بن ربيعَة يروي عَن الْمُسْتَوْرد بْن شَدَّاد رَوَى عَنْهُ سُلَيْمَان بْن مُوسَى وَمَكْحُول", "الثقات لابن حبان", "5816", "2013", "20138", 1]], "6789": [["قبيصة بن عقبة", "لا بأس به", "д", "قال قبيصة بن عقبة: حَدَّثَنَا سفيان الثوري عَنْ وقاء بن إياس، وكان لا بأس به.", "تهذيب الكمال", "3722", 13247, "165098", 1], ["أبو حاتم", "ضعفه", "ж", "وَقَال عَبد اللَّهِ بْن أَحْمَد بن حنبل (٢)، عَن أبيه: وقاء بن إياس كذا وكذا، ثم قال: ضعفه يحيى بن سَعِيد.", "تهذيب الكمال", "3722", 13247, "165098", 1], ["عبد الله بن أحمد", "صالح الحديث", "д", "قال عَبد اللَّهِ بْن أَحْمَد في \" العلل\": وسألته عن وهب بن إسماعيل الأسدي، قال: كتبنا عنه أحاديث. فقلت له: ترجو أن يكون صالح الحديث؟ قال: ما أدري. فراجعته، فقال", "تهذيب الكمال", "3722", 13247, "165098", 1], ["أبو بكر بن أبي خيثمة", "ضعفه", "ж", "وَقَال أَبُو بَكْر بْن أَبي خيثمة: سَأَلتُ أَبِي عَنْهُ، فَقَالَ: كذا وكذا، ثم قال: ضعفه يحيى القطان.", "تهذيب الكمال", "3722", 13247, "165098", 1], ["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي: ليس بالقو