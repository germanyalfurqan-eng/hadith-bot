{"5102": [["أحمد بن حنبل", "ثبت", "д", "قال أبو طالب (١)، عَن أحمد بْن حنبل: حماد بن سلمة أثبت الناس في حميد الطويل، سمع منه قديما.", "تهذيب الكمال", "3722", 3277, "34828", 1], ["أحمد بن حنبل", "ثبت", "д", "وَقَال الحسن الميموني، عن أَحْمَد بن حنبل: حماد بن سلمة أثبت في ثابت من معمر.", "تهذيب الكمال", "3722", 3277, "34828", 1], ["حنبل بن إسحاق", "وثقه", "д", "وَقَال حنبل بن إسحاق: قلتُ لأبي عَبد اللَّهِ: وهيب، وحماد بن زيد، وحماد بن سلمة؟ قال: وهيب وهيب كأنه يوثقه، وحماد بن سلمة لا أعلم أحدا أروى في الرد على أهل البد", "تهذيب الكمال", "3722", 3277, "34828", 1], ["حماد بن زيد، وحماد بن سلمة أيهما أحب إليك؟", "يهم", "ж", "سئل عَن حماد بْن زيد، وحماد بْن سلمة أيهما أحب إليك؟ قال: كلاهما. ووصف حماد بن زيد بوقار، وهدي، وعقل.", "تهذيب الكمال", "3722", 3277, "34828", 1], ["أبا عبد الله، وقيل له", "يهم", "ж", "سمعت أبا عَبد اللَّهِ، وقيل له: حماد بن سلمة، وحماد بن زيد إذا اجتمعا في حديث أيوب أيهما أحب إليك؟ قال: ما فيهما إلا ثقة، إلا أن ابن سلمة أقدم سماعا كتب عن أيوب", "تهذيب الكمال", "3722", 3278, "34838", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["الدارقطني", "ثقة", "д", "قلت فالفضل بن عنبسة قال ثقة", "سؤالات الحاكم للدارقطني", "5950", "178", "1788", 1], ["أحمد بن حنبل", "ثقة", "д", "سمعت أبي يقول الفضل بن عنبسة ثقة من كبار أصحاب الحديث ٥٧٢٩ - حدثني أبي قال أخبرنا أبو بدر", "العلل ومعرفة الرجال لعبد الله بن أحمد", "2331", "1543", "15398", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ضعيف", "itqan", "ضعيف", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""]], "5103": [["", "ضعيف", "ж", "وَقَال (١): كَانَ ضعيفا قدريا. و", "تهذيب الكمال", "3722", -1, "171658", 1], ["الربيع بن صبيح عنه، وكان رجلا", "صالح", "д", "سمعت عَبْد الرحمن يحدث عَن الربيع بْن صبيح عنه، وكان رجلا صالحا، وقد روى الناس عنه، وليس بالقوي فِي الحديث.", "تهذيب الكمال", "3722", 13700, "171818", 1], ["أبو داود", "يهم", "ж", "قال أَبُو داود: قاله فيهما جميعا.", "تهذيب الكمال", "3722", 13701, "171828", 1], ["أحمد بن حنبل", "منكر الحديث", "ж", "سمعت أحمد بْن حنبل يقول: لا يكتب حديث يزيد الرقاشي. قُلْتُ لَهُ: فلم ترك حديثه، لهوى كَانَ فيه؟ قال: لا، ولكن كَانَ منكر الحديث.", "تهذيب الكمال", "3722", 13701, "171828", 1], ["يحيى بن معين", "ضعيف", "ж", "وَقَال معاوية بْن صَالِح (٣)، عَنْ يحيى بْن مَعِين: ضعيف.", "تهذيب الكمال", "3722", -1, "5038", 1], ["يحيى بن معين", "صالح", "д", "وَقَال أَبُو بكر بْن أَبي خيثمة (٥)، عَن يحيى بْن مَعِين: رجل صالح وليس حديثه بشيءٍ.", "تهذيب الكمال", "3722", 13702, "171838", 1], ["أبو داود السجستاني", "صالح", "д", "وَقَال أَبُو عُبَيد الآجري (٧): سألت أبا داود عن يزيد الرقاشي، فقال: رجل صالح. و", "تهذيب الكمال", "3722", 13702, "171838", 1], ["ابن حجر العسقلاني", "منكر الحديث", "ж", "منكر الحديث ورمي بالقدر", "تقريب التهذيب", "8609", 372, "3728", 1], ["الذهبي", "ساقط", "ж", "ساقط", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["علي بن المديني", "ثقه", "jarh", "علي بن المديني: الفضل بن العلاء كان من أهل الكوفة، وكان عندنا بالبصرة، وكان ثقة (الترجمة ١", "تهذيب الكمال", "3722", 8869, "121328", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ساقط", "itqan", "ساقط", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "لا شيء", "itqan", "لا شيء", "تهذيب التهذيب", 0, -1, "", "", ""]], "5107": [["أبو حاتم", "صالح", "д", "قال أَبُو حاتم (١): كان شيخا صالحا، ضعيف الحديث، وكان قرابة لابن عُيَيْنَة (٢) . روى له ابن مَاجَهْ حديث عطية عَن أبي سَعِيد في القول إذا خرج من بيته إلى الصلاة", "تهذيب الكمال", "3722", 8885, "121488", 1], ["الذهبي", "ضعفه", "ж", "ضعفه أبو حاتم", "الكاشف / سير أعلام النبلاء", "2171", 189, "1898", 1], ["ابن حجر العسقلاني", "فيه ضعف", "itqan", "فيه ضعف", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن أبي حاتم", "ضعيف", "itqan", "ضعيف الحديث", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ضعيف", "itqan", "ضعيف الحديث", "تهذيب التهذيب", 0, -1, "", "", ""]], "5105": [["العجلي", "ثقة", "д", "وَقَال العجلي: بصري تابعي ثقة، من كبار التابعين، روى عنه الرياحي (ثقاته، الورقة ٦٤)، و", "تهذيب الكمال", "3722", 14925, "184068", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق ربما وهم", "تقريب التهذيب", "8609", 22, "2193", 1], ["", "ثقة", "д", "ابن حبانب بذكره ابن حبان في ?ب الثقات ?بب بتهذيب التهذيب …ا بذكره ابن حبان في كتاب ?ب الثقاتب بتهذيب الكمال …ااا بالدارقطنيب بقال الدارقطني ثقةب بتهذيب التهذيب ", "موسوعة الرواة (джарх)", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : صدوق ربما وهم", "д", "قال في التقريب : صدوق ربما وهم", "sunnah.com", "", "", "", 1], ["الدارقطني", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["زكريا بن يحيى الساجي", "فيه ضعف", "д", "فيه ضعف", "sunnah.com", "", "", "", 1], ["مصنفوا تحرير تقريب التهذيب", "صدوق حسن الحديث ، وهو أقرب إلى التوثيق ، فقد ، وروى عنه جمع وضعفه الساجي وحده", "д", "صدوق حسن الحديث ، وهو أقرب إلى التوثيق ، فقد ، وروى عنه جمع وضعفه الساجي وحده", "sunnah.com", "", "", "", 1]], "5109": [["أبو بكر الخطيب", "صدوق", "д", "وَقَال أَبُو بَكْر الخطيب: كان صدوقا. و", "تهذيب الكمال", "3722", 8890, "121538", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : صدوق", "д", "قال في التقريب : صدوق", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "محله الصدق", "д", "محله الصدق", "sunnah.com", "", "", "", 1], ["الخطيب البغدادي", "صدوق", "д", "صدوق", "sunnah.com", "", "", "", 1]], "5108": [["الذهبي", "مجهول", "ж", "وَقَال الذهبي في \" الميزان\": مجهول (٤ / الترجمة ١٠٤١١)،", "تهذيب الكمال", "3722", 14718, "181998", 1], ["ابن حجر", "واه", "ж", "وَقَال ابن حجر في \"التقريب\": مقبول. (٢) التِّرْمِذِيّ (٢٥٠٨) . هكذا قال، وهو خطأ. رواه منجاب بْن الحارث عن علي ابن مُسْهِرٍ، عَنِ الْفَضْلِ بْنِ يَزِيدَ، عَن أَ", "تهذيب الكمال", "3722", 14718, "181998", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابو زرعه", "ثقه", "jarh", "أبو زُرْعَة (١): كوفي ثقة", "تهذيب الكمال", "3722", -1, "121498", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""], ["الذهبي", "صدوق", "itqan", "صدوق", "الكاشف", 0, -1, "", "", ""]], "5106": [["أبو حاتم", "متروك", "ж", "وَقَال عَبد اللَّهِ (٢) بْن أَحْمَد بْن حنبل، عَن أبيه: لا شيء، متروك الحديث.", "تهذيب الكمال", "3722", -1, "", 0], ["يحيى بن معين", "ضعيف", "ж", "وَقَال عَباس الدُّورِيُّ (٣)، وغير واحد، عَنْ يَحْيَى بْن مَعِين: ليس _________ (١) الجرح والتعديل: ٤ / الترجمة ٢٠٩٧، وضعفاء العقيلي، الورقة ٩٨. (٢) العلل: ١ / ", "تهذيب الكمال", "3722", -1, "", 0], ["أبو حاتم", "لين", "ж", "وَقَال أَبُو حاتم (٣): ليس بقوي، لين عندهم. و", "تهذيب الكمال", "3722", -1, "", 0], ["البخاري", "ليس بشيء", "ж", "قَال البُخارِيُّ (٤): ليس بشيءٍ، كان يحيى بن مَعِين سئ الرأي فيه.", "تهذيب الكمال", "3722", -1, "", 0], ["أبو داود", "ضعيف", "ж", "وَقَال أبو داود: ضعيف.", "تهذيب الكمال", "3722", -1, "6038", 1], ["النسائي", "متروك", "ж", "وَقَال النَّسَائي (٥): متروك الحديث.", "تهذيب الكمال", "3722", -1, "5038", 1], ["", "ليس بثقة", "ж", "وَقَال فِي موضع آخر: ليس بثقة. روى له ابن عدي أحاديث، ثم", "تهذيب الكمال", "3722", -1, "", 0], ["(٦)، وطلحة بن عمرو هذا، قد حدث عنه قوم ثقا", "صالح", "д", "قال (٦)، وطلحة بن عَمْرو هذا، قد حدث عنه قوم ثقات، بأحاديث صالحة