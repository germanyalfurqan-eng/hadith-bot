الصدق", "تهذيب التهذيب", 0, -1, "", "", ""]], "5194": [["قدامة ابن محمد المديني، ف", "لا بأس", "д", "سئل أَبُو زُرْعَة عَنْ قدامة ابن مُحَمَّد المديني، فَقَالَ: لا بأس بِهِ. روى له أَبُو أَحْمَد بْن عدي أحاديث عَنْ إِسْمَاعِيل بْن شَيْبَة، ثم", "تهذيب الكمال", "3722", 9178, "124418", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق يخطئ", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ليس به بأس", "д", "قال أبو حاتم ليس به بأس", "الكاشف / سير أعلام النبلاء", "2171", 821, "8228", 1], ["الذهبي", "ليس به بأس", "itqan", "ليس به بأس", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ليس به بأس", "itqan", "ليس به بأس", "تهذيب التهذيب", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "يروى المقلوبات ، لا يجوز الاحتجاج به إذا انفرد", "д", "يروى المقلوبات ، لا يجوز الاحتجاج به إذا انفرد", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : صدوق يخطئ", "д", "قال في التقريب : صدوق يخطئ", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "ليس به بأس", "д", "ليس به بأس", "sunnah.com", "", "", "", 1], ["يحيى بن معين", "لا أعرفه", "д", "لا أعرفه", "sunnah.com", "", "", "", 1], ["أبو زرعة الرازي", "لا بأس به", "д", "لا بأس به", "sunnah.com", "", "", "", 1], ["أبو أحمد بن عدي الجرجاني", "أحاديثه عن إسماعيل بن شيبة غير محفوظة", "д", "أحاديثه عن إسماعيل بن شيبة غير محفوظة", "sunnah.com", "", "", "", 1], ["أبو بكر البيهقي", "ذكره في شعب الإيمان ، وقال : ليس بالقوي", "д", "ذكره في شعب الإيمان ، وقال : ليس بالقوي", "sunnah.com", "", "", "", 1], ["مصنفوا تحرير تقريب التهذيب", "صدوق حسن الحديث ، وقول ابن عدي ، إنما الذنب فيها على إسماعيل", "д", "صدوق حسن الحديث ، وقول ابن عدي ، إنما الذنب فيها على إسماعيل", "sunnah.com", "", "", "", 1]], "5193": [["", "صالح الحديث", "д", "قال (٤): ولَهُ غَيْر ما ذكرت أحاديث حسان غرائب، وهو صالح الحديث، لا بأس بِهِ، لم أر له حديثا منكرا. قيل: إنه مات سنة سبع وسبعين ومئة (٥) . _________ (١) الكامل ", "تهذيب الكمال", "3722", 10901, "141648", 3], ["يعقوب بن سفيان", "ثبت", "д", "وَقَال يعقوب بْن سُفْيَان: ومحمد بن مسلم الطائفي وإن كان سفيان 