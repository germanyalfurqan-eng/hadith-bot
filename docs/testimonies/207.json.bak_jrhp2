{"20723": [["أبي مسهر", "ضعيف", "ж", "وَقَال مُحَمَّد بْن إِسْحَاقَ الصاغاني، عَن أبي مسهر: حَدَّثَنَا هيثم بن حميد وكان ضعيفا. و", "تهذيب الكمال", "3722", 13177, "164408", 1], ["الدارقطني", "ثقة", "д", "وَقَال الدَّارَقُطنِيّ: ثقة. (السنن: ١ / ٣١٩)، وذَكَره ابن شاهين في الثقات.", "تهذيب الكمال", "3722", 13177, "164408", 1], ["ابو حاتم", "صالح", "jarh", "أَبُو حاتم (٢): صالح الحديث", "تهذيب الكمال", "3722", -1, "164538", 1], ["النسايي", "لا باس به", "jarh", "النَّسَائي (١): لا بأس به (٢)", "تهذيب الكمال", "3722", -1, "164588", 1]], "20704": [["", "واه", "ж", "ابن حجرب بقلت تفرد وكيع عن إبراهيم بقوله عن إسحاق بن سعد ورواه يحيى القطان وأبو أحمد الزبيري عن إبراهيم عن سعد بن سمرة عن أبيه عن أبي عبيدة ووقع في رواية أحمد ا", "موسوعة الرواة (джарх)", "", ""]], "20707": [["", "صدوق", "д", "الذهبىب بشيخ مصري صدوقب بتاريخ الإسلام …ا بالشيخ الإمام المحدث الصدوقب بسير أعلام النبلاء …ااا بالقاضي عبد الله بن وليد الظاهريب بوكان قد عدله القاضي عبد الله ب", "موسوعة الرواة (джарх)", "", ""]], "20713": [["", "صدوق", "ж", "ابن أبي حاتم الرازيب بوقال ابن أبي حاتم أيضا روى عنه محمد بن خالد بن عثمة ولم يذكر فيه جرحاب بلسان الميزان …ا بسمعت منه مع أبي وهو صدوقب بالجرح والتعديل لابن أب", "موسوعة الرواة (джарх)", "", ""]], "20720": [["", "مجهول", "ж", "أبو حاتم الرازيب بسمعت أبي يقول ذلك ويقول هو مجهولب بالجرح والتعديل لابن أبي حاتم …ا بمجهولب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "20721": [["", "صدوق", "д", "أبو حاتم الرازيب بثنا عبد الرحمن قال سئل أبي عنه فقال صدوقب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20722": [["", "واه", "ж", "لسان الميزان …ااا بالعقيليب بذكره العقيلي وقال لا يتابع على حديثه ولا يعرف إلا به ثم ساقه من روايته عن مطر الوراق عن عطاء عن جابر ?ب أفطر الحاجم والمحجوم ?بي ور", "موسوعة الرواة (джарх)", "", ""]], "20732": [["", "صدوق", "д", "ابن أبي حاتم الرازيب بكتبت عنه بأصبهان وهو صدوقب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""]], "20737": [["", "مجهول", "ж", "أبو حاتم الرازيب بمجهولب بلسان الميزان …ا بروى عن سنان بن مالك عن علي رضي الله عنه روى عنه أبو مخنف سمعت أبي يقول ذلك وسمعته يقول النضر وسنان مجهولانب بالجرح وا", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "مجهول", "itqan", "مجهول", "الجرح والتعديل", 0, -1, "", "", ""]], "20757": [["", "يخطئ", "ж", "ابن حبانب بوذكره ابن حبان أيضا في الثقات فقال يخطئ ويدلسب بلسان الميزان …ا بوقال ابن حبان لا يجوز أن يحتج به إذا انفردب بلسان الميزان …ا بوقال ابن حبان في الثقا", "موسوعة الرواة (джарх)", "", ""], ["", "يخطئ", "ж", "تعريف أهل التقديس …ا بيخطئ ويدلسب بالثقات …ا بوقال في الضعفاء لا يجوز أن يحتج بهب بتعريف أهل التقديس …ااا بأبو حاتم الرازيب بوقال أبو حاتم هو قليل الحديث وما يح", "موسوعة الرواة (джарх)", "", ""], ["", "يخطئ", "ж", "تعريف أهل التقديس …اااا ب…ن…ب بالتدليسب بوذكره ابن حبان أيضا في الثقات فقال يخطئ ويدلسب بلسان الميزان …ا بيخطئ ويدلسب بالثقات …ا بوقال ابن حبان في الثقات كان يخ", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20760": [["", "ثقة", "д", "يحيى بن معينب بحدثنا عبد الرحمن أنا أبو بكرا بن أبي خيثمة فيما كتب إلي قال سألت يحيى بن معين عن أبي هاشم السنجاري قال اسمه سعدي روى عن ابن عمر بصري ثقةب بالجرح ", "موسوعة الرواة (джарх)", "", ""]], "20762": [["", "مجهول", "ж", "أبو حاتم الرازيب بنا عبد الرحمن قال سألت أبي عنه فقال مغيرة هذا مجهوليب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "20765": [["", "مجهول", "ж", "أبو حاتم الرازيب بمجهولب بلسان الميزان …ا بسألت أبي عنه فقال مجهولب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "20774": [["", "منكر الحديث", "ж", "ابن حبانب بمستقيم الحديث جداب بالثقات …ا بوذكره ابن حبان في الثقات وقال مستقيم الحديثيب بلسان الميزان …ااا بأبو زرعة الرازيب بقال أبو زرعة منكر الحديثب بلسان ال", "موسوعة الرواة (джарх)", "", ""]], "20782": [["", "ثقة", "д", "يحيى بن معينب بحدثنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال الحكم بن الخزرج ثقةب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "الحكم بن الْخَزْرَج يروي عَن جدته عَن أَبِي مُوسَى روى عَنهُ حجاج بن الْمنْهَال ومُوسَى بن إِسْمَاعِيل", "الثقات لابن حبان", "5816", "2299", "22998", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20783": [["", "وثقه", "д", "ابن يونس المصريب بوثقه ابن يونسب بتاريخ الإسلام …ا بوثقه أبو سعيد بن يونسب بسير أعلام النبلاء …ااا بالذهبىب بالشيخب بسير أعلام النبلاء …ا بوكان صاحب حديثب بسير ", "موسوعة الرواة (джарх)", "", ""]], "20786": [["", "صدوق", "д", "أبو حاتم الرازيب بسئل أبي عنه فقال صدوقب بالجرح والتعديل لابن أبي حاتم …ااا بالفسويب بمن شيوخ يعقوب بن سفياني ذكره في ?ب تاريخه ?ب وقال كان ثقة إلا أنهم كانوا ي", "موسوعة الرواة (джарх)", "", ""]], "20792": [["", "مجهول", "ж", "الحسينيب بمجهولب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بابن حجرب بقلت قد بينت وجه الصواب فيه في ترجمة العلاء بن رافعب بتعجيل المنفعة بزوائد رجال الأئمة", "موسوعة الرواة (джарх)", "", ""]], "20797": [["", "مجهول", "ж", "أبو حاتم الرازيب بروى عن عبد الله بن فروخ مولى عائشة روى عنه حماد بن عبد الرحمن الكلبي من أهل قنسريني سمعت أبي يقول ذلك وسألته عنه فقال هو مجهول وعبد الله بن فر", "موسوعة الرواة (джарх)", "", ""]], "20781": [["أبو حاتم الرازي", "مجهول", "ж", "مجهول ليس بالقوي", "الجرح والتعديل", "2170", "1012", "10128", 1], ["ابن أبي حاتم", "ليس بالقوي", "itqan", "ليس بالقوي", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20731": [["أبو حاتم الرازي", "شيخ", "д", "وسألته عنه فقال: هو شيخ مثل الواقدي في لين الحديث وكثرة عجائبه", "الجرح والتعديل", "2170", "1675", "16768", 1], ["ابن أبي حاتم", "لين", "itqan", "لين الحديث", "الجرح والتعديل", 0, -1, "", "", ""]], "20763": [["ابن حبان", "ذ