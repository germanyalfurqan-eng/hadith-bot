 الرحمن ابن وهب.", "تهذيب الكمال", "3722", 15121, "186028", 2], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["", "مجهول", "ж", "ابن حجرب بلم يسم لا هو ولا أبوهب بتهذيب التهذيب …ا بمجهولب بتقريب التهذيب …اااان", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "ذكره في التاريخ الكبير وقال : عن عبد الله بن سلام ، روى عنه عبد الملك بن عمير", "д", "ذكره في التاريخ الكبير وقال : عن عبد الله بن سلام ، روى عنه عبد الملك بن عمير", "sunnah.com", "", "", "", 1]], "153": [["يحيى بن معين", "ثقة", "д", "قال إسحاق بْن منصور (٢)، عَن يحيى بْن مَعِين: ثقة. وكذلك", "تهذيب الكمال", "3722", -1, "7828", 1], ["أبو زرعة", "صالح", "д", "وَقَال أَبُو زُرْعَة (٣): صالح.", "تهذيب الكمال", "3722", -1, "12988", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد اللَّهِ العجلي (٤): ثقة صاحب سنة. كان إذا هدأت العيون وقف في البحر ركبتيه يذكر الله حتى يصبح، قال: نذكر الله مع حيتان البحر ودوابه حتى ن", "تهذيب الكمال", "3722", 3105, "33108", 1], ["أبو حاتم", "إمام", "д", "وَقَال عَبد اللَّهِ بْن أَحْمَد بْن حنبل، عَن أبيه: مات الحكم بن أبان سنة أربع وخمسين ومئة، وهو ابن أربع وثمانين سنة، وقدم عكرمة اليمن سنة مئة (٢) . روى له البخ", "تهذيب الكمال", "3722", 3106, "33118", 1], ["ابن خلفون", "وثقه", "д", "ذكره ابن خلفون في \"الثقات\" وَقَال: وثقه ابن نمير وأبو جعفر السبتي وعلي ابن المديني وأحمد بن حنبل. وخرج الحاكم والطوسي حديثه في صحيحهما، وخرج له ابن خزيمة حديث: ", "تهذيب الكمال", "3722", 3106, "33118", 1], ["ابن حبان", "ضعيف", "ж", "وَقَال ابن حبان في \"الثقات\": الحكم بن أبان المدني، سكن اليمن، روى عنه يزيد بْن أَبي زياد، وربما أخطأ، وإنما وقعت المناكير في روايته من رواية ابنه ابراهيم بن الح", "تهذيب الكمال", "3722", 3106, "33118", 1], ["العقيلي", "لا بأس", "д", "وَقَال العقيلي في حديث طاووس عن ابن عباس: رفعه في الركن الأسود لولا أنجاس الجاهلية لاستشفي به من كل عاهة\"لا يتابع عليه إلا بأسًانيد فيها لين.", "تهذيب الكمال", "3722", 3106, "33118", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر: صدوق عابد وله أوهام. وذكر ابن سعد وفاته سنة ١٥٤ أيضا", "تهذيب الكمال", "3722", 3106, "33118", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0]], "145": [["العجلي", "ثقة", "д", "وَقَال العجلي: مصري تابعي ثقة (ثقاته، الورقة ٤٤) .", "تهذيب الكمال", "3722", 8820, "120838", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في (التقريب): صدوق. (٣) ضبب عليها المؤلف لورودها هكذا وكتب في الحاشية: يتامى وهي كذلك، يتامى، عند أبي داود. عَلَى كُلِّ شَيْءٍ قَدِيرٌ) .", "تهذيب الكمال", "3722", 8820, "120838", 1], ["عياش", "واه", "ж", "قال عياش: هما ابنتا عم رَسُول اللَّهِ ﷺ. كذا في الأصل (عياش بْن عَبَّاس) وهو خطأ والصواب عياش ابن عقبة. رواه (١) عَنْ أَحْمَد بْن صالح عَنِ ابْن وهب، فوقع لنا ب", "تهذيب الكمال", "3722", 8821, "120848", 1], ["احمد بن حنبل", "لين", "jarh", "عَبد الله بْن أحمد بْن حنبل (١) ، عَن أبيه: قدم علينا يونس الصدوق مرة وكان يتتبع الشيوخ فأ", "تهذيب الكمال", "3722", 15167, "186488", 1]], "156": [["يحيى بن معين", "ثقة", "д", "قال عَبَّاس الدُّورِيُّ، عَنْ يحيى بْن مَعِين: ثقة، وليس بأخي سُلَيْمان بْن يسار.", "تهذيب الكمال", "3722", 1702, "17038", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة (٢) . روى له الجماعة. _________ (١) بكسر النون بعدها الياء خفيفة، كما في \"التقريب\"وغيره. (٢) ووثقه ابن شاهين، وابن حبان، والذهبي، وابن حج", "تهذيب الكمال", "3722", -1, "", 0], ["الحافظ ابن ناصر الدين", "حافظ", "д", "وَقَال الحافظ ابن ناصر الدين في توضيحه: وقيل: بصرة - بضم أوله مع الاهمال - وقيل: بسرة - بالضم أيضا مع سكون السين المهملة - وقيل: نضلة - بنون ومعجمة - واختلف في ", "تهذيب الكمال", "3722", 1703, "17048", 1]], "100": [["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة صالح", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["العجلي", "ثقة", "д", "دني تابعي ثقة رجل صالح", "معرفة الثقات للعجلي", "5825", "26", "1696", 1], ["الذهبي", "ثقة", "itqan", "ثقة صالح", "الكاشف", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة", "д