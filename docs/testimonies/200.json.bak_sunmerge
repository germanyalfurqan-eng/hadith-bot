{"20062": [["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد الله العجلي (٣): مدني، تابعي، ثقة.", "تهذيب الكمال", "3722", 14304, "177858", 1]], "20016": [["الترمذي بعد أن أخرجه", "واه", "ж", "وَقَال التِّرْمِذِيّ بعد أن أخرجه: هكذا روى عَبْد الرحمن بْن أَبي الموال هذا الحديث عَنْ عُبَيد اللَّهِ بْن عَبْد الرحمن بْن موهب عَنِ عُمَرة عَنْ عَائِشَةَ عَن", "تهذيب الكمال", "3722", 1938, "19398", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال عَباس الدُّورِيُّ، عَن يحيى بْن مَعِين: ثور بْن يزيد ثقة (١) .", "تهذيب الكمال", "3722", 1940, "19418", 1], ["أبو حاتم", "صدوق", "д", "وَقَال أبو حاتم: صدوق حافظ (٣) .", "تهذيب الكمال", "3722", 1940, "19418", 1], ["أبو أحمد بن عدي", "صالح", "д", "وَقَال أَبُو أَحْمَد بْن عدي: ولثور غير ما ذكرت أحاديث صالحة، وقد روى عنه الثوري، وابن عُيَيْنَة، ويحيى القطان، _________ (١) وكذا", "تهذيب الكمال", "3722", 1940, "19418", 3], ["", "حافظ", "ж", "محمد بن إسحاق ابن مندهب بقرأت بخط الحافظ أبي عبد الله بن منده اسمه وقال منكر الحديثب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "20000": [["", "إمام", "д", "البخاريب بوكان البخاري يتبجح بهب بسير أعلام النبلاء …ا بقال السليماني روى عنه شيوخناي قال وكان البخاري يتبجح بهب بتاريخ الإسلام …ااا بالذهبىب بوكان موصوفا بالشج", "موسوعة الرواة (джарх)", "", ""]], "20002": [["", "كذاب", "ж", "ابن حبانب بربما خالف وأخطأ وكان على القضاء بهايب بالثقات …ااا بابن حجرب بربما خالف وأخطأ وكان على القضاء بهاي ذكره ابن حبان في الثقات هكذاب بلسان الميزان …ااا ب", "موسوعة الرواة (джарх)", "", ""]], "20003": [["", "مجهول", "ж", "أبو حاتم الرازيب بسمع منه نصر بن علي سمعت أبي يقول هو مجهولب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "ثقة", "itqan", "ثقة", "التاريخ الكبير", 0, -1, "", "", ""]], "20009": [["", "ضعفه", "ж", "الأزديب بضعفه الأزديب بلسان الميزان …ااا بالبزارب بقال البزار لا نعرف عنه راويا سوى أبي عاصمب بلسان الميزان …ااا بالذهبىب بوهو مقل بل لا يعرف إلا بما رواه البزا", "موسوعة الرواة (джарх)", "", ""]], "20014": [["", "منكر الحديث", "ж", "الأزديب بقال الأزدي منكر الحديثب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "20015": [["", "صالح", "д", "محمد بن محمود ابن النجار البغداديب بقال ابن النجار كان صالحا متدينا على طريقة السلفب بسير أعلام النبلاء …ا بقال ابن النجار كان عبد الواحد شيخا صالحا على طريقة ا", "موسوعة الرواة (джарх)", "", ""]], "20023": [["", "واه", "ж", "أبو زرعة الرازيب بنا عبد الرحمن قال سئل أبو زرعة عنه فلم يعرفه وذكر له حديثا رواه عن هشام ابن حسان فقال هو باطلب بالجرح والتعديل لابن أبي حاتم …ااا بالعقيليب بق", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "واه", "itqan", "واه", "الجرح والتعديل", 0, -1, "", "", ""]], "20027": [["", "مجهول", "ж", "ابن حبانب بوفي ثقات ابن حبان ذكره وزاد روى عنه سعيد بن مسلمب بلسان الميزان …ااا بأبو حاتم الرازيب بمجهولب بلسان الميزان …ا بسمع ابن عمري روى عنه سعيد بن مسلمي س", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "عبيد اللَّه بن سَالم يروي عَن بْن عمر روى عَنْهُ سَعِيد بْن مُسلم", "الثقات لابن حبان", "5816", "1586", "15868", 1], ["ابن أبي حاتم", "مجهول", "itqan", "مجهول", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20033": [["", "واه", "ж", "ابن حبانب بقال ابن حبان في الثقات عبد الملك بن عبد الرحمن بن خالد بن أسيد القرشي من أهل مكة يروي عن أمه عن عائشة روى عنه ابن جريجيب بلسان الميزان …ااا بالعقيليب", "موسوعة الرواة (джарх)", "", ""], ["ابن حجر العسقلاني", "منكر الحديث", "itqan", "منكر الحديث", "تهذيب التهذيب", 0, -1, "", "", ""]], "20037": [["", "صالح", "д", "أبو سعد السمعانيب بقال السمعاني كان صالحا معمرا أديبا فاضلاب بسير أعلام النبلاء …ا بقال السمعاني كان شيخا صالحا معمرا أديبا فاضلاب بتاريخ الإسلام …ااا بالذهبىب ", "موسوعة الرواة (джарх)", "", ""]], "20051": [["", "صدوق", "д", "أبو حاتم الرازيب بسئل أبي عنه فقال صدوقا بصري ثقةب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "20056": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …ا بأبو بكر الخطيب ووثقهب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "ثقة", "itqan", "ثقة", "التاريخ الكبير", 0, -1, "", "", ""]], "20057": [["", "واه", "д", "البزارب بله عن سليمان عن حيان مولى أبي الدرداء عن أبي الدرداء مرفوعا ?ب إذا فاخرت ففاخر بقريشي ي ي ?بي الحديثي رواه البزار في مسنده وقال العباس ليس به بأس وبكر ", "موسوعة الرواة (джарх)", "", ""]], "20063": [["", "منكر الحديث", "ж", "ابن حبانب بقال ابن حبان منكر الحديث جداب بلسان الميزان …ااا بابن أبي حاتم الرازيب بقال أبو محمد روى عنه محمد بن عرعرة السامي والد إبراهيم ابن محمد بن عرعرةيب با", "موسوعة الرواة (джарх)", "", ""]], "20065": [["", "لين", "ж", "يحيى بن معينب بأشار ابن معين إلى لين فيه بقوله لم يكن البائس ممن يكذبب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "كان يكذب", "itqan", "كان يكذب", "التاريخ الكبير", 0, -1, "", "", ""]], "20077": [["", "ضعفه", "ж", "أبو حاتم الرازيب بضعفه أبو حاتمب بلسان الميزان …ااا بأبو زرعة الرازيب بحدثنا عبد الرحمن قال سئل أبو زرعة عنه ? فقال أي شيء تصنع به … يضعفهب بالجرح والتعديل لابن", "موسوعة الرواة (джарх)", "", ""]], "20086": [["", "لا بأس به", "д", "أبو زرعة الرازيب بحدثنا عبد الرحمن قال سألت أبا زرعة عنه فقال لا بأس بهب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "20073": [["ابن حبان", "ذكره في الثقات", "д", "حُصَيْن بْن حدير يروي عَن عمر أَنه قَالَ لَا قطع فِي عذق وَلَا فِي عَام سنة يعْنى مجاعَة روى عَنهُ حسان بْن زَاهِر وَيحيى بْن أبي كثير", "الثقات لابن حبان", "5816", "1274", "12748", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20055": [["ابن حبان", "ذكره في الثقات", "д", "رَجَاء بن الْحَارِث يروي عَن على روى عَنهُ حزن بْن بشير", "الثقات لابن حبان", "5816", "1355", "13558", 1], ["ابن حبان", "ذكره في الثقات", "д", "رَجَاء بن الْحَارِث يروي عَن مُجَاهِد روى عَنهُ الْفضل بن مُوسَى السينَانِي", "الثقات لابن حبان", "5816", "2417", "24178", 1], ["ابن أبي حاتم", "ضعيف", "itqan", "ضعيف", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20075": [["ابن حبان", "ذكره في الثقات", "д", "حميد بن أبي الصعبة يروي عَنْ عَبْدِ اللَّهِ بْنِ زرير الغافقي عَن عَليّ روى عَنهُ عمَارَة بن غزيَّة وَأهل مصر", "الثقات لابن حبان", "5816", "2305", "23058", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20079": [["ابن حبان", "ذكره في الثقات", "д", "حسان بن زَاهِر يروي عَن عبد الله بن الصَّامِت وحصين بن حدير روى عَنهُ يحيى بْن أَبِي كثير", "الثقات لابن حبان", "5816", "2335", "23358", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20098": [["ابن حبان", "ذكره في الثقات", "д", "طَلْحَة بن النَّضر يروي عَن بن سِيرِين روى عَنهُ بن الْمُبَارك", "الثقات لابن حبان", "5816", "2601", "26018", 1], ["أبو داود السجستاني", "ثقة", "д", "سألت أبا داود عن طلحة بن النضر١ قال: ثقة روى عنه ابن المبارك٢", "سؤالات الآجري لأبي داود", "11236", "339", "3398", 2], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20078": [["ابن حبان", "ذكره في الثقات", "д", "عبد الله بن مساحق يروي عَنِ الْحِجَازِيِّينَ روى عَنْهُ رَاشد بْن سعد", "الثقات لابن حبان", "5816", "2653", "26538", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20030": [["ابن حبان", "ذكره في الثقات", "д", "عبد الْملك بْن رَاشد يروي عَنْ أَبِيه روى عَنهُ مُحَمَّد بْن إِسْحَاق", "الثقات لابن حبان", "5816", "2710", "27108", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20036": [["ابن حبان", "ذكره في الثقات", "д", "عَبْد الْملك بْن عَبْد اللَّه بْن جَابر يروي عَنْ أبي جَعْفَر مُحَمَّد بن عَليّ روى عَنهُ إِسْمَاعِيل بْن أَبِي خَالِد", "الثقات لابن حبان", "5816", "2710", "27108", 1]], "20044": [["ابن حبان", "ذكره في الثقات", "д", "عبد الْملك بْن فارغ يروي عَنْ بِلَال بْن عَبْد اللَّهِ روى عَنْهُ عرَاك بْن مَالك من حَدِيث المصريين", "الثقات لابن حبان", "5816", "2714", "27148", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "20004