{"15102": [["", "ثقة", "д", "يحيى بن معينب بنا عبد الرحمن قال ذكره أبي عن إسحاق بن منصور عن يحيى بن معين أنه قال مجاهد بن رومي ثقةب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "مُجَاهِد بْن رومي يروي عَنْ عَطاء روى عَنهُ سُفْيَان الثَّوْريّ", "الثقات لابن حبان", "5816", "3106", "31068", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "15137": [["", "ثبت", "д", "ابن حبانب بله صحبةب بالثقات …ااا بابن حجرب بوأسلم أبو سفيان في الفتح لقي النبي ? صلى الله عليه وسلم ? وهو متوجه إلى مكة فأسلم شهد حنينا فكان ممن ثبت مع النبي ? ", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""]], "15182": [["", "واه", "ж", "ابن حبانب بقال ابن حبان يقال إن له صحبةب بالإصابة في تمييز الصحابة …ا بيقال إن له صحبةب بالثقات …ااا بابن أبي حاتم الرازيب بفيما رواه شباب العصفري خليفة بن خياط", "موسوعة الرواة (джарх)", "", ""]], "15192": [["", "واه", "ж", "أبو حاتم الرازيب بله صحبة مديني فيما رواه محمد بن سليمان المسمولي عن القاسم بن مخول عن أبيه سمعت أبي يقول ذلكب بالجرح والتعديل لابن أبي حاتم …ااا بابن حبانب بله", "موسوعة الرواة (джарх)", "", ""]], "15163": [["البخاري", "لا يتابع عليه", "д", "لا يتابع عليه", "التاريخ الكبير للبخاري", "113", "2408", "11958", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات ، وقال : من قال يزيد بن جارية فقد وهم", "д", "ذكره في الثقات ، وقال : من قال يزيد بن جارية فقد وهم", "sunnah.com", "", "", "", 1], ["الذهبي", "يقال : إن له صحبة", "д", "يقال : إن له صحبة", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "يقال له صحبة", "д", "يقال له صحبة", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "شيخ مجهول", "д", "شيخ مجهول", "sunnah.com", "", "", "", 1], ["أحمد بن شعيب النسائي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["المزي", "يقال : إن له صحبة", "д", "يقال : إن له صحبة", "sunnah.com", "", "", "", 1], ["أبو نعي