ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2358": [["الحافظ أبو بكر الخطيب", "حافظ", "д", "قال الحافظ أَبُو بَكْر الخطيب (٢): سكن بغداد، وحدث بها عَنْ مَالِك بْن أَنَس، وفي أحاديثه نكرة، ويُقال: إنه قلبت عليه صحيفة ورقاء عَن أَبِي الزناد، فرواها عَنْ ", "تهذيب الكمال", "3722", "5190", "51918", 1], ["أبي", "واه", "ж", "سمعت أَبِي يَقُول: كتبت عَنِ الزنبري أحاديث عَنْ مَالِك من أخبار الناس، ولو كَانَ رواها عَن أَبِيهِ،", "تهذيب الكمال", "3722", "5190", "51928", 1], ["أبي", "ضعفه", "ж", "قال أَبِي: ولقد حسبت سنه، فإذا هُوَ قد كَانَ رجلا، وكان أبوه أجود الناس منزلة من مَالِك، وضعفه.", "تهذيب الكمال", "3722", "5190", "51928", 1], ["أبو بكر الخطيب", "واه", "ж", "قال أَبُو بَكْر الخطيب (٣): قوله: لو كَانَ رواها عَن أَبِيهِ يَعْنِي: كَانَ ذَلِكَ أقرب لحاله، واحتملت روايته لها، فلما رواها عَنْ مَالِك استعظم علي ذَلِكَ واست", "تهذيب الكمال", "3722", "5190", "51928", 1], ["إبراهيم بن عبد الله بن الجنيد", "ثقة", "д", "وَقَال إِبْرَاهِيم بْن عَبد اللَّهِ بْن الجنيد (١): سألت يَحْيَى بْن مَعِين عَنِ الزنبري، فَقَالَ: ما كَانَ عندي بثقة.", "تهذيب الكمال", "3722", "5190", "51938", 1], ["أبو بكر الأثرم", "واه", "ж", "وَقَال أَبُو بَكْر الأثرم (٢): ذكرت لأبي عَبد اللَّهِ أَحْمَد بْن حَنْبَل هِشَام بْن عُرْوَة، فَقَالَ: ما كَانَ أروى أبا أُسَامَة عنه! روى حديث وقف الزُّبَيْر ع", "تهذيب الكمال", "3722", "5190", "51938", 1], ["ابن حجر العسقلاني", "صدوق", "ж", "صدوق له مناكير عن مالك ويقال اختلط عليه بعض حديثه وكذبه عبد الله بن نافع في دعواه أنه سمع من لفظ مالك", "تقريب التهذيب", "8609", 161, "1618", 3], ["الذهبي", "ضعفه", "ж", "ضعفه أبو زرعة", "الكاشف / سير أعلام النبلاء", "2171", 425, "4258", 1]], "2362": [["البزار", "ليس بالقوي", "ж", "وَقَال البزار: ليس بالقوي\" (كشف الاستار، حديث ١٥٥٢ و٢٣٣١) .", "تهذيب الكمال", "3722", 4801, "52008", 1], ["يعقوب بن سفيان", "ضعيف", "ж", "وَقَال يعقوب بْن سفيان: ضعيف\" (المعرفة: ٢ / ٦٦٠) .", "تهذيب الكمال", "3722", 4802, "52018", 1], ["الدارقطني", "متروك", "ж", "وَقَال الدَّارَقُطْنِيُّ في كتاب الضعفاء والمتروكين: متروك\" (الترجمة ٢٧٢)،", "تهذيب الكمال", "3722", 4802, "52018", 1], ["", "ضعيف", "ж", "وَقَال في السنن: ضعيف\" (١ / ٢٤٤) . وضعفه العقيلي، وابن الجوزي، والذهبي، وابن حجر. وهو غير سَعِيد بن زربي أبي عاصم العباداني الراوي عن مجاهد، روى عنه القاسم بن م", "تهذيب الكمال", "3722", 4802, "52018", 1], ["أبو حاتم", "مجهول", "ж", "قال أَبُو حاتم (١): مجهول. و", "تهذيب الكمال", "3722", 531, "5318", 1], ["أبو حاتم", "مجهول", "ж", "وَقَال عَن أبيه: مجهول (٤ / الترجمة ٩٦) ثم ذكر الذي روى عنه مرزوق أَبُو عَبْد اللَّهِ الشامي وسكت عنه دلالة على معرفته به (٤ / الترجمة ٣٢٨)، لذا لا يصح نقل المز", "تهذيب الكمال", "3722", 4803, "52028", 1], ["ذلك", "ثبت", "д", "قال ذلك في الذي أخرج له التِّرْمِذِيّ، اللهم إلا أن يكونا واحدًا، وهو أمر لم يثبت، ولو ثبت لصرح به البخاري، وأبو حاتم، والله أعلم. (٣) المعجم الكبير: ٢ / ١٠٢ حد", "تهذيب الكمال", "3722", 4803, "52028", 1], ["", "مجهول", "ж", "ابن حبانب بوذكره ابن حبان في ? الثقات ?ب بتهذيب التهذيب …ا بوذكره ابن حبان في كتاب ?ب الثقات ?بب بتهذيب الكمال …ااا بالذهبىب بوثقب بالكاشف في معرفة من له رواية ", "موسوعة الرواة (джарх)", "", ""]], "2359": [["النسائي", "ثقة", "д", "قال النَّسَائي (١): ثقة، مأمون، ثبت (٢) .", "تهذيب الكمال", "3722", 8233, "114958", 1], ["ابن حجر العسقلاني", "وثقه", "ж", "وثقه النسائي", "تقريب التهذيب", "8609", 29, "3242", 1], ["ابن حبان", "ذكره في الثقات", "д", "سعيد بن ذُؤَيْب من أهل نسا يروي عَن أبي ضَمرَة وَابْن عُيَيْنَة حَدَّثنا عَنهُ الْحسن بن سُفْيَان وَهُوَ جد أبي الْحسن أَحْمد بن مُحَمَّد بن سعيد بن ذ", "الثقات لابن حبان", "5816", "3548", "35488", 1]], "2363": [["أبي عمير بن النحاس، ف", "ثقة", "д", "سئل يحيى بْن مَعِين عَن أبي عُمَير بْن النحاس، فَقَالَ: ثقة من أحفظ الناس لحديث ضمرة.", "تهذيب الكمال", "3722", 8642, "119048", 1], ["أبو زرعة", "ثقة", "д", "وَقَال أَبُو زُرْعَة (٣): كان ثقة رضى.", "تهذيب الكمال", "3722", 8642, "119048", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي (١): ثقة.", "تهذيب الكمال", "3722", 315, "3158", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق لم يكن بالحافظ", "تقريب التهذيب", "8609", 161, "1618", 1], ["الذهبي", "صدوق", "д", "قال البخاري صدوق وقال أبو حاتم ليس بذاك", "الكاشف / سير أعلام النبلاء", "2171", 427, "4278", 1]], "2367": [["أبو حاتم", "ليس به بأس", "д", "قال عَبد اللَّهِ بْن أَحْمَد بْن حنبل (١)، عَن أبيه: ليس به بأس، وكان يَحْيَى بْن سَعِيد لا يستمرئه.", "تهذيب الكمال", "3722", "5214", "52168", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال عَباس الدُّورِيُّ (٣)، عَنْ يحيى بْن مَعِين: ثقة.", "تهذيب الكمال", "3722", "5214", "7598", 1], ["أبي داود", "ليس بشيء", "ж", "وَقَال أَبُو عُبَيد الأجري (٤)، عَن أَبِي دَاوُد: كَانَ يَحْيَى بْن سَعِيد يَقُول: ليس بشيءٍ، وكان عَبْد الرَّحْمَنِ يحدث عنه. و", "تهذيب الكمال", "3722", "5214", "52168", 1], ["البخاري", "صدوق", "д", "قَال البُخارِيُّ (٥): حَدَّثَنَا (٦) مسلم قال: حَدَّثَنَا سَعِيد بْن زَيْد أَبُو الْحَسَن صدوق، حافظ.", "تهذيب الكمال", "3722", "5214", "52168", 1], ["إبراهيم بن يعقوب الجوزجاني", "حجة", "д", "وَقَال إِبْرَاهِيم بْن يَعْقُوب الجوزجاني (٧): يضعفون حديثه، وليس بحجة. _________ (١) الجرح والتعديل: ٤ / الترجمة ٨٧، والكامل: ٢ / الورقة ٤١. (٢) المصدران الساب", "تهذيب الكمال", "3722", "5214", "52168", 2], ["أبو حاتم والنسائي", "ليس بالقوي", "ж", "وَقَال أَبُو حاتم والنَّسَائي: ليس بالقوي.", "تهذيب الكمال", "3722", "5214", "52178", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق له أوهام", "تقريب التهذيب", "8609", 3, "38", 1], ["الذهبي", "ليس بالقوي", "ж", "قال جماعة ليس بالقوي ووثقه ابن معيني", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2368": [["العجلي", "ثقة", "д", "ذكره العجلي في \"الثقات\" وَقَال: مدني تابعي ثقة (ثقاته، الورقة ٣٦) .", "تهذيب الكمال", "3722", 6513, "97758", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["يحيى بن معين", "ثقة", "д", "حيى بن معين عن سعيد بن زيد بن عقبة فقال ثقة", "تاريخ الدارمي عن ابن معين", "148", "75", "758", 1]], "2369": [["علي بن الحسين بن الجنيد", "ضعيف", "ж", "قال عبد الرحمن بْن أَبي حَاتِم (٢)، عَنْ علي بن الحسين بن الجنيد: ضعيف الحديث.", "تهذي