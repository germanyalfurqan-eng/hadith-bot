 "صالح", "д", "ابن حبانب بذكره ابن حبان في ? الثقات ?يب بتهذيب التهذيب …ا بذكره ابن حبان في كتاب ?ب الثقات ?بب بتهذيب الكمال …ااا بابن حجرب بمقبولب بتقريب التهذيب …ااا بالذهبى", "موسوعة الرواة (джарх)", "", ""]], "2396": [["يحيى بن معين", "يهم", "ж", "ذكره يحيى بْن مَعِين فِي تابعي أهل المدينة، ومحدثيهم. و", "تهذيب الكمال", "3722", "", "", 0], ["الدارقطني", "لا بأس به", "д", "قال الدارقطني (٤): لا بأس به. و", "تهذيب الكمال", "3722", 456, "4568", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2332": [["يحيى بن معين", "ثبت", "д", "وَقَال أَبُو بكر بْن أَبي خيثمة (١)، عَن يحيى بن مَعِين: أثبت الناس فِي قتادة: سَعِيد بْن أَبي عَرُوبَة، وهشام الدستوائي، وشعبة، فمن حدثك من هؤلاء الثلاثة بحديث", "تهذيب الكمال", "3722", 4925, "53248", 1], ["أبو حاتم", "ثقة", "д", "وَقَال عبد الرحمن بْن أَبي حاتم (٥)، عَن أبيه: سَعِيد بْن أَبي عَرُوبَة قبل أن يختلط ثقة، وكان أعلم الناس، بحديث قتادة", "تهذيب الكمال", "3722", 4925, "53248", 1], ["سعيد أحفظ، وأثبت أصحاب قتادة هشام وسعيد.", "ثبت", "д", "قَالَ سَعِيد أحفظ، وأثبت أصحاب قتادة هشام وسَعِيد.", "تهذيب الكمال", "3722", 4925, "53248", 1], ["دحيم", "اختلط", "ж", "وَقَال أَبُو زُرْعَة الدمشقي، عَنْ دحيم: إن سَعِيد بْن أَبي عَرُوبَة اختلط، فخرج إبراهيم سنة خمس وأربعين ومئة (٧) _________ (١) الجرح والتعديل: ٤ / الترجمة ٢٧٦.", "تهذيب الكمال", "3722", 4924, "53238", 2], ["يحيى بن معين", "اختلط", "ж", "سمعت يحيى بْن مَعِين يقول: سَعِيد بْن أَبي عَرُوبَة اختلط بعد هزيمة إِبْرَاهِيم بْن عَبد اللَّهِ بْن حسن بن حسن فمن سمع منه سنة اثنتين وأربعين فهو صحيح السماع، ", "تهذيب الكمال", "3722", 4926, "53258", 1], ["صالحا\"الخندقي", "صالح", "д", "سمعت صالحا\"الخندقي، قال:", "تهذيب الكمال", "3722", 4926, "53258", 1], ["أبو نعيم", "اختلط", "ж", "وَقَال أَبُو نعيم (١): كتبت عنه بعدما اختلط حديثين", "تهذيب الكمال", "3722", 4927, "53268", 1], ["سعيد بن عمرو البرذعي", "لا بأس به", "д", "وَقَال سَعِيد بْن عَمْرو البرذعي (٢): قلتُ لأبي زرعة: يحيى بْن سلام المغربي؟ فقا ل: لا بأس به، ربما وهم،", "تهذيب الكمال", "3722", 4927, "53268", 1], ["ابن حبان", "اختلط", "ж", "وَقَال ابن حبان: وكان قد اختلط سنة خمس وأربعين ومئة وهي خمس سنين في اختلاطه (كذا", "تهذيب الكمال", "3722", 4927, "53268", 1], ["لانه ذكر وفاته سنة ١٥٠) وأحب أن لا يحتج به", "لا يحتج به", "ж", "قال لانه ذكر وفاته سنة ١٥٠) وأحب أن لا يحتج به إلا ربما روى عنه القدماء قبل اختلاطه\" (الثقات: ١ / الورقة ١٦٠) . (١) تاريخ البخاري الكبير: ٣ / الترجمة ١٦٧٩، والك", "تهذيب الكمال", "3722", 4927, "53268", 1], ["البزار", "مأمون", "д", "وَقَال البزار: يحدث عن جماعة لم يسمع منهم، فإذا قال: سمعت\"و\"حَدَّثَنَا\"كان مأمونا على ما قال.", "تهذيب الكمال", "3722", 4928, "53278", 1], ["ابن سعد", "ثقة", "д", "وَقَال ابن سعد في طبقاته: كان ثقة كثير الحديث ثم اختلط في آخر عُمَره.", "تهذيب الكمال", "3722", 4928, "53278", 1], ["ابن عدي", "حجة", "д", "وَقَال ابن عدي في نهاية ترجمته من\"الكامل\": وسَعِيد بن أَبي عَرُوبَة من ثقات الناس، وله أصناف كثيرة، وقد حدث عنه الأئمة، ومن سمع منه قبل الاختلاط فإن ذلك صحيح حج", "تهذيب الكمال", "3722", 4928, "53278", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة حافظ له تصانيف ? لكنه كثير التدليس واختلط وكان من أثبت الناس في قتادة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثبت", "д", "أحد الأعلام قال أحمد كان يحفظ لم يكن له كتاب وقال ابن معين هو من أثبتهم في قتادة وقال أبو حاتم هو قبل أن يختلط ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2333": [["أبو زرعة", "ثقة", "д", "قال أَبُو زُرْعَة (٣): ثقة. و", "تهذيب الكمال", "3722", 796, "7968", 1], ["ابن حجر العسقلاني", "وثقه", "ж", "وثقه أبو زرعة", "تقريب التهذيب", "8609", 166, "1668", 1]], "2336": [["محمد بن سعد", "صالح", "д", "وَقَال مُحَمَّد بن سعد (٢): دعوتهم فِي بني الابجر، وهو خدرة بْن عوف لمحالفة سَمُرَة بْن جندب إياهم. توفي فِي أول خلافة هشام بْن عَبد المَلِك، وله أحاديث صالحة (", "تهذيب الكمال", "3722", "5414", "54158", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة مشهور", "الكاشف / سير أعلام النبلاء", "2171", 437, "4378", 1], ["", "ثقة", "д", "تقريب التهذيب …ا بثقة", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "سَعِيد بْن أَبِي هِنْد من أهل الْمَدِينَة يَرْوِي عَن أَبِي مُوسَى روى عَنهُ ابْنه عَبْد اللَّه بن سَعِيد", "الثقات لابن حبان", "5816", "1401", "14018", 1]], "2335": [["أبو حاتم", "لا بأس به", "д", "قال أَبُو حاتم (١): لا بأس به. و", "تهذيب الكمال", "3722", 375, "3758", 1], ["غيره", "ثقة", "д", "وَقَال غيره: مات سنة ثلاث وثلاثين. _________ (١) الجرح والتعديل: ٤ / الترجمة ٣٠١. (٢) ١ / الورقة ١٦٣، ووثقة ابن سعد، والعجلي، وابن خزيمة، والدَّارَقُطنِيّ، والب", "تهذيب الكمال", "3722", 5013, "54128", 2], ["الساجي", "صدوق", "д", "وَقَال الساجي: صدوق كان أحمد يقول: ما أدري أي شيء يخلط في الاحاديث.", "تهذيب الكمال", "3722", 5013, "54128", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["العجلي", "ثقة", "д", "أبي هلال ثقة", "معرفة الثقات للعجلي", "5825", "227", "2278", 1]], "2319": [["يعقوب بن شيبة السدوسي", "ثقة", "д", "وَقَال يَعْقُوب بْن شَيْبَة السدوسي: ثقة ثبت.", "تهذيب الكمال", "3722", 13441, "169218", 1], ["النسائي", "ليس بشيء", "ж", "قال النَّسَائي (١): ليس بشيءٍ. و", "تهذيب الكمال", "3722", 12695, "159578", 1], ["النسائي", "ليس بشيء", "ж", "وَقَال النَّسَائي: ليس بشيءٍ (٤ / الترجمة ٩٥٤٩)", "تهذيب الكمال", "3722", 13443, "169238", 1], ["ابن حجر", "لين", "ж", "وَقَال ابن حجر في \"التقريب\": لين الحديث.", "تهذيب الكمال", "3722", 3241, "34458", 1]], "2301": [["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه أحمد", "الكاشف / سير أعلام النبلاء", "2171", 27, "5541", 1]], "2302": [["ابن حجر العسقلاني", "متروك", "ж", "متروك ورماه ابن حبان بالوضع وكان رافضي", "تقريب التهذيب", "8609", 157, "1578", 1], ["الذهبي", "واه", "ж", "شيعي واه ضعفوه", "الكاشف / سير أعلام النبلاء", "2171", 420, "4208", 1], ["أبو داود السجستاني", "ضعيف", "ж", "سئل أبو داود عن سعد بن طريف٤ فقال: ضعيف (**)", "سؤالات الآجري لأبي داود", "11236", "102", "", 0], ["النسائي", "متروك الحديث",