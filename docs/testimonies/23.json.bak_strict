{"2300": [["العجلي", "ثقة", "д", "وَقَال العجلي: مصري تابعي ثقة (الورقة ١٨) .", "تهذيب الكمال", "3722", 4637, "50368", 1], ["الذهبي", "حجة", "д", "وَقَال الذهبي في المجرد: ليس بحجة\" (الورقة ٩)", "تهذيب الكمال", "3722", 4637, "50368", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في التقريب: صدوق له أفراد\"", "تهذيب الكمال", "3722", 4637, "50368", 1]], "2308": [["يحيي بن معين", "ثقة", "д", "قال الدوري عن يحيي بن مَعِين: ثقة (تاريخه: ٢ / ١٩٢ ونقله ابن أَبي حاتم في الجرح والتعديل: ٤ / الترجمة ٣٩٠) .", "تهذيب الكمال", "3722", 4658, "50578", 1], ["مسلم", "ثقة", "д", "وَقَال مسلم في الكنى: ثقة.", "تهذيب الكمال", "3722", 4658, "50578", 1], ["أبو عبيد", "لين", "ж", "قال أَبُو عُبَيد: ثُمَّ شهدت العيد مع عُثْمَان بْن عَفَّان، فصلى بالناس قبل الخطبة فَقَالَ: قد اجتمع لكم فِي يومكم هَذَا عيدان، فمن أحب من أهل العالية أن ينتظر ", "تهذيب الكمال", "3722", 4658, "50578", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "2306": [["يحيى بن معين", "ليس به بأس", "д", "وَقَال إِبْرَاهِيم بْن الجنيد، عن يحيى بْن مَعِين: ليس به بأس، وقد كتبت عنه (١) .", "تهذيب الكمال", "3722", 4656, "50558", 1], ["يعقوب بن شيبة", "ثقة", "д", "وَقَال يَعْقُوب بْن شَيْبَة (٢): ثقة، صدوق، صَالِح.", "تهذيب الكمال", "3722", 4656, "50558", 1], ["صالح بن محمد البغدادي", "لا بأس به", "д", "وَقَال صَالِح بْن مُحَمَّد الْبَغْدَادِيّ (٣): لا بأس به.", "تهذيب الكمال", "3722", 4656, "50558", 1], ["", "يخطئ", "ж", "وَقَال في موضع آخر (٤): عبد الحميد بْن جَعْفَر سيئ الحفظ، ذكر عَنِ الثوري أنه رآه يفتي فِي مسائل ويخطئ فيها، فتكلم فيه الثوري من أجل هَذَا، وابنه سَعْد أثبت منه", "تهذيب الكمال", "3722", 4656, "50558", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في المجرد في رجال ابن ماجة: ثقة (الورقة ١٥) و", "تهذيب الكمال", "3722", 4656, "50558", 1], ["بشار", "صدوق", "д", "قال بشار: هذا كثير والاحسن ما قاله ابن حجر: صدوق له أغاليط\"، فالذهبي لم يبين وجه توثيقه مطلقا.", "تهذيب الكمال", "3722", 4657, "50568", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق له أغاليط", "تقريب التهذيب", "8609", 156, "1568", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2309": [["يحيى بن معين", "ثقة", "д", "قال إِسْحَاق بْن مَنْصُور (٢)، عَنْ يحيى بْن مَعِين: ثقة. وكذلك", "تهذيب الكمال", "3722", 782, "7828", 1], ["ابن سعد", "ثقة", "д", "وَقَال ابن سعد: كان ثقة كثير الحديث\".", "تهذيب الكمال", "3722", 1876, "18768", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي: كوفي تابعي ثقة (الورقة ١٨) .", "تهذيب الكمال", "3722", 4661, "50608", 1], ["يعقوب بن سفيان", "وثقه", "д", "وَقَال يعقوب بْن سفيان: حَدَّثَنَا سُلَيْمان بن حرب، حَدَّثَنَا حماد بن زيد، حَدَّثَنَا عطاء بن السائب، قال: كنا نأتي أبا عبد الرحمن ونحن غلمة أيفاع، فكان يقول:", "تهذيب الكمال", "3722", 4661, "50608", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة ثبت", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2311": [["البخاري", "فيه نظر", "ж", "قَال البُخارِيُّ: فيه نظر (تاريخه الكبير: ٥ / الترجمة ٩٣٣)، وذَكَره ابنُ حِبَّان في \"الثقات\".", "تهذيب الكمال", "3722", "", "", 0], ["الذهبي", "منكر الحديث", "ж", "وَقَال الذهبي في \"الديوان\": منكر الحديث.", "تهذيب الكمال", "3722", 446, "4468", 2], ["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة. و", "تهذيب الكمال", "3722", 269, "2698", 1], ["ابن سعد", "ثبت", "д", "وَقَال ابن سعد: كَانَ كثير الحديث، وليس هو بثبت، ويستضعفون روايته، ولا يحتجون به (طبقاته: ٥ / ٢٦٨) .", "تهذيب الكمال", "3722", "", "", 0], ["العجلي", "ثقة", "д", "وَقَال العجلي: ثقة (تهذيب التهذيب: ٦ / ١٨٤)،", "تهذيب الكمال", "3722", "", "", 0], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. (٤) تاريخ البخاري الكبير: ٥ / الترجمة ٩٣٠، ٩٣٢، وثقات العجلي، الورقة ٣٣، والجرح والتعديل: ٥ / الترجمة ١١٢١، وثقات ابن حبان: ٥ ", "تهذيب الكمال", "3722", 5661, "89238", 3]], "2316": [["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة.", "تهذيب الكمال", "3722", 269, "2698", 1], ["ابن سعد", "ثقة", "д", "وَقَال ابن سعد: قالوا: وكان سعد بن هشام ثقة إن شاء الله\" (الطبقات: ٧ / ٢٠٩) و", "تهذيب الكمال", "3722", 4677, "50768", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "2318": [["", "واه", "ж", "قال (٣) فِي جَرِّ الإِزَارِ فَهُوَ فِي الْقَمِيصِ، وجَرُّ الْقَمِيصِ أَشَدُّ مِنْ جَرِّ الإِزَارِ. رواه (٤) عَنْ هناد بْن السَّرِيّ، عَنِ ابْن الْمُبَارَك، عَن ", "تهذيب الكمال", "3722", "5096", "50968", 1], ["يحيى", "ثقة", "д", "وَقَال عَباس الدُّورِيُّ عَن يحيى: ثقة.", "تهذيب الكمال", "3722", "5096", "50968", 1], ["يحيى", "ليس به بأس", "д", "قال يحيى: وسعدان بن سالم هذا ليس به بأس (تاريخه: ٢ / ١٩٤) . (٢) ضبب عليها المؤلف لما فيها، وكتب في الحاشية: كذا\"، إذ الصواب: ابن عُمَر\"كما هو في سنن أبي داود، و", "تهذيب الكمال", "3722", "5096", "50968", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2338": [["الأنصاري", "يكذب", "ж", "سمعت الأَنْصارِيّ يكذبه. _________ (١) تاريخ بغداد ٩ / ٧٧. (٢) ضبب عليها المؤلف، وسيأتي ما فيها. (٣) هذا الاستدراك للخطيب البغدادي لم يشر إليه المؤلف على غير عا", "تهذيب الكمال", "3722", "", "", 0], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق له أوهام ورمي بالقدر", "تقريب التهذيب", "8609", 159, "1598", 1], ["الذهبي", "ثقة", "д", "ثقة علامة ذو تصانيف", "الكاشف / سير أعلام النبلاء", "2171", 423, "4238", 1]], "2325": [["صالح جزرة", "صالح", "д", "وَقَال صالح جزرة: لا بأس بِهِ.", "تهذيب الكمال", "3722", 10260, "135228", 1], ["ابن قانع", "ثقة", "д", "وَقَال ابن قانع: كان ثقة (٩ / ٢٤٥)", "تهذيب الكمال", "3722", 10260, "135228", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة ثبت وروايته عن ابن عمر مرسلة", "تقريب التهذيب", "8609", 159, "1598", 1], ["الذهبي", "حجة", "д", "حجة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2349": [["يحيى بن معين", "ثقة", "д", "وَقَال إسحاق بْن منصور (١)، وأحمد بْن سعد بْن أَبي مريم (٢) عن يحيى بن مَعِين: حفص بن غياث ثقة", "تهذيب الكمال", "3722", 3075, "32798", 1], ["يحيى بن معين", "يهم", "ж", "سئل يحيى بن مَعِين: أيهما أحفظ ابن إدريس (٤) أو حفص بن غياث؟ فَقَالَ: كان ابن إدريس حافظا وكان حفص بن غياث صاحب حديث له معرفة. فقيل له: فابن فضيل؟ فَقَالَ: كان ", "تهذيب الكمال", "3722", 3075, "32798", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بن عَبد اللَّهِ العجلي (٥): ثقة مأمون فقيه وكان وكيع ربما", "تهذيب الكمال", "3722", 3075, "32798", 1], ["يعقوب بن شيبة", "ثقة", "д", "وَقَال يعقوب بْن شَيْبَة (٦): ثقة ثبت إذا حدث من كتابه، ويتقى بعض حفظه.", "تهذيب الكمال", "3722", 3075, "32798", 1], ["أبو زرعة", "صالح", "д", "وَقَال أَبُو زُرْعَة (٤): ساء حفظه بعد ما استقضي، فمن كتب عنه من كتابه فهو صالح، وإلا فهو كذا.", "تهذيب الكمال", "3722", 3076, "32808", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق تغير في آخر عمره", "تقريب التهذيب", "8609", 160, "1608", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2351": [["أحمد بن حنبل", "ثبت", "д", "وَقَال محمد بن علي الجوزجاني، عن أَحْمَد بْن حنبل: كان شعبة لا يقدم على عَمْرو بن دينار أحدا لا الحكم ولا غيره، يعني في الثبت. قال: وكان عَمْرو بن دينار مولى ول", "تهذيب الكمال", "3722", 7991, "112538", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2354": [["أبو زرعة", "ضعيف", "ж", "قال أَبُو زُرْعَة (١): ضعيف الحديث (٢) .", "تهذيب الكمال", "3722", "5175", "32378", 1], ["أبو حاتم", "منكر الحديث", "ж", "وَقَال أَبُو حاتم (٣): لا أعلم روى عنه غير مُحَمَّد بْن شعيب، ولا يشبه حديثه حديث أهل الصدق، منكر الحديث، وأحاديثه عَنْ أَنَس لا تعرف.", "تهذيب الكمال", "3722", "5175", "51768", 1], ["ابن حجر العسقلاني", "منكر الحديث", "ж", "منكر الحديث", "تقريب التهذيب", "8609", 53, "6759", 1], ["الذهبي", "ضعفه", "ж", "ضعفه أبو زرعة", "الكاشف / سير أعلام النبلاء", "2171", 425, "4258", 1]], "2356": [["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة. و", "تهذيب الكمال", "3722", "5181", "2708", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "2326": [["أحمد بن عبد الله العجلي", "ثقة", "д", "قال أَحْمَد بْن عَبد اللَّهِ العِجْلِيّ (٢): إِسْمَاعِيل بْن أَبي خَالِد ت