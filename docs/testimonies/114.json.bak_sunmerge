{"11412": [["ابن حجر", "ثقة", "д", "قال ابن حجر في \"التقريب\": ثقة. (٢)", "تهذيب الكمال", "3722", -1, "15938", 1]], "11461": [["", "ثقة", "д", "الذهبىب بثقة مكثرب بتاريخ الإسلام …ا بوكان أحد الفقهاءب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "11462": [["", "حافظ", "д", "الذهبىب بالحافظ المحدث الصدوقب بسير أعلام النبلاء …ا بوهو صدوق رحالب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "11464": [["", "لين", "д", "ابن أبي حاتم الرازيب بكتبت عنه بالري قدم علينا وكان ثقة صدوقاب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "11465": [["", "وثقه", "ж", "أبو نعيم الأصبهانيب بوثقه أبو نعيمب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "11466": [["", "وثقه", "д", "الدارقطنيب بوثقه الدارقطني وحدهب بتاريخ الإسلام …ا بحدثني علي بن محمد بن نصر قال سمعت حمزة بن يوسف يقول سألت الدارقطني عن محمد بن عبد العزيز بن محمد بن ربيعة ال", "موسوعة الرواة (джарх)", "", ""]], "11471": [["", "مجهول", "ж", "الذهبىب بمجهول الحالب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "11476": [["", "منكر الحديث", "ж", "أبو بكر الإسماعيليب بوروى عنه الإسماعيلي في معجمه وقال بصري منكر الحديثب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "11478": [["", "لين", "ж", "تعريف أهل التقديس …ااا بالحسين بن إسماعيل المحامليب بثنا ابن سعيد حدثني حسين بن إسماعيل قال كنت يوما ببلد وحميد بن الربيع وهو يملي علينا من كتب وكيع فأملى عن اب", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["البخاري", "كذاب", "itqan", "كذاب", "التاريخ الكبير", 0, -1, "", "", ""]], "11479": [["", "لا بأس به", "д", "أبو نعيم الأصبهانيب بقال أبو نعيم الأصبهاني لا بأس بهيب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "11484": [["", "صدوق", "д", "ابن أبي حاتم الرازيب بكتبنا عنه وهو صدوقب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""]], "11497": [["", "كذاب", "ж", "لسان الميزان …ااا بعبد الله بن أسامة الكلبىب بقال ابن عقدة سمعت عبد الله بن أسامة الكلبي وإبراهيم بن إسحاق الصواف وداود بن يحيى يقولون محمد بن عثمان كذاب وزادنا", "موسوعة الرواة (джарх)", "", ""]], "11496": [["الدارقطني", "ضعيف", "ж", "رقطني عن محمد بن عثمان بن أبي سويد فقال ضعيف", "سؤالات حمزة للدارقطني", "2491", "8", "92", 1]], "11486": [["ابن حبان", "من الصحابة", "itqan", "من الصحابة", "الثقات", 0, -1, "", "", ""]], "11453": [["ابن حجر العسقلاني", "صدوق", "itqan", "صدوق", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "11455": [["البخاري", "امام", "itqan", "إمام", "التاريخ الكبير", 0, -1, "", "", ""]], "11485": [["البخاري", "لين", "itqan", "لين", "التاريخ الكبير", 0, -1, "", "", ""], ["الذهبي", "واه", "itqan", "واه", "تذكرة الحفاظ", 0, -1, "", "", ""]], "11482": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "11450": [["ابن أبي حاتم", "ثقة", "itqan", "ليس بثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ضعيف", "itqan", "ضعيف جدا", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ضعيف", "itqan", "ضعيف", "الطبقات الكبرى", 0, -1, "", "", ""], ["البخاري", "متروك", "itqan", "متروك الحديث", "التاريخ الكبير", 0, -1, "", "", ""]]}