تعديل: ٦ / ا", "تهذيب الكمال", "3722", -1, "", 0], ["يحيى ليس به بأس. قيل", "ليس به بأس", "д", "وَقَال ابن طهمان عَن يحيى ليس به بأس. قيل: يحتج به؟ قال: ليس به بأس (سؤالاته: الترجمة ٢٥٦) .", "تهذيب الكمال", "3722", 7015, "102788", 1], ["ابن معين", "ضعيف", "ж", "وَقَال ابن الجنيد عن ابن مَعِين: كان ضعيفا في القضاء، ضعيفا في الحديث (سؤالاته: الورقة ١٨) . وفي كتاب أبي الْوَلِيد بْن أَبي الجارود، عَنْ يحيى: ضعيف (ضعفاء الع", "تهذيب الكمال", "3722", 7015, "102788", 1], ["أبو زرعة", "لين", "ж", "وَقَال أَبُو زُرْعَة (١): لين.", "تهذيب الكمال", "3722", -1, "11518", 1], ["أبو حاتم", "ضعيف", "ж", "وَقَال أبو حاتم (٢): ضعيف، يكتب حديثه، وأبو نضرة أحب إلي منه.", "تهذيب الكمال", "3722", 7016, "102798", 1], ["النسائي", "ضعيف", "ж", "وَقَال النَّسَائي (٤): ضعيف.", "تهذيب الكمال", "3722", -1, "5248", 1], ["أبو أحمد بن عدي", "ضعفه", "ж", "وَقَال أبو أحمد بن عدي (٥): وقد روى عنه جماعة من الثقات، ولعطية عَن أبي سَعِيد أحاديث عدد، وعن غير أبي سَعِيد وهُوَ مع ضعفه يكتب حديثه، وكان يعد مع شيعة أهل الك", "تهذيب الكمال", "3722", 7016, "102798", 1], ["الدارقطني", "مضطرب", "ж", "وَقَال الدَّارَقُطْنِيُّ: مضطرب الحديث (ال", "تهذيب الكمال", "3722", 7016, "102798", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0]], "4216": [["أبو حاتم", "صالح", "д", "قال صالح بْن أحمد بْن حَنْبَلٍ، عَن أَبِيهِ: لا أعلم إِلاَّ خَيْرًا.", "تهذيب الكمال", "3722", 2567, "25688", 1], ["يحيى بن معين", "ليس بشيء", "ж", "وَقَال عَباس الدُّورِيُّ، عَنْ يحيى بْن مَعِين: ليس بشيءٍ (١) .", "تهذيب الكمال", "3722", -1, "18718", 1], ["النسائي", "ضعيف", "ж", "وَقَال النَّسَائي: ضعيف (٢) .", "تهذيب الكمال", "3722", -1, "5248", 1], ["يحيى", "لا يكتب حديثه", "ж", "وَقَال ابن طهمان، عن يَحْيَى: لا يكتب حديثه، ليس بشيءٍ، ليس بثقة. (٢)", "تهذيب الكمال", "3722", 2567, "25688", 1], ["ابن سعد", "ضعيف", "ж", "وَقَال ابن سعد: كَانَ ضعيفا فِي الْحَدِيث\".", "تهذيب الكمال", "3722", 2567, "25688", 1], ["ابن حبان", "منكر الحديث", "ж", "وَقَال ابن حبان في كتاب المجروحين: منكر الحديث كثير الوهم على قلة روايته