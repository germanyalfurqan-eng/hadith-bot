سايي", "صالح", "jarh", "النَّسَائي (٢): صالح", "تهذيب الكمال", "3722", -1, "97288", 1]], "4207": [["ابن ق", "ثقة", "д", "قال ابن قانه: هو ثقة (٧ / ٤٩)،", "تهذيب الكمال", "3722", -1, "97298", 1], ["", "ثقة", "д", "وَقَال في \"التقريب\": ثقة حافظ. (٤) الكاشف: ٢ / الترجمة ٣٦٣٨، وميزان الاعتدال: ٣ / الترجمة، وتذهيب التهذيب: ٣ / الورقة ٢١، ونهاية السول، الورقة ٢٣١، وتهذيب التهذ", "تهذيب الكمال", "3722", 6472, "97358", 1], ["", "ثقة", "д", "ابن حجرب بمقبولي من الرابعةب بتقريب التهذيب …ااا بالضياء المقدسيب بأخرجه الضياء في ?ب المختارة ?ب ومقتضاه أن يكون عبيد الله عنده ثقةب بتهذيب التهذيب …ااا بالذهب", "موسوعة الرواة (джарх)", "", ""]], "4211": [["أبا مسلم البغدادي الحافظ", "حافظ", "д", "سمعت أبا مسلم البغدادي الحافظ يقول: عُبَيد الله بن موسى من المتروكين تركه أحمد لتشيعه، وقد عوتب أحمد على روايته عن عبد الرزاق فذكر: أن عبد الرزاق رجع،", "تهذيب الكمال", "3722", 6482, "97458", 1], ["ابن قانع كوفي صالح يتشيع. (٧ / ٥٣)", "صالح", "д", "وَقَال ابن قانع كوفي صالح يتشيع. (٧ / ٥٣)", "تهذيب الكمال", "3722", 6482, "97458", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة كان يتشيع.", "تهذيب الكمال", "3722", 6482, "97458", 1], ["يحيى بن معين", "ثقة", "д", "قال إسحاق بْن منصور (١)، عَن يحيى بْن مَعِين: ثقة.", "تهذيب الكمال", "3722", -1, "7838", 1], ["أبو حاتم", "لا بأس به", "д", "وَقَال أَبُو حاتم (٢): لا بأس به (٣) . روى له أَبُو داود حديثا واحدا عَن أَبِيهِ، عَنْ أَنَس. • عُبَيد اللَّه بْن أَبي نهيك. ويُقال: عَبد اللَّهِ تقدم .", "تهذيب الكمال", "3722", 6483, "97468", 1], ["ابن حجر العسقلاني", "لا بأس به", "д", "لا بأس به", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه ابن معين", "الكاشف / سير أعلام النبلاء", "2171", 27, "5541", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4208": [[