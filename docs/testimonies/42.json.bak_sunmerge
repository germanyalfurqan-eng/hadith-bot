لقطان: مجهول الحال (١١ / ١٣١) .", "تهذيب الكمال", "3722", 13290, "165538", 1], ["الذهبي", "وثقه", "д", "وَقَال الذهبي في \" الميزان\": ما رأيت من وثقه غير ابن حبان\" (٤ / الترجمة ٩٣٥٨)", "تهذيب الكمال", "3722", 13292, "165558", 1], ["ابن حجر", "لين", "ж", "وَقَال ابن حجر في \"التقريب\" لين الحديث (٣) علل أحمد: ١ / ٤٤، وتاريخ البخاري الكبير: ٨ / الترجمة ٢٤٨٨، والجرح والتعديل: ٩ / الترجمة ٥، وثقات ابن حبان: ٥ / ٤٩٤ و٧", "تهذيب الكمال", "3722", 13292, "165558", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "4273": [["ابن سعد", "ثقة", "д", "وَقَال ابن سعد: وكان ثقة (طبقاته: ٦ / ٤١٠) .", "تهذيب الكمال", "3722", 6666, "99298", 1], ["", "ثقة", "д", "ابن حجرب بمقبولي من كبار العاشرةب بتقريب التهذيب …ااا بالفسويب بذكره محمد بن سعد في الطبقة الثامنة من أهل الكوفة وقال روى عن شريك وغيره وكان ثقةي وكذا قاله يعقو", "موسوعة الرواة (джарх)", "", ""]], "4270": [["أبو زرعة الدمشقي", "ثقة", "д", "وَقَال أَبُو زُرْعَة الدمشقي (١): قُلْت لابن مسهر: ما تقول في ابن علاق؟ قال: كَانَ ثقة، من طلبة العلم، ونسبه لنا، فَقَالَ: عُثْمَان بْن حصن بْن عُبَيدة بْن علاق", "تهذيب الكمال", "3722", 6664, "99278", 1], ["أبو زرعة الرازي", "لا بأس به", "д", "وَقَال أَبُو زُرْعَة الرازي (٢): لا بأس به.", "تهذيب الكمال", "3722", -1, "93558", 1], ["أبو داود (٣) ثقة. و", "ثقة", "д", "وَقَال أَبُو دَاوُدَ (٣) ثقة. و", "تهذيب الكمال", "3722", -1, "99208", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه أبو داود", "الكاشف / سير أعلام النبلاء", "2171", 28, "5601", 1]], "4269": [["", "ثقة", "д", "وَقَال في ختن الشعبي: عَنْ إِسْحَاقَ بْنِ مَنْصُورٍ، عَنْ يَحْيَى بْن مَعِين إنه قال: عثمان بن الحارث الذي يروي عنه الثوري هو ثقة (الجرح والتعديل: ٦ / الترجمتان", "تهذيب الكمال", "3722", 6661, "99248", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. (٢) تاريخ البخاري الكبير: ٦ / الترجمة ٢٢١٦، وثقات ابن حبان: ٧ / ١٩٢، والكاشف: ٢ / الترجمة ٣٧٣٤، وتذهيب التهذيب: ٣ / الورقة ٢٨،", "تهذيب الكمال", "3722", 6661, "99248", 1], ["أبو زرعة", "ثقة", "д", "قال أَبُو زُرْعَة (١): يماني حميري ثقة.", "تهذيب الكمال", "3722", 6662, "99258", 1], ["أبي يقول ذلك، و", "مجهول", "ж", "سمعت أَبِي يَقُول ذَلِكَ، ويَقُول: لا أدري هو عثمان بن حاضر أم لا. وَقَال: سَأَلتُ أَبِي عنه؟ فقال: هو شيخ مجهول، روى عنه أبو الجنيد (٩ / الترجمة ١٦٥٢) .", "تهذيب الكمال", "3722", 6662, "99258", 1], ["ابن حزم", "مجهول", "ж", "قال ابن حزم في \"المحلى\"أبو حاضر الأزدي مجهول (٧ / ١١٠) .", "تهذيب الكمال", "3722", 6662, "99258", 1], ["", "صدوق", "д", "وَقَال في \"التقريب\": صدوق.", "تهذيب الكمال", "3722", -1, "28778", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه أبو زرعة", "الكاشف / سير أعلام النبلاء", "2171", 252, "2528", 1], ["", "ثقة", "д", "أبو زرعة الرازيب بقال أبو زرعة يماني حميري ثقةيب بتهذيب التهذيب …ا بقيل لأبي زرعة له صحبة ? قال الله أعلم", "موسوعة الرواة (джарх)", "", ""]], "4272": [["أبو حاتم", "متقن", "д", "قال أبو حاتم (١): شيخ ليس بالمتقن.", "تهذيب الكمال", "3722", 6665, "99288", 1], ["يعقوب بن سفيان", "لا بأس به", "д", "وَقَال يعقوب بْن سفيان: سألت ابن بكير عن عقبة بن نافع وناجية بن بكر وعثمان بن الحكم؟ قال: لا بأس بهم هم أهل ورع، وعثمان جذامي وهو أفضلهم. (المعرفة والتاريخ: ١ /", "تهذيب الكمال", "3722", 6665, "99288", 1], ["ابن حجر", "وثقه", "д", "وَقَال ابن حجر في \"التهذيب\": وثقه أَحْمَد بْن صَالِح المِصْرِي (٧ / ١١١) .", "تهذيب الكمال", "3722", 6665, "99288", 1], ["", "صدوق", "д", "وَقَال في \"التقريب\": صدوق له أوهام. روى له أَبُو داود، والنَّسَائي.", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق له أوهامي", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "متقن", "д", "قال أبو حاتم ليس بالمتقن", "الكاشف / سير أعلام النبلاء", "2171", 692, "6938", 1], ["ابن أبي حاتم", "شيخ", "itqan", "شيخ", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقه", "تهذيب التهذيب", 0, -1, "", "", ""]], "4260": [["يحيى بن معين", "ثقة", "д", "قال عَبَّاس الدُّورِيُّ (١)، عَنْ يحيى بْن مَعِين: ثقة (١) . و", "تهذيب الكمال", "3722", 6679, "99428", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه ابن معين", "الكاشف / سير أعلام النبلاء", "2171", 27, "5541", 1], ["الدارقطني", "ثقة", "д", "قلت فعثمان بن أبي رواد قال ثقة", "سؤالات الحاكم للدارقطني", "5950", "169", "1698", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""]], "4277": [["", "ثقة", "д", "وَقَال (١): ثقة. _________ = ١٩١ (أحمد الثالث ٢٩١٧ / ٧)، ورجال ابن ماجة، الورقة ١٦، ونهاية السول، الورقة ٣٤١، والعقد الثمين: ٢ / ٢٩٥، وتهذيب التهذيب: ٩ / ٣٣٦، و", "تهذيب الكمال", "3722", -1, "", 0], ["صالح بن محمد الأسدي", "صالح", "д", "وَقَال صالح بْن مُحَمَّد الأسدي: ثقة، صدوق، إلا أنه يروي عَن أَبِيهِ المناكير، قيل: ما حاله؟ قال: لا نعرفه، لم أسمع أحدا يحدث عنه غير سلمة بن شبيب.", "تهذيب الكمال", "3722", 10569, "138328", 1], ["مات بمكة", "يخطئ", "ж", "وَقَال مات بمكة في آخر سنة أربعين، أو أول سنة إحدى وأربعين ومئتين يخطئ ويخالف.", "تهذيب الكمال", "3722", 10569, "138328", 1], ["موسى بن هارون الحافظ", "حافظ", "д", "وَقَال مُوسَى بن هَارُونَ الحافظ: مات سنة إحدى وأربعين ومئتين (٢) . وروى له النَّسَائي في (الخصائص) . ٥٤٥٥ - بخ: مُحَمَّد بن عثمان بن سيار (٣)، ويُقال: ابن ____", "تهذيب الكمال", "3722", 10569, "138328", 3], ["الذهبي", "ثقة", "д", "وَقَال الذهبي: ثقة، له عَن أبيه مناكير. (ديوان الضعفاء، الترجمة ٣٨٦٧) .", "تهذيب الكمال", "3722", 10569, "138328", 1], ["ابن حجر العسقلاني", "متروك", "ж", "متروك الحديث", "تقريب التهذيب", "8609", 18, "1631", 1], ["الذهبي", "ثقة", "д", "قال النسائي ليس ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "4282": [["ابن حجر", "مجهول", "ж", "وَقَال ابن حجر في \" التقريب\": مجهول. (٢) تاريخ البخاري الكبير: ٦ / الترجمة ٢٢٣٨، والجرح والتعديل: ٦ / الترجمة ٨٣٩، وثقات ابن حبان: ٧ / ١٩٦، والكاشف: ٢ / الترجمة", "تهذيب الكمال", "3722", 6686, "99498", 1], ["ابن حبان", "ذكره في الثقات", "д", "عُثْمَان بْن السَّائِب يروي عَنْ أَبِيه روى عَنهُ بن جريج", "الثقات لابن حبان", "5816", "2803", "28038", 1], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "4281": [["أبو حاتم", "صدوق", "д", "قال أَبُو حاتم (٢): صَالِح الحَدِيث، صدوق. و", "تهذيب الكمال", "3722", 6685, "99488", 1], ["محمد بن عبد الله الحضرمي", "ثقة", "д", "وَقَال مُحَمَّد بْن عَبد اللَّهِ الحضرمي: مَاتَ فِي ربيع الآخر سنة ثماني عشرة ومئتين وكَانَ ثقة (٤) . روى له التِّرْمِذِيّ حَدِيثا، والنَّسَائي آخر.", "تهذيب الكمال", "3722", 6685, "99488", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "قال أبو حاتم صدوق", "الكاشف / سير أعلام النبلاء", "2171", 204, "2048", 1]], "4278": [["يحيى بن معين", "ثقة", "д", "قال إسحاق بْن منصور (٢)، عَن يحيى بْن مَعِين: ثقة.", "تهذيب الكمال", "3722", -1, "7828", 1], ["أبو حاتم", "منكر الحديث", "ж", "وَقَال أَبُو حاتم (٤): منكر الحديث، يكتب حديثه.", "تهذيب الكمال", "3722", -1, "7328", 2], ["مغلطاي", "ثقة", "д", "وَقَال مغلطاي: ونقل المزي وفاته من عند الواقدي وأغفل منها ما هو أهم من الوفاة، والذي عندي أنه لم ينقله من أصل إنما نقله تقليدا، بيانه ما ذكر محمد بن سعد عن شيخه", "تهذيب الكمال", "3722", -1, "", 0], ["الواقدي", "ثقة", "д", "وَقَال ابن سعد، عن الواقدي: وكان ثقة قليل الحديث ... \" (تهذيب: ٣ / ٢٦٠) .", "تهذيب الكمال", "3722", -1, "", 0], ["ابن سعد من غير عزو هو من كلام شيخه، و", "فيه نظر", "ж", "ذكره ابن سعد من غير عزو هو من كلام شيخه، وفيه نظر، لما نعرفه من تعدد مصادر ابن سعد، فضلا عن أنه تحميل للنص بما ليس فيه، وهذا سببه الركون إلى نقل الآخرين من غير ", "تهذيب الكمال", "3722", -1, "", 0], ["ابن أبي حاتم", "منكر الحديث", "itqan", "منكر الحديث", "الجرح والتعديل", 0, -1, "", "", ""]], "4283": [["أبو زرعة", "لين", "ж", "وَقَال أَبُو زُرْعَة (٦): لين.", "تهذيب الكمال", "3722", -1, "11518", 1], ["عنه عبد الله الدورقي، ومعاوية بن صالح.",