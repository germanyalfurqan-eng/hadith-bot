{"8402": [["", "مجهول", "ж", "ابن حبانب بوذكره ابن حبان في ?ب الثقات ?ب وقال يروي عن علي روى عنه أهل الكوفةب بلسان الميزان …ااا بأبو حاتم الرازيب بمجهولب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "8404": [["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["", "مجهول", "ж", "ابن حجرب بتابعي أرسل حديثا فذكره بعضهم في الصحابةب بالإصابة في تمييز الصحابة …ا بمجهولب بتقريب التهذيب …اااا ب…ن…ب بالإرسالب بتابعي أرسل حديثا فذكره بعضهم في ال", "موسوعة الرواة (джарх)", "", ""]], "8410": [["", "مجهول", "ж", "لسان الميزان …ا بوذكره ابن حبان في الثقات ولم يزد على ذكر شيخه والراوي عنهب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بعلي ابن المدينيب بوقال علي بن المدين", "موسوعة الرواة (джарх)", "", ""]], "8415": [["", "متروك", "ж", "الدارقطنيب بقال الدارقطني متروكب بلسان الميزان …ا بقال الدارقطني متروكب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "8432": [["", "مجهول", "ж", "ابن حبانب بوذكره ابن حبان في الثقاتيب بلسان الميزان …ااا بأبو حاتم الرازيب بمجهولب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "8434": [["", "ضعيف", "ж", "ابن الجوزيب بقال ابن الجوزي ضعيف", "موسوعة الرواة (джарх)", "", ""], ["", "ضعيف", "ж", "لسان الميزان …ااا بالجوزقانيب بفقرأت بخطه في كتاب الأباطيل للجوزقاني لما ذكر حديثا من طريق أبي عبيدة هذا عن مالك بن سعير عن ثور بن يزيد حدثنا عبد الرحمن بن أبي ", "موسوعة الرواة (джарх)", "", ""]], "8435": [["", "مجهول", "ж", "الحسينيب بمجهولب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "8439": [["", "مجهول", "ж", "ابن حجرب بعن أبيه عن ابن مسعود وعنه أبو حمزة مجهولي قلت الصواب في الرواية عن أبي حمزة واسمه عبد الرحمن عن أبي أخزم كما سأذكر تحقيق ذلك في ترجمة أبي حمزة في الكن", "موسوعة الرواة (джарх)", "", ""]], "8442": [["", "فيه نظر", "ж", "ابن خلفونب بووقع في الثقات لابن خلفون أن أبا عوانة روى عنه وفيه نظر فإنه في المسند من طريق أبي عوانة عن أبي يعفور عن أبي الصلتب بتعجيل المنفعة بزوائد رجال الأئم", "موسوعة الرواة (джарх)", "", ""]], "8445": [["", "مجهول", "ж", "ابن السكنب بقال أبو علي بن السكن مجهولب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "8449": [["", "مجهول", "ж", "الحسينيب بمجهولب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "8455": [["", "صالح", "д", "أبو حاتم الرازيب بحدثنا عبد الرحمن قال سألت أبي عنه فقال شيخ صالح في حديثه صنعةب بالجرح والتعديل لابن أبي حاتم …ااا بأبو زرعة الرازيب بحدثنا عبد الرحمن قال سئل ", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "8464": [["", "مجهول", "ж", "الحسينيب بمجهولب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "8470": [["", "مجهول", "ж", "ابن حبانب بوأما هو فذكره ابن حبان في الثقاتب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بالحسينيب بمجهول عن مثله قاله الحسينيب بتعجيل المنفعة بزوائد رجال ال", "موسوعة الرواة (джарх)", "", ""]], "8478": [["", "وثقه", "ж", "ابن حبانب بوثقه ابن حبانب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "8479": [["", "مجهول", "ж", "تعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بابن حجرب بمجهولب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بالذهبىب بفي الإكمال قال الذهبي لا يعرفب بتعجيل ا", "موسوعة الرواة (джарх)", "", ""]], "8480": [["", "مجهول", "ж", "ابن حجرب بقلت كيف يكون مجهولا من روى عنه جماعة ويأذن أحمد لابنه في الكتابة عنه … فإن عبد الله كان لا يأخذ إلا من يأذن له أبوه في الأخذ عنهب بتعجيل المنفعة بزوائ", "موسوعة الرواة (джарх)", "", ""]], "8481": [["", "مجهول", "ж", "الحسينيب بمجهولب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "8482": [["", "مجهول", "ж", "الحسينيب بمجهول قاله الحسينيب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بالقاسم بن علي ابن عساكرب بقلت نبه ابن عساكر في ترجمة صدقة على أن الصواب أبو هريرة ", "موسوعة الرواة (джарх)", "", ""]], "8483": [["", "مجهول", "ж", "الحسينيب بمجهول قاله الحسينيب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …ااا بأبو أحمد الحاكمب بقلت ذكره الحاكم أبو أحمد تبعا للبخاري فيمن لا يعرف اسمه ولم يذكر", "موسوعة الرواة (джарх)", "", ""]], "8490": [["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0]], "8495": [["", "مجهول", "ж", "الحسينيب بمجهولب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""]], "8407": [["أبو حاتم الرازي", "مجهول", "ж", "مجهول", "الجرح والتعديل", "2170", "4143", "", 0], ["أبو حاتم الرازي", "مجهول", "ж", "فقال: مجهول", "الجرح والتعديل", "2170", "4143", "4888", 1], ["ابن أبي حاتم", "مجهول", "itqan", "مجهول", "الجرح والتعديل", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "8471": [["ابن حبان", "ذكره في الثقات", "д", "أَبُو مطر يروي عَنْ سَالم بْن عَبْد الله روى عَنهُ الْحجَّاج بْن أَرْطَأَة", "الثقات لابن حبان", "5816", "3271", "32718", 1]], "8459": [["النسائي", "ليس بثقة", "ж", "أبو قحذم ليس بثقة", "الضعفاء والمتروكون للنسائي", "10805", "104", "1048", 1]], "8496": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "منكر الحديث", "itqan", "منكر الحديث", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "مجهول", "itqan", "مجهول", "تقريب التهذيب", 0, -1, "", "", ""]]}