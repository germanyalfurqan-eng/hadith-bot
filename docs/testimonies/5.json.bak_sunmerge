{"501": [["أبو زرعة", "لا بأس به", "д", "وَقَال أَبُو زُرْعَة (٢): لا بأس به.", "تهذيب الكمال", "3722", -1, "7058", 1], ["أبو حاتم", "صالح الحديث", "д", "وَقَال أَبُو حاتم (٣): صالح الحديث. و", "تهذيب الكمال", "3722", -1, "5688", 1], ["أبو داود السجستاني", "لا بأس به", "д", "قال أَبُو عُبَيد الآجري (١): سألت أَبَا داود عنه، فقال: لا بأس به، وأخوه أَحْمَد تأخر موته. قلت: مُحَمَّد سنة كم مات؟ قال: مات قبل بقية. و", "تهذيب الكمال", "3722", 9977, "132408", 1], ["الوهبي محمد بن خالد، ف", "ثقة", "д", "سئل يحيى بْن مَعِين وأنا أسمع، عن الوهبي محمد بن خالد، فقال: ثقة (سؤالاته، الورقة ٤١) .", "تهذيب الكمال", "3722", 9977, "132408", 1], ["الدارقطني", "ثقة", "д", "قال الدَّارَقُطنِيّ: ثقة (٩ / ١٤٣) .", "تهذيب الكمال", "3722", 9977, "132408", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["النسايي", "صالح", "jarh", "النَّسَائي: صَالِح", "تهذيب الكمال", "3722", -1, "4578", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "صدوق", "itqan", "صدوق", "تهذيب التهذيب", 0, -1, "", "", ""]], "506": [["لي", "ضعيف", "ж", "قَالَ لي: يا بني وما تصنع بحرملة؟ حرملة ضعيف، ثم أملي علي عن حرملة ثلاثة أحاديث لم يزدني عليها (٣) .", "تهذيب الكمال", "3722", -1, "", 0], ["أحمد بن صالح", "صالح", "д", "سمعت أَحْمَد بْن صالح يقول: صنف ابن _________ (١) وعبد الله بْن مُحَمَّد بْن سيار الفرهاذاني، ذكر ذلك السمعاني في (الفرهاذاني) من الانساب، وابن الاثير في اللباب", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "صدوق", "д", "ابن حجرب بصدوقب بتقريب التهذيب …ااا بالنسائيب بقال النسائي في أسماء شيوخه لا بأس بهب بإكمال تهذيب الكمال …ا بقال النسائي في أسماء شيوخه لا بأس بهب بتهذيب التهذي", "موسوعة الرواة (джарх)", "", ""]], "511": [["مسلمة بن قاسم الاندلسي", "ثقة", "д", "وَقَال مسلمة بن قاسم الاندلسي: ثقة.", "تهذيب الكمال", "3722", 479, "4808", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي في أسماء شيوخه: مصري ثقة.", "تهذيب الكمال", "3722", 479, "4808", 1], ["الحاكم", "يهم", "ж", "ذكره الحاكم في باب من لقيهم البخاري وأخذ عنهم ثم أخذ عن رجل عنهم، وهو رد لقول المزي\"روى له البخاري\"ولم يذكر روايته عنه. ويُقال: إسمه أحمد بن يوسف بن يزيد بن إبر", "تهذيب الكمال", "3722", 479, "4808", 1], ["الذهبي", "ضعفه", "ж", "وَقَال الذهبي في \"الميزان\": ضعفه أبو حاتم، ومشاه غيره. له عن فليح عَن المقبري عَن أبي هُرَيْرة مرفوعا: إنه مر ببقعة بين البقيع والمناصع، فقال: نعم موضع الحمام ه", "تهذيب الكمال", "3722", 479, "4808", 1]], "507": [["يعقوب بن شيبة", "ثقة", "д", "وَقَال يعقوب بْن شَيْبَة: ثقة صحيح الكتاب، وكان من _________ (١) الجرح والتعديل: ٨ / الترجمة ٩٠٥. (٢) منهم عباس الدوري", "تهذيب الكمال", "3722", -1, "144678", 2], ["", "ثقة", "д", "وَقَال في موضع آخر: كان ثقة متثبتا.", "تهذيب الكمال", "3722", 11217, "144808", 1], ["أبو حاتم", "لين", "ж", "وَقَال أَبُو حاتم (٢): كان أَبُو غسان يملي علينا من أصله، وكان (٣) لا يملي حديثا حتى يقرأه، وكان ينحو، ولم أر بالكوفة أتقن من أبي غسان لا أَبُو نعيم ولا غيره، و", "تهذيب الكمال", "3722", 11217, "144808", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة. و", "تهذيب الكمال", "3722", -1, "3158", 1], ["الجوزجاني", "صالح", "д", "وَقَال الجوزجاني: كان حسنيا - أعني الحسن بن صالح - على عبادته وسوء مذهبه. (أحوال الرجال، الترجمة ١١١) .", "تهذيب الكمال", "3722", 11218, "144818", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي: كوفي ثقة وكان متعبدا وكان صحيح الكتاب (ثقاته، الورقة ٤٩)", "تهذيب الكمال", "3722", 11218, "144818", 1], ["يعقوب بن سفيان", "ثقة", "д", "وَقَال يعقوب بن سفيان: ثقة ثقة يميل إلى التشيع (المعرفة والتاريخه: ٣ / ٢٤١)، وذَكَره ابن عدي في \"الكامل \"وَقَال: وأبو غسان هذا مالك لم أذكر له من", "تهذيب الكمال", "3722", 11218, "144818", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""]], "513": [["ابن خلفون", "ثقة", "д", "وَقَال ابن خلفون: هو ثقة\"", "تهذيب الكمال", "3722", -1, "4818", 1], ["ابن حجر العسقلاني", "حافظ", "д", "حافظ ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "حافظ", "д", "كان حافظا جوال", "الكاشف / سير أعلام النبلاء", "2171", 198, "1988", 1]], "515": [["الدارقطني", "متروك", "ж", "وَقَال البرقاني عن الدارقطني: متروك (سؤالاته، الترجمة ٣٢٧) .", "تهذيب الكمال", "3722", 6516, "97798", 1], ["البخاري", "ضعفه", "ж", "قال البخاري: لم يذكر سماعا من أبي ذر، وضعفه الدارقطني (٧ / ٦٥)", "تهذيب الكمال", "3722", 6516, "97798", 1], ["", "لين", "ж", "وَقَال في \"التقريب\": لين. دَاوُدَ الطَّيَالِسِيِّ، قال: حَدَّثَنَا الْمَسْعُودِيُّ، عَن أَبِي عُمَر الشَّامِيِّ، عَنْ عُبَيد بْنِ الْخَشْخَاشِ، عَن أَبِي ذَرٍّ،", "تهذيب الكمال", "3722", -1, "97728", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق ربما وهم", "تقريب التهذيب", "8609", 22, "2193", 1], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن شاهين", "ثقة", "д", "أبو جواب ثقة وهو أحوص بن جواب", "تاريخ أسماء الثقات لابن شاهين", "5818", "20", "1254", 1], ["يحيي بن معين", "ثقه", "jarh", "أبو بكر بْن أَبي خيثمة، عَن يحيى بْن مَعِين: ثقة (١)", "تهذيب الكمال", "3722", -1, "7718", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "صدوق", "itqan", "صدوق", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ليس بذاك", "itqan", "ليس بذاك", "تهذيب التهذيب", 0, -1, "", "", ""]], "516": [["ابن حبان", "متقن", "д", "وَقَال ابن حبان في \"الثقات\": كان متقنا ربما وهم. (الورقة: ٢٢) وانظر تاريخ البخاري الكبير: ١ / ٢ / ٥٨. (٦) ولم ي", "تهذيب الكمال", "3722", 770, "7718", 1], ["يحيى بن سعيد", "ثقة", "д", "سمعت يحيى بْن سَعِيد يقول: كان ثور عندي ثقة.", "تهذيب الكمال", "3722", 772, "7738", 1], ["علي", "صالح", "д", "قال علي (٤): هو عندي أكبر من الأَحوص، والأَحوص صالح. _________ (١) تاريخه الكبير: ١ / ٢ / ٥٨، والكامل لابن عدي عن البخاري بواسطة ابن حماد: ٢ / الورقة ٢١٣. (٢) ا", "تهذيب الكمال", "3722", -1, "7738", 2], ["", "ثقة", "д", "وَقَال في موضع آخر (١): والأَحوص ثقة.", "تهذيب الكمال", "3722", 773, "7748", 1], ["", "لا يكتب حديثه", "ж", "وَقَال في رواية: لا يكتب حديثه (٢) .", "تهذيب الكمال", "3722", 773, "7748", 1], ["إسحاق بن منصور، وإبراهيم بن عبد الله بن ال", "صالح", "д", "وَقَال إسحاق بْن منصور، وإبراهيم بْن عَبد الله بْن الجنيد، ومعاوية بْن صالح، ومحمد بْن عثمان بْن أَبي شَيْبَة، عن يحيى ابن مَعِين (٤): ليس بشيءٍ.", "تهذيب الكمال", "3722", 773, "7748", 1], ["أحمد بن عبد الله العجلي", "لا بأس به", "д", "وَقَال أحمد بْن عَبد الله العجلي (٥): لا بأس به.", "تهذيب الكمال", "3722", -1, "7748", 1], ["يعقوب بن سفيان", "ليس بالقوي", "ж", "وَقَال يعقوب بْن سفيان (٦): كان - زعموا - رجلا، عابدا، مجتهدا، وحديثه ليس بالقوي.", "تهذيب الكمال", "3722", 773, "7748", 1], ["الجوزجاني", "ليس بالقوي", "ж", "وَقَال الجوزجاني (٧): ليس بالقوي في الحديث.", "تهذيب الكمال", "3722", 773, "7748", 1], ["النسائي", "ضعيف", "ж", "وَقَال النَّسَائي (٨): ضعيف. _________ (١) تهذيب ابن عساكر: ٢ /", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف الحفظ", "تقريب التهذيب", "8609", 17, "1493", 1]], "525": [["بشار", "فيه نظر", "ж", "قال بشار: الظاهر أن المزي لم يذكر روايته عن عَبد الله بن بسر لاعتقاده ومعرفته بعدم وجودها وصحتها وإن ذكر ذلك ابن عساكر، ثم أنظر إلى قول ابن حبان في \"مشاهير علما", "تهذيب الكمال", "3722", 795, "7968", 1], ["أبو زرعة", "ثقة", "д", "قال أبو زُرْعَة (١): ثقة. و", "تهذيب الكمال", "3722", -1, "7978", 1], ["محمد بن سعد", "ثقة", "д", "وَقَال مُحَمَّد بْن سعد (٣): كَانَ ثقة قليل الحديث. روى له ابن ماجه حديثا واحدا في ذكر مرض النَّبِيّ ﷺ (٤) . _________ (١) الجرح والتعديل لابن أَبي حاتم: ١ / ١ ", "تهذيب الكمال", "3722", 796, "7978", 0], ["", "وثقه", "д", "ذكره في كتاب\"الضعفاء\"وقد روى عنه أيضا\"أخوه وعَبْد اللَّهِ بْن أَبي السفر. وثقه أبو زُرْعَة وغير واحد\" (الميزان: ١ / ١٧١) . ولم ي", "تهذيب الكمال", "3722", 796, "7978", 1], ["ابن عبد البر", "ثقة", "д", "وَقَال ابن عَبد الْبَرِّ: هو حديث صحيح، وأرقم ثقة جليل، وذكر عَن أبي إسحاق السبيعي، قال: كان أرقم من أشراف الناس وخيارهم، وهذا أورده العقيلي بسن