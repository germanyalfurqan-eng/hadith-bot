اء الله\" (الطبقات: ٧ / ٢ / ٥)، وذَكَره ابنُ حِبَّان في \"الثقات\" وَقَال: مات في ولاية خالد على العراق\" (١ / الورقة: ٢٤) .", "تهذيب الكمال", "3722", 800, "8018", 1], ["", "صالح", "д", "وَقَال في \"مشاهير علماء الامصار: ٩٢\": من صالحي أهل البصرة، مات بها في ولاية خالد بن عَبد الله.", "تهذيب الكمال", "3722", 800, "8018", 1], ["الحاكم أبو عبد الله، قلت، يعني للدارقطني", "ثقة", "д", "قال الحاكم أبو عبد الله، قلت، يعني للدارقطني: فالازرق بن قيس؟ قال: ثقة مأمون\". وخرج ابن خزيمة وابن حبان والحاكم حديثه في \"الصحيح\". و", "تهذيب الكمال", "3722", 800, "8018", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["الدارقطني", "ثقة", "д", "قلت فالأزرق بن قيس قال ثقة مأمون", "سؤالات الحاكم للدارقطني", "5950", "104", "1048", 1], ["النسايي", "ثقه", "jarh", "النَّسَائي: ثقة (١)", "تهذيب الكمال", "3722", -1, "8018", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة مأمون", "itqan", "ثقة مأمون", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""]], "534": [["مسلمة بن قاسم الاندلسي", "ثقة", "д", "وَقَال مسلمة بن قاسم الاندلسي في كتاب\"الصلة: ثقة، روى عنه من أهل بلدنا بقي بن مخلد. وقد أسلفنا أن رواية بقي عنه توثيق له\". وأخذ هذا ابن حجر و", "تهذيب الكمال", "3722", 812, "8138", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["الذهبي", "صدوق", "itqan", "صدوق", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "533": [["أبو زرعة (١)، والنسائي", "لا بأس به", "д", "وَقَال أَبُو زُرْعَة (١)، والنَّسَائي: لا بأس به. و", "تهذيب الكمال", "3722", 12843, "161068", 1], ["يعقوب بن سفيان", "لا بأس به", "д", "وَقَال يعقوب بن سفيان: مديني لا بأس به. (المعرفة والتاريخ: ٣ / ١٠٦) .", "تهذيب الكمال", "3722", 12843, "161068", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في \" الكاشف\": ثقة. (٣ / الترجمة ٥٩٨٥) وكذلك", "تهذيب الكمال", "3722", 12843, "161068", 1], ["أبو حاتم", "صدوق", "д", "وَقَال أَبُو حاتم (١): صدوق.", "تهذيب الكمال", "3722", -1, "3648", 1], ["النسائي", "لا بأس", "д", "وَقَال النَّسَائي (٢): لا بأس بِهِ.", "تهذيب الكمال", "3722", -1, "2178", 1], ["أبو بكر الخطيب", "ثقة", "д", "وَقَال أَبُو بَكْر الخطيب (٣): كان ثقة.", "تهذيب الكمال", "3722", -1, "11708", 1], ["أحمد بن سيار المروزي", "ثقة", "д", "وَقَال أَحْمَد بْن سيار المروزي (٤): كان ثقة صاحب سنة وجماعة ورأيته لا يخضب. مات فِي رجب سنة اثنين وأربعين ومئتين. وكذلك", "تهذيب الكمال", "3722", 12845, "161088", 1], ["مسلمة بن قاسم", "ثقة", "д", "قال مسلمة بن قاسم: ثقة. (١٠ / ٤٨٢) .", "تهذيب الكمال", "3722", 12845, "161088", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة سني. (٩) تاريخ البخاري الكبير: ٨ / الترجمة ٢٣٨١، والجرح والتعديل: ٨ / الترجمة ٢٢٠٥، = رَوَى عَن: داود (د) رجل من ولد عروة بن مس", "تهذيب الكمال", "3722", 12845, "161088", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "حجة", "д", "ليس بالحجة", "الكاشف / سير أعلام النبلاء", "2171", 224, "2248", 1], ["ابن أبي حاتم", "لا يحتج به", "itqan", "لا يحتج به", "الجرح والتعديل", 0, -1, "", "", ""], ["الذهبي", "حجة", "itqan", "حجة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "لا يحتج به", "itqan", "لا يحتج به", "تهذيب التهذيب", 0, -1, "", "", ""]], "531": [["يحى بن معين", "صالح", "д", "قال معاوية بن صالح، عن يحى بْن مَعِين (١): ضعيف. وكذلك", "تهذيب الكمال", "3722", 3115, "33208", 1], ["أبو حاتم", "ليس بالقوي", "ж", "وَقَال أَبُو حاتم (٣): عنده وهم كبير، وليس بالقوي، ومحله الصدق، يكتب حديثه. _________ (١) الكامل لابن عدي: ٢ / الورقة ٢٢. (٢) الضعفاء، له، الترجمة ١٢٦. (٣) الجر", "تهذيب الكمال", "3722", 3115, "33208", 2], ["البخاري", "لا يكتب حديثه", "ж", "قَال البُخارِيُّ في تاريخه الصغير: لا يكتب حديثه. وضعفه ابن سعد،", "تهذيب الكمال", "3722", 3116, "33218", 1], ["أبي داود", "ضعيف", "ж", "وَقَال الآجري عَن أبي داود: ضعيف.", "تهذيب الكمال", "3722", 3116, "33218", 1], ["صالح جزرة", "صالح", "д", "وَقَال صالح جزرة: لا يشتغل به.", "تهذيب الكمال", "3722", -1, "33178", 1], ["الساجي", "صدوق", "д", "وَقَال الساجي: صدوق كثير الوهم، أراه كذابا.", "تهذيب الكمال", "3722", 3116, "33218", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["ابن حجر العسقلاني", "واه", "itqan", "واه", "تهذيب التهذيب", 0, -1, "", "", ""]], "538": [["أبو حاتم", "منكر الحديث", "ж", "وَقَال صَالِح بْن أَحْمَد بْن حنبل، عَن أبيه (٣): منكر الحديث، ضعيف (٤) . _________ (١)", "تهذيب الكمال", "3722", 815, "8168", 0], ["الإمام الذهبي", "إمام", "д", "قال الإمام الذهبي في \"الميزان: ١ / ١٧٤\": وما أظن أن أصبغ أدركه. (٢) وأورد ابن عدي هذه الرواية في \"الكامل: ٢ / الورقة: ١٩٨\"باختلاف يسير، قال: حَدَّثَنَا ابن حماد", "تهذيب الكمال", "3722", 815, "8168", 1], ["أبي", "ثقة", "д", "سمعت أبي يقول: أسامة بن زيد بن أسلم أخشى أن لا يكون ثقة في الحديث. (٣) أوردها عَبد الرَّحْمَنِ بْن أَبي حَاتِم في \"الجرح والتعديل: ١ / ١ / ٢٨٥\"عن صالح، عَن أبيه", "تهذيب الكمال", "3722", 815, "8168", 1], ["يحيى بن معين", "ضعيف", "ж", "وَقَال معاوية بْن صَالِح، عَنْ يحيى بْن مَعِين (٢): أسامة بن زيد بن أسلم ضعيف، وعبد الله بْن زيد بْن أسلم ضعيف، وعبد الرحمن بْن زيد بْن أسلم ضعيف.", "تهذيب الكمال", "3722", 816, "8178", 1], ["الحافظ ابن حجر", "حافظ", "д", "وَقَال الحافظ ابن حجر في \"تهذيب التهذيب: ١ / ٢٠٧\":", "تهذيب الكمال", "3722", 816, "8178", 1], ["يحيى - ليس به بأس\".", "ليس به بأس", "д", "وَقَال عثمان الدارمي عنه، يعني عن يحيى - ليس به بأس\".", "تهذيب الكمال", "3722", 816, "8178", 1], ["بشار", "ضعيف", "ж", "قال بشار: وهو وهم فاحش إنما هذه مقولته في أسامة بن زيد الليثي، وأصل الخبر في تاريخ الدارمي هو: قلت: وأسامة بن زيد الصغير - أعني ابن أسلم -؟ فقال: ضعيف. قال: وسم", "تهذيب الكمال", "3722", 816, "8178", 1], ["يحيى", "ضعيف", "ж", "وَقَال أَبُو بَكْر بْن أَبي خيثمة عَن يحيى (١): ضعيف الحديث.", "تهذيب الكمال", "3722", 817, "8188", 1], ["أبو حاتم", "لا يحتج به", "ж", "وَقَال أبو حاتم (٣): يكتب حديثه ولا يحتج به.", "تهذيب الكمال", "3722", -1, "7068", 1], ["أسامة بن زيد بن أسلم وعبد الله بن زيد بن أ", "يهم", "ж", "سئل أبو زُرْعَة عَن أسامة بْن زيد بْن أسلم وعبد الله بْن زيد بْن أسلم أيهما أحب إليك؟ قال: أسامة أمثل.", "تهذيب الكمال", "3722", 817, "8188", 1], ["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي (٥): ليس بالقوي.", "تهذيب الكمال", "3722", -1, "3268", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف من قبل حفظه", "تقريب التهذيب", "8609", 24, "2500", 1], ["علي بن المديني", "ليس بالقوي", "ж", "أسامه بن زيد بن أسلم فقال هو عندنا ثقه وليس بالقوي وقد أنكر أصحابنا عليه أحاديث وبنو زيد ب", "سؤالات ابن أبي شيبة", "5947", "8", "96", 1], ["النسائي", "ليس بالقوي", "ж", "د بن أسلم ليس بالقوي", "الضعفاء والمتروكون للنسائي", "10805", "9", "98", 1], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ضعفوه", "itqan", "ضعفوه", "الكاشف", 0, -1, "", "", ""]], "543": [["أبو حاتم", "مجهول", "ж", "قال أبو حاتم (٥): مجهول. _________ (١) ووثقه ابن شاهين كما نقلنا، وابن حبان البستي حينما", "تهذيب الكمال", "3722", -1, "8418", 0], ["", "صدوق", "д", "وَقَال في تاريخه الاوسط (كما نقل مغلطاي): صدوق.", "تهذيب الكمال", "3722", 840, "8418", 1], ["مغلطاي", "إمام", "д", "وَقَال مغلطاي: وخرج ابن حبان حديثه في صحيحه، وكذلك أبو عوانة والحاكم. وعاب أبو زُرْعَة على مسلم إخراج حديثه (كما سيأتي في ترجمة الإمام مسلم)، وذَكَره أبو العرب ", "تهذيب الكمال", "3722", 840, "8418", 1], ["", "وثقه", "д", "ذكره في الثقات: وهو عندي في الطبقة الثالثة من المحدثين. وتناوله الذهبي في ميزانه (١ / ١٧٥) وَقَال: وثقه ابن مَعِين، وتوقف أحمد، وضعفه أبو نعيم،", "تهذيب الكمال", "3722", 840, "8418", 1], ["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي: ليس بالقوي\"وساق له مما تفرد به: أسباط، عن السدي، عن صبيح مولى أم سلمة، عن زيد ابن أرقم أن النبي ﷺ", "تهذيب الكمال", "3722", 840, "8418", 1], ["ابن حجر", "إمام", "д", "قال ابن حجر: علق له البخاري حديثًا في الاستسقاء، وقد وصله الإمام أحمد والبيهقي في \"السنن الكبير\"، وهو حديث منكر وضحته في \"التعليق\".", "تهذيب الكمال", "3722", 840, "8418", 1], ["الذهبي", "منكر الحديث", "ж", "قال الذهبي في \"الميزان: ١ / ١٧٥\": أسباط بن عبد الواحد، منكر الحديث.", "تهذيب الكمال", "3722", 840, "8418", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "مجهول", "ж", "قال أبو حاتم مجهول", "الكاشف / سير أعلام النبلاء", "2171", 225, "2258", 1]], "544": [["النسائي", "صدوق", "д", "قال النَّسَائي: صدوق (٧ / ٥٨)", "تهذيب الكمال", "3722", -1, "97538", 1], ["الدارقطني", "ثقة", "д", "قال الحاكم عن الدارقطني: ثقة (٧ / ٥٩)", "تهذيب الكمال", "3722", 6499, "97628", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة ض?ع??ف في الثوري", "تقريب التهذيب", "8609", 24, "2500", 3], ["الذهبي", "وثقه", "ж", "وثقه ابن معين", "الكاشف / سير أعلام النبلاء", "2171", 27, "5541", 1]], "554": [["النسائي وأبو بكر بن أبي داود", "ثقة", "д", "قال النَّسَائي وأبو بكر بْن أَبي داود: ثقة. مات في المحرم سنة أربع وخمسين ومئتين بالرملة (٢) .", "تهذيب الكمال", "3722", 847, "8488", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "548": [["أبو حاتم", "صدوق", "д", "قال عَبد اللَّهِ بْن أَحْمَد بْن حنبل، عَن أبيه: صدوق.", "تهذيب الكمال", "3722", -1, "8448", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي (٤): ثقة. _________ (١) جاء في حواشي النسخ من قول المؤلف المزي: الرخجي: قرية من قرى بغداد\"يعني: نسبة إلى هذه القرية، وإنما", "تهذيب الكمال", "3722", -1, "8448", 2], ["الدارقطني", "ثقة", "д", "وَقَال الدَّارَقُطْنِيُّ (١): ثقة مأمون.", "تهذيب الكمال", "3722", 844, "8458", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "حجة", "д", "حجة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["الدارقطني", "ثقة", "д", "إسحاق بن إبراهيم بن حبيب بن الشهيد فقال ثقة مأمون", "سؤالات حمزة للدارقطني", "2491", "16", "173", 1], ["الذهبي", "حجة", "itqan", "حجة", "الكاشف", 0, -1, "", "", ""], ["البخاري", "ثقة مأمون", "itqan", "ثقة مأمون", "التاريخ الكبير", 0, -1, "", "", ""]], "555": [["الحافظ أبو بكر أحمد بن موسى بن مردويه", "حافظ", "д", "قال الحافظ أبو بكر أحمد بن موسى بن مردويه في كتابه\"أولاد المحدثين\": مات سنة ست وخمسين ومئتين. (٤)", "تهذيب الكمال", "3722", 844, "8458", 1], ["عنه أبي، ف", "صدوق", "д", "سئل عنه أبي، فَقَالَ: صدوق\". (الجرح والتعديل. ١ / ١ / ٢١١) أما الذي نقله ابن حجر في \"تهذيب التهذيب: ١ / ٢١٣\"عن ابن أَبي حاتم فهو: وسألت أبا زرعة عنه، فقال: صدوق", "تهذيب الكمال", "3722", 844, "8458", 1], ["الحافظ ابن حبان البستي", "حافظ", "д", "ذكره الحافظ ابن حبان البستي في \"الثقات: ١ / الورقة: ٢٥\"وَقَال: حَدَّثَنَا عنه إسحاق ابن إبراهيم القاضي وغيره من شيوخنا\". وخرج هو وأبو علي الطوسي وابن خزيمة وأبو", "تهذيب الكمال", "3722", 844, "8458", 1], ["مسلمة", "ثقة", "д", "وَقَال مسلمة في كتاب\"الصلة\": ثقة، أخبرنا عنه المهراني. (٥) الثقات: ١ / الورقة: ٢٦.", "تهذيب الكمال", "3722", 844, "8458", 1], ["أبو زرعة", "منكر الحديث", "ж", "قال أبو زُرْعَة (٢): منكر الحديث، ليس بقوي.", "تهذيب الكمال", "3722", 845, "8468", 1], ["ابن حجر العسقلاني", "لين", "ж", "لين الحديث", "تقريب التهذيب", "8609", 8, "148", 1]], "551": [["محمد بن إسحاق السراج", "ثقة", "д", "قال مُحَمَّد بْن إسحاق السراج (١): ثقة.", "تهذيب الكمال", "3722", 848, "8498", 1], ["عبد الرحمن بن أبي حاتم", "صدوق", "д", "وَقَال عَبْد الرَّحْمَنِ بْن أَبي حاتم (٢): صدوق ثقة.", "تهذيب الكمال", "3722", 848, "8498", 1], ["الدارقطني", "ثقة", "д", "وَقَال الدَّارَقُطْنِيُّ (٣): من الثقات (٤) . _________ (١) الرواية في تاريخ الخطيب (٦ / ٣٧١) ومنه أخذها المؤلف. (٢) الجرح والتعديل (١ / ١ / ٣١١) . (٣) تاريخ ال", "تهذيب الكمال", "3722", -1, "8498", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "552": [["الحافظ ابن حجر", "حافظ", "д", "قال الحافظ ابن حجر: وعلق البخاري في قيام الليل حديثًا للزبيدي هو من رواية إسحاق هذا عَنْ عَمْرو بْن الحارث الحمصي، وصله الطبراني وغيره\" (تهذيب التهذيب: ١ / ٢١٦)", "تهذيب الكمال", "3722", 852, "8538", 1], ["البزار", "ثقة", "д", "ذكره البزار في سننه فقال: هو ثقة. وكذا قاله أبو الحسن علي بن عُمَر الدارقطني ومحمد ين مخلد فيما", "تهذيب الكمال", "3722", 853, "8548", 1], ["البزار", "ثقة", "д", "ذكره البزار في سننه فقال: ثقة وحكى الخطيب توثيقه للدارقطني، كذا قرأته بخط مغلطاي.", "تهذيب الكمال", "3722", 853, "8548", 1], ["المؤلف المزي وقد", "اختلط", "ж", "ذكره المؤلف المزي وقد اختلط الامر على مغلطاي اختلاطا عجيبا وتابعه ابن حجر - على عادته - ولو تدبرا الترجمتين تدبرا جيدا لما وجدا من الصلة بين الترجمتين ما يجعلهم", "تهذيب الكمال", "3722", 853, "8548", 1], ["الخطيب", "صالح", "д", "قال الخطيب: سمع عبد الوهاب بن عطاء، ومحمد بن عُمَر الواقدي، وصالح بن بيان الأَنْبارِيّ، وإسماعيل بن أبان الكوفي، وزكريا بن عدي\" (تاريخه: ٦ / ٣٧٥)", "تهذيب الكمال", "3722", 853, "8548", 1], ["الدارقطني", "ثقة", "д", "قال الدارقطني: بغدادي ثقة\"فأين هذا البغدادي من ذاك الصواف البَصْرِيّ؟ ! يضاف إلى ذلك أن الخطيب ذكر قول محمد بن مخلد العطار في وفاته وأنها كانت سنة ١٦٢ هـ ولم يذ", "تهذيب الكمال", "3722", 853, "8548", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["", "ثقة", "д", "ابن حبانب بوذكره ابن حبان في الثقاتب بتهذيب التهذيب …ا بذكره أبو حاتم بن حبان في كتاب ?ب الثقات ?بب بتهذيب الكمال …ااا بابن حجرب بثقةب بتقريب التهذيب …ااا بالبز", "موسوعة الرواة (джарх)", "", ""]], "553": [["ابن حجر", "مجهول", "ж", "وَقَال ابن حجر في \"التقريب\": مجهول. (٢) تاريخ البخاري الكبير: ٦ / الترجمة ٣٢٦٤، والجرح والتعديل: ٦ / الترجمة ٢١٠٨، وثقات ابن حبان: ٥ / ٢٥٤، والكاشف: ٢ / الترجمة", "تهذيب الكمال", "3722", 8386, "116498", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["", "مجهول", "ж", "ابن حبانب بوذكره ابن حبان في الثقاتب بتهذيب التهذيب …ااا بابن حجرب بمجهول", "موسوعة الرواة (джарх)", "", ""]], "550": [["يحيى بن معين", "ثقة", "д", "قال عثمان بْن سَعِيد الدارمي، عَن يحيى بْن مَعِين (٢): ثقة.", "تهذيب الكمال", "3722", -1, "7948", 1], ["أبو زرعة", "ثقة", "д", "وَقَال أبو زُرْعَة (٣): ثقة، وهو أوثق من ابنه (٤) . _________ = فأفرده بترجمة، فقال: إسحاق بن يزيد الخراساني..وغفلا (يعني الباجي وعبد الغني) عما", "تهذيب الكمال", "3722", -1, "9768", 2], ["بشار", "إمام", "д", "قال بشار: بل نبه الإمام المزي ف", "تهذيب الكمال", "3722", 976, "9778", 1], ["فيه\"لا يحتج به\"، ولم يبينه (الميزان", "لا يحتج به", "ж", "قال فيه\"لا يحتج به\"، ولم يبينه (الميزان: ١ / ٢٠٥) . وترجم له ابن سعد في \"الطبقات: ٩ / الورقة: ١٦٣\"، والبخاري في تاريخه الكبير: ١ / ١ / ٤٠٥ وغيرهما. (٢) تاريخ ال", "تهذيب الكمال", "3722", 977, "9788", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق ضعف بلا مستند", "تقريب التهذيب", "8609", 25, "2659", 1], ["الذهبي", "ثقة", "д", "ثقة بكاء", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "562": [["أبو سعيد بن يونس", "حجة", "д", "قال أَبُو سَعِيد بْن يونس: توفي بأيلة في ذي الحجة سنة ثمان وخمسين ومئتين (٢) .", "تهذيب الكمال", "3722", 890, "8918", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "صدوق", "д", "ابن حجرب بصدوق", "موسوعة الرواة (джарх)", "", ""], ["", "لين", "ж", "تقريب التهذيب …ااا بابن أبي حاتم الرازيب بوكتب إليناب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "564": [["أبو أحمد بن عدي", "مجهول", "ж", "وَقَال أبو أحمد بْن عدي (٣): مجهول. روى له أبو داود، وابن ماجه (٤) .", "تهذيب الكمال", "3722", 894, "8958", 1], ["ابن حجر العسقلاني", "فيه ضعف", "itqan", "فيه ضعف", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن أبي حاتم", "شيخ", "itqan", "شيخ", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "تركوه", "itqan", "تركوه", "تهذيب التهذيب", 0, -1, "", "", ""]], "565": [["المزي، وليس للرجل ترجمة", "حافظ", "д", "قال المزي، وليس للرجل ترجمة في \"الكامل\"وقد لاحظ ذلك قبلي العلامة مغلطاي والحافظ ابن حجر ونبها عليه،", "تهذيب الكمال", "3722", 894, "8958", 1], ["أبو أحمد الحاكم", "مجهول", "ж", "وَقَال أبو أحمد الحاكم في كتاب\"الكني\": مجهول..وفي قول المزي\"", "تهذيب الكمال", "3722", 894, "8958", 1], ["أبو أحمد بن عدي", "مجهول", "ж", "قال أَبُو أَحْمَد بْن عَدِيّ: مجهول\"نظر، لان هذا الرجل لم أر له في كتاب\"الكامل\"تأليف أبي أحمد ذكرا، والذي رأيت أن قائل ذاك فيما أظن هو الحاكم أبو أحمد، فكأنه اش", "تهذيب الكمال", "3722", 894, "8958", 1], ["أبو حاتم", "لا بأس به", "д", "قال أبو حاتم (١): لا بأس به، كان عنده درج عَن أبيه.", "تهذيب الكمال", "3722", 895, "8968", 1], ["أبو سعيد بن يونس", "ثقة", "д", "وَقَال أبو سَعِيد بْن يونس (٢): كان فقيها مفتيا، وكان يجلس في حلقة الليث بن سعد، ويفتي بقول الليث، يروي عَن أبيه، وكان ثقة، توفي سنة ثماني عشرة ومئتين. وذكر يحي", "تهذيب الكمال", "3722", 895, "8968", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق فقيه", "تقريب التهذيب", "8609", 26, "2810", 1], ["الذهبي", "ثقة", "д", "ثقة مفت", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "560": [["أبا طالب", "لا بأس به", "д", "سمعت أبا طالب، قال: سألت أَحْمَد بْن حنبل عن إسحاق بن أَبي بكر الدي روى عنه القعنبي، قال: هو مولى حويطب لا بأس به. \"، ولكن أبا حفص بن شاهين روى عن عَبد اللَّهِ ", "تهذيب الكمال", "3722", 896, "8978", 1], ["فيه", "ثقة", "д", "قال فيه: ثقة ثقة\" (الورقة: ٧)، و", "تهذيب الكمال", "3722", 896, "8978", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "صدوق", "д", "ابن حجرب بصدوق", "موسوعة الرواة (джарх)", "", ""]], "568": [["أبو حاتم", "صالح", "д", "قال صالح بْن أحمد بْن حنبل، عَن أبيه (١): ثقة. وكذلك", "تهذيب الكمال", "3722", 899, "9008", 1], ["أبو حاتم", "صالح الحديث", "д", "وَقَال أبو حاتم (٣): صالح الحديث (٤) . وروى ابن جُرَيْج، عَن إسحاق بْن حازم، عَن حرام بْن عثمان، عَن عَبْد الرحمن بْن جابر بْن عَبد الله، عَن أبيه، في النهي. عَ", "تهذيب الكمال", "3722", 899, "9008", 1], ["أبو جعفر", "صالح", "д", "قال أبو جعفر (٦): يقولون: إني أنا المهدي، والله لو أن الناس أطبقوا أن الفرج يجيئهم من باب، لخالفهم القدر _________ (١) انظر الثقات ابن شاهين: عن صالح، عن أحمد (", "تهذيب الكمال", "3722", 899, "9008", 2], ["أبو داود السجستاني", "ليس به بأس", "д", "قال الآجري: سألت أبا داود عن إسحاق بن حازم، فَقَالَ: ليس به بأس. قلت: حدث عنه عَبْد الرَّحْمَنِ بْن مَهْدِيّ؟ قال: نعم..", "تهذيب الكمال", "3722", 899, "9008", 1], ["يحيى", "صدوق", "д", "قال يحيى: هو قدري، وهو صدوق فِي الحديث.", "تهذيب الكمال", "3722", 899, "9008", 1], ["الساجي", "صدوق", "д", "وَقَال الساجي: صدوق يرى القدر.", "تهذيب الكمال", "3722", 899, "9008", 1], ["أحمد بن حنبل", "ضعيف", "ж", "وَقَال أَحْمَد بْن حَنْبَلٍ: لا أعلم إِلاَّ خَيْرًا كان يرى القدر\". وذكر أَبُو حَفْصِ بْنُ شاهين فِي \"الثقات، الورقة: ٧\"، وابن حبان البستي أيضا\"الثقات: ١ / الور", "تهذيب الكمال", "3722", 899, "9008", 1], ["ملك ويحيى", "ليس بثقة", "ж", "قال ملك ويحيى: ليس بثقة،", "تهذيب الكمال", "3722", -1, "9008", 1], ["الشافعي ويحيى بن معين", "إمام", "д", "وَقَال الشافعي ويحيى بن مَعِين: الرواية عن حرام حرام، وقد أورد الإمام الذهبي في \"الميزان\"١ / ٤٦٩ حديثه هذا من طريق عبد بن حميد في جملة منكراته. (ش) . (٦) أبو جع", "تهذيب الكمال", "3722", 899, "9008", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق تكلم فيه للقدر", "تقريب التهذيب", "8609", 26, "2810", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "567": [["يحيى بن معين", "صدوق", "д", "قال عثمان بْن سَعِيد الدارمي، عَنْ يحيى بْن مَعِين (١): ما أراه إلا كان صدوقا (٢) . روى له البخاري في كتاب\"القراءة خلف الإمام\"وغيره، والتِّرْمِذِيّ، وابن ماجه. ", "تهذيب الكمال", "3722", 898, "8998", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "يخطئ", "д", "ابن حبانب بكان يخطئب بالثقات …ا بوذكره ابن حبان في الثقات وقال كان يخطئب بتهذيب التهذيب …ااا بابن حجرب بصدوق", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "مقبول", "itqan", "مقبول", "الكاشف", 0, -1, "", "", ""]], "572": [["أحمد بن حنبل", "ليس به بأس", "д", "قال حنبل بْن إسحاق، عَن أحمد بْن حنبل: ليس به بأس.", "تهذيب الكمال", "3722", 909, "9108", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة.", "تهذيب الكمال", "3722", -1, "3168", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""]], "566": [["حديث", "ثقة", "д", "سئل أبي عن حديث: \"تبني مدينة\"قال: ما حدث به إنسان ثقة. وذكر له أن عبد العزيز بن أبان رواه عن الثوري، فقال: تركته لما حدث بحديث المواقيت.", "تهذيب الكمال", "3722", 5881, "91448", 1], ["عبد العزيز بن أبان، ف", "كذاب", "ж", "سئل عن عبد العزيز بن أبان، فقال: كذاب خبيث يضع الحديث.", "تهذيب الكمال", "3722", 5881, "91448", 1], ["يحيى بن معين", "يكذب", "ж", "وَقَال أَحْمَد بن مُحَمَّد بْن القاسم بْن محرز (٤)، عَن يحيى بْن مَعِين: ليس حديثه بشيءٍ، كان يكذب.", "تهذيب الكمال", "3722", 5881, "91448", 1], ["يحيى بن معين مرة أخرى", "يهم", "ж", "سمعت يحيى بن مَعِين مرة أخرى يقول: كان يحدث بأحاديث موضوعة. وأتوه بحديث أبي داود الطيالسي، عن الأسود بن شيبان حديث أم معبد فقرأه عليهم وحدثهم به (٦) . _________", "تهذيب الكمال", "3722", 5881, "91448", 3], ["ابن معين", "ليس بشيء", "ж", "وَقَال الدوري عن ابن مَعِين: ليس بشيءٍ (تاريخه: ٢ / ٣٦٤) .", "تهذيب الكمال", "3722", 5881, "91448", 1], ["ابن معين", "ليس بثقة", "ж", "وَقَال الدارمي عن ابن مَعِين: ليس بثقة. قُلْتُ: من أين جاء ضعفه؟ فقال: كان يأخذ أحاديث الناس فيرويها (تاريخه: الترجمة ٥٦٩) .", "تهذيب الكمال", "3722", 5881, "91448", 1], ["معاوية بن صالح عنه", "صالح", "д", "وَقَال معاوية بن صالح عَنه: كذاب (ضعفاء العقيلي الورقة ١٢٣ - ١٢٤) .", "تهذيب الكمال", "3722", 5881, "91448", 1], ["علي بن الحسين بن حبان", "كذاب", "ж", "وَقَال علي بْن الحسين بْن حبان (١): وجدت فِي كتاب أَبِي بخط يده: سألت أبا زكريا عن الواقدي، قال: كان كذابا. قلتُ لأبي زكريا: فعبد العزيز بن أبان مثله؟ قال: لا، ", "تهذيب الكمال", "3722", 5882, "91458", 1], ["يعقوب بن شيبة", "متروك", "ж", "وَقَال يعقوب بن شَيْبَة (٤): وعبد العزيز بن أبان عند أصحابنا جميعًا _________ (١) تاريخ بغداد: ١٠ / ٤٤٦. (٢) ضبب المصنف في هذا الموضع. (٣) تاريخ بغداد: ١٠ / ٤٤٥", "تهذيب الكمال", "3722", 5882, "91458", 3], ["محمد بن عبد الله بن نمير", "كذاب", "ж", "سمعت محمد بن عَبد الله بن نمير يقول: ما رأيت أحدا أبين أمرا منه، وَقَال: هو كذاب.", "تهذيب الكمال", "3722", 5883, "91468", 1], ["أبو حاتم", "متروك", "ж", "وَقَال أبو حاتم (١): متروك الحديث، لا يشتغل به، تركوه لا يكتب حديثه (٢) .", "تهذيب الكمال", "3722", 5883, "91468", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "صدوق", "д", "ابن حجرب بصدوق", "موسوعة الرواة (джарх)", "", ""]], "574": [["الحافظ ابن حجر", "حافظ", "д", "قال الحافظ ابن حجر في \"تهذيب التهذيب: ١ / ٢٣٥\": وقع", "تهذيب الكمال", "3722", 913, "9148", 1], ["بشار", "حافظ", "д", "قال بشار: هذه التفاتة جيدة من الحافظ ابن حجر، وهو الخبير بصحيح البخاري، ولكن هذا ليس من شرط المزي، لانه لم ينسب\"التعليق\"إلى إسحاق حتى يصح", "تهذيب الكمال", "3722", 913, "9148", 1], ["أبو حاتم", "ثقة", "д", "قال عَبد اللَّهِ بْن أَحْمَد بْن حنبل، عَن أبيه (٢): شيخ ثقة", "تهذيب الكمال", "3722", 914, "9158", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال إسحاق بْن منصور، عَنْ يحيى بْن مَعِين (٣): ثقة. وكذلك", "تهذيب الكمال", "3722", -1, "9158", 1], ["أبو حاتم", "صالح الحديث", "д", "وَقَال أبو حاتم (٤): صالح الحديث.", "تهذيب الكمال", "3722", -1, "5698", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق تكلم فيه للنص", "تقريب التهذيب", "8609", 27, "2952", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""]], "575": [["البخاري والساجي وأبو زرعة", "منكر الحديث", "ж", "قَال البُخارِيُّ والساجي وأَبُو زُرْعَة: منكر الحديث،", "تهذيب الكمال", "3722", 2052, "20538", 1], ["أبو حاتم", "متروك", "ж", "وَقَال أبو حاتم: متروك الحديث، فالخبر لا يصح. لهم، وعلي ما عليهم (١)", "تهذيب الكمال", "3722", -1, "20518", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["النسايي", "لا باس به", "jarh", "النَّسَائي: لا بأس به", "تهذيب الكمال", "3722", -1, "9178", 1], ["ابن حبان", "مستقيم الحديث", "itqan", "مستقيم الحديث", "الثقات", 0, -1, "", "", ""], ["الذهبي", "صدوق", "itqan", "صدوق", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "صدوق", "itqan", "صدوق", "تهذيب التهذيب", 0, -1, "", "", ""]], "586": [["يحيى بن معين", "صالح", "д", "قال إسحاق بْن مَنْصُور، عَنْ يحيى بْن مَعِين (٢): صالح.", "تهذيب الكمال", "3722", -1, "7598", 1], ["أبو حاتم", "ثقة", "д", "وَقَال أبو حاتم (٣): ثقة، لا بأس به (٤) . _________ (١) جاء في حواشي النسخ من قول المؤلف: كان فيه: وميمون الكردي، وهو وهم\". قلت: يريد بذلك \"الكمال\" لعبد الغني ا", "تهذيب الكمال", "3722", -1, "9418", 2], ["مغلطاي", "إمام", "д", "وَقَال مغلطاي: وخرج إمام الأئمة ابن خزيمة وابن حبان والحاكم وأبو محمد الدارمي حديثه في صحيحهم. وفي كتاب \"الثقات\" لابن خلفون:", "تهذيب الكمال", "3722", 940, "9418", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق مقل", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "580": [["يحيى بن معين", "صالح", "д", "قال عَبَّاس الدُّورِيُّ، عَنْ يحيى بْن مَعِين: صالح بن عَبد الله بن أَبي فروة، وعبد الحكيم، وعبد الأعلى، كلهم ثقات، إلا إسحاق (٢) . و", "تهذيب الكمال", "3722", -1, "", 0], ["يحيى", "ليس به بأس", "д", "وَقَال ابن الجنيد عن يحيى: ليس به بأس (سؤالاته، الورقة ١٥) . (٣) ١ / الورقة ١٩٣، وَقَال: مات سنة أربع وعشرين ومئة. و", "تهذيب الكمال", "3722", -1, "138918", 2], ["البخاري", "صالح", "д", "قَال البُخارِيُّ: حدثني هارون بن محمد، قال: مات صالح بن عَبد الله بن أَبي فروة أبو عفراء سنة أربع وعشرين. (تاريخه الصغير: ١ / ٣٢٠) .", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "متروك", "ж", "متروك", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "تركوه", "ж", "تركوه", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "579": [["ابن حجرفي\"التقريب\"", "مجهول", "ж", "وَقَال ابن حجرفي\"التقريب\": مقبولة. لكن الذهبي ذكرها في المجهولات من\" الميزان\" (٤ / الترجمة ١٠٩٥١) . (٣) الفرسن: عظم قليل اللحم، وهو خف البعير، قد يستعار للشاة، ", "تهذيب الكمال", "3722", 15279, "187608", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة حجة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "حجة", "д", "حجة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "589": [["مغلطاي", "مجهول", "ж", "قال مغلطاي: ونقل المزي عَن أبي حاتم أنه قال: هو مجهول\"، وفي ذلك نظر لان أبا حاتم لم ينص على هذا الرجل بعينه إنما ذكر شخصا وافقه في اسم الاب والتلميذ ولم يوافقه ", "تهذيب الكمال", "3722", 943, "9448", 1], ["مغلطاي", "واه", "ж", "وَقَال مغلطاي في إكماله: إسحاق بن عُمَر عن عائشة. خرج الحاكم حديثه عنها في الشواهد. ولما رواه أبو علي الطوسي في كتاب\"الاحكام\"قال: يقال: إسناده منقطع.", "تهذيب الكمال", "3722", 943, "9448", 1], ["ابن القطان", "مجهول", "ж", "وَقَال ابن القطان: لا يعرف. فانظر إلى قول ابن عساكر في إسحاق بن عُمَر الراوي عن عائشة: مجهول، وهو قول أبي حاتم أيضا. (٢)", "تهذيب الكمال", "3722", 943, "9448", 1], ["صالح بن محمد الحافظ", "صالح", "д", "وَقَال صالح بْن مُحَمَّد الحافظ (٢): لا بأس به، صدوق. _________ (١) تاريخه الكبير: ١ / ١ / ٣٩٩. (٢) تاريخ الخطيب: ٦ / ٣٣٣.", "تهذيب الكمال", "3722", -1, "9458", 0], ["أبو حاتم", "صدوق", "д", "وَقَال أبو حاتم (١): مُحَمَّد أخوه إلي منه، وهو صدوق", "تهذيب الكمال", "3722", 945, "9468", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""]], "590": [["أبو عوانة الإسفراييني", "ثقة", "д", "قال أبو عوانة الإسفراييني: ثقة. _________ (١) تاريخ بغداد: ٦ / ٣١٨. وانظر تاريخ البخاري الكبير: ١ / ١ / ٣٩٩. (٢) جاء في حواشي النسخ من قول المؤلف في توهيم صاحب ", "تهذيب الكمال", "3722", -1, "9488", 2], ["أبو سعيد بن يونس", "حجة", "д", "وَقَال أَبُو سَعِيد بْن يونس: كان فقيها ولي القضاء بمصر خليفة لمحمد بْن مسروق الكندي (٥)، وفي أحاديثه أحاديث كأنها منقلبة، توفي بمصر ليلة الجمعة لليلتين خلتا من", "تهذيب الكمال", "3722", 948, "9498", 1], ["لي الشافعي", "وثقه", "д", "قال لي الشافعي: أشرت على بعض الولاة بأن يولي إسحاق بن الفرات القضاء، وقلت له: إنه يتخير، وهو عالم باختلاف من مضى\" (٧٨)، وذَكَره ابنُ حِبَّان في \"الثقات: ١ / الو", "تهذيب الكمال", "3722", 948, "9498", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق فقيه", "تقريب التهذيب", "8609", 26, "2810", 1], ["الذهبي", "ثقة", "д", "ثقة يغر", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "شيخ", "itqan", "شيخ", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "منكر الحديث", "itqan", "منكر الحديث", "تهذيب التهذيب", 0, -1, "", "", ""]], "588": [["يحيى بن معين", "ثقة", "д", "وَقَال عبد الخالق (٣) بْن مَنْصُور، عَنْ يحيى بْن مَعِين: ثقة (٤) .", "تهذيب الكمال", "3722", 6246, "95098", 1], ["علي (٥) بن الحسين بن حبان", "ثبت", "д", "وَقَال علي (٥) بْن الحسين بْن حبان: وجدت فِي كتاب أبي بخط يده: ذكر أبو زكريا أبا عُبَيدة الحداد فقال: كان من المتثبتين ما أعلم أنا أخذنا عليه خطأ البتة، جيد الق", "تهذيب الكمال", "3722", 6246, "95098", 1], ["يحيى بن معين", "ثقة", "д", "قال الدوري عنه أيضا (تاريخه: ٢ / ٣٧٧) . (٥) تاريخ الخطيب: ١١ / ٤. (٦) نفسه. (٧) نفسه. (٨) تاريخ الخطيب: ١١ / ٥. ويعقوب بْن سفيان (١)، وأَبُو دَاوُدَ (٢): ثقة. ز", "تهذيب الكمال", "3722", 6246, "95098", 1], ["الخطيب", "ثقة", "д", "وَقَال الخطيب: بصري سكن بغداد وحدث بها، وكَانَ ثقة. (تاريخه: ١١ / ٣) .", "تهذيب الكمال", "3722", 6247, "95108", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التهذيب\": وثقة الدارقطني (٦ 