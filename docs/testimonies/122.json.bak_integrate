{"12201": [["", "ضعفه", "ж", "الحسن بن بكيرب بضعفه الحسن بن بكيرب بلسان الميزان …ااا بالحسين بن أحمد الصيرفيب بقال الحافظ الحسين بن أحمد بن عبد الله بن بكير هو ضعيفب بإكمال تهذيب الكمال …ااا", "موسوعة الرواة (джарх)", "", ""]], "12204": [["", "صدوق", "д", "ابن أبي حاتم الرازيب بصدوقب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "12206": [["", "حافظ", "д", "الذهبىب بكان حافظا ثقة واسع العلمب بتاريخ الإسلام …ا بسمع إبراهيم بن الهيثم البلدي وجعفر بن محمد بن شاكر وإسماعيل القاضي ويحيى بن عثمان بن صالح المصريب بتاريخ ا", "موسوعة الرواة (джарх)", "", ""]], "12208": [["", "صدوق", "д", "ابن أبي حاتم الرازيب بصدوقب بالجرح والتعديل لابن أبي حاتم …ا بوقال ابن أبي حاتم روى عن الأشيب كتبت عنه وهو صدوقب بلسان الميزان …ااا بابن حبانب بقال ابن حبان في ", "موسوعة الرواة (джарх)", "", ""]], "12211": [["", "لا يحتج به", "ж", "الخطيب البغداديب بوقال الخطيب روى عنه محمد بن مخلد وما رأيت أحاديثه إلا مستقيمةب بلسان الميزان …ااا بالدارقطنيب بقال الدارقطني لا يحتج بهب بلسان الميزان …ااا با", "موسوعة الرواة (джарх)", "", ""]], "12212": [["", "صدوق", "д", "ابن أبي حاتم الرازيب بصدوقب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "12221": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …ااا بالذهبىب بوكان صدوقا سماه بعضهم محمداب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "12224": [["", "صدوق", "д", "الخطيب البغداديب بسمع إسماعيل بن أبان وإسماعيل بن أبي أويس وعبيد الله بن موسى وزكريا بن عديي روى عنه يحيى بن صاعد والحسين بن إسماعيل المحاملي ومحمد بن مخلد ويعق", "موسوعة الرواة (джарх)", "", ""]], "12227": [["", "صدوق", "д", "أبو حاتم الرازيب بسمعت أبي يقول كتبنا عنهب بالجرح والتعديل لابن أبي حاتم …ا بقال أبو محمد وكتبنا عنها معه بسامرا قال وسئل أبي عنه فقال صدوقيب بالجرح والتعديل لا", "موسوعة الرواة (джарх)", "", ""]], "12236": [["", "صدوق", "д", "ابن أبي حاتم الرازيب بسمع منه أبي بمصر وهو صدوقب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""]], "12240": [["", "صدوق", "д", "أبو حاتم الرازيب