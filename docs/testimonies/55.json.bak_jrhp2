{"5501": [["", "يهم", "ж", "ذكره في هذا الكتاب. ولم يذكر السمعاني هذه النسبة في \"الانساب\"ولا استدركها عليه العز ابن الاثير في \"اللباب\"فتستدرك عليهما. علي حَمْدَان الْوَرَّاق، ومحمد بْن غال", "تهذيب الكمال", "3722", 350, "3518", 1], ["أبو الحسن الميموني", "حافظ", "д", "قال أَبُو الْحَسَن الميموني: سألت أَحْمَد بْن حنبل عَنْهُ فَقَالَ: قد كَانَ عندنا ورأيته كيسا وما رأيت بأسا، رأيته حافظا لحديثه وما رأيت إِلاَّ خَيْرًا، وهو صاح", "تهذيب الكمال", "3722", 351, "3528", 1], ["يعقوب بن شيبة", "ثقة", "д", "وَقَال يَعْقُوب بْن شَيْبَة: كَانَ ثقة.", "تهذيب الكمال", "3722", -1, "3518", 1], ["الكلاباذي والباجي", "متروك", "ж", "ذكره الكلاباذي والباجي، قال: وهو متروك.", "تهذيب الكمال", "3722", 351, "3528", 1], ["ابن خلفون", "ثقة", "д", "وَقَال ابن خلفون: أحمد بن عبد الملك هذا ثقة مشهور، وقد زعم بعض الناس أن أهل بلده كانوا يسيئون الثناء عليه، فترك حديثه لذلك ولم يضع شيئا\"", "تهذيب الكمال", "3722", 351, "3528", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة حافظ", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه النسائي", "الكاشف / سير أعلام النبلاء", "2171", 22, "5195", 1], ["ابن حبان", "ذكره في الثقات", "д", "مُحَمَّد بن إِسْمَاعِيل بن يُوسُف يروي عَن الْأنْصَارِيّ روى عَنهُ الْحَضْرَمِيّ", "الثقات لابن حبان", "5816", "3928", "39288", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة حافظ لم يتضح كلام أبي حاتم فيه", "д", "قال في التقريب : ثقة حافظ لم يتضح كلام أبي حاتم فيه", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "تكلم فيه", "д", "تكلم فيه", "sunnah.com", "", "", "", 1], ["ابن أبي حاتم الرازي", "تكلموا فيه", "д", "تكلموا فيه", "sunnah.com", "", "", "", 1], ["الدارقطني", "ثقة صدوق تكلم فيه أبو حاتم", "д", "ثقة صدوق تكلم فيه أبو حاتم", "sunnah.com", "", "", "", 1], ["أحمد بن شعيب النسائي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["الخطيب البغدادي", "فهم متقن مشهور