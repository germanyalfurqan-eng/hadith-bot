 ، ومرة : اثنى عليه خيرا لصلابته في السنة", "sunnah.com", "", "", "", 1], ["الدارقطني", "في سؤالات أبي عبد الرحمن السلمي ، قال : مختلف فيه", "д", "في سؤالات أبي عبد الرحمن السلمي ، قال : مختلف فيه", "sunnah.com", "", "", "", 1], ["أحمد بن شعيب النسائي", "ليس بثقة ، ومرة : كذاب", "д", "ليس بثقة ، ومرة : كذاب", "sunnah.com", "", "", "", 1], ["أبو جعفر العقيلي", "ذكره في الضعفاء", "д", "ذكره في الضعفاء", "sunnah.com", "", "", "", 1], ["أبو زرعة الرازي", "تركه ، ومرة : رماه بالكذب", "д", "تركه ، ومرة : رماه بالكذب", "sunnah.com", "", "", "", 1], ["إبراهيم بن يعقوب الجوزجاني", "كان رديء المذهب غير ثقة", "д", "كان رديء المذهب غير ثقة", "sunnah.com", "", "", "", 1], ["يعقوب بن شيبة السدوسي", "كثير المناكير", "д", "كثير المناكير", "sunnah.com", "", "", "", 1], ["عبد الرحمن بن يوسف بن خراش", "كان والله يكذب ، ومرة : ضعيف الحديث جدا", "д", "كان والله يكذب ، ومرة : ضعيف الحديث جدا", "sunnah.com", "", "", "", 1], ["صالح بن محمد جزرة", "كل شيء كان يحدثنا ابن حميد كنا نتهمه فيه ، ومرة : ما رأيت أحدا أجرأ علي الله منه ، كان يأخذ أحاديث الناس فيقلب بعضه علي ", "д", "كل شيء كان يحدثنا ابن حميد كنا نتهمه فيه ، ومرة : ما رأيت أحدا أجرأ علي الله منه ، كان يأخذ أحاديث الناس فيقلب بعضه علي بعض ، ومرة : كان يحفظ حديثه كله ، وكان حديثه كل يوم يزيد", "sunnah.com", "", "", "", 1], ["أبو يعلى الخليلي", "كان حافظا ، عالما بهذا الشأن ، رضيه أحمد ويحيى", "д", "كان حافظا ، عالما بهذا الشأن ، رضيه أحمد ويحيى", "sunnah.com", "", "", "", 1], ["محمد بن إسحاق بن خزيمة", "كان لا يروى عنه ، وقيل له : أحمد قد أحسن الثناء عليه ؟ فقال : إنه لم يعرفه ، ولو عرفه كما عرفناه ما أثني عليه أصلا", "д", "كان لا يروى عنه ، وقيل له : أحمد قد أحسن الثناء عليه ؟ فقال : إنه لم يعرفه ، ولو عرفه كما عرفناه ما أثني عليه أصلا", "sunnah.com", "", "", "", 1], ["السيوطي", "كذاب", "д", "كذاب", "sunnah.com", "", "", "", 1], ["محمد بن يحيى الذهلي", "قيل له ما تقول في محمد بن حميد ؟ قال : ألا تراني هو ذا أحدث عنه", "д", "قيل له ما تقول في محمد بن حميد ؟ قال : ألا تراني هو ذا أحدث عنه", "sunnah.com", "", "", "", 1], ["محمد بن مسلم