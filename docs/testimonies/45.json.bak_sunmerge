{"4503": [["علي بن إسحاق المروزي، ف", "ثقة", "д", "سئل أبو زكريا عن علي بن إسحاق المروزي، فقال: ثقة صدوق.", "تهذيب الكمال", "3722", 7187, "104508", 1], ["محمد بن سعد", "ثقة", "д", "وَقَال محمد بن سعد (٢): علي بن إسحاق الداركاني وهي قرية بمرو، وكان ينزلها الحاج إذا خرجوا من مرو، وكان من أصحاب عبد الله بن المبارك معروفا بصحبته، وكان ثقة، وقد", "تهذيب الكمال", "3722", 7187, "104508", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة. و", "تهذيب الكمال", "3722", -1, "3168", 1], ["علي بن إسحاق كنيته أبو الحسن، وهو مولى لبن", "ثقة", "д", "قال علي بن إسحاق كنيته أبو الحسن، وهو مولى لبني سليم، وكان أصله من ترمذ نزل قرية الداركان، فمات بها سنة ثلاث عشرة ومئتين، وكان ثقة. وكذلك", "تهذيب الكمال", "3722", 7187, "104508", 1], ["أبو بكر الخطيب", "ثقة", "д", "وَقَال أبو بكر الخطيب: أخبرني الخلال: عَن أبي الحسن الدارقطني، قال: علي بن إسحاق المروزي ثقة (تاريخه: ١١ / ٣٤٩) .", "تهذيب الكمال", "3722", 7187, "104508", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. روى له التِّرْمِذِيّ. وفي طبقته شيخ آخر ي", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه النسائي", "الكاشف / سير أعلام النبلاء", "2171", 22, "5195", 1], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""]], "4505": [["يحيى بن معين، وأبو حاتم (٣)، والعجلي (٤)،", "ثقة", "д", "وَقَال إسحاق بْن منصور (٢)، وأحمد بْن سعد بْن أَبي مريم، عَن يحيى بْن مَعِين، وأبو حاتم (٣)، والعجلي (٤)، ويعقوب بن سفيان (٥)، والنَّسَائي، وابن خراش، والدارقطن", "تهذيب الكمال", "3722", 7192, "104558", 1], ["أبي", "لين", "ж", "قال أبي: أملى علينا وكيع حديث سفيان عن = روى له الجماعة.", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة حجة", "itqan", "ثقة حجة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4506": [["الدارمي", "ثقة", "д", "وَقَال الدارمي: وسألته (يعني يحيى بن مَعِين) عن مبشر بن إسماعيل، فقال: ثقة. (تاريخه، الترجمة ٧٦٠) .", "تهذيب الكمال", "3722", 11320, "145838", 1], ["الذهبي", "حجة", "д", "وَقَال الذهبي في \"الميزان \": تكلم فيه بلا حجة. (٣ / الترجمة ٧٠٥١) .", "تهذيب الكمال", "3722", 11320, "145838", 1], ["أحمد بن حنبل", "ثقة", "д", "قال أَحْمَد بْن حَنْبَلٍ: ثقة.", "تهذيب الكمال", "3722", -1, "145708", 1], ["ابن قانع", "ضعيف", "ж", "وَقَال ابن قانع: ضعيف. (١٠ / ٣٢) .", "تهذيب الكمال", "3722", 11320, "145838", 1], ["علي بن الحسن الذهلي", "ثقة", "д", "قال علي بْن الْحَسَن الذهلي: حَدَّثَنَا مبشر بْن عَبد اللَّه بْن رزين، وكان ثقة. وذكر الحاكم أَبُو عَبْد الله الحافظ أنه أكبر الأَخُوة القهندزيين وأنه سمع من جم", "تهذيب الكمال", "3722", 11321, "145848", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في \"الكاشف \": ثقة. (٣ / الترجمة ٥٣٦٩) وكذلك", "تهذيب الكمال", "3722", 11321, "145848", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة فاضل", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "عَليّ بن بَحر بن بَرى من أهل بابسير من كور الأهواز يرْوى عَن بن عُيَيْنَة روى عَنهُ ابْنه الْحسن بن عَليّ بن بَحر وَالنَّاس مَاتَ سنة أَربع وَثَلَاثِي", "الثقات لابن حبان", "5816", "3746", "37468", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة مأمون", "itqan", "ثقة مأمون", "تهذيب التهذيب", 0, -1, "", "", ""], ["البخاري", "ثقة", "itqan", "ثقة", "التاريخ الكبير", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "تذكرة الحفاظ", 0, -1, "", "", ""]], "4511": [["يحيى بن معين", "ليس بشيء", "ж", "وَقَال عَباس الدُّورِيُّ (٣)، ويعقوب بن شَيْبَة (٤) عَن يحيى بْن مَعِين: ليس بشيءٍ.", "تهذيب الكمال", "3722", 12683, "159468", 1], ["يحيى بن معين", "ضعيف", "ж", "وَقَال مُحَمَّد (٧) بْن عثمان بْن أَبي شَيْبَة، عَن يحيى بْن مَعِين: كَانَ ضعيفا.", "تهذيب الكمال", "3722", 12683, "159468", 1], ["يحيى بن معين", "صدوق", "д", "وَقَال الليث بن عبدة المِصْرِي (٨)، عن يَحْيَى بن مَعِين: كَانَ صدوقا، وكَانَ لا يدري ما يحدث بِهِ.", "تهذيب الكمال", "3722", 12683, "159468", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي (٩): كوفي ثقة، وكان امام مسجد الجامع. _________ (١) تاريخه الكبير: ٨ / الترجمة ٢٢٩٨. (٢) انظر تاريخ الخطيب: ١٣ / ٤٣٣. (٣) تاريخه: ٢ / ٦٠٥. (٤) تار", "تهذيب الكمال", "3722", -1, "159318", 2], ["يعقوب بن شيبة", "صدوق", "д", "وَقَال يعقوب بْن شَيْبَة (١): صدوق، ضعيف الحديث.", "تهذيب الكمال", "3722", 12684, "159478", 1], ["يعقوب بن سفيان", "ضعيف", "ж", "وَقَال يعقوب بْن سُفْيَانَ (٢): ضعيف.", "تهذيب الكمال", "3722", 12684, "159478", 1], ["أبو زرعة (٤)، والنسائي", "ليس بالقوي", "ж", "وَقَال أَبُو زُرْعَة (٤)، والنَّسَائي (٥): ليس بالقوي.", "تهذيب الكمال", "3722", 12684, "159478", 1], ["أبو أحمد بن عدي", "لا بأس", "д", "وَقَال أَبُو أَحْمَد بْن عدي (٧): أرجو إنه لا بأس بِهِ (٨) . روى له التِّرْمِذِيّ، والنَّسَائي. ٦٤١٧ - ع: النضر بن أنس بن مالك الأَنْصارِيّ (٩)، أبو _________ (", "تهذيب الكمال", "3722", 12684, "159478", 3], ["الذهبي", "ليس بالقوي", "ж", "وَقَال الذهبي في \" الكاشف\": ليس بالقوي. (٣ / الترجمة ٥٩٢٥) .", "تهذيب الكمال", "3722", 12684, "159478", 1], ["أبو أحمد الحاكم", "ليس بالقوي", "ж", "قال أبو أحمد الحاكم: ليس بالقوي عندهم.", "تهذيب الكمال", "3722", -1, "3928", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة. و", "تهذيب الكمال", "3722", -1, "3158", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة ثبت رمي بالتشيع", "تقريب التهذيب", "8609", 324, "3248", 1], ["الذهبي", "حافظ", "д", "الحافظ", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "لين", "itqan", "لين", "تهذيب التهذيب", 0, -1, "", "", ""], ["البخاري", "لين", "itqan", "لين", "التاريخ الكبير", 0, -1, "", "", ""], ["الذهبي", "لين", "itqan", "لين", "تذكرة الحفاظ", 0, -1, "", "", ""]], "4512": [["ابن عدي", "ثقة", "д", "وَقَال ابن عدي في \"الكامل\": ما رأي بحديثه بأسا، ولم أر في رواياته إذا حدث عن ثقة حديثًا منكرا (٢ / الورقة ٢٧١) .", "تهذيب الكمال", "3722", 7220, "104838", 1], ["الدارقطني", "ثقة", "д", "قال الدارقطني: ثقة مأمون.", "تهذيب الكمال", "3722", -1, "8448", 1], ["ابن قانع ثقة ثبت", "ثقة", "д", "وَقَال ابن قانع ثقة ثبت،", "تهذيب الكمال", "3722", -1, "104758", 1], ["مطين", "ثقة", "д", "وَقَال مطين: ثقة (٧ / ٢٩٢) .", "تهذيب الكمال", "3722", -1, "104758", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة ثبت رمي بالتشيع.", "تهذيب الكمال", "3722", 7220, "104838", 1]], "4515": [["البخاري", "فيه نظر", "ж", "قَال البُخارِيُّ (٣): علي بن الحزور أراه ابن أَبي فاطمة. رَوَى عَنه: يونس بن بكير، فيه نظر.", "تهذيب الكمال", "3722", 7235, "104988", 1], ["", "منكر الحديث", "ж", "وَقَال فِي موضع آخر (٤): منكر الحديث، عنده عجائب.", "تهذيب الكمال", "3722", 7235, "104988", 1], ["أبو حاتم", "منكر", "ж", "وَقَال أَبُو حاتم (٦): منكر الْحَدِيث.", "تهذيب الكمال", "3722", 7235, "104988", 1], ["النسائي", "متروك", "ж", "وَقَال النَّسَائي (٧): متروك الحديث.", "تهذيب الكمال", "3722", -1, "5048", 1], ["أبو زرعة الرازي", "واه", "ж", "وَقَال أبو زُرْعَة الرازي: واهي الحديث (أبو زُرْعَة الرازي: ٤٣٤) .", "تهذيب الكمال", "3722", 7235, "104988", 1], ["ابن حجر العسقلاني", "متروك", "ж", "متروك شديد التشيع", "تقريب التهذيب", "8609", 325, "3258", 1], ["الذهبي", "فيه نظر", "ж", "قال البخاري فيه نظر", "الكاشف / سير أعلام النبلاء", "2171", 258, "2588", 1]], "4517": [["الدارقطني", "مجهول", "ж", "وَقَال البرقاني عَنه: مجهول يترك (سؤالاته، الترجمة ٣٦٧) .", "تهذيب الكمال", "3722", 7236, "104998", 1], ["ابن حجر", "متروك", "ж", "وَقَال ابن حجر في \"التقريب\": متروك شديد التشيع. (١) الجرح والتعديل: ٦ / الترجمة ٩٨٢، والكاشف: ٢ / الترجمة ٣٩٤٨، وتذهيب التهذيب: ٣ / الورقة ٥٦، ورجال ابن ماجة، ا", "تهذيب الكمال", "3722", 7236, "104998", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "4513": [["أبو علي محمد بن علي بن حمزة المروزي", "حافظ", "д", "قال أبو علي مُحَمَّد بْن علي بْن حمزة المروزي: كان ينزل بغداد، ثم تحول إلى مرو فنزل قرية زرزم، وكان فاضلا حافظا.", "تهذيب الكمال", "3722", 7225, "104888", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي (٢): ثقة، مأمون، حافظ. _________ (١) تاريخ الخطيب: ١١ / ٤١٨. (٢) نفسه، والمعجم المشتمل، الترجمة ٦١٧.", "تهذيب الكمال", "3722", -1, "104888", 2], ["أبو بكر الخطيب", "متقن", "д", "وَقَال أبو بكر الخطيب (١): كان سكن بغداد قديما، ثم انتقل إلى مرو، فنزلها، واشتهر حديثه بها، وكان صادقا متقنا حافظا.", "تهذيب الكمال", "3722", 7226, "104898", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة حافظ", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "قال النسائي ثقة مأمون حافظ", "الكاشف / سير أعلام النبلاء", "2171", 722, "7238", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة مأمون", "itqan", "ثقة مأمون", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة مأمون", "itqan", "ثقة مأمون", "تهذيب التهذيب", 0, -1, "", "", ""], ["البخاري", "ثقة مأمون", "itqan", "ثقة مأمون", "التاريخ الكبير", 0, -1, "", "", ""], ["الذهبي", "واه", "itqan", "واه", "تذكرة الحفاظ", 0, -1, "", "", ""]], "4519": [["أبو زكريا", "لين", "ж", "قال أبو زكريا: وما أعلم أحدا قدم علينا من خراسان كان أفضل _________ (١) تاريخ الخطيب: ١١ / ٣٧١. من ابن شقيق، وكانوا كتبوا في أمره كتابا أنه يرى الأرجاء، فقلنا ل", "تهذيب الكمال", "3722", 7240, "105038", 0], ["سفيان بن زياد، ف", "ثبت", "д", "سئل أَبُو داود عَنْ سفيان بْن زياد، فقَالَ: من أصحاب ابْن المبارك أثبت أصحاب ابْن المبارك، وبعده سُلَيْمان، وبعده علي بن الحسن بن شقيق.", "تهذيب الكمال", "3722", 7241, "105048", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة حافظ", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "4525": [["النسائي", "متروك", "ж", "ذكره النَّسَائي في تسمية فقهاء أهل المدينة من التابعين. (رسائله في نهاية كتابه\"الضعفاء والمتروكين\"صفحه ١٢٧) .", "تهذيب الكمال", "3722", 7272, "105358", 1], ["أبو حاتم", "صدوق", "д", "قال أَبُو حَاتِم (١): صدوق.", "تهذيب الكمال", "3722", -1, "3168", 1], ["النسائي", "صدوق", "д", "وَقَال النَّسَائي (٢): صدوق.", "تهذيب الكمال", "3722", -1, "32478", 1], ["", "لا بأس", "д", "وَقَال في موضع آخر (٣): لا بأس بِهِ. و", "تهذيب الكمال", "3722", -1, "3698", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه النسائي", "الكاشف / سير أعلام النبلاء", "2171", 22, "5195", 1], ["ابن حبان", "مستقيم الحديث", "itqan", "مستقيم الحديث", "الثقات", 0, -1, "", "", ""]], "4522": [["النسائي", "ثقة", "д", "قال النَّسَائي (١): ثقة.", "تهذيب الكمال", "3722", -1, "2708", 1], ["عبد الرحمن بن أبي حاتم", "صدوق", "д", "وَقَال عَبْد الرَّحْمَنِ بْن أَبي حاتم (٢): روى عنه أبي وكتبت عنه معه، وهو صدوق ثقة،", "تهذيب الكمال", "3722", 7249, "105128", 1], ["أبي عنه، ف", "صدوق", "д", "سئل أَبِي عَنْهُ، فَقَالَ: صدوق. و", "تهذيب الكمال", "3722", -1, "2108", 1], ["أبو الحسين ابن المنادي (٥)، وزاد", "ثقة", "д", "قال أَبُو الحسين ابْن المنادي (٥)، وزاد: وكان بين موته وموت أخيه عشرة أشهر تزيد أو تنقص (٦) (٧) . _________ (١) تاريخ الخطيب: ١١ / ٣٩٣، والمعجم المشتمل، الترجمة", "تهذيب الكمال", "3722", 7249, "105128", 2], ["النسائي", "لا بأس به", "д", "قال النَّسَائي: كتبنا عنه ببغداد وأصله من نسا ولا بأس به.", "تهذيب الكمال", "3722", 7249, "105128", 1], ["مسلمة بن قاسم", "ثقة", "д", "وَقَال مسلمة بن قاسم: كان ثقة (٧ / ٣٠٢ - ٣٠٣) .", "تهذيب الكمال", "3722", 7249, "105128", 1], ["", "صدوق", "д", "وَقَال في \"التقريب\": صدوق. (٧) واستدرك الحافظ ابن حجر في هذا الموضع ترجمة ذكر الدارقطني أن النَّسَائي روى عنه هو: س: علي بن الحسين بن حرب بن عيسى القاضي، أَبُو ", "تهذيب الكمال", "3722", 7249, "105128", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه النسائي", "الكاشف / سير أعلام النبلاء", "2171", 22, "5195", 1], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""], ["البخاري", "واه", "itqan", "واه", "التاريخ الكبير", 0, -1, "", "", ""]], "4524": [["ابن حبان", "يخطئ", "ж", "ذكره ابنُ حِبَّان في \"الثقات: ١ / الورقة: ٢٧\"وَقَال: كان يخطئ. وذكر الزبير بْن بكار أنه زوج السيدة نفيسة بنت الْحَسَن بن زيد بن الْحَسَن بن علي ﵃. (٣) هكذا", "تهذيب الكمال", "3722", 898, "8998", 1], ["أبو حاتم", "صالح", "д", "قال صالح بْن أحمد بْن حنبل، عَن أبيه (١): ثقة. وكذلك", "تهذيب الكمال", "3722", 899, "9008", 1], ["أبو حاتم", "صالح الحديث", "д", "وَقَال أبو حاتم (٣): صالح الحديث (٤) . وروى ابن جُرَيْج، عَن إسحاق بْن حازم، عَن حرام بْن عثمان، عَن عَبْد الرحمن بْن جابر بْن عَبد الله، عَن أبيه، في النهي. عَ", "تهذيب الكمال", "3722", 899, "9008", 1], ["أبو جعفر", "صالح", "д", "قال أبو جعفر (٦): يقولون: إني أنا المهدي، والله لو أن الناس أطبقوا أن الفرج يجيئهم من باب، لخالفهم القدر _________ (١) انظر الثقات ابن شاهين: عن صالح، عن أحمد (", "تهذيب الكمال", "3722", 899, "9008", 2], ["أبو داود السجستاني", "ليس به بأس", "д", "قال الآجري: سألت أبا داود عن إسحاق بن حازم، فَقَالَ: ليس به بأس. قلت: حدث عنه عَبْد الرَّحْمَنِ بْن مَهْدِيّ؟ قال: نعم..", "تهذيب الكمال", "3722", 899, "9008", 1], ["يحيى", "صدوق", "д", "قال يحيى: هو قدري، وهو صدوق فِي الحديث.", "تهذيب الكمال", "3722", 899, "9008", 1], ["الساجي", "صدوق", "д", "وَقَال الساجي: صدوق يرى القدر.", "تهذيب الكمال", "3722", 899, "9008", 1], ["أحمد بن حنبل", "ضعيف", "ж", "وَقَال أَحْمَد بْن حَنْبَلٍ: لا أعلم إِلاَّ خَيْرًا كان يرى القدر\". وذكر أَبُو حَفْصِ بْنُ شاهين فِي \"الثقات، الورقة: ٧\"، وابن حبان البستي أيضا\"الثقات: ١ / الور", "تهذيب الكمال", "3722", 899, "9008", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة ثبت عابد فقيه فاضل مشهور", "تقريب التهذيب", "8609", 326, "3268", 1], ["العجلي", "ثقة", "д", "دني تابعي ثقة وكان رجلا صالحا قال العجلي ويروى عن الزهرى قال ما ر", "معرفة الثقات للعجلي", "5825", "455", "4558", 1]], "4531": [["ابن شاهين", "ثقة", "д", "وَقَال ابن شاهين: ثقة (ثقاته: الترجمة ٧٦١) . ووثقة البزار وابن نمير،", "تهذيب الكمال", "3722", 7283, "105468", 1], ["يحيى بن معين", "ليس به بأس", "д", "قال إبراهيم بْن عَبْد اللَّهِ بْن الجنيد، عَنْ يحيى بْن مَعِين: ليس به بأس، ثقة.", "تهذيب الكمال", "3722", 7284, "105478", 1], ["أبو حاتم", "صدوق", "д", "وَقَال أبو حاتم (