722", 7499, "107628", 1], ["ابن عدي", "ثبت", "д", "وَقَال ابن عدي: هو ثبت في يحيى بن أَبي كثير ومقدم في يحيى، وهو عندي لا بأس به (٢ / الورقة ٢٥٨) .", "تهذيب الكمال", "3722", 7499, "107628", 1], ["ابن المديني", "ثقة", "д", "قال ابن المديني: علي بن المبارك بصري هنائي، ثقة (الترجمة ٧٥٢) .", "تهذيب الكمال", "3722", 7499, "107628", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التهذيب\": وثقة ابن نمير (٧) ٣٧٦) .", "تهذيب الكمال", "3722", 7499, "107628", 1], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "4578": [["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة، مأمون.", "تهذيب الكمال", "3722", -1, "23618", 1], ["لي عبد الله بن المبارك", "حافظ", "д", "وَقَال لي عَبد اللَّه بْن المبارك: يا أبا علي ما أحسن حال من انقطع إِلَى ربه. قال: فسمع ذَلِكَ علي ابْني فسقط مغشيا عَلَيْهِ. أَخْبَرَنَا أَبُو عَبْد اللَّهِ مُ", "تهذيب الكمال", "3722", 7483, "107468", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة عابد", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه النسائي", "الكاشف / سير أعلام النبلاء", "2171", 22, "5195", 1], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة مأمون", "itqan", "ثقة مأمون", "تهذيب التهذيب", 0, -1, "", "", ""]], "4579": [["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة.", "تهذيب الكمال", "3722", -1, "2698", 1], ["ابن خراش", "ثقة", "д", "وَقَال ابْن خراش: كَانَ ثقة عدلا.", "تهذيب الكمال", "3722", -1, "3648", 1], ["أبو حاتم", "صدوق", "д", "وَقَال أَبُو حَاتِم: صدوق (١) .", "تهذيب الكمال", "3722", -1, "3648", 1], ["ابن حبان", "وثقه", "д", "ذكره ابنُ حِبَّان في \"الثقات\"، ووثقه أيضا ابن خلفون ومسلمة بن القاسم الاندلسي وابن عساكر في \"المعجم المشتمل\"والذهبي في كتبه. (٢) وبه", "تهذيب الكمال", "3722", 364, "3658", 1], ["أبو حاتم، ثقة رضى.", "ثقة", "д", "قال أَبُو حَاتِم، ثقة رضى.", "تهذيب الكمال", "3722", -1, "3658", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة (١) .", "تهذيب الك