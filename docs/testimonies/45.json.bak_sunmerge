", "وَقَال أبو بكر الخطيب (٦): وزعم أحمد بن حنبل أن علي بن أَبي طلحة الذي روى عنه الثوري والحسن بن صالح كوفي وهو غير الشامي وأن حجاجا الأَعور إنما رأى هذا الكوفي، و", "تهذيب الكمال", "3722", 7360, "106238", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق قد يخطئ", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "منكر", "ж", "وقال أحمد له أشياء منكرات", "الكاشف / سير أعلام النبلاء", "2171", 727, "7288", 1], ["العجلي", "ثقة", "д", "ن المخارق ثقة", "معرفة الثقات للعجلي", "5825", "458", "4588", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "متروك", "itqan", "متروك", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "واه", "itqan", "واه", "الطبقات الكبرى", 0, -1, "", "", ""], ["البخاري", "متروك", "itqan", "متروك", "التاريخ الكبير", 0, -1, "", "", ""]], "4556": [["يحيى بن معين", "ضعيف", "ж", "سمعت يحيى بْن مَعِين يَقُول: علي بن عابس كأنه ضعيف.", "تهذيب الكمال", "3722", 7371, "106348", 1], ["يحيى", "ليس بشيء", "ж", "وَقَال أبوبشرالدولابي، عَنْ عباس (٢) عَن يَحْيَى: ليس بشيءٍ (٣) . _________ (١) الجرح والتعديل: ٦ / الترجمة ١٠٨٥. (٢) تاريخ الدوري: ٢ / ٤٢١. (٣)", "تهذيب الكمال", "3722", 7371, "106348", 0], ["يحيى", "ضعيف", "ж", "وَقَال أبو داود (٣) عَن يحيى: ضعيف. وكذلك", "تهذيب الكمال", "3722", 7372, "106358", 1], ["أبو أحمد بن عدي", "ضعفه", "ж", "وَقَال أبو أحمد بْن عدي (٦): له أحاديث حسان، ويروي عن أبان بن تغلب وغيره أحاديث غرائب، ومع ضعفه يكتب حديثه (٧) . روى له التِّرْمِذِيّ (٨) حديثًا واحدًا عن مسلم ", "تهذيب الكمال", "3722", 7372, "106358", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ضعفوه", "itqan", "ضعفوه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ضعيف", "itqan", "ضعيف", "تهذيب التهذيب", 0, -1, "", "", ""]], "4555": [["يحيى", "كذاب", "ж", "وَقَال أَحْمَد بْن مُحَمَّد بْن القاسم بْن محرز (١) عَن يحيى: كذاب خبيث ليس بثقة.", "تهذيب الكمال", "3722", 7366, "106298", 1], ["منه بالكوفة، وهو كوفي كان قاضي الشرقية، فق", "منكر", "ж", "سمعت منه بالكوفة، وهو كوفي كان قاضي الشرقية، فقلت له: يحدث بحديث منكر. فقال: ما هو؟ قلت: عن عُبَيد الله؟ فقال: نعم، عن نافع، عن ابن عُمَر، عَن النَّبِيِّ ﷺ قال:", "تهذيب الكمال", "3722", 7366, "106298", 1], ["محمد بن عبد الله بن نمير", "ضعيف", "ж", "وَقَال مُحَمَّد بْن عَبْد اللَّهِ بن نمير (٣): ضعيف، يخطئ في حديثه كله. و", "تهذيب الكمال", "3722", 7366, "106298", 1], ["البخاري", "منكر الحديث", "ж", "قَال البُخارِيُّ (٤): منكر الحديث.", "تهذيب الكمال", "3722", -1, "5248", 1], ["النسائي", "متروك", "ж", "وَقَال النَّسَائي (٥): متروك الحديث.", "تهذيب الكمال", "3722", -1, "5038", 1], ["", "ليس بثقة", "ж", "وَقَال فِي موضع آخر: ليس بثقة ولا يكتب حديثه.", "تهذيب الكمال", "3722", -1, "6478", 1], ["أبو زرعة", "واه", "ж", "وَقَال أبو زُرْعَة (٦): واهي الحديث جدا.", "تهذيب الكمال", "3722", 7366, "106298", 1], ["أبو حاتم (٧)، وأبو الفتح الأزدي", "متروك", "ж", "وَقَال أبو حاتم (٧)، وأبو الفتح الأزدي: متروك.", "تهذيب الكمال", "3722", 7366, "106298", 1], ["ابن حبان", "متروك", "ж", "وَقَال ابن حبان (٨): سقط الاحتجاج بأخباره. _________ (١) سؤالاته: ١. (٢) سؤالاته: ٥٧. وانظر تاريخ بغداد: ١١ / ٤٤٤ - ٤٤٥. (٣) المجروحين لابن حبان: ٢ / ١٠٥. (٤) ض", "تهذيب الكمال", "3722", -1, "", 0], ["الدارقطني", "ضعيف", "ж", "وَقَال الدَّارَقُطْنِيُّ: ضعيف (١) .", "تهذيب الكمال", "3722", -1, "6378", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ضعفوه", "itqan", "ضعفوه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "صحابي", "itqan", "صحابي", "تهذيب التهذيب", 0, -1, "", "", ""]], "4557": [["يحيى بمن معين - وذكر عاصم بن علي بن عاصم ب", "كذاب", "ж", "سمعت يحيى بمن معين - وذكر عاصم بن علي بن عاصم بن صهيب الواسطي - فقال: كذاب ابن كذاب.", "تهذيب الكمال", "3722", -1, "", 0], ["أبو حاتم", "صدوق", "д", "وَقَال أبو حاتم (٣): صدوق.", "تهذيب الكمال", "3722", -1, "3648", 1], ["لها عاصم", "لين", "ж", "قال لها عاصم: تسأليني وهذا عاصم بن علي قاعد؟ أما ليكونن له نبأ، قال: فكنت أتوقعها أربعين سنة.", "تهذيب الكمال", "3722", -1, "", 0], ["له إبراهيم", "يهم", "ж", "قال له إبراهيم: يا أبا الحسين، أبلغ إلى بناتي فأوصيهم وأجدد بهم عهدا. قال: فظنننا أنه ذهب يتكفن ويتحنط، ثم جاء ف", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق يخطئ ويصر ورمي بالتشيع", "تقريب التهذيب", "8609", 328, "3288", 3]], "4562": [["الدارقطني", "ثقة", "д", "وَقَال الدَّارَقُطْنِيُّ (٤): هو ثقة.", "تهذيب الكمال", "3722", -1, "104408", 1], ["لنا علي بن إبراهيم", "صدوق", "д", "وَقَال لنا علي بن إبراهيم: _________ (١) منسوب إلى جبل، بلدة بين بغداد وواسط. (٢) الجرح والتعديل: ٧ / الترجمة ٩٥٧. (٣) بقية كلامه: وهو صدوق. (٤) تاريخ الخطيب: ١", "تهذيب الكمال", "3722", -1, "", 0], ["", "متقن", "д", "ابن حجرب بمقبولب بتقريب التهذيب …ااا بالبخاريب بقال الحاكم قرأت بخط أبي عمرو المستملي سمعت البخاري حدث عن علي بن عبد الله بن إبراهيم البغدادي فسئل عنه فقال متقن", "موسوعة الرواة (джарх)", "", ""]], "4571": [["بعد ذلك", "منكر الحديث", "ж", "ذكره بعد ذلك في \"المجروحين\"وَقَال: منكر الحديث ينفرد عن علي بما لا يشبه حديثه فلا أدري سمع منه سماعا أو أخذ ما يروي عنه عن غيره. (٢ / ١٠٩) .", "تهذيب الكمال", "3722", 7456, "107198", 1], ["بشار", "ضعيف", "ж", "قال بشار: بل ضعيف. (٤) المجادلة (١٢) .", "تهذيب الكمال", "3722", 7456, "107198", 1], ["البخاري", "في حديثه نظر", "д", "في حديثه نظر", "التاريخ الكبير للبخاري", "113", "4321", "11690", 1], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "4567": [["أبو حاتم", "ثقة", "д", "قال أَبُو حَاتِم (١): ثقة.", "تهذيب الكمال", "3722", -1, "3578", 1], ["الحاكم أبو عبد الله الحافظ", "حافظ", "д", "وَقَال الحاكم أَبُو عَبْد اللَّهِ الْحَافِظ: علي بْن عثام بْن عَلِيٍّ أَبُو الحسن الكوفي ساكن نيسابور، أديب، فقيه، حافظ، زاهد، واحد عصره، وكان لا يحدث إلا بعد ا", "تهذيب الكمال", "3722", 7444, "107078", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة فاضل", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صالح", "д", "كان أديبا فقيها صالحا صدوق", "الكاشف / سير أعلام النبلاء", "2171", 730, "7318", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "صدوق", "itqan", "صدوق", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4568": [["النسائي", "ثقة", "д", "قال النَّسَائي (٢): ثقة.", "تهذيب الكمال", "3722", -1, "2708", 1], ["", "صالح", "д", "وَقَال فِي موضع آخر: صالح، لا بأس به. و", "تهذيب الكمال", "3722", 7453, "107168", 1], ["مسلمة", "ثقة", "д", "قال مسلمة في الصلة: ثقة. (٧ / ٣٦٤) . =", "تهذيب الكمال", "3722", 7453, "107168", 1], ["ابن حجر العسقلاني", "لا بأس به", "д", "لا بأس به", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "صدوق", "itqan", "صدوق", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4577": [["إسحاق بن راهويه", "لين", "ж", "سمعت إِسْحَاق بْن راهويه يقول: أَبُو عُبَيد أوسعنا علما، وأكثرنا أدبا، وأجمعنا جمعا. إنا نحتاج إلى _________ (١) تاريخه الكبير: ٧ / الترجمة ٧٧٨. (٢) تاريخ الخطي", "تهذيب الكمال", "3722", 8982, "122458", 2], ["أبي عبيد، ف", "ثقة", "д", "سئل يحيى بْن مَعِين عَن أبي عُبَيد، فَقَالَ: ثقة. وروي عَنْ حمدان بْن سهل (٣)، قال: سألت يَحْيَى بْن مَعِين عَنِ الكتابة عَن أبي عُبَيد والسماع منه، فتبسم، وَقَ", "تهذيب الكمال", "3722", 8983, "122468", 1], ["القاسم بن سلام، ف", "ثقة", "д", "سئل أَبُو دَاوُد عَنِ القاسم بْن سلام، فَقَالَ: ثقة مأمون.", "تهذيب الكمال", "3722", 8983, "122468", 1], ["أبو عبد الرحمن السلمي النيسابوري", "إمام", "д", "وَقَال أَبُو عَبْد الرَّحْمَنِ السلمي النيسابوري: سألت أبا الحسن الدارقطني عَن أبي عُبَيد، فَقَالَ: إمام ثقة جبل، وسلام والده رومي.", "تهذيب الكمال", "3722", 8983, "122468", 1], ["محمد بن عبد الله _________ (١) تاريخ الخطي", "إمام", "д", "سمعت مُحَمَّد بْن عَبد اللَّهِ _________ (١) تاريخ الخطيب: ١٢ / ٤١٤ - ٤١٥. (٢) تاريخ الخطيب: ١٢ / ٤١٤. (٣) نفسه. (٤) تاريخ الخطيب: ١٢ / ٤١٥. الْحَافِظ يقول: كان", "تهذيب الكمال", "3722", 8983, "122468", 0], ["إبراهيم (١) بن إسحاق الحربي", "لين", "ж", "وَقَال إِبْرَاهِيم (١) بْن إِسْحَاق الحربي: أدركت ثلاثة لن يرى مثلهم أبدا تعجز النساء أن يلدن مثلهم ; رأيت أبا عُبَيد القاسم ابن سلام ما مثلته إلا بجبل نفخ فيه ", "تهذيب الكمال", "3722", 8984, "122478", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوقي وكان يدلس ويتشيع", "تقريب التهذيب", "8609", 330, "3308", 3], ["الذهبي", "وثقه", "ж", "مختلف فيه وثقه ابن معيني وقال أبو داود ترك حديثه", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "4570": [["محمد بن عبد الله بن عمار الموصلي", "ثقة", "д", "قال محمد بْن عَبد اللَّه بْن عمار الموصلي: سألت عنه بدمشق، قالوا: ثقة. _________ =", "تهذيب الكمال", "3722", 7454, "107178", 0], ["يحيى بن معين", "ليس بشيء", "ж", "وَقَال عثمان بْن سَعِيد الدارمي (١)، عَنْ يحيى بْن مَعِين: ليس بشيءٍ. و", "تهذيب الكمال", "3722", 7455, "107188", 1], ["البخاري", "مجهول", "ж", "قَال البُخارِيُّ: مجهول.", "تهذيب الكمال", "3722", -1, "100078", 1], ["أبو حاتم", "متروك", "ж", "وَقَال أَبُو حَاتِم (٢): متروك الْحَدِيث.", "تهذيب الكمال", "3722", -1, "107188", 1], ["صالح بن محمد الأسدي", "صالح", "д", "وَقَال صالح بْن محمد الأسدي: عثمان بن عبد الرحمن القرشي الوقاصي كَانَ يضع الحديث، وعلي بْن عروة الدمشقي أكذب مِنْهُ.", "تهذيب الكمال", "3722", 7455, "107188", 1], ["أبو الفتح الأزدي", "لا يكتب حديثه", "ж", "وَقَال أَبُو الفتح الأزدي: لا يكتب حديثه.", "تهذيب الكمال", "3722", 7455, "107188", 1], ["يحيى بن معين، ليس حديثه بشيء، وهو", "ضعيف", "ж", "قال يَحْيَى بْن مَعِين، ليس حديثه بشيءٍ، وهو ضعيف عن كل من روى عنه (٥) . روى له ابن ماجة. _________ (١) تاريخه، الترجمة ٦٢٢. (٢) الجرح والتعديل: ٦ / الترجمة ١٠٩", "تهذيب الكمال", "3722", 7455, "107188", 2], ["ابن عدي أيضا", "منكر الحديث", "ж", "وَقَال ابن عدي أيضا: منكر الحديث (الكامل: ٢ / الورقة ٢٦٨) .", "تهذيب الكمال", "3722", 7455, "107188", 1], ["", "منكر الحديث", "ж", "وَقَال فِي موضع آخر: منكر الحديث (٧ / ٣٦٥) .", "تهذيب الكمال", "3722", 7455, "107188", 1], ["", "متروك", "ж", "وَقَال في \"التقريب\": متروك.", "تهذيب الك