{"9": [["يحيى بن معين", "ليس به بأس", "д", "قال أحمد بْن مُحَمَّد بْن القاسم بْن محرز البغدادي، عَن يحيى بْن مَعِين: ليس به بأس.", "تهذيب الكمال", "3722", "487", "4878", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد اللَّهِ العجلي (١): ثقة.", "تهذيب الكمال", "3722", "487", "4878", 1], ["أبو الفتح الأزدي", "متروك", "ж", "وَقَال أبو الفتح الأزدي: متروك (٢) . _________ (١) انظر ترتيب ثقات العجلي للهيثمي، الورقة: ٢ (شهيد علي باشا رقم ٢٧٤٧) . (٢) أضاف المزي قول العجلي وأبي الفتح الأ", "تهذيب الكمال", "3722", "487", "4878", 2], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "لين", "ж", "فيه لين", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "30": [["الحافظ أبو إسحاق الحربي", "حافظ", "д", "وَقَال الحافظ أبو إسحاق الحربي في تاريخه: شيخ مدني صالح له فضل ولا أحسبه حافظا\".", "تهذيب الكمال", "3722", "526", "5268", 1], ["ابن معين", "ضعيف", "ж", "وَقَال أبو داود عن ابن مَعِين: ضعيف.", "تهذيب الكمال", "3722", "526", "5268", 1], ["أبو عيسى بن سورة (الترمذي) وأبو علي الطوسي", "ضعفه", "ж", "وَقَال أبو عيسى بن سورة (التِّرْمِذِيّ) وأبو علي الطوسي في كتاب الاحكام، تأليفه: ضعفه بعض أهل العلم.", "تهذيب الكمال", "3722", "526", "5268", 1], ["الحافظ أبويحيى زكريا بن يحيى الساجي", "حافظ", "д", "وَقَال الحافظ أبويحيى زكريا بن يحيى الساجي في كتاب\"التعديل والتجريح\": في حديثه لين: وفي كتاب ابن الجارود: منكر الحديث.", "تهذيب الكمال", "3722", "526", "5268", 1], ["الدارقطني", "ليس بالقوي", "ж", "قال الدارقطني: ليس بالقوي في الحديث. وفي كتاب\"التعريف بصحيح التاريخ\"لابن أَبي خالد: كان مصليا عابدا. ولما ذكر له ابن عدي أحاديث، قال: لم أجد له أوحش من هذه الاح", "تهذيب الكمال", "3722", "526", "5268", 1], ["", "وثقه", "д", "وَقَال في (ديوان الضعفاء الورقة: ٧): وثقه أحمد وضعفه غيره\".", "تهذيب الكمال", "3722", "526", "5268", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["يحيي بن معين", "ضعيف", "jarh", "عباس الدُّورِيُّ، عَن يحيى بْن مَعِين (٣): ضعيف ليس بشيءٍ", "تهذيب الكمال", "3722", 527, "5288", 1]], "32": [["أحمد بن حنبل", "ثقة", "д", "قال أبو طالب عَن أحمد بن حنبل: ثقة. _________ = وتصوم لهما مع صومك\"وَقَال: ف", "تهذيب الكمال", "3722", "524", "", 0], ["عبد الله", "ثقة", "д", "قال عَبد اللَّهِ: يا أبا إسحاق عمن هذا، قال: قلت له: هذا من، حديث شهاب بْن خراش، فقال: ثقة، عمن؟ قال: قلت: عَنِ الحجاج بْن دينار. قال: ثقة عمن؟ قال: قلت:", "تهذيب الكمال", "3722", "524", "5248", 1], ["يحيى بن معين", "صالح", "д", "وَقَال عثمان بْن سَعِيد الدارمي عَن يحيى بْن مَعِين (١): صالح، يكتب حديثه ولا يحتج به.", "تهذيب الكمال", "3722", "524", "5258", 1], ["يحيى بن معين", "ليس بشيء", "ж", "وَقَال عَباس الدُّورِيُّ عَن يحيى بْن مَعِين (٢): ليس بشيءٍ.", "تهذيب الكمال", "3722", "524", "5258", 1], ["أبو حاتم", "لا يحتج به", "ж", "وَقَال أبو حاتم (٣): شيخ ليس بقوي، يكتب حديثه ولا يحتج به منكر الحديث، دون إِبْرَاهِيم بْن إِسْمَاعِيل بْن مجمع، وأحب إلي من إِبْرَاهِيم بْن الفضل. و", "تهذيب الكمال", "3722", "524", "5258", 1], ["البخاري", "منكر الحديث", "ж", "قَال البُخارِيُّ (٤): منكر الحديث.", "تهذيب الكمال", "3722", "524", "5258", 1], ["النسائي", "ضعيف", "ж", "وَقَال النَّسَائي (٥): ضعيف.", "تهذيب الكمال", "3722", "524", "5258", 1], ["الدارقطني", "متروك", "ж", "وَقَال الدَّارَقُطْنِيُّ: متروك.", "تهذيب الكمال", "3722", "524", "5258", 1], ["أبو أحمد بن عدي", "صالح", "д", "وَقَال أَبُو أَحْمَد بْن عَدِيّ (٦): هو صالح في باب الرواية، كما حكي عَن يحيى بْن مَعِين، ويكتب حديثه مع ضعفه.", "تهذيب الكمال", "3722", "524", "5258", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "متروك", "ж", "قال الدارقطني وغيره متروك", "الكاشف / سير أعلام النبلاء", "2171", 201, "2018", 1], ["يحيى بن معين", "صالح", "д", "ت فإبراهيم بن إسماعيل بن أبي حبيبة فقال صالح", "تاريخ الدارمي عن ابن معين", "148", "31", "318", 1], ["النسائي", "ضعيف", "ж", "أبي حبيبة ضعيف مدني", "الضعفاء والمتروكون للنسائي", "10805", "1", "18", 1]], "8": [["عباد بن عباد المهلبي", "يهم", "ж", "قال عباد بْن عباد المهلبي: أتيت شعبة، أنا وحماد بْن زيد، فكلماه في أبان بْن أَبي عياش فقالا له: يا أبا بسطام، تمسك عَنه؟ ! فلقيهم بعد ذلك. فَقَالَ: ما أراني يسع", "تهذيب الكمال", "3722", "503", "5038", 1], ["أبو حاتم", "متروك", "ж", "وَقَال عَبد الله بْن أحمد أيضا، عَن أبيه: أبان بْن أَبي عياش، متروك الحديث، ترك الناس حديثه منذ دهر من الدهر، كان وكيع إذا أتى على حديثه يقول: رجل، ولا يسميه اس", "تهذيب الكمال", "3722", "503", "5038", 1], ["أحمد بن حنبل", "منكر الحديث", "ж", "سمعت أَحْمَد بْن حنبل يقول: لا يكتب عَن أبان بْن أَبي عياش. قلت: كان له هوى؟ قال: كان منكر الحديث.", "تهذيب الكمال", "3722", "503", "5038", 1], ["يحيى بن معين", "صالح", "д", "وَقَال معاوية بْن صالح، عَن يحيى بْن مَعِين: ضعيف.", "تهذيب الكمال", "3722", "503", "5038", 1], ["يحيى", "متروك", "ж", "قال يحيى: وأبان متروك الحديث (٢) . _________ (١) يعني السختياني. (٢) انظر تاريخ يحيى برواية الدوري: ٢ / ٥ - ٦ و", "تهذيب الكمال", "3722", "503", "", 0], ["أبو حاتم الرازي", "متروك", "ж", "وَقَال أبو حاتم الرازي (٣): متروك الحديث، وكان رجلا صالحا، ولكنه بلي بسوء الحفظ.", "تهذيب الكمال", "3722", "503", "5048", 1], ["أبو زرعة عنه ف", "لين", "ж", "سئل أبو زُرْعَة عَنه فَقَالَ: ترك حديثه ولم يقرأ علينا حديثه، فقيل له: كان يتعمد الكذب؟ قال: لا، كان يسمع الحديث من أنس ومن شهر (٥) ومن الحسن، فلا يميز بينهم. و", "تهذيب الكمال", "3722", "503", "5048", 1], ["النسائي", "متروك", "ж", "وَقَال النَّسَائي (٧): متروك الحديث.", "تهذيب الكمال", "3722", "503", "5048", 1], ["", "ليس بثقة", "ж", "وَقَال في موضع آخر: ليس بثقة، ولا يكتب حديثه.", "تهذيب الكمال", "3722", "503", "5048", 1], ["سفيان بن عيينة", "حافظ", "д", "وَقَال إسحاق بْن أَبي إسرائيل، عَن سفيان بْن عُيَيْنَة: كان مالك بْن دينار يقول: كان أبان بن أَبي عياش طاووس القراء (١) . روى له أبو داود حديثا واحدا مقرونا بقت", "تهذيب الكمال", "3722", "503", "5058", 1], ["القراب", "حافظ", "д", "ذكره القراب في تاريخه. (٢) رقم (٤٢٩) في الصلاة: باب في المحافظة على الصلوات من طريق محمد بن عَبد الرحمن العنبري، عن عُبَيد الله بن عَبد المجيد، عن عِمْران بن دا", "تهذيب الكمال", "3722", "503", "5058", 1], ["ابن حجر العسقلاني", "متروك", "ж", "متروك", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "متروك", "ж", "قال أحمد متروك", "الكاشف / سير أعلام النبلاء", "2171", 199, "1998", 1]], "13": [["أبو زرعة", "واه", "ж", "وَقَال أبو زُرْعَة (١): واهي الحديث.", "تهذيب الكمال", "3722", 972, "9728", 1], ["أبو داود", "ضعيف", "ж", "وَقَال أَبُو دَاوُدَ (٤): أبان بْن طارق لا يعرف، ودرست بْن زياد ضعيف.", "تهذيب الكمال", "3722", 3985, "41898", 1], ["", "ثقة", "д", "وَقَال (٥): درست الكبير صاحب أيوب ثقة (٦) .", "تهذيب الكمال", "3722", 3985, "41898", 1], ["أبو أحمد بن عدي", "لا بأس", "д", "وَقَال أَبُو أَحْمَد بْن عدي (٧): أرجو إنه لا بأس بِهِ.", "تهذيب الكمال", "3722", 2085, "20858", 1], ["النسائي", "ليس بالقوي", "ж", "ذكره النَّسَائي في الضعفاء، وَقَال: ليس بالقوي\" (الترجمة ١٨٦) و", "تهذيب الكمال", "3722", 3986, "41908", 1], ["الدارقطني", "متروك", "ж", "ذكره الدَّارَقُطنِيّ في الضعفاء والمتروكين (الترجمة ٢١٣)", "تهذيب الكمال", "3722", 3986, "41908", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول الحال", "تقريب التهذيب", "8609", 13, "895", 1], ["أبو زرعة الرازي", "شيخ", "д", "شيخ مجهول", "الجرح والتعديل", "2170", "706", "4448", 1]], "25": [["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة مأمون أحد الزهاد.", "تهذيب الكمال", "3722", "509", "5108", 1], ["أبو عبد الرحمن السلمي النيسابوري", "ثقة", "д", "وَقَال أبو عَبْد الرحمن السلمي النيسابوري (٤): سألت الدارقطني عَنه، فَقَالَ: إذا روى عنه ثقة، فهو صحيح الحديث. _________ (١) نهاس: بفتح النون وتشديد الهاء وفي آ", "تهذيب الكمال", "3722", "509", "5108", 2], ["أبو عبد الله بن منده الحافظ", "حافظ", "д", "وَقَال أبو عَبْد الله بْن منده الحافظ: إبراهيم بْن أدهم بن منصور بن يزيد بْن جابر بْن ثعلبة بْن سعد بْن حلام بْن غزية بن أسامة بن ربيعة ابن ضبيعة بْن عجل بْن لج", "تهذيب الكمال", "3722", "509", "5118", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "31": [["يحيي بن معين", "ليس بشيء", "ж", "سمعت يحيي بن مَعِين يقول: إبراهيم بن إسماعيل المكي ليس بشيءٍ\".", "تهذيب الكمال", "3722", "529", "5298", 1], ["ابن حزم", "منكر الحديث", "ж", "ذكره ابن حزم: منكر الحديث ويشبه أن يكون وهما. والذي في كتاب\"الجرح والتعديل\"للساجي: ضعيف، وإسماعيل أبوه ضعيف عنده مناكير، روى أبو نعيم عنه نسخة لا يتابع على بعضه", "تهذيب الكمال", "3722", "529", "5298", 1], ["الحافظ أبو عبد الله محمد بن أبي بكر بن خلف", "حافظ", "д", "وَقَال الحافظ أبو عبد الله محمد بن أَبي بكر بن خلف المعروف بابن المواق في كتابه\"بغية النقاد\": لا يحتج به، و", "تهذيب الكمال", "3722", "529", "5298", 1], ["أبو داود عنه ف", "ضعيف", "ж", "سئل أبو داود عنه فقال: ضعيف متروك الحديث،", "تهذيب الكمال", "3722", "529", "5298", 1], ["أبو جعفر العقيلي", "ضعفه", "ж", "وَقَال أبو جعفر العقيلي: حَدَّثَنَا مُحَمَّد بْن عَبد الله الحضرمي (٣) قال: كان ابن نمير لا يرضى إِبْرَاهِيم بْن إِسْمَاعِيل ويضعفه، قال: روى أحاديث مناكير. ___", "تهذيب الكمال", "3722", "529", "5308", 0], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0]], "33": [["أبو حاتم", "ضعيف", "ж", "قال أبو حاتم (١): ضعيف الحديث، منكر الحديث.", "تهذيب الكمال", "3722", "537", "5378", 1], ["الحافظ أبو بكر الخطيب", "حافظ", "д", "وَقَال الحافظ أبو بكر الخطيب (٢): حدث عنه إسرائيل بْن يونس، وأبو سَعِيد الأشج وبين وفاتيهما بضع وتسعون سنة، وحدث عنه الليث بْن سعد والأشج وبين وفاتيهما اثنتان و", "تهذيب الكمال", "3722", "537", "5378", 1], ["بشار", "إمام", "д", "قال بشار: فسكون الزاي والهمز هو الراجح وبه قيده الإمام الذهبي في كتبه الاخرى. وهو من الضعفاء.", "تهذيب الكمال", "3722", "537", "5378", 1], ["ابن المبارك", "ثبت", "д", "قال ابن المبارك: كان قدريا ولم يكن يثبت،", "تهذيب الكمال", "3722", "537", "5378", 1], ["الإمام أحمد بن حنبل", "إمام", "д", "قال الإمام أحمد بْن حنبل: لا يكتب حديثه،", "تهذيب الكمال", "3722", "537", "5378", 1], ["النسائي وغيره", "متروك", "ж", "وَقَال النَّسَائي وغيره: متروك.", "تهذيب الكمال", "3722", "537", "5378", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ضعفه", "ж", "ضعفه أبو حاتم", "الكاشف / سير أعلام النبلاء", "2171", 189, "1898", 1]], "34": [["الحافظ ابن حجر بعد أن أورد قول ابن أبي حات", "حافظ", "д", "وَقَال الحافظ ابن حجر بعد أن أورد قول ابن أَبي حاتم: فيظهر لي أن الذي روى عنه الاشج غير الشيباني، وقد فرق بينهما ابْن حبان فِي \"الثقات\" ف", "تهذيب الكمال", "3722", 538, "5388", 1], ["ابن حبان", "ضعفه", "ж", "قال ابن حبان: إبراهيم بن أعين الشيباني عداده في أهل الرملة، روى عنه هشام بن عمار، يغرب. فهذا هو الذي ضعفه أبو حاتم الرازي، والله أعلم\" (تهذيب: ١ / ١٠٨) .", "تهذيب الكمال", "3722", 538, "5388", 1], ["البخاري", "يهم", "ж", "قال البخاري: يهم في الشئ بعد الشئ، وهو صدوق.", "تهذيب الكمال", "3722", 538, "5388", 1], ["أبي ذكر إبراهيم بن بشار الرمادي ف", "يهم", "ж", "سمعت أبي ذكر إِبْرَاهِيم بْن بشار الرمادي فَقَالَ: كان يحضر معنا عند سفيان بْن عُيَيْنَة، فكان يملي على الناس ما يسمعون من سفيان، وكان ربما أملى عليهم ما لم يسم", "تهذيب الكمال", "3722", 539, "5398", 1], ["أبي", "يهم", "ж", "قال أبي: فقلت له يوما: ألا تتقي الله ويحك! تملي عليهم ما لم يسمعوا؟ ولم يحمده أبي في ذلك وذمه ذما شديدا.", "تهذيب الكمال", "3722", 539, "5398", 1], ["معاوية بن صالح", "صالح", "д", "وَقَال معاوية بْن صالح: سألت يحيى بْن مَعِي", "تهذيب الكمال", "3722", 539, "5398", 1], ["ابن حجر العسقلاني", "حافظ", "д", "حافظ له أوهام", "تقريب التهذيب", "8609", 14, "1048", 1]], "35": [["لي سعيد بن سليمان، حدثنا داود بن عبد الجبا", "منكر الحديث", "ж", "قال لي سَعِيد بن سُلَيْمان، حَدَّثَنَا داود بن عبد الجبار - وكان ببغداد وهو منكر الحديث - سمع إبراهيم بْنُ جَرِيرٍ، قال: حَدَّثني أَبِي أَنَّهُ سَمِعَ النَّبِيّ", "تهذيب الكمال", "3722", "545", "5468", 1], ["الحافظ ابن حجر", "حافظ", "д", "وَقَال الحافظ ابن حجر: إنما جاءت روايته عَن أبيه بتصريح التحديث منه من طريق داود بن عبد الجبار عنه، وداود ضعيف ونسبه بعضهم إلى الكذب، وقد روى عَن أبيه بالعنعنة ", "تهذيب الكمال", "3722", "545", "5468", 1], ["الإمام الذهبي", "إمام", "д", "وَقَال الإمام الذهبي في (الميزان): صدوق\"", "تهذيب الكمال", "3722", "545", "5468", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "37": [["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة (١) . و", "تهذيب الكمال", "3722", "549", "2708", 1], ["البخاري", "وثقه", "д", "قَال البُخارِيُّ (٢): مَاتَ سنة ثلاث ومئتين. رَوَى لَهُ النَّسَائي حَدِيثًا واحِدًا عَن أَبِيهِ، عَنْ عَمْرو بْنِ دِينَارٍ، عَنْ جَابِرِ بْنِ عَبد الله بن عَمْر", "تهذيب الكمال", "3722", "549", "5498", 1], ["أبو عبد الرحمن السلمي", "وثقه", "д", "قال أَبُو عبد الرحمن السلمي: وسألته، يعني الدارقطني، عَن إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ حبيب فقال: هو وأبوه وجده ثقات\". ووثقه أيضا: ابن قانع البغدادي، وأبو عب", "تهذيب الكمال", "3722", "549", "5498", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "40": [["بعد ذلك", "ضعفه", "ж", "وَقَال بعد ذلك: وابرهيم بن الحكم بن أبان لا يختلفون في ضعفه\" (٣ / ٥٤) . وقد تناوله الحافظ ابن حبان البستي في (المجروحين: ١ / ١١٤) وَقَال: لا يعجبني الاحتجاج بخب", "تهذيب الكمال", "3722", "558", "5588", 1], ["الإمام الذهبي", "إمام", "д", "قال الإمام الذهبي في (الميزان: ١ / ٢٧): تركوه وقل من مشاه. (٢) ادعى مغلطاي أن ابْن أَبي حاتم", "تهذيب الكمال", "3722", "558", "5588", 1], ["أبو حاتم", "ثقة", "д", "قال فيه عَن أبيه: ثقة (إكمال: ١ / الورقة: ٥١) وليس بشيءٍ وما هنا هو الصحيح (الجرح والتعديل، ١ / ١ / ٩٣) وذكر أن أباه كتب عنه بالرملة في الرحلة الثانية.", "تهذيب الكمال", "3722", "558", "5588", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في (الكاشف: ١ / ٧٩): ثقة. وانظر (التذهيب: ١ / الورقة: ٣٥) . (٣) في حاشية الاصل من قول المؤلف: ومنهم من أسقط من نسبه مصعبا، ومنهم من أسقط عبد الله،", "تهذيب الكمال", "3722", "558", "5588", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["", "صدوق", "д", "أبو حاتم الرازيب بوكتب عنه أبو حاتم الرازي وقال صدوقب بتهذيب التهذيب …ا بسئل أبي عنه فقال صدوقيب بالجرح والتعديل لابن أبي حاتم …ا بوكتب عنه أبو حاتم الرازي وقال", "موسوعة الرواة (джарх)", "", ""], ["", "ثقة", "д", "تقريب التهذيب …ااا بالذهبىب بثقةب بالكاشف في معرفة من له رواية في الكتب الستة …اااان", "موسوعة الرواة (джарх)", "", ""]], "38": [["ابن قانع", "صالح", "д", "ذكره ابن قانع في وفياته فقال: صالح. وخرج ابن حبان والحاكم أَبُو عَبْد اللَّهِ حديثه في صحيحيهما، روى = روى له النَّسَائي.", "تهذيب الكمال", "3722", "551", "5528", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة يهم قليل", "تقريب التهذيب", "8609", 14, "1048", 1], ["الذهبي", "وثقه", "ж", "وثقه ابن حبان", "الكاشف / سير أعلام النبلاء", "2171", 27, "5541", 1]], "39": [["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة.", "تهذيب الكمال", "3722", "554", "3168", 1], ["", "ليس به بأس", "д", "وَقَال فِي موضع آخر: ليس به بأس (١) (٢) . _________ (١) ووثقه ابن حبان البستي (الثقات: ١ / الورقة: ١٣)،", "تهذيب الكمال", "3722", "554", "5558", 0], ["الإمام الذهبي، ثقة ثبت (الكاشف", "إمام", "д", "وَقَال الإمام الذهبي، ثقة ثبت (الكاشف: ١ / ٧٩ وراجع التذهيب: ١ / ٣٥) . (٢) ومما يستدرك على المزي: ٢٦ - س: إِبْرَاهِيم بن الحسن بن نجيح الباهلي المقري التبان الب", "تهذيب الكمال", "3722", "554", "5558", 1], ["إبراهيم بن الحسن ف", "ثقة", "д", "سئل أبو زُرْعَة عن إبراهيم بن الحسن فقال: كتبت عنه بالبصرة، وكان صاحب قرآن وكان بصيرا به، وكان شيخنا ثقة (الجرح والتعديل: ١ / ١ / ٩٢) . و", "تهذيب الكمال", "3722", "554", "5558", 1], ["ابن الجزري", "ثقة", "д", "وَقَال ابن الجزري في غاية النهاية: ١ / ١١): ثقة، قرأ على سلام بن سُلَيْمان الطويل ويعقوب الحضرمي. وروى الحروف عن المعلي بن عيسى ويونس بن حبيب عَن أبي عَمْرو، وع", "تهذيب الكمال", "3722", "554", "5558", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة ثبت", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "45": [["عبد الله بن أحمد بن حنبل", "ثقة", "д", "قال عَبد اللَّهِ بْن أَحْمَد بْن حنبل: سألت يحيى بْن مَعِين عنه فَقَالَ: ثقة (٣) . قال:", "تهذيب الكمال", "3722", "561", "5628", 1], ["أبي", "ثقة", "д", "وَقَال أبي: كان ثقة، وأثنى عليه خيرا.", "تهذيب الكمال", "3722", "561", "5628", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "41": [["بعد ذلك", "ضعفه", "ж", "وَقَال بعد ذلك: وابرهيم بن الحكم بن أبان لا يختلفون في ضعفه\" (٣ / ٥٤) . وقد تناوله الحافظ ابن حبان البستي في (المجروحين: ١ / ١١٤) وَقَال: لا يعجبني الاحتجاج بخب", "تهذيب الكمال", "3722", "558", "5588", 1], ["الإمام الذهبي", "إمام", "д", "قال الإمام الذهبي في (الميزان: ١ / ٢٧): تركوه وقل من مشاه. (٢) ادعى مغلطاي أن ابْن أَبي حاتم", "تهذيب الكمال", "3722", "558", "5588", 1], ["أبو حاتم", "ثقة", "д", "قال فيه عَن أبيه: ثقة (إكمال: ١ / الورقة: ٥١) وليس بشيءٍ وما هنا هو الصحيح (الجرح والتعديل، ١ / ١ / ٩٣) وذكر أن أباه كتب عنه بالرملة في الرحلة الثانية.", "تهذيب الكمال", "3722", "558", "5588", 1], ["أبو حاتم", "صدوق", "д", "قال أَبُو حاتم: صدوق (٣) . _________ (١) و", "تهذيب الكمال", "3722", "558", "", 0], ["الإمام مالك بن أنس على الرغم من قول ابن سع", "إمام", "д", "ذكره الخطيب فيمن روى عن الإمام مالك بن أنس على الرغم من قول ابن سعد في طبقاته (٥ / ٤٤١): ولم يجالس إبراهيم بن حمزة مالك بن أنس. (٢)", "تهذيب الكمال", "3722", "558", "5598", 1], ["النسائي", "ليس به بأس", "д", "وَقَال النَّسَائي: ليس به بأس.", "تهذيب الكمال", "3722", "558", "4488", 1], ["محمد بن سعد", "ثقة", "д", "وَقَال مُحَمَّد بْن سعد (١): ثقة صدوق في الحديث. يأتي الربذة (٢) كثيرا فيقيم بها، ويتجر بها ويشهد العيدين بالمدينة (٣) .", "تهذيب الكمال", "3722", "558", "5608", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "قال أبو حاتم صدوق", "الكاشف / سير أعلام النبلاء", "2171", 204, "2048", 1]], "48": [["أبي", "صالح الحديث", "д", "سمعت أبي يقول: إبراهيم بن زياد سيلان صالح الحديث ثقة كتبت عنه ببغداد\" (الجرح والتعديل: ١ / ١ / ١٠٠) فكان ينبغي للمزي إكمال قول أبي حاتم: صالح الحديث ثقة. (٢) وو", "تهذيب الكمال", "3722", "569", "5698", 1], ["محمد بن سعد", "ثقة", "д", "قال مُحَمَّد بْن سعد (٢): كان ثقة وله أحاديث. ومات سنة ثلاث وخمسين ومئة وهُوَ ابن أربع وسبعين سنة. و", "تهذيب الكمال", "3722", "569", "5708", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "44": [["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة مأمون، أحد الفقهاء.", "تهذيب الكمال", "3722", "562", "5648", 1], ["الحافظ أبو بكر الخطيب", "حافظ", "д", "وَقَال الحافظ أبو بكر الخطيب (٦): كان أحد الثقات المأمونين، ومن الأئمة الأعلام في الدين، وله كتب مصنفة في الأحكام، جمع فيها بين الحديث والفقه. _________ (١) أي:", "تهذيب الكمال", "3722", "562", "5648", 0], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "أحد المجتهدين ثقة مأمون", "الكاشف / سير أعلام النبلاء", "2171", 430, "4308", 3]], "49": [["أبي يذكر", "ضعفه", "ж", "سمعت أبي يذكر، قال: ذكر عند يحيى بن سَعِيد عقيل وابراهيم بن سعد فجعل كأنه يضعفهما يقول: عقيل وابراهيم بن سعد! عقيل وإبراهيم بن سعد!.", "تهذيب الكمال", "3722", "576", "5768", 1], ["محمد بن سعد", "ثقة", "д", "قال مُحَمَّد بْن سعد (١): كان ثقة كثير الحديث. روى له البخاري ومسلم والنَّسَائي وابن ماجه (٢) .", "تهذيب الكمال", "3722", "576", "5778", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["العجلي", "ثقة", "д", "دني تابعي ثقة", "معرفة الثقات للعجلي", "5825", "23", "1488", 1]], "46": [["وكيع بن الجراح", "يكذب", "ж", "قال مُحَمَّد بْن عقبة السدوسي (١)، عن وكيع بْن الجراح: هو أشرف من أن يكذب.", "تهذيب الكمال", "3722", 4325, "47248", 1], ["أبو حاتم", "ليس به بأس", "д", "وَقَال عَبد اللَّهِ بْن أَحْمَد بْن حنبل (٢)، عَن أبيه: ليس به بأس، حديثه حديث أهل الصدق.", "تهذيب الكمال", "3722", 4325, "47248", 1], ["عنه مرة أخرى، ف", "صدوق", "д", "سئل عنه مرة أخرى، فقَالَ: كان صدوقا.", "تهذيب الكمال", "3722", 4325, "47248", 1], ["يحيى بن معين", "ليس بشيء", "ж", "وَقَال عَباس الدُّورِيُّ (٥)، عَنْ يحيى بْن مَعِين: ليس بشيءٍ، وكان عندي في المغازي لا بأس به، زعم عَبد الله بْن إدريس أنه باع بعض داره وكتب المغازي.", "تهذيب الكمال", "3722", 4325, "47248", 1], ["يحيى بن معين", "ثقة", "д", "سمعت يحيى بْن مَعِين يقول: زياد البكائي في ابْن إسحاق ثقة، كأنه يضعفه في غيره.", "تهذيب الكمال", "3722", 4325, "47248", 1], ["يحيى بن معين", "لا بأس به", "д", "وَقَال عثمان بْن سَعِيد الدارمي (٧)، عَن يحيى بْن مَعِين: لا بأس به _________ (١) تاريخ البخاري الكبير: ٣ / الترجمة ١٢١٨. (٢) الجرح والتعديل: ٣ / الترجمة ٢٤٢٥. ", "تهذيب الكمال", "3722", 4325, "47248", 2], ["محمد بن عثمان بن أبي شيبة", "ضعيف", "ж", "وَقَال مُحَمَّد بْن عثمان بْن أَبي شَيْبَة (٢): ذكرت ليحيى بْن مَعِي