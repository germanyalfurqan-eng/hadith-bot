, 1], ["العقيلي وأبو حفص ابن شاهين وأبو العرب القي", "إمام", "д", "ذكره العقيلي وأبو حفص ابن شاهين وأبو العرب القيرواني في جملة الضعفاء\" (١ / الورقة: ٥٩) . وقد تناوله الإمام الذهبي في (الميزان: ١ / ٤٥) وَقَال: كوفي صدوق. لينه ش", "تهذيب الكمال", "3722", "614", "6148", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق ضعيف الحفظ", "تقريب التهذيب", "8609", 17, "1493", 1], ["الذهبي", "ضعفه", "ж", "ضعفه أحمد", "الكاشف / سير أعلام النبلاء", "2171", 209, "2098", 1]], "62": [["معلقا", "لين", "ж", "قال معلقا: فهذه الاحاديث بهذا الإسناد لم أره إلا من رواية إبراهيم بن عبد الرحمن هذا، ولعل هذا من قبل جعفر بن عبد الواحد فإنه لين\".", "تهذيب الكمال", "3722", "619", "6198", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["", "مجهول", "ж", "ابن حجرب بمجهولب بتقريب التهذيب …ااا بالترمذيب باستغرب الترمذي حديثهب بتهذيب التهذيب …ااا بالذهبىب بوذكر الذهبي في الميزان أنه روى عنه أيضا أبو غسان محمد بن مطر", "موسوعة الرواة (джарх)", "", ""]], "69": [["", "ضعيف", "ж", "وَقَال في (ديوان الضعفاء، الورقة: ٩): ضعيف متهم\"", "تهذيب الكمال", "3722", 620, "6208", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق يخطئ", "تقريب التهذيب", "8609", "", "", 0]], "65": [["الحافظ أبو بكر الخطيب", "حافظ", "д", "وَقَال الحافظ أَبُو بكر الخطيب (٣): كَانَ ثقة.", "تهذيب الكمال", "3722", 2590, "27948", 1]], "80": [["عبد الرحمن بن أبي حاتم", "صالح", "д", "قال عَبْد الرحمن بْن أَبي حاتم (٢): حَدَّثَنَا صالح بْن أَحْمَد بْن مُحَمَّد (٣) بْن حنبل قال:", "تهذيب الكمال", "3722", "627", "6288", 1], ["أبو زرعة عنه ف", "ثقة", "д", "سئل أبو زُرْعَة عنه فَقَالَ: مديني أنصاري ثقة (٥) . و", "تهذيب الكمال", "3722", "627", "6288", 1], ["محمد بن سعد", "إمام", "д", "ذكره مُحَمَّد بْن سعد في الطبقة الثالثة (٦) من أهل المدينة، _________ (١) له عنه عند الإمام مسلم حديث واحد في باب الرحمة، ومحمد بن كعب القرظي من أقران إبراهيم ه", "تهذيب الكمال", "3722", "627", "6288", 0], ["المحقق", "ثقة", "д", "ذكره المحقق في الحاشية. (٥) في المطبوع منه: مديني أنصاري زرقي ثقة. (٦)", "تهذيب الكمال", "3722", "627", "6288", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "21": [["أحمد بن عبد الله العجلي", "ثقة", "д", "قال أحمد بْن عَبد اللَّه العِجْلِيّ (١): أبو الأبيض شامي، تابعي، ثقة.", "تهذيب الكمال", "3722", 14185, "176658", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "قال أبو حاتم صدوق", "الكاشف / سير أعلام النبلاء", "2171", 204, "2048", 1]], "84": [["يحيى", "يهم", "ж", "قال يحيى: وقد رأيت أبا إبراهيم بن عقيل. كان إبراهيم بن عقيل هذا يأتي هشام بن يوسف، ولم يكن به بأس، ولكنه ينبغي أن تكون صحيفة وقعت إليهم\". ونقل مغلطاي أن ابن أَب", "تهذيب الكمال", "3722", "636", "6368", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "حافظ", "д", "ابن حبانب بوذكره البستي في كتاب ?ب الثقات ?بب بإكمال تهذيب الكمال …ا بوقال ابن حبان في الثقات إنه يروي أيضا عن عم أبيه وهب بن منبهب بتهذيب التهذيب …ا بوخرج الحا", "موسوعة الرواة (джарх)", "", ""]], "90": [["الساجي", "منكر", "ж", "وَقَال الساجي: روى عن محمد بن عروة حديثًا منكرا. و", "تهذيب الكمال", "3722", "638", "6388", 1], ["يحيى بن معين (٢) ثقة.", "ثقة", "д", "وَقَال إسحاق بْن منصور عَن يحيى بْن مَعِين (٢) ثقة.", "تهذيب الكمال", "3722", "638", "6398", 1], ["النسائي", "ليس به بأس", "д", "وَقَال النَّسَائي: ليس به بأس.", "تهذيب الكمال", "3722", "638", "4488", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["", "صدوق", "д", "ابن حبانب بوكان من العباد الخشنب بالثقات …ا بوقال ابن حبان في الثقات كان من العباد الخشن وهم إخوة أربعة إبراهيم ومحمد وحفص ووهب بنو عمر بن كيسانب بتهذيب التهذيب", "موسوعة الرواة (джарх)", "", ""]], "87": [["عثمان بن سعيد الدارمي", "ليس به بأس", "д", "قال عثمان بْن سَعِيد الدارمي (١): قلت ليحيى بْن مَعِين: إِبْرَاهِيم بْن علي الرافعي من هو؟ قال: شيخ مات بالقرب، كان هاهنا ليس به بأس، قلت: يقول: حدثني عمي أيوب ", "تهذيب الكمال", "3722", 637, "6378", 1], ["", "ليس به بأس", "д", "قال (٢): ليس به بأس. و", "تهذيب الكمال", "3722", 235, "2358", 1], ["البخاري", "فيه نظر", "ж", "قَال البُخارِيُّ (٣): فيه نظر.", "تهذيب الكمال", "3722", 637, "6378", 1], ["الدارقطني", "ضعيف", "ж", "وَقَال الدَّارَقُطْنِيُّ: ضعيف.", "تهذيب الكمال", "3722", 637, "6378", 1], ["أبو حاتم بن حبان", "يخطئ", "ж", "وَقَال أبو حاتم بْن حبان (٥): كان يخطئ حتى خرج من حد من يحتج به إذا انفرد (٦) . روى له ابن ماجه.", "تهذيب الكمال", "3722", 637, "6378", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ضعفه", "ж", "ضعفه الدارقطني", "الكاشف / سير أعلام النبلاء", "2171", 212, "2128", 1]], "83": [["يحيى بن معين، والنسائي", "ثقة", "д", "وَقَال عَبد اللَّهِ بْن أَحْمَد بْن حنبل عَن أبيه، وإسحاق بْن مَنْصُور عَنْ يحيى بْن مَعِين، والنَّسَائي: ثقة.", "تهذيب الكمال", "3722", "634", "6358", 1], ["إبراهيم بن عقبة، ف", "لا بأس", "д", "سمعت أبي يقول وسألته عن إبراهيم بن عقبة، فَقَالَ: صَالِح لا بأس بِهِ. قلت: يحتج بحديثه؟ قال: يكتب حديثه (الجرح والتعديل: ١ / ١ / ١١٧) . وفي سؤالات الحاكم للدارق", "تهذيب الكمال", "3722", "634", "6358", 1], ["أبو عمر بن عبد البر", "ثقة", "д", "وَقَال أَبُو عُمَر بْن عَبد الْبَرِّ في كتاب\"التمهيد\": سمع إبراهيم من جماعة من التابعين، وروى عنه جماعة من أئمة الحديث وهو ثقة عندهم فيما حمل ونقل.", "تهذيب الكمال", "3722", "634", "6358", 1], ["ابن خلفون", "ثقة", "д", "وَقَال ابن خلفون: هو عندهم ثقة. ووثقه أيضا أبو حفص ابن شاهين وابن منجويه والذهبي (انظر ثقات ابن شاهين، الورقة: ٦، وثقات ابن حبان: ١ / الورقة: ١٧، ورجال صحيح مسل", "تهذيب الكمال", "3722", "634", "6358", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "81": [["العجلي", "ثقة", "д", "قال العجلي: كوفي تابعي ثقة. وكناه ابن خلفون أبا إسحاق. وفي كتاب الصريفيني: روى له مسلم حديثا واحدا في كتاب الحج. و", "تهذيب الكمال", "3722", 610, "6108", 1], ["", "حافظ", "д", "ذكره في الصحابة: أبو نعيم وابن مندة الحافظان\" (إكمال: ١ / الورقة ٥٨) . وأخذ ابن حجر ما", "تهذيب الكمال", "3722", 610, "6108", 1], ["أبو حاتم", "صدوق", "д", "قال أبو حاتم: صدوق (١) .", "تهذيب الكمال", "3722", 315, "3158", 1], ["ابن حجر العسقلاني", "متروك", "ж", "متروك الحديث", "تقريب التهذيب", "8609", 18, "1631", 1]], "88": [["مغلطاي", "لا بأس به", "д", "وَقَال مغلطاي: كذا هو في نسختين جيدتين، وكذا نقله عنه الباجي وابن خلفون، والذي نقله عنه المزي،\"لا بأس به\"لم أره\" (إكمال: ١ / الورقة: ٦٢) .", "تهذيب الكمال", "3722", "641", "6418", 1], ["بشار", "وثقه", "д", "قال بشار: هو قول النَّسَائي فجمعه معه المزي، وليس فيه اختلاف في التوثيق، ووثقه أبو عيسى التِّرْمِذِيّ، والدارقطني، والحاكم، وابن حبان، والذهبي (ثقات ابن حبان: ١", "تهذيب الكمال", "3722", "641", "6418", 1], ["مغلطاي", "حافظ", "д", "وَقَال مغلطاي: وفي كتاب الحافظ أبي إسحاق الصريفيني: مات سنة ثلاث وثلاثين ومئتين، وكذا", "تهذيب الكمال", "3722", "641", "6418", 1], ["صاحب \"الكمال\" ولا أدري لم", "عدل", "д", "ذكره صاحب \"الكمال\" ولا أدري لم عدل المزي عنه ولم يبين فيه قدحا إذ لو بين قدحا لقبل، وإن كان اعتقد ما نقله عن الكلاباذي قادحا فليس بشيءٍ لان الثلاث والثلاثين هي ", "تهذيب الكمال", "3722", "641", "6418", 1]], "92": [["البخاري فيه", "منكر الحديث", "ж", "قال البخاري فيه: منكر الحديث،", "تهذيب الكمال", "3722", "645", "6458", 1], ["أبو زرعة", "ليس بالقوي", "ж", "وَقَال أَبُو زُرْعَة: ليس بالقوي.", "تهذيب الكمال", "3722", "645", "6458", 1], ["يحيى بن معين", "صدوق", "д", "قال إِبْرَاهِيم بْن عَبد اللَّهِ بْن الجنيد عَنْ يحيى بْن مَعِين: كان مسلما صدوقا، لم يكن من أصحاب الحديث.", "تهذيب الكمال", "3722", "645", "6468", 1], ["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي: ليس بالقوي (٣) .", "تهذيب الكمال", "3722", "645", "3268", 1], ["العجلي", "صدوق", "д", "وَقَال العجلي: صدوق. و", "تهذيب الكمال", "3722", "645", "6468", 1], ["الذهبي", "صالح", "д", "وَقَال الذهبي في (الميزان: ١ / ٥١) بعد أن أورد قولي أبي حاتم والنَّسَائي: وحديثه صالح\". وانظر تاريخ الاسلام له، الورقة: ١٩٢ (أيا صوفيا: ٣٠٠٦، والكاشف: ١ / ٨٩، و", "تهذيب الكمال", "3722", "645", "6468", 1], ["إبراهيم بن عيينة وعمران ومحمد ابني عيينة ف", "صالح", "д", "سئل أَبُو داود عن إبراهيم بن عُيَيْنَة وعِمْران ومحمد ابني عُيَيْنَة فقال: كلهم صالح وحديثهم قريب من بعض. وفي تاريخ ابن أَبي خيثمة الكبير: قال: سُلَيْمان بن أَب", "تهذيب الكمال", "3722", "645", "6468", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق يهم", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ليس بالقوي", "ж", "قال النسائي ليس بالقوي", "الكاشف / سير أعلام النبلاء", "2171", 186, "1868", 1]], "86": [["ابن الجارود والعقيلي", "صالح", "д", "ذكره ابن الجارود والعقيلي في \"الضعفاء\". ومحمد بْن يحيى الذهلي، ويحيى بْن عثمان بْن صالح السهمي، ويحيى بْن مُحَمَّد بْن عَمْرو المعروف بابن عَمْروس المِصْرِي وهو", "تهذيب الكمال", "3722", 851, "8518", 1], ["أبو حاتم", "لا بأس به", "д", "قال أبو حاتم (٢): شيخ لا بأس به، ولكنهم يحسدونه،", "تهذيب الكمال", "3722", 851, "8518", 1], ["النسائي", "ليس بثقة", "ж", "وَقَال النَّسَائي: ليس بثقة (٣) .", "تهذيب الكمال", "3722", 851, "8518", 1], ["يحيى بن معين - وأثنى على إسحاق بن الزبريق", "لا بأس به", "д", "سمعت يحيى بْن مَعِين - وأثنى على إسحاق بن الزبريق خيرا - وَقَال: الفتى لا بأس به ولكنهم يحسدونه.", "تهذيب الكمال", "3722", 851, "8518", 1], ["النسائي", "ليس بثقة", "ж", "قال النَّسَائي: إسحاق ليس بثقة إذا روى عن عَمْرو بن الحارث\" (تهذيب ابن بدران: ٢ / ٤٠٧)، ولعل مما يقوي الذي ذهبنا إليه أن الإمام النَّسَائي لم ي", "تهذيب الكمال", "3722", 852, "8528", 1], ["مغلطاي", "يهم", "ж", "وَقَال مغلطاي: خرج الحاكم وابن حبان حديثه في صحيحيهما بعد", "تهذيب الكمال", "3722", 852, "8528", 1], ["مسلمة", "ثقة", "д", "وَقَال مسلمة: ثقة - كذا لقيته في نسخة وفي أخرى", "تهذيب الكمال", "3722", 852, "8528", 1], ["لي ابن عوف", "يكذب", "ж", "وَقَال لي ابن عوف: ما أشك أن إسحاق بن إبراهيم بن زبريق يكذب\"", "تهذيب الكمال", "3722", 852, "8528", 1], ["الذهبي", "صدوق", "д", "شيخ صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "95": [["فيه", "إمام", "д", "قال فيه: إِبْرَاهِيم بن محمد بن أَبي عطاء (٤) . رَوَى عَن: إسحاق بْن عَبد الله بْن أَبي طلحة، والحارث بْن فضيل، وحسين بْن عَبد الله بن عُبَيد الله بن عباس، وداو", "تهذيب الكمال", "3722", "666", "6668", 1], ["فيه\"ثقة صدوق\"، وأن أباه", "ثقة", "д", "قال فيه\"ثقة صدوق\"، وأن أباه قال: ثقة صالح\"فقوله\"زاد\"قد يفهم منها أن أبا حاتم", "تهذيب الكمال", "3722", "666", "6668", 1], ["فيه\"ثقة صدوق صالح\"وهو ما لم يقله (قارن الج", "ثقة", "д", "قال فيه\"ثقة صدوق صالح\"وهو ما لم يقله (قارن الجرح والتعديل: ١ / ١ / ١٢٤) . (٢)", "تهذيب الكمال", "3722", "666", "6668", 1], ["ابن سعد", "وثقه", "д", "ذكره ابن سعد فِي الطبقة الرابعة من أهل الكوفة ووثقه (٦ / ٣٥٢)،", "تهذيب الكمال", "3722", "666", "6668", 1], ["يعقوب بن سفيان الفسوي", "ثقة", "д", "وَقَال يعقوب بن سفيان الفسوي: حَدَّثَنَا أَبُو نعيم، قال: حَدَّثَنَا سفيان عن إبراهيم ابن محمد بن المنتشر - شريف، ثقة، كوفي -\" (المعرفة والتاريخ: ٣ / ٩٨) .", "تهذيب الكمال", "3722", "666", "6668", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي: كوفي ثقة\" (الثقات، الورقة: ٣) . ووثقه أبو حفص ابن شاهين (الثقات، الورقة: ٦) و", "تهذيب الكمال", "3722", "666", "6668", 1], ["ابن حبان البستي", "متقن", "д", "ذكره ابنُ حِبَّان البستي في (الثقات: ١ / الورقة: ١٩)، وفي (مشاهير علماء الامصار: ١٦٤) وَقَال: من متقني أهل الكوفة\"،", "تهذيب الكمال", "3722", "666", "6668", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي: ثقة قانت لله نبيل\" (الكاشف: ١ / ٩١)، وانظر تاريخ البخاري الكبير: ١ / ١ / ٣٢٠، ورجال صحيح مسلم لابن منجويه، الورقة: ٥ - ٦، والجمع لابن القيسراني: ", "تهذيب الكمال", "3722", "666", "6668", 1], ["يحيى بن سعيد القطان", "ثقة", "д", "وَقَال يحيى بْن سَعِيد القطان: سألت مالكا عَنه: أكان ثقة؟ قال: لا، ولا ثقة في دينه.", "تهذيب الكمال", "3722", "666", "6688", 1], ["أحمد بن حنبل", "لا يكتب حديثه", "ж", "وَقَال أبو طالب أحمد بْن حميد عَن أحمد بْن حنبل: لا يكتب حديثه، ترك الناس حديثه. كان يروي أحاد", "تهذيب الكمال", "3722", "666", "6688", 1], ["ابن حجر العسقلاني", "متروك", "ж", "متروك", "تقريب التهذيب", "8609", "", "", 0]], "4": [["أبو حاتم", "صالح", "д", "قال أبو حاتم (٣): صالح. _________ (١) الوفيات لابن زبر عَن أبي زرعة، الورقة: ٦٧. ونقل مغلطاي في \"الاكمال\"عن كتاب\"أحاديث التابعين\"للمديني أنه قال: وتوفي في جمادى", "تهذيب الكمال", "3722", "789", "7898", 2], ["إنه كان ممن يكتب عنه شعبة، وكان ثقة\" (ثقات", "ثقة", "д", "قال إنه كان ممن يكتب عنه