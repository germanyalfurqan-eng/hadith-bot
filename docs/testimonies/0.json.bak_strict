، ولعل هذا من قبل جعفر بن عبد الواحد فإنه لين\".", "تهذيب الكمال", "3722", 618, "6188", 1], ["", "ضعيف", "ж", "وَقَال في (ديوان الضعفاء، الورقة: ٩): ضعيف متهم\"", "تهذيب الكمال", "3722", 620, "6208", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق حافظ تكلم فيه بسبب القرآن", "تقريب التهذيب", "8609", 16, "1340", 1], ["الذهبي", "ليس بالقوي", "ж", "قال النسائي وغيره ليس بالقوي ووثقه طائفة", "الكاشف / سير أعلام النبلاء", "2171", 207, "2078", 1]], "70": [["ابن معين", "وثقه", "д", "وَقَال ابن مَعِين: كان الزُّهْرِيّ يغلط فيه\". (تهذيب: ١ / ١٣٤، ١٣٥) (٢) ووثقه ابن حبان و", "تهذيب الكمال", "3722", "608", "6088", 1], ["ابن خلفون", "ثقة", "д", "وَقَال ابن خلفون: هو ثقة مشهور، وصحح أبو عيسى حديثه في جامعه..وخرج ابن حبان حديثه في صحيحه =", "تهذيب الكمال", "3722", "608", "6088", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "صدوق", "д", "ابن حبانب بولما ذكره البستي في كتاب ?ب الثقات ?ب قال روى عن أبي سلمةب بإكمال تهذيب الكمال …ا بوخرج ابن حبان حديثه في ?ب صحيحه ?ب وكذلك الحاكمب بإكمال تهذيب الكم", "موسوعة الرواة (джарх)", "", ""]], "74": [["لنا عبد الله بن صالح", "صالح", "д", "وَقَال لنا عَبد الله بن صالح: حدثني الليث، قال: حدثني نافع عن إبراهيم بن عَبد الله بْن معبد بْن عباس عن ميمونة، قالت:", "تهذيب الكمال", "3722", "612", "6128", 1], ["البني ﷺ يقول\"صلاة", "واه", "ж", "سمعت البني ﷺ يقول\"صلاة في مسجدي هذا أَفْضَلُ مِنْ أَلْفِ صَلاةٍ فِيمَا سواه إلا مسجد الكعبة\"", "تهذيب الكمال", "3722", "612", "6128", 1], ["الحافظ ابن حجر", "حافظ", "д", "قال الحافظ ابن حجر: فهذا مشعر لصحة روايته عن ميمونة عند البخاري، وقد علم مذهبه في التشديد في هذه المواطن، وقد نبه المزي في الاطراف على أن روايته عن ميمونة بإسقا", "تهذيب الكمال", "3722", "612", "6128", 1], ["تعليقا على ما ورد", "حجة", "д", "قال تعليقا على ما ورد في تاريخ البخاري الكبير: وليس هذا مخلصا للمزي لان البخاري إنما أنكر دخول ابن عباس في هذه الرواية بينهما لا أن سماعة منها صحيح، ومن علم حجة", "تهذيب الكمال", "3722", "612", "6128", 1], ["ابن سعد لا يؤخذ حجة، والاحسن من هذا ما", "حجة", "д", "ذكره ابن سعد لا يؤخذ حجة، والاحسن من هذا ما", "تهذيب الكمال", "3722", "612", "6128", 1], ["الحافظ ابن حجر، والله أعلم. (٢) وانظر الجر", "حافظ", "д", "ذكره الحافظ ابن حجر، والله أعلم. (٢) وانظر الجرح والتعديل لابن أَبي حاتم: ١ / ١ / ١٠٨، ورجال صحيح مسلم لابن منجويه، الورقة: ٤، والجمع لابن القيسراني: ١ / ٢٢.", "تهذيب الكمال", "3722", "612", "6128", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "23": [["عمر", "إمام", "д", "سمعت عُمَر يقول: عضل بي أهل الكوفة، ما يرضون بأمير ولا يرضى عنهم أمير\" (الطبقات: ٥ / ٥٨) . (١) بالتصغير على وزن حسين. (٢) تناوله الإمام الذهبي في (الميزان: ١ / ", "تهذيب الكمال", "3722", "609", "6098", 1], ["ابن حجر العسقلاني", "ثبت", "д", "لم يثبت له سماع إلا من بعض الصحابة ووثقه العجلي", "تقريب التهذيب", "8609", 17, "1493", 1]], "78": [["العجلي", "ثقة", "д", "قال العجلي: كوفي تابعي ثقة. وكناه ابن خلفون أبا إسحاق. وفي كتاب الصريفيني: روى له مسلم حديثا واحدا في كتاب الحج. و", "تهذيب الكمال", "3722", "610", "6108", 1], ["", "حافظ", "д", "ذكره في الصحابة: أبو نعيم وابن مندة الحافظان\" (إكمال: ١ / الورقة ٥٨) . وأخذ ابن حجر ما", "تهذيب الكمال", "3722", "610", "6108", 1], ["أبو حاتم", "صدوق", "д", "قال أبو حاتم: صدوق (١) .", "تهذيب الكمال", "3722", "610", "3168", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["", "صدوق", "д", "أبو حاتم الرازيب بقال أبو حاتم صدوقب بتهذيب الكمال …ا بقال أبو حاتم صدوقب بتهذيب التهذيب …ااا بابن حبانب بوذكره ابن حبان في الثقاتب بتهذيب التهذيب …ااا بابن حجر", "موسوعة الرواة (джарх)", "", ""]], "61": [["أبو حاتم", "ثقة", "д", "قال عَبد اللَّهِ بْن أَحْمَد بْن حنبل عَن أبيه: ثقة. وكذلك", "تهذيب الكمال", "3722", "613", "6138", 1], ["يحيى بن معين", "ليس به بأس", "д", "وَقَال إسحاق بْن مَنْصُور عَنْ يحيى بْن مَعِين: ليس به بأس.", "تهذيب الكمال", "3722", "613", "6138", 1], ["أبو حاتم", "صالح", "д", "وَقَال أبو حاتم: صالح يكتب حديثه.", "تهذيب الكمال", "3722", "613", "6138", 1], ["الع