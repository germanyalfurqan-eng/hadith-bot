{"21105": [["ابن حجر\"التقريب\"", "لين", "ж", "قال ابن حجر\"التقريب\": لايعرف حالها. روى أَبُو داود فِي \"المراسيل\"، عَنْ عُبَيد اللَّهِ بْن معاذ، عَن أَبِيهِ، عَنْ عَبد اللَّهِ بن عون، قال: أتيت حذاء بالمدينة،", "تهذيب الكمال", "3722", -1, "188408", 1]], "21184": [["الحاكم أبو عبد الله الحافظ", "لين", "ж", "قال الحاكم أَبُو عَبْد اللَّهِ الْحَافِظ: قرأت بخط أَبِي عَمْرو المستملي: أملى علينا إسحاق بْن منصور سنة إحدى وخمسين ومئتين، ومسلم بْن الحجاج ينتخب عليه وأنا أس", "تهذيب الكمال", "3722", 11632, "148958", 1], ["الثقة من أصحابنا وأكثر ظني أنه أبو سعيد بن", "ثقة", "д", "سمعت الثقة من أصحابنا وأكثر ظني أنه أَبُو سَعِيد بْن يعقوب يقول: رأيت فيما يرى النائم كان أبا علي الزغوري (٣) يمضي في شارع الحيرة", "تهذيب الكمال", "3722", 11633, "148968", 1], ["أبو حاتم الرازي", "مجهول", "ж", "مجهول", "الجرح والتعديل", "2170", "3379", "", 0], ["ابو حاتم", "ثقه", "jarh", "أَبُو حَاتِم (١): ثقة صدوق", "تهذيب الكمال", "3722", -1, "128608", 1], ["ابو زرعه", "منكر الحديث", "jarh", "أَبُو زُرْعَة (١): منكر الحديث", "تهذيب الكمال", "3722", -1, "129418", 1], ["يحيي بن معين", "ثقه", "jarh", "إسحاق بْن منصور (١) ، عَنْ يحيى بْن مَعِين: ثقة (٢)", "تهذيب الكمال", "3722", -1, "130058", 1], ["علي بن المديني", "ليس به باس", "jarh", "علي بن المديني: ليس به بأس (٩ / ١٢٣) وَقَال ابن حجر في \"التقريب\": صدوق يخطئ", "تهذيب الكمال", "3722", 9918, "131818", 1], ["النسايي", "ثقه", "jarh", "النَّسَائي: ثقة", "تهذيب الكمال", "3722", -1, "133088", 1], ["ابو داود", "صدوق", "jarh", "أَبُو دَاوُد (١): قلت لأحمد بن حنبل: أَبُو سعد مُحَمَّد بن ميسر؟ قال: السيناني، هو صدوق", "تهذيب الكمال", "3722", 11023, "142868", 1]], "21132": [["", "مجهول", "ж", "ابن الجوزيب بأشار ابن الجوزي في ?ب العلل ?ب إلى أنه مجهولب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "21144": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …ا بقال الخطيب كان ثقةب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "21145": [["", "ثقة", "д", "أبو حاتم الرازيب بسألت أبي عنه فقال هوا ثقةب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["أبو حاتم الرازي", "ثقة", "д", "ثقة", "الجرح والتعديل", "2170", "3865", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "هَاشم بن مَرْزُوق يروي عَن عَمْرو بن أَبى قيس روى عَنهُ ابْنه عَليّ بن هَاشم", "الثقات لابن حبان", "5816", "4049", "", 0]], "21152": [["", "إمام", "д", "الذهبىب بالإمام المحدث الثقةب بسير أعلام النبلاء …ا بمحدث موثق مشهورب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "21154": [["", "صدوق", "д", "الذهبىب بالشيخ المسند الصدوق بقية المشيخةب بسير أعلام النبلاء …اااان", "موسوعة الرواة (джарх)", "", ""]], "21157": [["", "ضعفه", "ж", "الدارقطنيب بضعفه الدارقطني وأورد له في ?ب الغرائب ?ب حديثا وقال هذا غير محفوظب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "21159": [["", "إمام", "д", "الذهبىب بالشيخ الإمام محدث دمشقب بسير أعلام النبلاء …ا بأحد محدثي الشام الثقاتب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "21160": [["", "لين", "ж", "أحمد بن حنبلب بلينه أحمد بن حنبلب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "21172": [["", "ثقة", "д", "الخطيب البغداديب بالفقيهب بتاريخ بغداد …ا بوكان ثقةيب بتاريخ بغداد …ااا بالذهبىب بوكان ثقةب بتاريخ الإسلام …ا بالفقيهب بتاريخ الإسلام …ااا بعمر بن بشران السكريب", "موسوعة الرواة (джарх)", "", ""]], "21178": [["", "وثقه", "д", "الخطيب البغداديب بوثقه الخطيبيب بتاريخ الإسلام …ااا ببشرىب بوقال لنا بشرى كان من معادن الصدقب بتاريخ بغداد …ااا بمحمد بن العباس البغداديب بحدثني الأزهري عن أبي ", "موسوعة الرواة (джарх)", "", ""]], "21185": [["", "متروك", "ж", "الحاكمب بوقال الحاكم كان شيخ عصرنا ببلدناب بلسان الميزان …ااا بأبو حامد ابن الشرقيب بوقال أبو حامد بن الشرقي متروك الحديثب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "21188": [["", "كذاب", "ж", "ابن حبانب بيروي عن يزيد بن هارون وغيره ربما أغرب مات سنة …يب بلسان الميزان …ا بربما أغربب بالثقات …ا بذكره ابن حبان في ?ب الثقات ?ب هكذاب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "21189": [["", "مجهول", "ж", "الحسينيب بقال الحسيني مجهول كشيخهب بتعجيل المنفعة بزوائد رجال الأئمة الأربعة …اااان", "موسوعة الرواة (джарх)", "", ""]], "21196": [["", "صدوق", "д", "ابن أبي حاتم الرازيب بكتب عنه أبي وكتبت عنه وهو صدوقب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""]], "21124": [["أبو حاتم الرازي", "شيخ", "д", "شيخ لحماد بن زيد ليس بالمشهور", "الجرح والتعديل", "2170", "4093", "40938", 1], ["أبو حاتم بن حبان البستي", "ذكره في الثقات وقال : يروي المراسيل", "д", "ذكره في الثقات وقال : يروي المراسيل", "sunnah.com", "", "", "", 1], ["الذهبي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة", "д", "قال في التقريب : ثقة", "sunnah.com", "", "", "", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1]], "21116": [["ابن عدي", "منكر الحديث", "ж", "منكر الحديث", "الكامل في الضعفاء", "12579", "2092", "1688", 1]], "21125": [["ابن حبان", "ذكره في الثقات", "д", "خَالِد بْن أَبِي عُثْمَان يروي عَن أَبِي الطُّفَيْل روى عَنهُ يَعْقُوب بْن إِسْحَاق الْحَضْرَمِيّ", "الثقات لابن حبان", "5816", "1322", "13228", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "21149": [["ابن حبان", "ذكره في الثقات", "д", "خَالِد بن صبيح من أهل مرو يروي عَن أبي حَمْزَة وَابْن الْمُبَارك روى عَنهُ عبد الْوَارِث بن عبيد الله الْعَتكِي وَأهل بَلَده مُسْتَقِيم الحَدِيث", "الثقات لابن حبان", "5816", "3502", "35028", 1]], "21101": [["ابن شاهين", "ثقة", "д", "ن بن صالح ثقة ليس به باس قاله يحيى", "تاريخ أسماء الثقات لابن شاهين", "5818", "35", "358", 1], ["أبو حاتم بن حبان البستي", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["الذهبي", "وثقه", "д", "وثقه", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة", "д", "قال في التقريب : ثقة", "sunnah.com", "", "", "", 1], ["يحيى بن معين", "لو كان يتقي الله لم يكن يحدث بالمغازي ما كان يحسن يقرؤها", "д", "لو كان يتقي الله لم يكن يحدث بالمغازي ما كان يحسن يقرؤها", "sunnah.com", "", "", "", 1], ["ابن أبي حاتم الرازي", "ذكره في الجرح والتعديل ، وقال : كان من أوثق أصحاب ابن إدريس ، ثقة ، كنت أحسبه مكسور العنق لانحنائه حتى قيل بعد : إنه لا ", "д", "ذكره في الجرح والتعديل ، وقال : كان من أوثق أصحاب ابن إدريس ، ثقة ، كنت أحسبه مكسور العنق لانحنائه حتى قيل بعد : إنه لا ينظر إلى السماء", "sunnah.com", "", "", "", 1], ["الدارقطني", "قال في السنن : ثقة", "д", "قال في السنن : ثقة", "sunnah.com", "", "", "", 1], ["الخطيب البغدادي", "لم يعبه يحيى إلا بأنه كان لا يحسن قراءة المغازي وما فيها من الأشعار وذلك لا يوجب ضعفه وقد كان ثقة صالحا متعبدا", "д", "لم يعبه يحيى إلا بأنه كان لا يحسن قراءة المغازي وما فيها من الأشعار وذلك لا يوجب ضعفه وقد كان ثقة صالحا متعبدا", "sunnah.com", "", "", "", 1], ["أحمد بن عبد الله العجلي", "ثقة ، رجل صالح متعبد", "д", "ثقة ، رجل صالح متعبد", "sunnah.com", "", "", "", 1], ["أبو حفص عمر بن شاهين", "ذكره في الثقات", "д", "ذكره في الثقات", "sunnah.com", "", "", "", 1], ["عبد الرحمن بن يوسف بن خراش", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["عثمان بن أبي شيبة العبسي", "صدوق وليس بحجة", "д", "صدوق وليس بحجة", "sunnah.com", "", "", "", 1], ["أبو علي الغساني", "ذكره في تقييد المهمل وقال : شيخ للبخاري ومسلم", "д", "ذكره في تقييد المهمل وقال : شيخ للبخاري ومسلم", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "صالح ثقة متقن حافظ", "д", "صالح ثقة متقن حافظ", "sunnah.com", "", "", "", 1], ["أحمد بن حنبل", "ثقة ، ومرة : قال صحيح الرواية ، متفقه ، صائن لنفسه في الحديث والورع ، ومرة : اثبت في الحديث من شريك", "д", "ثقة ، ومرة : قال صحيح الرواية ، متفقه ، صائن لنفسه في الحديث والورع ، ومرة : اثبت في الحديث من شريك", "sunnah.com", "", "", "", 1], ["أحمد بن شعيب النسائي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["أبو زرعة الرازي", "اجتمع فيه اتقان وفقه وعبادة وزهد", "д", "اجتمع فيه اتقان وفقه وعبادة وزهد", "sunnah.com", "", "", "", 1], ["أبو أحمد بن عدي الجرجاني", "لم أجد له حديثا منكرا مجاوز المقدار وهو عندي من أهل الصدق", "д", "لم أجد له حديثا منكرا مجاوز المقدار وهو عندي من أهل الصدق", "sunnah.com", "", "", "", 1], ["محمد بن سعد كاتب الواقدي", "ذكره في الطبقات الكبرى وقال : كان ناسكا عابدا ، فقيها حجة ، صحيح الحديث كثيره ، وكان متشيعا", "д", "ذكره في الطبقات الكبرى وقال : كان ناسكا عابدا ، فقيها حجة ، صحيح الحديث كثيره ، وكان متشيعا", "sunnah.com", "", "", "", 1], ["يحيى بن سعيد القطان", "كان سفيان الثوري سيئ الرأي في الحسن بن حي", "д", "كان سفيان الثوري سيئ الرأي في الحسن بن حي", "sunnah.com", "", "", "", 1], ["أبو عبد الله الحاكم", "ذكره في معرفة علوم الحديث وقال : ثقة مأمون", "д", "ذكره في معرفة علوم الحديث وقال : ثقة مأمون", "sunnah.com", "", "", "", 1], ["أبو نعيم الأصبهاني", "ما كان دون الثوري في الورع والقوة ، ما رأيت أحدا إلا وقد غلط في شيء غيره ، ومرة : كتبت عن ثمانمائة محدث فما رأيت أفضل من", "д", "ما كان دون الثوري في الورع والقوة ، ما رأيت أحدا إلا وقد غلط في شيء غيره ، ومرة : كتبت عن ثمانمائة محدث فما رأيت أفضل منه", "sunnah.com", "", "", "", 1], ["يعقوب بن سفيان الفسوي", "ثقة وكان يميل إلى التشيع", "д", "ثقة وكان يميل إلى التشيع", "sunnah.com", "", "", "", 1], ["عبد الرحمن بن مهدي", "ترك حديثه", "д", "ترك حديثه", "sunnah.com", "", "", "", 1], ["سفيان بن عيينة", "صالح بن حي خير من ابنيه ، وعلي خيرهما", "д", "صالح بن حي خير من ابنيه ، وعلي خيرهما", "sunnah.com", "", "", "", 1], ["وكيع بن الجراح", "لو رأيته ذكرت سعيد بن جبير أو شبهته بسعيد بن جبير ، ومرة : لا يبالي من رأى الحسن بن صالح أن لا يرى الربيع بن خثيم", "д", "لو رأيته ذكرت سعيد بن جبير أو شبهته بسعيد بن جبير ، ومرة : لا يبالي من رأى الحسن بن صالح أن لا يرى الربيع بن خثيم", "sunnah.com", "", "", "", 1], ["سفيان الثوري", "ذاك رجل يري السيف علي أمة محمد صلي الله عليه وسلم ، ومرة : الحسن بن صالح مع ما تسمع من علم وفقه يترك الجمعة", "д", "ذاك رجل يري السيف علي أمة محمد صلي الله عليه وسلم ، ومرة : الحسن بن صالح مع ما تسمع من علم وفقه يترك الجمعة", "sunnah.com", "", "", "", 1], ["أبو سعيد بن يونس المصري", "لو لم يولد لكان خيرا له يترك الجمعة ، ويرى السيف جالسته عشرين سنة فما رأيته رفع رأسه إلى السماء ولا ذكر الدنيا", "д", "لو لم يولد لكان خيرا له يترك الجمعة ، ويرى السيف جالسته عشرين سنة فما رأيته رفع رأسه إلى السماء ولا ذكر الدنيا", "sunnah.com", "", "", "", 1], ["زكريا بن يحيى الساجي", "صدوق ، وكان يتشيع", "д", "صدوق ، وكان يتشيع", "sunnah.com", "", "", "", 1], ["عبد الله بن داود الخريبي", "لم يكن شيء ، ومرة : كان معجبا ، والمعجب : الأحمق", "д", "لم يكن شيء ، ومرة : كان معجبا ، والمعجب : الأحمق", "sunnah.com", "", "", "", 1], ["زائدة بن قدامة", "قد استصلب منذ زمان وما نجد أحدا يصلبه ، وكان يجلس في المسجد يحذر الناس من ابن حي وأصحابه", "д", "قد استصلب منذ زمان وما نجد أحدا يصلبه ، وكان يجلس في المسجد يحذر الناس من ابن حي وأصحابه", "sunnah.com", "", "", "", 1], ["عبد الله بن إدريس الكوفي", "ما أنا وابن حي لا يري جمعة ولا جهادا", "д", "ما أنا وابن حي لا يري جمعة ولا جهادا", "sunnah.com", "", "", "", 1], ["أحمد بن يونس الضبي", "لو لم يولد الحسن لكان خيرا له", "д", "لو لم يولد الحسن لكان خيرا له", "sunnah.com", "", "", "", 1], ["يوسف بن أسباط الشيباني", "كان يري السيف", "д", "كان يري السيف", "sunnah.com", "", "", "", 1], ["أبو نصر ابن ماكولا", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["عثمان بن سعيد الدارمي", "ليس في الحديث بذاك ، وهو من أهل الصدق والأمانة", "д", "ليس في الحديث بذاك ، وهو من أهل الصدق والأمانة", "sunnah.com", "", "", "", 1], ["أبو جعفر الطحاوي", "ثقة حجة", "д", "ثقة حجة", "sunnah.com", "", "", "", 1], ["مصنفوا تحرير تقريب التهذيب", "ثقة ، وأخرج به مسلم في صحيحه", "д", "ثقة ، وأخرج به مسلم في صحيحه", "sunnah.com", "", "", "", 1]], "21146": [["ابن سعد", "صحابي", "itqan", "صحابي", "الطبقات الكبرى", 0, -1, "", "", ""]], "21164": [["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "21117": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "21115": [["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]]}