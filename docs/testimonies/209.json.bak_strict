{"20963": [["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق. (٣) المعجم المشتمل، الترجمة ١٠٠٥، وتذهيب التهذيب: ٤ / الورقة ١٢، ونهاية السول، الورقة ٣٥٧، وتهذيب التهذيب: ٩ / ٥٢٥ - ٥٢٦، وال", "تهذيب الكمال", "3722", "14414", "144148", 1], ["العجلي", "لا بأس", "д", "وَقَال العجلي (١): كوفي، لا بأس بِهِ، صاحب قرآن، قرأ على سليم (٢)، وولي قضاء المدائن. و", "تهذيب الكمال", "3722", "14414", "144178", 1], ["البخاري", "ضعفه", "ж", "قَال البُخارِيُّ (٣): رأيتهم مجتمعين على ضعفه (٤) .", "تهذيب الكمال", "3722", "14414", "144178", 1], ["النسائي", "ضعيف", "ж", "وَقَال النَّسَائي (٥): ضعيف.", "تهذيب الكمال", "3722", "14414", "5258", 1]], "20905": [["", "صالح", "д", "أبو سعد السمعانيب بقال ابن السمعاني شيخ صالح كثير الصلاةب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "20906": [["", "صدوق", "д", "الذهبىب بالشيخ المعمر الصدوقب بسير أعلام النبلاء …ا بشيخ معمر عالي الإسناد رحلة الوقتب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "20910": [["", "ثقة", "д", "ابن يونس المصريب بقال ابن يونس ثقةي له سماعات صحاح في كتب أبيهب بسير أعلام النبلاء …ا بقال ابن يونس ثقة له سماعات صحاح في كتب أبيهيب بتاريخ الإسلام …ااا بالذهبى", "موسوعة الرواة (джарх)", "", ""]], "20911": [["", "صدوق", "д", "الخطيب البغداديب بكتبت عنه شيئا يسيرا وكان صدوقا", "موسوعة الرواة (джарх)", "", ""], ["", "صدوق", "д", "تاريخ بغداد …ا بقال الخطيب كتبت عنه وكان صدوقاب بتاريخ الإسلام …ا بقال الخطيب كتبت عنه وكان صدوقايب بسير أعلام النبلاء …ااا بالذهبىب بوكان ثقة صدوقا حسن الأخلاق", "موسوعة الرواة (джарх)", "", ""]], "20913": [["", "لين", "ж", "ابن غلام الزهريب بوقال الحسن بن علي بن عمرو الزهري ليس بالمرضيب بلسان الميزان …ااا بابن ماكولاب بلينه الأمير ابن ماكولايب بلسان الميزان …ااا بالدارقطنيب بوضعفه ", "موسوعة الرواة (джарх)", "", ""]], "20915": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …ااا بالدارقطنيب بوقال الدارقطني لا بأس بهب بتاريخ بغداد …ااا بالذهبىب بكان صدوقاب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "20916": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …ااا بالذهبىب بوهو ثقةب بتاريخ الإسلام …ا بالشيخ المحدث الثقةب بسير أعلام النبلاء …اااان", "موسوعة الرواة (джарх)", "", ""]], "20918": [["", "ضعيف", "ж", "الطحاويب بكان الطحاوي ينكر عليه روايته عن أبيهب بلسان الميزان …اااا ب…ن…ب بالتضعيف الاستثنائيب بكان الطحاوي ينكر عليه روايته عن أبيهب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "20927": [["", "يهم", "ж", "الذهبىب بحدثني عمي سمعت أبي وعمي عن أبيهما عن جدهما أن عبد العزيز بن سيف بن ذي يزن وفد على النبي صلى الله عليه وسلم بهديةي فهؤلاء لا ندرى من هم روى عن هذا ابن م", "موسوعة الرواة (джарх)", "", ""]], "20928": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …اااان", "موسوعة الرواة (джарх)", "", ""]], "20930": [["", "لا بأس به", "д", "أبو حاتم الرازيب بسمعت أبي يقول ذلك وسألته عنه فقال هو شيخب بالجرح والتعديل لابن أبي حاتم …ااا بأبو زرعة الرازيب بنا عبد الرحمن قال سئل أبو زرعة عن فهد بن سلام ", "موسوعة الرواة (джарх)", "", ""]], "20943": [["", "ثقة", "д", "أحمد بن محمد العتيقيب بوقال العتيقي حدث عن ابن مبشر الواسطي وكان يذهب إلى الاعتزال ثقة في الحديثب بلسان الميزان …ااا بالبرقانيب بوقال البرقاني كان معتزليا وكان ", "موسوعة الرواة (джарх)", "", ""]], "20944": [["", "صدوق", "д", "الخطيب البغداديب بوكان صدوقاب بتاريخ بغداد …ااا بالذهبىب بقال الخطيب حدثنا عنه الكتاني بدمشق وكان صدوقاب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "20945": [["", "مجهول", "ж", "علي ابن المدينيب بقال ابن المديني مجهولي روى عن سلمة بن سلامة بن وقش ولا يدرى سمع منه أم لا لأنه لم يقل سمعتب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""]], "20955": [["", "مجهول", "ж", "أبو حاتم الرازيب بذكره ابن أبي حاتم ونقل عن أبيه أنه مجهول", "موسوعة الرواة (джарх)", "", ""], ["", "مجهول", "ж", "لسان الميزان …ااا بالأزديب بوذكره الأزدي فقال مجهول لا يحتج بحديثهي روى عن ليث عن أبي محمد عن معقل بن يسار عن أبي بكر رفعه ?ب الشرك أخفى فيكم من دبيب النمل ?ب و", "موسوعة الرواة (джарх)", "", ""]], "20959": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …اااان", "موسوعة الرواة (джарх)", "", ""]], "20977": [["", "مجهول", "ж", "أبو حاتم الرازيب بسمعت أبي يقول ذلك وسمعته يقول ابن أبي سعد مجهولب بالجرح والتعديل لابن أبي حاتم …ا بقال أبو حاتم هو حديث ضعيف وهذا مجهول رواه عنه مجهول مثله وه", "موسوعة الرواة (джарх)", "", ""]], "20978": [["", "ثقة", "д", "أحمد بن محمد العتيقيب بأحمد بن محمد العتيقي قال سنة ست وتسعين وثلاثمائة فيها توفي أبو بكر محمد بن علي بن النضر الديباجي ثقة مأمونب بتاريخ بغداد …ا بووثقه أبو ال", "موسوعة الرواة (джарх)", "", ""]], "20989": [["", "صالح", "д", "أبو سعد السمعانيب بقال السمعاني شيخ صالح دين خيرب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "20993": [["", "لين", "ж", "الأزديب بوذكره الأزدي في ?ب الضعفاء ?ب وحكى عن النسائي أنه قال لينب بلسان الميزان …ااا بالذهبىب بلا يدرى من هو والخبر الذي رواه باطلب بلسان الميزان …ااا بالنسائ", "موسوعة الرواة (джарх)", "", ""]], "20994": [["", "ضعيف", "ж", "الذهبىب بوكان ضعيفاب بتاريخ الإسلام …ااا بعبد الوهاب الأنماطيب بوقال عبد الوهاب الأنماطي هو شيخ مقاربب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "20995": [["", "صالح", "д", "ابن الجوزيب بقال ابن الجوزي كان خيرا صحيح السماع توفي في ثامن صفريب بتاريخ الإسلام …ااا بالذهبىب بصالح خير صحيح السماعيب بسير أعلام النبلاء …اااان", "موسوعة الرواة (джарх)", "", ""]], "20980": [["ابن حبان", "ذكره في الثقات", "д", "أَيُّوب بن أبي الْعَالِيَة يروي عَن جمَاعَة من التَّابِعين روى عَنهُ أهل مصر كنيته أَبُو قنان", "الثقات لابن حبان", "5816", "2171", "21718", 1]], "20950": [["ابن حبان", "ذكره في الثقات", "д", "أَشْرَس بن أبي الأشرس يروي عَن مُعَاوِيَة بن قُرَّة عداده فِي أهل الْبَصْرَة روى عَنهُ الثَّوْريّ", "الثقات لابن حبان", "5816", "2192", "21928", 1]], "20900": [["ابن حبان", "ذكره في الثقات", "д", "حجاج بن مهَاجر يروي عَن شيخ لَهُ عَن أبي أَيُّوب الْأنْصَارِيّ رَوَى عَنْهُ أَبُو بشر جَعْفَر بن أبي وحشية", "الثقات لابن حبان", "5816", "2313", "23138", 1]], "20983": [["ابن حبان", "ذكره في الثقات", "д", "أَبُو سُوَيْد بْن الْمُغيرَة يروي عَنِ الْحسن روى عَنهُ حَمَّاد بن زيد", "الثقات لابن حبان", "5816", "3269", "32698", 1]]}