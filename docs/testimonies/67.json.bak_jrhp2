 وقال : ثقة", "sunnah.com", "", "", "", 1]], "6773": [["الحافظ ابن حجر تعقيبا على حديث", "حافظ", "д", "وَقَال الحافظ ابن حجر تعقيبا على حديث: \" لا ترجعوا بعدي كفارا\": رويناه في الاول من الكبير من حديث ابن السماك من طريق عفان، عن شعبة، كما", "تهذيب الكمال", "3722", 13215, "164788", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "وَاقد بن عبد الرَّحْمَن بن سعد بن معَاذ يروي عَن جَابر بْن عَبْد الله روى عَنهُ مُحَمَّد بن إِسْحَاق", "الثقات لابن حبان", "5816", "2012", "20128", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""]], "6767": [["يحيى بن معين", "ليس بثقة", "ж", "وَقَال ابن طهمان عَنه: ليس بثقة (سؤالاته، ٢٣)،", "تهذيب الكمال", "3722", 13206, "164698", 1], ["", "ضعيف", "ж", "وَقَال في موضع آخر: ضعيف الحديث (سؤالاته، ٢٤٩)،", "تهذيب الكمال", "3722", 13206, "164698", 1], ["يحيى بن معين", "ليس بشيء", "ж", "وَقَال ابن محرز عَنه: ليس بشيءٍ. قيل لابن مَعِين: أيهما أحب إليك هو أو طلحة بن عَمْرو؟ قال: طلحة لا بأس به، ليس منهما أحدًا أحبه (ابن محرز، الترجمة ٥٥٩) .", "تهذيب الكمال", "3722", 13206, "164698", 1], ["أبو بكر بن أبي شيبة", "ضعيف", "ж", "وَقَال أَبُو بَكْر بْن أَبي شَيْبَة (١): ضعيف.", "تهذيب الكمال", "3722", 13207, "164708", 1], ["أبو زرعة", "ضعيف", "ж", "وَقَال أَبُو زُرْعَة (٢): ضعيف الحديث مثل أشعث بن سوار، وليث بن أَبي سليم، وأشباههما. و", "تهذيب الكمال", "3722", 13207, "164708", 1], ["البخاري (٣)، وأبو حاتم", "منكر الحديث", "ж", "قَال البُخارِيُّ (٣)، وأَبُو حاتم (٤): منكر الحديث.", "تهذيب الكمال", "3722", 13207, "164708", 1], ["النسائي", "متروك", "ж", "وَقَال النَّسَائي (٥): متروك الحديث.", "تهذيب الكمال", "3722", -1, "5038", 1], ["يعقوب", "منكر الحديث", "ж", "قال يعقوب: منكر الحديث ضعيف\" (المعرفة: ٣ / ١٤١) .", "تهذيب الكمال", "3722", 13207, "164708", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "ت