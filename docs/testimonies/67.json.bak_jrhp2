, "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "6720": [["يحيى بن معين، وأبو حاتم، والنسائي", "ثقة", "д", "قال أبو بكر الأثرم، عَن أحمد بْن حنبل، وإسحاق بْن مَنْصُور عَنْ يحيى بْن مَعِين، وأبو حاتم، والنَّسَائي: ثقة، زاد أحمد: صالح الحديث، مقارب الحديث (٤) .", "تهذيب الكمال", "3722", 4157, "45578", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد اللَّهِ العجلي: ثقة ثبت من أصحاب إبراهيم، وكان مع قتيبة بْن مسلم بخراسان، وكان إبراهيم يقول له: اتق الله، لا تقتل مع قتيبة. ويُقال: إن ا", "تهذيب الكمال", "3722", 4157, "45578", 1], ["الدارقطني", "متروك", "ж", "قال الدارقطني في الضعفاء: بشر بن حسين أصبهاني متروك، عن الزبير بن عدي بواطيل، وله عنه نسخة موضوعة، قال: والزبير ثقة\" (الترجمة ١٢٦) . (٢) جاء في حاشية النسخة تعل", "تهذيب الكمال", "3722", 4157, "45578", 1]], "6724": [["النسائي (٢)، وأبو حاتم", "منكر الحديث", "ж", "وَقَال النَّسَائي (٢)، وأَبُو حاتم (٣): منكر الحديث. زاد النَّسَائي: ليس بثقة. وذكر له أَبُو أحمد بْن عدي أحاديث، ثم", "تهذيب الكمال", "3722", 13139, "164028", 1], ["إسناد ضعيف\" روى له ابن ماجه حديثا واحدا", "ضعيف", "ж", "قال إسناد ضعيف\" روى له ابن ماجه حديثا واحدا فِي فضل الطواف فِي المطر. ولهم شيخ آخر ي", "تهذيب الكمال", "3722", -1, "163888", 1], ["ابن حجر العسقلاني", "متروك", "ж", "متروك", "تقريب التهذيب", "8609", "", "", 0], ["ابن أبي حاتم", "منكر الحديث", "itqan", "منكر الحديث", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "6728": [["يحيى بن معين", "ثقة", "д", "قال أَبُو بكر بْن أَبي خيثمة (١)، عَن يَحْيَى بْن مَعِين: ثقة مأمون.", "تهذيب الكمال", "3722", 11617, "148808", 1], ["العجلي", "ثبت", "д", "وَقَال العجلي (٢): كان يسكن البصرة في دار كبيرة، وإنما معه أخته، وكانت عجوزا كبيرة، كان أصحاب ال