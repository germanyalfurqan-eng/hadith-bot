{"6701": [["إبراهيم بن يعقوب الجوزجاني", "يهم", "ж", "وَقَال إبراهيم بن يعقوب الجوزجاني: وكان قوم يتكلمون في القدر منهم من يزن ويتوهم عليه احتمل الناس حديثهم لما عرفوا من اجتهادهم في الدين وصدق ألسنتهم وأمانتهم في ", "تهذيب الكمال", "3722", 13027, "162908", 1], ["ونحا به نحو الثقة والثبت.", "ثقة", "д", "ذكره ونحا به نحو الثقة والثبت.", "تهذيب الكمال", "3722", 13027, "162908", 1], ["أحمد بن حنبل يسأل", "ثبت", "д", "سمعت أحمد بن حنبل يسأل: من أثبت الناس في يحيى بن أَبي كثير؟ قال: هشام الدستوائي، ثم ذكر هؤلاء الأربعة: علي بن المبارك وأبان، وهشام وحرب بن شداد يعني بعد هشام. (", "تهذيب الكمال", "3722", 13027, "162908", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق ربما وهم", "تقريب التهذيب", "8609", 22, "2193", 1], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "6702": [["ابن سعد", "ثقة", "д", "وَقَال ابن سعد: كان ثقة حجة ثبتا. (طبقاته: ٧ / ٣٠٠) .", "تهذيب الكمال", "3722", 13036, "162998", 1], ["أبي", "ثبت", "д", "سمعت أبي يقول: هما كثيرا الكتاب، عَن أبي عوانة: يحيى ابن حماد، وهشام بن عَبد المَلِك، إلا أن يحيى بن حماد كان أروى منه. قلت له: هشام كان ثبتا؟ قال: في حديث شعبة", "تهذيب الكمال", "3722", 13036, "162998", 1], ["عبد الله بن أحمد أيضا", "ثبت", "д", "وَقَال عَبد الله بن أحمد أيضا: قلتُ لأبي: كان أبو الوليد ثبتا؟ قال: لا، ما كان كتابه منقوطا ولا مشكولا، ولكنه في حديث شعبة متقن.", "تهذيب الكمال", "3722", 13036, "162998", 1], ["يحيى", "ثقة", "д", "قال يحيى: هشام بن عَبد المَلِك الطيالسي بصري ثقة. (الترجمة ١٥٣٥) .", "تهذيب الكمال", "3722", 13036, "162998", 1], ["ابن قانع", "ثقة", "д", "قال ابن قانع: ثقة مأمون ثبت.", "تهذيب الكمال", "3722", -1, "162998", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة فقيه ربما دلس", "تقريب التهذيب", "8609", 499, "4998", 1], ["الذهبي", "ثقة", "д", "أحد الأعلام قال أبو حاتم ثقة إمام في الحديث", "الكاشف / سير أعلام النبلاء", "2171", 1022, "10238", 3], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "لين", "itqan", "لين", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ثقة ثبت", "itqan", "ثقة ثبت", "الطبقات الكبرى", 0, -1, "", "", ""], ["البخاري", "واه", "itqan", "واه", "التاريخ الكبير", 0, -1, "", "", ""], ["الذهبي", "لين", "itqan", "لين", "تذكرة الحفاظ", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات وقال : كان حافظا متقنا ورعا فاضلا", "д", "ذكره في الثقات وقال : كان حافظا متقنا ورعا فاضلا", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "ثقة فقيه ربما دلس ، وقال في هدي الساري : مجمع على تثبيته إلا أنه في كبره تغير حفظه فتغير حديث من سمع منه في قدمته الثالث", "д", "ثقة فقيه ربما دلس ، وقال في هدي الساري : مجمع على تثبيته إلا أنه في كبره تغير حفظه فتغير حديث من سمع منه في قدمته الثالثة إلى العراق وقد احتج به جميع الأئمة", "sunnah.com", "", "", "", 1], ["أبو حاتم الرازي", "ثقة ، إمام في الحديث", "д", "ثقة ، إمام في الحديث", "sunnah.com", "", "", "", 1], ["الدارقطني", "ذكره في السنن وقال : ثقة", "д", "ذكره في السنن وقال : ثقة", "sunnah.com", "", "", "", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1], ["محمد بن سعد كاتب الواقدي", "ثقة ، ثبت ، كثير الحديث ، حجة", "д", "ثقة ، ثبت ، كثير الحديث ، حجة", "sunnah.com", "", "", "", 1], ["يعقوب بن شيبة السدوسي", "ثبت ، ثقة ، لم ينكر عليه شىء إلا بعدما صار إلى العراق", "д", "ثبت ، ثقة ، لم ينكر عليه شىء إلا بعدما صار إلى العراق", "sunnah.com", "", "", "", 1], ["عبد الرحمن بن يوسف بن خراش", "كان مالك لا يرضاه ، وكان هشام صدوقا تدخل اخباره في الصحيح ، ومرة : قال بلغني ان مالكا نقم عليه حديثه لأهل العراق", "д", "كان مالك لا يرضاه ، وكان هشام صدوقا تدخل اخباره في الصحيح ، ومرة : قال بلغني ان مالكا نقم عليه حديثه لأهل العراق", "sunnah.com", "", "", "", 1], ["مالك بن أنس", "كان لا يرضاه نقم عليه حديثه لأهل العراق ، ومرة : كذاب ، قال ابن معين : عسى أراد الكذب في الكلام ، فأما في الحديث فهو ثقه", "д", "كان لا يرضاه نقم عليه حديثه لأهل العراق ، ومرة : كذاب ، قال ابن معين : عسى أراد الكذب في الكلام ، فأما في الحديث فهو ثقه ، وهو من الرواة عنه", "sunnah.com", "", "", "", 1], ["على بن المديني", "أروى القوم", "д", "أروى القوم", "sunnah.com", "", "", "", 1], ["البرهان الحلبي", "إمام مشهور لم يشتهر بالتدليس", "д", "إمام مشهور لم يشتهر بالتدليس", "sunnah.com", "", "", "", 1], ["وهيب بن خالد", "قدم علينا فكان فينا مثل الحسين وابن سيرين", "д", "قدم علينا فكان فينا مثل الحسين وابن سيرين", "sunnah.com", "", "", "", 1], ["النضر بن عبد الجبار", "كان يعجب من حديثه عن أبيه", "д", "كان يعجب من حديثه عن أبيه", "sunnah.com", "", "", "", 1]], "6736": [["يحيى بن معين", "ثقة", "д", "قال إسحاق بْن مَنْصُور (٢)، عَنْ يحيى بْن مَعِين: ثقة. و", "تهذيب الكمال", "3722", -1, "7838", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة عابد", "تقريب التهذيب", "8609", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""], ["أبو حاتم بن حبان البستي", "ذكره في الثقات وقال : كان من العباد", "д", "ذكره في الثقات وقال : كان من العباد", "sunnah.com", "", "", "", 1], ["الذهبي", "كان من العلماء العباد", "д", "كان من العلماء العباد", "sunnah.com", "", "", "", 1], ["ابن حجر العسقلاتي", "قال في التقريب : ثقة عابد", "д", "قال في التقريب : ثقة عابد", "sunnah.com", "", "", "", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "ثقة", "sunnah.com", "", "", "", 1]], "6737": [["العجلي", "ثقة", "д", "وَقَال العجلي: من أصحاب عَبد الله ثقة (ثقاته، الورقة ٥٦) .", "تهذيب الكمال", "3722", 13102, "163658", 1], ["يحيى بن معين", "ثقة", "д", "قال إسحاق بْن مَنْصُور، عَنْ يحيى بْن مَعِين: ثقة (١) . و", "تهذيب الكمال", "3722", 13103, "163668", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "صدوق", "itqan", "صدوق", 