{"4701": [["الذهلي", "ضعفه", "ж", "وَقَال الذهلي: ما رأيت أحدًا ضعفه (تهذيب التهذيب: ٧ / ٤٦٣) .", "تهذيب الكمال", "3722", 7780, "110438", 1], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "4702": [["أبو حاتم الرازي (٢) وأبو أحمد بن عدي", "منكر الحديث", "ж", "وَقَال أَبُو حاتم الرازي (٢) وأبو أحمد بْن عدي (٣): منكر الحديث.", "تهذيب الكمال", "3722", 7783, "110468", 1], ["أبو الفتح الأزدي", "كذاب", "ж", "وَقَال أَبُو الفتح الأزدي (٥): كذاب.", "تهذيب الكمال", "3722", 7783, "110468", 1], ["الدارقطني", "متروك", "ж", "وَقَال الدَّارَقُطْنِيُّ (٦): متروك (٧) . روى له ابْن ماجه حديثا واحدا عَنِ الأَوزاعِيّ، عَنْ مكحول، عَن أَبِي بْن كعب فِي الجهاد.", "تهذيب الكمال", "3722", 7783, "110468", 1], ["ابن حجر العسقلاني", "متروك", "ж", "متروك", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "تركوه", "ж", "تركوه", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "منكر الحديث", "itqan", "منكر الحديث", "الجرح والتعديل", 0, -1, "", "", ""], ["الذهبي", "تركوه", "itqan", "تركوه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "كذاب", "itqan", "كذاب", "تهذيب التهذيب", 0, -1, "", "", ""]], "4700": [["يحيى بن معين", "ليس بثقة", "ж", "قال عَبَّاس الدُّورِيُّ (١) عَنْ يحيى بْن مَعِين: ليس بثقة.", "تهذيب الكمال", "3722", 7777, "110408", 1], ["", "ليس بشيء", "ж", "وَقَال في موضع آخر (٢): ليس بشيءٍ، وقد رأيته وقد روى عنه (٣) مروان بْن معاوية.", "تهذيب الكمال", "3722", 7777, "110408", 1], ["أبيه شبيب المسلي. قلت ليحيى", "ثقة", "д", "سمعت مِنْهُ ولم يكن بثقة، روى مروان الفزاري عَن أبيه شبيب المسلي. قلت ليحيى: وكان شبيبب ثقة؟ قال: نعم. و", "تهذيب الكمال", "3722", 7778, "110418", 1], ["أبو زرعة", "لين", "ж", "وَقَال أَبُو زُرْعَة (٣): لين الحديث.", "تهذيب الكمال", "3722", -1, "35148", 1], ["", "واه", "ж", "وَقَال في موضع آخر (٤): واهي الحديث.", "تهذيب الكمال", "3722", -1, "110418", 1], ["أبو حاتم", "لا يحتج به", "ж", "وَقَال أبو حاتم (٥): شيخ يكتب حديثه، ولا يحتج به.", "تهذيب الكمال", "3722", 7778, "110418", 1], ["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي (٦): ليس بالقوي.", "تهذيب الكمال", "3722", -1, "3268", 1], ["أبو حاتم بن حبان", "صدوق", "д", "وَقَال أبو حاتم بْن حبان (٧): كان شيخًا صدوقًا (٨)، ولكنه كان يخطئ كثيرا حتى خرج عن حد الاحتجاج بِهِ إِذَا انفرد عَلَى قلة روايته (٩) . _________ (١) سؤالاته: ٢", "تهذيب الكمال", "3722", 7778, "110418", 0], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "لا يحتج به", "ж", "قال أبو حاتم لا يحتج به وقال النسائي ليس بالقوي", "الكاشف / سير أعلام النبلاء", "2171", 329, "3298", 1], ["ابن أبي حاتم", "لين", "itqan", "لين الحديث", "الجرح والتعديل", 0, -1, "", "", ""], ["الذهبي", "ليس بالقوي", "itqan", "ليس بالقوي", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "يضع", "itqan", "يضع", "تهذيب التهذيب", 0, -1, "", "", ""], ["البخاري", "يضع", "itqan", "يضع", "التاريخ الكبير", 0, -1, "", "", ""]], "4703": [["عبد الله بن أحمد بن حنبل", "ضعيف", "ж", "قال عَبد اللَّهِ بْن أَحْمَد بْن حنبل (١): سألته، يعني أباه، عَن مندل بْن عَلِيٍّ، فَقَالَ: ضعيف الحديث. فقلت: حبان أخوه؟ فقال: لا، هو أصلح منه، يعني مندلا أصلح", "تهذيب الكمال", "3722", 12208, "154718", 1], ["يحيى بن معين", "لا بأس به", "д", "وَقَال عُثْمَان بْن سَعِيد الدارمي (٥)، عَن يحيى بْن مَعِين: لا بأس به،", "تهذيب الكمال", "3722", 12208, "154718", 1], ["يحيى بن معين", "ضعيف", "ж", "وَقَال عَباس الدُّورِيُّ (٦)، عَنْ يحيى بْن مَعِين: مندل، وحبان ضعيفان وهما أحب إلي من قيس بْن البيع (٧) . _________ (١) العلل ومعرفة الرجال: ١ / ١٣٥. (٢)", "تهذيب الكمال", "3722", 12208, "154718", 3], ["أبي", "يهم", "ж", "قال أبي: مندل وحبان فيهما ضعف. (تاريخ الخطيب: ٣ / ٢٤٨) . (٣) الكامل لابن عدي: ٣ / الورقة ١٥٠، وتاريخ الخطيب: ١٣ / ٢٤٨. (٤) الجرح والتعديل: ٨ / الترجمة ١٩٨٧. (٥)", "تهذيب الكمال", "3722", 12208, "154718", 1], ["ابن محرز", "صالح", "д", "وَقَال ابن محرز: سألت يحيى بن مندل بْن عَلِيٍّ؟ فَقَالَ: ليس بذاك، وضعف أمره. ثم قال: هو صالح. (الترجمة ١٦٥)", "تهذيب الكمال", "3722", 12208, "154718", 2], ["يحيى مرة أخرى", "ليس به بأس", "д", "سمعت يحيى مرة أخرى يقول: مندل بن علي ليس به بأس، وحبان مثله (الترجمة ٣٠٠)", "تهذيب الكمال", "3722", 12208, "154718", 1], ["ابن الجنيد", "ضعيف", "ж", "وَقَال ابن الجنيد: قلت ليحيى: مندل وحبان جميعا سواء؟ قال: سواء، أي ضعيفان. (سؤالاته، الترجمة ٨١٠)", "تهذيب الكمال", "3722", 12208, "154718", 3], ["يعقوب بن شيبة", "صدوق", "д", "وَقَال يعقوب بْن شَيْبَة (٢): مندل بْن عَلِيٍّ العنزي من أنفسهم، كَانَ أشهر من أخيه حبان، وهو أصغر سنا من أخيه حبان، وأصحابنا يحيى بْن مَعِين، وعلي بْن المديني،", "تهذيب الكمال", "3722", 12209, "154728", 1], ["يحيى", "لين", "ж", "قال يحيى: لو كان ابن فيل مثل مندل كان قد هلك. قال: مندل دونه؟ قال: نعم دونه، ودون جيرته أولئك النقالين. (سؤالاته، الترجمة ٨٥٥)", "تهذيب الكمال", "3722", 12209, "154728", 1], ["أبو زرعة الدمشقي", "يهم", "ж", "وَقَال أَبُو زُرْعَة الدمشقي: حَدَّثَنِي محمد بن إدريس، قال: سألت يحيى بْن مَعِين، عَن مندل وحبان: أيهما أحب إليك؟ قال: ليس بهما جميعا بأس. (تاريخه: ٥٥٨)", "تهذيب الكمال", "3722", 12209, "154728", 1], ["معاوية بن صالح", "صالح", "д", "وَقَال معاوية بن صالح:", "تهذيب الكمال", "3722", -1, "5398", 1], ["يحيى", "ضعيف", "ж", "سمعت يحيى قال: مندل وحبان. حبان أصح حديثا من مندل، وسألته مرة أخرى عن مندل ابن علي، فقال: ضعيف الحديث. (ضعفاء العقيلي، الورقة ٢١٨)", "تهذيب الكمال", "3722", 12209, "154728", 1], ["معاوية ابن صالح عنه أيضا", "صالح", "д", "وَقَال معاوية ابن صالح عنه أيضا: مندل وحبان ضعيفان في الحديث. (الكامل: ٣ / الورقة ١٥١) .", "تهذيب الكمال", "3722", 12209, "154728", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "متروك", "ж", "قال الدارقطني متروك", "الكاشف / سير أعلام النبلاء", "2171", 256, "2568", 1]], "4712": [["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي: ليس بالقوي (الضعفاء والمتروكين: الترجمة ٤٥٩) . (٢) ٧ / ١٨٠. (٣)", "تهذيب الكمال", "3722", 7792, "110558", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي: ثقة (ثقاته: الورقة ٤١)، وذَكَره ابن شاهين في \"الثقات\" (الترجمة: ٧٢١)، وذَكَره ابن الجوزي في \"الضعفاء \" (الورقة: ١١٥)،", "تهذيب الكمال", "3722", 7792, "110558", 1], ["أبي", "ثقة", "д", "سمعت أبي يقول: عُمَر بن عامر ثقة ثبت في الحديث إلا أنه كان مرجئا (تهذيب التهذيب: ٧ / ٤٦٧) .", "تهذيب الكمال", "3722", 7792, "110558", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف وكان كثير الإرسال", "تقريب التهذيب", "8609", 340, "3408", 1], ["النسائي", "ضعيف", "ж", "عمر بن عبد الله مولى غفرة ضعيف", "الكامل في الضعفاء", "12579", "2742", "27428", 1], ["العجلي", "ثقة", "д", "الله مدني ثقة رجل صالح", "معرفة الثقات للعجلي", "5825", "470", "2068", 1], ["الترمذي", "ضعيف", "jarh", "التِّرْمِذِيّ (٥) عن البخاري: ضعيف الحديث، ذاهب", "تهذيب الكمال", "3722", 7793, "110568", 1], ["احمد بن حنبل", "منكر الحديث", "jarh", "مُحَمَّد بن علي بن أحمد بْن حنبل: منكر الحديث (ضعفاء العقيلي، الورقة ١٤٣)", "تهذيب الكمال", "3722", 7803, "110668", 1], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "4713": [["البخاري", "ضعيف", "ж", "قال التِّرْمِذِيّ (٥) عن البخاري: ضعيف الحديث، ذاهب. وضعفه جدا.", "تهذيب الكمال", "3722", 7793, "110568", 1], ["أبي زرعة", "واه", "ж", "وَقَال سَعِيد بْن عَمْرو البرذعي (٦)، عَن أبي زرعة: واهي _________ (١) و", "تهذيب الكمال", "3722", -1, "", 0], ["الدارقطني", "ضعيف", "ж", "وَقَال الدَّارَقُطْنِيُّ: ضعيف (علله: ٣ / الورقة ٣٨)، وذَكَره ابن الجوزي في \"الضعفاء \" (الورقة: ١١٥) . (٣) التِّرْمِذِيّ (٤٣٥) . وابن ماجة (١١٦٧) و(١٣٧٤) . وروى", "تهذيب الكمال", "3722", 7794, "110578", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0]], "4715": [["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق له غرائب. مُحَمَّدِ بْنِ مَحْمَشٍ الْفَقِيهُ، قال: أخبرنا أَبُو بكر مُحَمَّد بْن الحسين القطان، قال: حَدَّثَنَا أَحْمَدَ بْنِ ", "تهذيب الكمال", "3722", -1, "2178", 2], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق له غرائ", "تقريب التهذيب", "8609", 179, "1798", 1], ["الذهبي", "ثقة", "д", "ثقة نبيل", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "4716": [["أبي داود", "ضعيف", "ж", "وَقَال الآجري عَن أَبِي داود: عُمَر بن عَبد الله الرومي جيد الحديث. وابن الرومي صاحب الحروف ضعيف (سؤالاته: ٣ / الترجمة ٣١٣) .", "تهذيب الكمال", "3722", 7798, "110618", 1], ["الذهبي", "صدوق", "д", "وَقَال الذهبي: صدوق (وسير أعلام النبلاء: ١٠ / ٤٢٢) .", "تهذيب الكمال", "3722", 7798, "110618", 1], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "4718": [["أحمد بن حنبل", "صدوق", "д", "قال أَبُو دَاوُد (١)، عَنْ أَحْمَد بْن حنبل: كان صدوقا. قال: وذكر أنه كان (٢) يلي بعض العمل في السواد. _________ (١) تاريخ الخطيب: ١٢ / ٤٠١. (٢) قوله \"كان \"سقط ", "تهذيب الكمال", "3722", 9049, "123128", 2], ["يحيى ابن معين", "ثقة", "д", "وَقَال عَباس الدُّورِيُّ (١) وأبو بكر بْن أَبي خيثمة (٢)، عَن يحيى ابن مَعِين: ثقة (٣) . وكذلك", "تهذيب الكمال", "3722", 9050, "123138", 1], ["يحيى بن معين", "صدوق", "д", "وَقَال إِبْرَاهِيم بْن عَبد اللَّهِ بْن الجنيد (٦)، عَنْ يحيى بن مَعِين: ماكان بِهِ بأس، صدوق.", "تهذيب الكمال", "3722", 9050, "123138", 1], ["أبو حاتم", "صالح", "д", "وَقَال أَبُو حاتم (٧): صالح، ليس بالمتين.", "تهذيب الكمال", "3722", 9050, "123138", 1], ["زكريا بن يحيى الساجي", "ضعيف", "ж", "وَقَال زكريا بْن يحيى الساجي (٨): ضعيف، وقد روى عنه عَلِيّ بْن المديني، والناس.", "تهذيب الكمال", "3722", 9050, "123138", 1], ["أبي داود", "ليس به بأس", "д", "وَقَال أَبُو عُبَيد الآجري (٩)، عَن أبي دَاوُد: ليس به بأس.", "تهذيب الكمال", "3722", 9050, "123138", 1], ["", "ثقة", "д", "وَقَال في موضع آخر (١٠)، عَنه: ثقة عمل للسلطان عملا، وكان يلبس شاشية. _________ (١) تاريخه: ٢ / ٤٨٢. (٢) الجرح والتعديل: ٧ / الترجمة ٦٩٣. (٣) وكذلك", "تهذيب الكمال", "3722", 9050, "123138", 2], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0]], "4706": [["أبي الزبير، ف", "ليس به بأس", "д", "سئل أَحْمَد بْن حنبل عَن أبي الزبير، فقال: قد احتمله الناس، وأَبُو الزبير أحب إلي من أبي سفيان لأن أبا الزبير أعلم بالحديث منه (٦)، وأَبُو الزبير ليس به بأس. __", "تهذيب الكمال", "3722", 10892, "141558", 3], ["", "ثقة", "д", "ذكره في الطبقة الثالثة منهم وَقَال: كان ثقة كثير الحديث إلا أن شعبة تركه لشئ زعم أن رآه فعله في معاملة. (طبقاته: ٥ / ٤٨١) . (٣) المعرفة ليعقوب: ٢ / ٢٣. (٤) الكا", "تهذيب الكمال", "3722", 10892, "141558", 1], ["أبي", "ضعفه", "ж", "قال أبي: كان أيوب السختياني يقول: حَدَّثَنَا أَبُو الزبير، وأَبُو الزبير أَبُو الزبير! قلتُ لأبي: كأنه يضعفه؟ قال: نعم.", "تهذيب الكمال", "3722", 10893, "141568", 1], ["ابن عيينة", "ضعفه", "ж", "سمعت ابن عُيَيْنَة يقول: حَدَّثَنَا أَبُو الزبير وهو أَبُو الزبير. أي كأنه يضعفه.", "تهذيب الكمال", "3722", 10893, "141568", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال أَبُو بكر بْن أَبي خيثمة (٢)، عَن يحيى بْن مَعِين: ثقة.", "تهذيب الكمال", "3722", -1, "8378", 1], ["يحيى بن معين", "صالح", "д", "وَقَال إسحاق بْن منصور (٣)، عَن يحيى بن مَعِين: صالح.", "تهذيب الكمال", "3722", -1, "7588", 1], ["مرة (٤) ثقة.", "ثقة", "д", "وَقَال مرة (٤) ثقة.", "تهذيب الكمال", "3722", -1, "141448", 1], ["يعقوب بن شيبة", "ثقة", "д", "وَقَال يعقوب بن شَيْبَة: ثقة صدوق وإلى الضعف ما هو.", "تهذيب الكمال", "3722", 10894, "141578", 1], ["عبد الرحمن (٨) بن أبي حاتم", "لا يحتج به", "ж", "وَقَال عَبْد الرَّحْمَنِ (٨) بْن أَبي حَاتِم: سَأَلتُ أَبِي عَن أبي الزبير، فقال: يكتب حديثه، ولا يحتج به، وهو أحب إلي من ابي _________ (١) الجرح والتعديل: ٨ / ", "تهذيب الكمال", "3722", 10894, "141578", 3], ["يحيى بن معين", "ثقة", "д", "وَقَال الدارمي عَن يحيى بْن مَعِين: ثقة (الترجمتان", "تهذيب الكمال", "3722", 10894, "141578", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ثقة", "الثقات", 0, -1, "", "", ""]], "4708": [["ابن حبان. و", "يخطئ", "ж", "ذكره ابنُ حِبَّان. وَقَال: يخطئ يعتبر بحديثه إذا كان دونه ثقة (٥ / ١١٤) . وحكى الخطابي عن أَحْمَد بْن حنبل، قال: ليس هو من أهل الحفظ والاتقان (تهذيب التهذيب: ٦ ", "تهذيب الكمال", "3722", 5949, "92128", 1], ["يحيى بن معين", "ليس بثقة", "ж", "وَقَال عثمان بْن سَعِيد الدارمي (٢)، عَن ي