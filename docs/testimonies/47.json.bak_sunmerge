 به، وضعفه الذهبي، ولا أدري كيف", "تهذيب الكمال", "3722", 2214, "22158", 1], ["الحافظ ابن حجر", "حافظ", "д", "قال الحافظ ابن حجر: صدوق له أغلاط\". و", "تهذيب الكمال", "3722", 2214, "22158", 1], ["أبو حاتم الرازي", "صدوق", "д", "وَقَال أبو حاتم الرازي: صدوق.", "تهذيب الكمال", "3722", -1, "5438", 1], ["الحافظ أبو الحسن بن عساكر", "حافظ", "д", "قال الحافظ أبو الحسن بن عساكر في تاريخ دمشق والذهبي في تاريخ الاسلام: توفي في جمادي الآخرة سنة ست وعشرين ومئتين. ولم ي", "تهذيب الكمال", "3722", 2215, "22168", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["", "ثقة", "д", "ابن حبانب بذكره ابن حبان في كتاب ?ب الثقات ?بب بتهذيب الكمال …ا بذكره ابن حبان في ?ب الثقات ?بيب بتهذيب التهذيب …ااا بابن حجرب بثقةب بتقريب التهذيب …ااا بالدارق", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "عمرَان بن ميسرَة من أهل الْبَصْرَة يروي عَن عبد الْوَارِث بن سعيد حَدَّثنا عَنهُ أَبُو خَليفَة", "الثقات لابن حبان", "5816", "3776", "37768", 1], ["الدارقطني", "ثقة", "д", "قلت فعمران بن ميسرة قال ثقة", "سؤالات الحاكم للدارقطني", "5950", "168", "1688", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقه", "تهذيب التهذيب", 0, -1, "", "", ""]], "4780": [["يحيى بن معين", "ليس بشيء", "ж", "قال عباس الدُّورِيُّ (٣)، عن يحيى بْن مَعِين: ليس بشيءٍ (٤) . _________ = فإن ذا آخر (٣ / الترجمة ٦٢٢٨) . وهو كمال", "تهذيب الكمال", "3722", -1, "", 0], ["البرذعي", "ضعيف", "ж", "وَقَال البرذعي: قلتُ لأبي زرعة عُمَر بن نافع؟ قال: ضعيف. (أبو زُرْعَة الرازي: = ذكرناه للتمييز بينهما. ٤٣١٣ - د: عُمَر بن نبهان العبدي (١)، ويُقال: الغبري، البَ", "تهذيب الكمال", "3722", 7899, "111628", 1], ["يحيى بن معين", "ليس بشيء", "ж", "وَقَال ابْن أَبي حاتم (١) عن عباس الدوري، عن يحيى بْن مَعِين: عُمَر بْن نبهان ليس بشيءٍ، وليس بينه وبين الحارث بْن نبهان قرابة.", "تهذيب الكمال", "3722", 7901, "111648", 1], ["يحيى بن معين", "ليس بشيء", "ж", "سمعت يحيى بْن مَعِين يَقُول: الحارث بْن نبهان ليس بشيءٍ، وعُمَر بْن نبهان صالح الحديث وهما بصريان. قُلْتُ ليحيى: بينهما قرابة؟ قال: لا (٣) .", "تهذيب الكمال", "3722", 7901, "111648", 1], ["عمرو بن علي (٤)، وأبو حاتم", "ضعيف", "ж", "وَقَال عَمْرو بْن علي (٤)، وأبو حاتم (٥): ضعيف الحديث. و", "تهذيب الكمال", "3722", 7901, "111648", 1], ["يعقوب بن سفيان", "ضعيف", "ж", "قال يعقوب بن سُفْيَانَ: ضعيف.", "تهذيب الكمال", "3722", -1, "111558", 1], ["ابن حجر", "ضعيف", "ж", "وَقَال ابن حجر في \"التقريب\": ضعيف. (٢) أبو داود (١٤٨٧) . (٣) ميزان الاعتدال: ٣", "تهذيب الكمال", "3722", 7902, "111658", 1], ["", "ثقة", "д", "ابن حبانب بوذكره ابن حبان في ?ب الثقات ?بيب بتهذيب التهذيب …ا بوذكره ابن حبان في كتاب ?ب الثقات ?بب بتهذيب الكمال …ااا بابن حجرب بمقبولب بتقريب التهذيب …ااا بال", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ذكره في الثقات", "д", "عمرَان بْن نَافِع يروي عَنْ حَفْص بْن عبيد اللَّه عَنْ أنس روى عَنْهُ بكير بْن عَبْد الله بْن الْأَشَج", "الثقات لابن حبان", "5816", "2849", "28498", 1], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4781": [["يحيى بن معين", "ثقة", "д", "قال أحمد بْن سعد بْن أَبي مريم، عَن يحيى بْن مَعِين: ثقة، حجة.", "تهذيب الكمال", "3722", -1, "187528", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد الله العجلي (١): مدنية، تابعة، ثقة.", "تهذيب الكمال", "3722", 15361, "188428", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "4704": [["ابن حجر العسقلاني", "صدوق", "д", "صدوق له أوهام", "تقريب التهذيب", "8609", 3, "38", 1], ["الذهبي", "صالح", "д", "اختلف قول ابن معين فيهي وقال ابن المديني شيخ صالح", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "شيخ", "itqan", "شيخ", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "متروك", "itqan", "متروك", "تهذيب ا