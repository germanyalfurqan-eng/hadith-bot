{"4302": [["ابن حجر", "مجهول", "ж", "وَقَال ابن حجر في \"التقريب\": مجهول. (٢) الكاشف: ٢ / الترجمة ٣٧٧١، وتذهيب التهذيب: ٣ / الورقة ٣٢، وتاريخ الاسلام، الورقة ٤٢ (أيا صوفيا: ٣٠٠٧)، ونهاية السول، الور", "تهذيب الكمال", "3722", 6746, "100098", 1], ["ابن حجر", "مجهول", "ж", "وَقَال ابن حجر في \"التقريب\": أن يكون الطرائفي، والا فمجهول. (٤) تاريخ الدوري: ٢ / ٣٩٤، وتاريخ البخاري الكبير: ٦ / الترجمة ٢٢٨٠، والجرح والتعديل: ٦ / الترجمة ٨٧٠", "تهذيب الكمال", "3722", 6746, "100098", 1], ["أبو حاتم", "منكر الحديث", "ж", "وَقَال أَبُو حاتم (٤): منكر الحديث. و", "تهذيب الكمال", "3722", 6747, "100108", 1], ["ابن حجر", "لين", "ж", "وَقَال ابن حجر في \"التقريب\": لين الحديث. وروى لَهُ التِّرْمِذِيّ فِي \"الشمائل\"وابن ماجه.", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "لين", "ж", "لين الحديث", "تقريب التهذيب", "8609", 8, "148", 1], ["ابن أبي حاتم", "منكر الحديث", "itqan", "منكر الحديث", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "منكر الحديث", "itqan", "منكر الحديث", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "من الصحابة", "itqan", "من الصحابة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4305": [["يحيى بن معين", "ثقة", "д", "قال أبو بكر بْن أَبي خيثمة (١)، عَن يحيى بْن مَعِين: ثقة. وكذلك", "تهذيب الكمال", "3722", 6753, "100168", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "عُثْمَان بْن عُرْوَة بْن الزبير بْن الْعَوام يروي عَن أَبِيه روى عَنهُ أهل الْمَدِينَة مَاتَ فِي ولَايَة أبي جَعْفَر أمه فَاخِتَة بنت أبي الْأسود بْن", "الثقات لابن حبان", "5816", "2798", "27988", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4304": [["أبو داود. ٢٥٠٧ - خت م ٤", "حافظ", "д", "قال أَبُو داود. ٢٥٠٧ - خت م ٤: سُلَيْمان بن داود بن الجارود (١)، أَبُو داود الطيالسي البَصْرِيّ الحافظ، فارسي الأصل، وهو مولى القريش.", "تهذيب الكمال", "3722", 5322, "57228", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق ربما وهم", "تقريب التهذيب", "8609", 22, "2193", 1], ["الذهبي", "وثقه", "ж", "وثقه أحمد", "الكاشف / سير أعلام النبلاء", "2171", 27, "5541", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "مضطرب الحديث", "itqan", "مضطرب الحديث", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "صحابي", "itqan", "صحابي", "الطبقات الكبرى", 0, -1, "", "", ""]], "4306": [["عبد الله بن المبارك", "ثقة", "д", "قال أَبُو إسحاق الطالقاني (١)، عَنْ عَبد اللَّهِ بْن المبارك: ثقة. وكذلك", "تهذيب الكمال", "3722", -1, "3588", 2], ["أحمد بن حنبل", "لا بأس به", "д", "وَقَال حرب بْن إِسْمَاعِيل (٣)، عَن أحمد بْن حنبل: لا بأس به.", "تهذيب الكمال", "3722", -1, "2138", 2], ["يحيى بن معين", "ليس به بأس", "д", "وَقَال أَبُو بَكْر بْن أَبي خيثمة (٤)، وعثمان بْن سَعِيد الدارمي (٥) عَنْ يحيى بْن مَعِين: ليس به بأس. وكذلك", "تهذيب الكمال", "3722", -1, "10298", 2], ["يحيى بن معين", "ثقة", "д", "وَقَال المفضل بْن غسان الغلابي، عَنْ يحيى بْن مَعِين: ثقة.", "تهذيب الكمال", "3722", -1, "5728", 3], ["أحمد بن عبد الله العجلي (٦)، وأبو زرعة", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد اللَّهِ العجلي (٦)، وأَبُو زُرْعَة: كوفي ثقة نزل الرملة. _________ (١) الجرح والتعديل: ٤ / الترجمة ١٥٨٦. (٢) تهذيب تاريخ دمشق: ٦ / ٣٤٤. ", "تهذيب الكمال", "3722", -1, "", 0], ["أبو زرعة", "لا بأس به", "д", "وَقَال أَبُو زُرْعَة فِي مَوْضِعٍ آخر (٢): لا بأس به.", "تهذيب الكمال", "3722", -1, "2138", 2], ["أبو حاتم", "صدوق", "д", "وَقَال أبو حاتم (٣): صدوق لا بأس به.", "تهذيب الكمال", "3722", -1, "5978", 1], ["سعيد بن منصور", "يهم", "ж", "وَقَال بهلول بْن إسحاق الأَنْبارِيّ (٥)، عَنْ سَعِيد بْن منصور: حَدَّثَنَا شهاب بْن خداش ابْن أخي العوام بْن حوشب، قال: أدركت من أدركت من صدر هذه الأمة وهم يقول", "تهذيب الكمال", "3722", -1, "", 0], ["شهاب بن خراش", "عدل", "д", "سمعت شهاب بْن خراش يقول: إن القدرية أرادوا أن يصفوا اللَّه بعدله فأخرجوه من فضله (٦) . _________ (١) كذا نسب هذه الزيادة لابي زرعة، ولعل الصواب: زاد العجلي\"، فه", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0]], "4312": [["أحمد بن حنبل", "ثقة", "д", "وَقَال أحمد بن حنبل (١): ثقة، وكَانَ يرى الإرجاء.", "تهذيب الكمال", "3722", 6786, "100498", 1], ["يحيى بن معين (٢)، والنسائي", "ثقة", "д", "وَقَال يَحْيَى بْن مَعِين (٢)، والنَّسَائي: ثقة.", "تهذيب الكمال", "3722", 6786, "100498", 1], ["أبو حاتم", "صدوق", "д", "وَقَال أَبُو حاتم (٣): صدوق.", "تهذيب الكمال", "3722", -1, "3648", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقةي رمي بالإرجاء", "تقريب التهذيب", "8609", 16, "1340", 3], ["أحمد بن حنبل", "ثقة", "д", "سمعت أبي يقول عثمان بن غياث ثقة ثبت ثبت الحديث إلا أنه كان مرجئا ١٩٤٩ - أخبرنا عبد الله إج", "العلل ومعرفة الرجال لعبد الله بن أحمد", "2331", "764", "7368", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "يضع", "itqan", "يضع", "تهذيب التهذيب", 0, -1, "", "", ""]], "4309": [["البخاري", "إمام", "д", "قال البخاري فِي كتاب \"القراءة خلف الإمام \":", "تهذيب الكمال", "3722", 7846, "111098", 1], ["عبد الرحمن بن أبي حاتم بعد أن ساق قول يحيى", "مجهول", "ж", "وَقَال عَبْد الرَّحْمَنِ بْن أَبي حاتم بعد أن ساق قول يحيى بْن مَعِين ما أعرفه: يعني أنه مجهول (الجرح والتعديل: ٦ / الترجمة ٦٧٤) .", "تهذيب الكمال", "3722", 7846, "111098", 1], ["الذهبي", "مجهول", "ж", "وَقَال الذهبي في \"ديوان الضعفاء \": مقل مجهول (الترجمة ٣٠٨١) .", "تهذيب الكمال", "3722", 7846, "111098", 1], ["يحيى بن معين، وأبو زرعة", "ثقة", "д", "قال عباس الدُّورِيُّ (١) عَن يحيى بْن مَعِين، وأبو زُرْعَة (٢): ثقة. و", "تهذيب الكمال", "3722", -1, "111018", 1], ["يعقوب بن سفيان", "ثقة", "д", "وَقَال يعقوب بن سفيان: ثقة (المعرفة والتاريخ: ٣ / ٤٢) .", "تهذيب الكمال", "3722", 7848, "111118", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في \"الميزان \": ثقة (٣ / الترجمة ٦١٧٠) .", "تهذيب الكمال", "3722", 7848, "111118", 1], ["ابن حجر", "وثقه", "д", "وَقَال ابن حجر في \"التهذيب \": وثقه العجلي (٧ / ٤٨٣) .", "تهذيب الكمال", "3722", 7848, "111118", 1], ["", "ثقة", "д", "وَقَال في \"التقريب\": ثقة. (٢) تاريخ الدوري: ٢ / ٤٣٢، وتاريخ البخاري الكبير: ٦ / الترجمة ٢١٠٦، والمعرفة ليعقوب: ٣ / ٤٢، وضعفاء النَّسَائي، الترجمة ٤٥٨، وضعفاء ال", "تهذيب الكمال", "3722", 7848, "111118", 1], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""]], "4311": [["خليفة بن خياط", "مجهول", "ж", "ذكره خليفة بْن خياط فِي الطبقة الثانية من قراء أهل البصرة (٢) . _________ (١) هو مجهول، كما صرح به الحافظان: الذهبي في \" الكاشف\"، وابن حجر في \"التقريب. (٢) كتاب", "تهذيب الكمال", "3722", 14422, "179038", 2], ["أبو أحمد بن عدي", "واه", "ж", "وَقَال أبو أحمد بْن عدي (٣) فِي حديث رواه ديلم بْن غزوان عَنْ وهب بْن أَبي دبي، عَن أَبِي حرب، عَنْ محجن، عَن أَبِي ذر: لعل أبا حرب هو محجن.", "تهذيب الكمال", "3722", 14423, "179048", 1], ["خليفة", "وثقه", "д", "قال خليفة: مات سنة ثمان ومئة (طبقاته: ٢٠٦) . وذكر ابن حجر في زياداته على\" التهذيب\" ان ابن عَبد الْبَرِّ وثقه، فوثقه هو والذهبي أيضا. (٥) مسند أحمد: ١ / ٩٧. الأَ", "تهذيب الكمال", "3722", 14423, "179048", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف واختلطي وكان يدلس ويغلو في التشيع", "تقريب التهذيب", "8609", "", "", 0]], "4313": [["سهل", "واه", "ж", "قال سَهْلٌ: لَقَدْ رَكَضَتْنِي (٣) مِنْهَا نَاقَةٌ حَمْرَاءُ. رواه البخاري (٤", "تهذيب الكمال", "3722", 14873, "183548", 0], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["ابن حجر العسقلاني", "لا شيء", "itqan", "لا شيء", "تهذيب التهذيب", 0, -1, "", "", ""]], "4314": [["", "صدوق", "д", "وَقَال (١): صدوق.", "تهذيب الكمال", "3722", -1, "3238", 1], ["النسائي", "صالح", "д", "وَقَال النَّسَائي (٢): صالح.", "تهذيب الكمال", "3722", -1, "3438", 1], ["", "لا بأس به", "д", "وَقَال فِي موضع آخر (٣): لا بأس به.", "تهذيب الكمال", "3722", -1, "2788", 1], ["أبو سعيد بن يونس", "ثقة", "д", "وَقَال أَبُو سَعِيد بن يونس: كان ثقة، ثبتا، حسن الحديث، توفي، يمصر يوم الثلاثاء لسبع خلون من جمادى الأولى سنة إحدى وخمسين ومئتين (٤) . ٥٦٦٥ - خ د س: مُحَمَّد بن", "تهذيب الكمال", "3722", 11052, "143158", 1], ["أبو بكر الخطيب", "ثقة", "д", "قال أَبُو بكر الخطيب (١): كان ثقة. و", "تهذيب الكمال", "3722", -1, "3738", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق ربما خالف", "تقريب التهذيب", "8609", 121, "1218", 1], ["الذهبي", "واه", "ж", "قواه ابن حبان", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "عُثْمَان بن فرقد يروي عَن جَعْفَر بن مُحَمَّد روى عَنهُ زيد بن أخزم الطَّائِي", "الثقات لابن حبان", "5816", "3728", "37288", 1], ["ابن أبي حاتم", "واه", "itqan", "واه", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "مستقيم الحديث", "itqan", "مستقيم الحديث", "الثقات", 0, -1, "", "", ""], ["الذهبي", "واه", "itqan", "واه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "مستقيم الحديث", "itqan", "مستقيم الحديث", "تهذيب التهذيب", 0, -1, "", "", ""]], "4324": [["أبو حاتم", "صالح", "д", "قال أَبُو حاتم (٤): صالح الْحَدِيث (٥) . روى له النَّسَائي فِي \"اليوم والليلة\" (٦) هَذَا الحَدِيث الْوَاحِد. ٣٨٦٦ - ت: عُثْمَان بن ناجية الخراساني (٧) . _______", "تهذيب الكمال", "3722", 6811, "100748", 3], ["العجلي", "ثقة", "д", "وَقَال العجلي: ثقة (ثقاته: الورقة ٣٧) .", "تهذيب الكمال", "3722", -1, "98328", 1], ["", "صالح الحديث", "д", "أبو حاتم الرازيب بنا عبد الرحمن قال سئل أبي عنه فقال صالح الحديثب بالجرح والتعديل لابن أبي حاتم …ا بقال أبو حاتم صالح الحديثب بتهذيب الكمال …ا بقال أبو حاتم صال", "موسوعة الرواة (джарх)", "", ""], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن أبي حاتم", "صالح", "itqan", "صالح الحديث", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "صالح", "itqan", "صالح الحديث", "تهذيب التهذيب", 0, -1, "", "", ""]], "4325": [["العجلي", "ثقة", "д", "وَقَال العجلي: ثقة (ثقاته: الورقة ٣٧) .", "تهذيب الكمال", "3722", -1, "98398", 1], ["ابن حجر العسقلاني", "مستور", "itqan", "مستور", "تقريب التهذيب", 0, -1, "", "", ""]], "4326": [["ابن حجر", "مجهول", "ж", "وَقَال ابن حجر في \"التقريب\": مجهول. أَخْبَرَنَا أَبُو مُحَمَّد عَبد الرحيم بْنُ عَبد المَلِك الْمَقْدِسِيُّ، قال: أَنْبَأَنَا الْمُؤَيِّدُ بْنُ عَبد الرَّحِيمِ ", "تهذيب الكمال", "3722", -1, "57358", 2], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["", "مجهول", "ж", "الذهبىب بصويلحب بالكاشف في معرفة من له رواية في الكتب الستة …ااا بابن حجرب بمجهولي من السادسةب بتقريب التهذيب …اااان", "موسوعة الرواة (джарх)", "", ""]], "4319": [["معاذ بن عبد الله بن خبيب ف", "ثقة", "д", "سئل أَبُو داود عَن معاذ بْن عَبد اللَّهِ بْن خبيب فقال: ثقة روى عنه غير واحد. و", "تهذيب الكمال", "3722", 11839, "151028", 1], ["ابن حزم", "مجهول", "ж", "وَقَال ابن حزم: مجهول (المحلى: ٧ / ٣٦٤)", "تهذيب الكمال", "3722", 11839, "151028", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في \"الكاشف: ثقة (٣ / الترجمة ٥٥٩٧)", "تهذيب الكمال", "3722", 11839, "151028", 1], ["الذهبي", "ثقة", "д", "وَقَال الذهبي في \"الكاشف \": ثقة (٣ / الترجمة ٥٥٩٨)", "تهذيب الكمال", "3722", 11840, "151038", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال ابن طهمان عن يحيى بن مَعِين: معاذ بن العلاء أبو غسان بصري ثقة (الترجمة ١١٦)", "تهذيب الكمال", "3722", 11841, "151048", 1], ["يحيى بن معين أيضا", "ثقة", "д", "وَقَال ابن محرز عن يحيى بن مَعِين أيضا: ثقة (الترجمة ٤٥٢)", "تهذيب الكمال", "3722", 11841, "151048", 1], ["ابن حجر العسقلاني", "لا بأس به", "д", "لا بأس به", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "عُثْمَان بْن مرّة من أهل الْبَصْرَة يروي عَن الْقَاسِم بن مُحَمَّد روى عَنهُ النَّضر بْن شُمَيْل وَأَبُو عَاصِم", "الثقات لابن حبان", "5816", "2811", "28118", 1], ["ابن أبي حاتم", "لا باس به", "itqan", "لا بأس به", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "لا باس به", "itqan", "لا بأس به", "تهذيب التهذيب", 0, -1, "", "", ""]], "4321": [["هشام بن عروة", "لين", "ж", "وَقَال حفص بن غياث (١)، عن هشام بْن عروة: ما قدم علينا من العراق أفضل من أيوب السختياني، ومن ذاك الرواسي (٢)، يعَنْي مسعرا لأن رأسه كان كبيرا.", "تهذيب الكمال", "3722", 11592, "148558", 1], ["علي بن المديني", "ثبت", "д", "وَقَال علي بْن المديني (٣): قلت ليحيى بْن سَعِيد: أيما أثبت هشام الدستوائي أو مسعر؟ قال: ما رأيت مثل مسعر كان من أثبت الناس. _________ (١) انظر حلية الاولياء: ٧", "تهذيب الكمال", "3722", 11592, "148558", 3], ["له أحمد بن حنبل", "ثقة", "д", "قَالَ لَهُ أَحْمَد بْن حَنْبَل: كَانَ ثقة. قال: كان مؤدبا وكان خيارا، الثقة شعبة ومسعر.", "تهذيب الكمال", "3722", 11593, "148568", 1], ["ابن حجر العسقلاني", "لين", "ж", "فيه لين", "تقريب التهذيب", "8609", "", "", 0], ["", "لين", "ж", "ابن حبانب بوذكره ابن حبان في كتاب الثقاتب بتهذيب الكمال …ا بوذكره ابن حبان في ?ب الثقات ?بب بتهذيب التهذيب …ااا بابن حجرب بفيه ليني من السادسةب بتقريب التهذيب …", "موسوعة الرواة (джарх)", "", ""]], "4322": [["يحيى بن سعيد وذكر حنظلة السدوسي، ف", "اختلط", "ж", "سمعت يَحْيَى بْن سَعِيد وذكر حنظلة السدوسي، فَقَالَ: قد رأيته وتركته على عمد. قلت ليحيى: كان قد اختلط؟ قال: نعم.", "تهذيب الكمال", "3722", 3466, "36718", 1], ["أحمد بن حنبل", "ضعيف", "ж", "وَقَال أَبُو الحسن الميموني، عن أَحْمَد بْن حنبل: ضعيف الحديث. _________ (١) علق المؤلف في حاشية نسخته بقوله: ذكر عَبد المَلِك هذا في الاصل في شيوخه وهو وهم. (٢", "تهذيب الكمال", "3722", 3466, "36718", 0], ["أبو بكر الأثرم", "منكر الحديث", "ж", "وَقَال أَبُو بكر الأثرم: سألت أبا عَبد الله بن حنظلة السدوسي فَقَالَ: حنظلة: - ومد بها صوته - ثم قال: ذاك منكر الحديث، يحدث بأعاجيب، حدث عن أنس، قيل: يا رَسُول ", "تهذيب الكمال", "3722", 3467, "36728", 1], ["أبو حاتم", "صالح", "д", "وَقَال صالح بن أحمد بْن حنبل، عَن أبيه: ضعيف الحديث يروي عن أنس أحاديث مناكير\"قلنا: أينحني بعضنا لبعض\". وقد روى عنه بعض الناس، وترك الرواية عنه بعض الناس وكان ق", "تهذيب الكمال", "3722", 3467, "36728", 1], ["يحيى بن معين", "ضعيف", "ж", "وَقَال أَبُو بَكْر بْن أَبي خيثمة (٤)، عَن يحيى بْن مَعِين: ضعيف (٥) . وكذلك", "تهذيب الكمال", "3722", 3467, "36728", 1], ["يحيى", "متروك", "ж", "سمعت يحيى يقول: حنظلة بن عَبد الله السدوسي ليس حديثه بشيءٍ\" (الكامل: ٢ / الورقة ٢٩٠) . (٦) الضعفاء والمتروكون، الترجمة ١٦٤.", "تهذيب الكمال", "3722", 3467, "36728", 1], ["", "اختلط", "ж", "ذكره في \"المجروحين\"أيضا، وَقَال: اختلط بأخرة حتى كان لا يدري ما يحدث، فاختلط حديثه القديم بحديثه الاخير، تركه يحيى القطان\" (١ / ٢٦٧)،", "تهذيب الكمال", "3722", 3468, "36738", 1], ["ابن حبان", "إمام", "д", "وَقَال ابْن حبان في كتاب\"المجروحين\": حنظلة بن عُبَيد الله السدوسي، كان إمام بني سدوس في مسجد قتادة كنيته أبو عبد الرحمن، وهو الذي ي", "تهذيب الكمال", "3722", 3468, "36738", 1], ["ابن أبي حاتم", "واه", "ж", "قال ابن أَبي حاتم في \"الجرح والتعديل\": حنظلة السدوسي بصري، وهو ابن عُبَيد الله، ويُقال: حنظلة بن أَبي صفية، أبو عبد الرحيم\". فهما واحد كما بينه ابن أَبي حاتم وا", "تهذيب الكمال", "3722", 3468, "36738", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0]], "4330": [["الدارقطني", "لا بأس به", "д", "وَقَال البرقاني عن الدارقطني: لا بأس به (سؤالاته: الترجمة ٣٥٨) .", "تهذيب الكمال", "3722", 6818, "100818", 1], ["ابن حزم", "مجهول", "ж", "وَقَال ابن حزم: مجهول (تهذيب التهذيب: ٧ / ١٥٨ - ١٥٩) .", "تهذيب الكمال", "3722", 6818, "100818", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق ربما وهم. (٢) تاريخ البخاري الكبير: ٦ / الترجمة ٢٣٢٩، والجرح والتعديل: ٦ / الترجمة ٩٤١، وثقات ابن حبان: ٧ / ٩٣، والكاشف: ٢ / ا", "تهذيب الكمال", "3722", 6818, "100818", 1]], "4334": [["ابن معين", "ثقة", "д", "وَقَال الدوري عن ابن مَعِين: ثقة (تاريخه: ٢ / ٣٩٦) .", "تهذيب الكمال", "3722", 6825, "100888", 1], ["أبو أحمد", "وثقه", "д", "وَقَال أَبُو أَحْمَد: لَيْسَ بالمتين عندهم، وأسند عن وكيع أنه وثقه (تهذيب التهذيب: ٧ / ١٦١) .", "تهذيب الكمال", "3722", 6825, "100888", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0]], "4331": [["محمد بن عوف أيما أحب إليك عمرو بن عثمان أو", "ثقة", "д", "سئل مُحَمَّد بْن عوف أيما أحب إليك عَمْرو بن عُثْمَان أو يَحْيَى بْن عُثْمَان؟ فَقَالَ: كلاهما ثقة فِي الحديث، ولكن يحيى _________ (١) في تاريخ دمشق، وكذلك الاق", "تهذيب الكمال", "3722", 13528, "170098", 3], ["أبو حاتم (١) كان رجلا صالحا صدوقا.", "صالح", "д", "وَقَال أَبُو حاتم (١) كان رجلا صالحا صدوقا.", "تهذيب الكمال", "3722", 13529, "170108", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي (٢): ثقة.", "تهذيب الكمال", "3722", -1, "3158", 1], ["", "لا بأس به", "д", "وَقَال فِي موضع آخر (٣): لا بأس به.", "تهذيب الكمال", "3722", -1, "2788", 1], ["الحسين بن محمد بن إبراهيم السكوني", "عدل", "д", "وَقَال الْحُسَيْن بْن مُحَمَّد بْن إِبْرَاهِيم السكوني: حَدَّثَنَا يحيى ابن عُثْمَان المختار العدل الرضى.", "تهذيب الكمال", "3722", 13529, "170108", 1], ["أبو أحمد بن عدي", "صالح", "д", "قال أَبُو أَحْمَد بْن عدي (١): وليحيى بْن عُثْمَان أحاديث صالحة عَنْ شيوخ الشام ولم أر أحدا يطعن فيه غير ابْن أَبي معشر، وهُوَ مَعْرُوف بالصدق، وأخوه عَمْرو بْن", "تهذيب الكمال", "3722", 13530, "170118", 1], ["أبي داود", "وثقه", "д", "وَقَال الآجري عَن أبي داود: لم يكن به بأس (٥ / الورقة ٢٥) ووثقه مسلمة بن قاسم الاندلسي (تهذيب: ١١ / ٢٥٦) والذهبي في الكاشف وَقَال: ثقة عابد من الابدال", "تهذيب الكمال", "3722", 13530, "170118", 1], ["ابن حجر العسقلاني", "ضعفه", "ж", "ضعفه الأزدي", "تقريب التهذيب", "8609", 9, "310", 1], ["الذهبي", "مجهول", "ж", "مجهول", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["", "ضعفه", "ж", "النسائيب بوقال ابن عدي كان النسائي حسن الرأي فيهب بتهذيب التهذيب …ااا بالأزديب بضعفه الأزديب بتقريب التهذيب …ا بقال الأزدي عثمان بن يحيى هو الحضرمي لا يكتب حديث", "موسوعة الرواة (джарх)", "", ""], ["الذهبي", "مجهول", "itqan", "مجهول", "الكاشف", 0, -1, "", "", ""]], "4340": [["أبو حاتم", "ثقة", "д", "قال عَبد الله بْن أحمد بْن حنبل (١)، عَن أبيه: ثقة. وكَذَلِكَ أَحْمَد بْن عَبد الله العجلي (٢) والنَّسَائي. _________ (١) الجرح والتعديل: ٧ / الترجمة ٥. (٢) ثقا", "تهذيب الكمال", "3722", 6835, "100988", 2], ["أبو حاتم (١) صدوق، وكان إمام مسجد الشيعة و", "صدوق", "д", "وَقَال أَبُو حاتم (١) صدوق، وكَانَ إمام مَسْجِد الشيعة وقاصهم (٢) .", "تهذيب الكمال", "3722", 6836, "100998", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة رمي بالتشيع", "تقريب التهذيب", "8609", 165, "1658", 1], ["الذهبي", "ثقة", "д", "ثقة لكنه قاص الشيعة وإمام مسجدهم بالكوفة", "الكاشف / سير أعلام النبلاء", "2171", 701, "7028", 1], ["الدارقطني", "ثقة", "д", "وسألته عن عدي بن ثابت ؟ فقال: ثقة، إلا أنه كان رافضيا غاليا فيه", "سؤالات السلمي للدارقطني", "1680", "200", "2008", 2], ["احمد بن حنبل", "ثقه", "jarh", "عَبد الله بْن أحمد بْن حنبل (١) ، عَن أبيه: ثقة", "تهذيب الكمال", "3722", -1, "100988", 1], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "صحابي", "itqan", "صحابي", "تهذيب التهذيب", 0, -1, "", "", ""]], "4342": [["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة. و", "تهذيب الكمال", "3722", -1, "2698", 1], ["ابن حجر العسقلاني", "وثقه", "ж", "وثقه النسائى", "تقريب التهذيب", "8609", "", "", 0], ["النسايي", "ثقه", "jarh", "النَّسَائي: ثقة", "تهذيب الكمال", "3722", -1, "101078", 1], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4346": [["محمد بن سعد", "ثقة", "д", "وَقَال مُحَمَّد بْن سعد (٤): كان ثقة فاضلا كثير العلم.", "تهذيب الكمال", "3722", -1, "", 0], ["أحمد بن عبد الله العجلي (٥) والنسائي", "ثقة", "д", "وَقَال أحمد بْن عَبد الله العجلي (٥) والنَّسَائي (٦): شامي ثقة. _________ (١) تاريخه الكبير: ٣ / الترجمة ١٠٦٢. (٢) قوله: وقدم الكوفة\"ليست من كلام الحكم، فقد قال", "تهذيب الكمال", "3722", -1, "", 0], ["مسلمة بن عبد الملك", "لين", "ж", "وَقَال مغيرة بْن مغيرة الرملي، عن مسلمة بْن عَبد المَلِك: أن في كندة لثلاثة إن الله لينزل بهم الغيث وينصر بهم على الأعداء: رجاء بْن حيوة، وعبادة بْن نسي، وعدي ب", "تهذيب الكمال", "3722", -1, "101038", 2], ["نعيم بن سلامة", "إمام", "д", "قال نعيم بْن سلامة: ما بالشام أحد أحب إلي أن أقتدي به من رجاء بن حيوة. _________ (١) علق الإمام الذهبي على هذه الحكاية بقوله: كان ما بينهما فاسدا، وما زال الاقر", "تهذيب الكمال", "3722", -1, "", 0], ["عبد الرحمن بن يزيد بن جابر", "صالح", "д", "وَقَال صفوان بْن صالح، عن عَبد الله بْن كثير القارئ، عن عبد الرحمن بْن يزيد بْن جابر: كنا مع رجاء بْن حيوة فتذاكرنا شكر النعم، فقال: ما أحد يقوم بشكر نعمة، وخلف", "تهذيب الكمال", "3722", -1, "", 0], ["ابن حجر العسقلاني", "صحابي", "itqan", "صحابي", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""], ["الذهبي", "له صحبة", "itqan", "له صحبة", "الكاشف", 0, -1, "", "", ""]], "4349": [["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد الله العجلي (٢): تابعي ثقة من خيار التابعين.", "تهذيب الكمال", "3722", 6859, "101228", 1], ["أبو زرعة (٣)، وأبو حاتم", "ثقة", "д", "وَقَال أَبُو زُرْعَة (٣)، وأَبُو حاتم (٤): ثقة.", "تهذيب الكمال", "3722", -1, "14088", 1], ["عبد العزيز بن عمر بن عبد العزيز، ما كان أب", "عدل", "д", "وَقَال أيوب بْن سويد الرملي (٥)، عَنْ عَبْد الْعَزِيزِ بْن عُمَر بْن عَبْد الْعَزِيز، مَا كَانَ أَبِي يعدل بعراك بْن مَالِك أحدا.", "تهذيب الكمال", "3722", 6859, "101228", 1], ["المنذر بن عبد الله", "يهم", "ж", "وَقَال الزُّبَيْر بْن بكار، عَنْ مُحَمَّد بْن الضحاك، عَنِ المنذر بْن عَبد اللَّهِ: إِن عراك بْن مَالِك كَانَ من أشد أَصْحَاب عُمَر بْن عَبْد الْعَزِيز عَلَى بَ", "تهذيب الكمال", "3722", 6860, "101238", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة فاضل", "تقريب التهذيب", "8609", "", "", 0]], "4352": [["علي بن المدني", "ضعيف", "ж", "وَقَال عباس ابن السندي، عن علي بن المدني: ضعيف. و", "تهذيب الكمال", "3722", 6866, "101298", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق يهم", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "لين", "ж", "لينه علي وقواه غيره", "الكاشف / سير أعلام النبلاء", "2171", 703, "7048", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "واه", "itqan", "واه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ضعيف", "itqan", "ضعيف", "تهذيب التهذيب", 0, -1, "", "", ""]], "4354": [["أبو حاتم", "ضعيف", "ж", "قال عَبد اللَّهِ بْن أَحْمَد بْن حنبل (١)، عَن أبيه: ضعيف الحديث (٢) . وكذلك", "تهذيب الكمال", "3722", 7803, "110668", 1], ["محمد بن علي بن أحمد بن حنبل", "منكر الحديث", "ж", "قال مُحَمَّد بن علي بن أحمد بْن حنبل: منكر الحديث (ضعفاء العقيلي، الورقة ١٤٣) . (٣) تاريخه: ٢ / ٤٣١. حاتم (١)، والنَّسَائي (٢) . زاد أَبُو حاتم: منكر الحديث.", "تهذيب الكمال", "3722", 7803, "110668", 1], ["يحيى", "ليس بشيء", "ж", "وَقَال عثمان بن سَعِيد الدارمي (٣)، عَن يحيى: ليس بشيءٍ.", "تهذيب الكمال", "3722", 7804, "110678", 1], ["عمر بن _________ (١) الجرح والتعديل", "متروك", "ж", "وَقَال الوليد بْن مسلم، عن سفيان، عن عُمَر بْن _________ (١) الجرح والتعديل: ٦ / الترجمة ٦٣٨. (٢) الضعفاء والمتروكين: الترجمة ٤٥٧. (٣) تاريخه: الترجمة ٤٦٢، ٦٤٠.", "تهذيب الكمال", "3722", 7804, "110678", 2], ["أبي زرعة", "ضعيف", "ж", "قال البرذعي عَن أبي زرعة: ضعيف الْحَدِيث (أبو زُرْعَة: ٣٦٤) . (٦) ضعفاؤه الصغير: الترجمة ٢٤٨. (٧) تاريخه الكبير: ٦ / الترجمة ٢٠٦٥. (٨) نفسه. يَعْلَى، عَن أَبِيه", "تهذيب الكمال", "3722", 7804, "110678", 1], ["الدارقطني", "متروك", "ж", "وَقَال الدَّارَقُطْنِيُّ (٢): متروك (٣) . روى له أَبُو داود فِي زكاة الحلي. وروى له ابن ماجه حديثا واحِدًا عن الْمِنْهَالِ بْنِ عَمْرو، عَنْ سَعِيد بْنِ جُبَيْر", "تهذيب الكمال", "3722", 7805, "110688", 1], ["الدارقطني", "متروك", "ж", "ذكره الدارقطني في \"الضعفاء والمتروكون: الترجمة ٣٧٦) .", "تهذيب الكمال", "3722", 7805, "110688", 1], ["يعقوب بن سفيان", "لين", "ж", "وَقَال يَعْقُوب بْن سُفْيَان: لين الحديث (المعرفة والتاريخ: ٣ / ١١١) .", "تهذيب الكمال", "3722", 7805, "110688", 1]], "4364": [["ابن حجر", "ثبت", "д", "وَقَال ابن حجر في \"التهذيب\": أثبت غير واحد لهُ صُحبَةٌ وشك فيه بعضهم، وروايته عن بعض الصحابة لا تمنع أن يكون صحابيا (٧ / ١٨٥) .", "تهذيب الكمال", "3722", 6895, "101588", 1], ["أبو زرعة", "ثقة", "д", "وَقَال أبو زُرْعَة (١): ثقة. و", "تهذيب الكمال", "3722", -1, "9408", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. رَوَاهُ أَبُو دَاوُدَ (١) عَنِ النُّفَيْلِيِّ، وأَحْمَدُ بْنُ يُونُسَ عَنْ زُهَيْرٍ، فَوَقَعَ لَنَا بَدَلا عَالِيًا. ورَوَاهُ ", "تهذيب الكمال", "3722", -1, "101528", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "4360": [["يحيى بن معين", "منكر الحديث", "ж", "وَقَال عَباس الدُّورِيُّ (٢) عَن يحيى بْن مَعِين: منكر الحديث وليس هو كما قالوا صلب في الزندقة ولكنه منكر الحديث. و", "تهذيب الكمال", "3722", 10097, "133608", 1], ["النسائي الكذابون المعروفون بوضع الحديث أرب", "كذاب", "ж", "وَقَال النَّسَائي الكذابون المعروفون بوضع الحديث أربعة: إِبْرَاهِيم بْن أَبي يَحْيَى بالمدينة، والواقدي ببغداد، ومقاتل بْن سُلَيْمان بخراسان، ومُحَمَّد بْن سَعِ", "تهذيب الكمال", "3722", 10097, "133608", 1], ["أبو زرعة", "كذاب", "ж", "وَقَال أبو زُرْعَة: حدثني أحمد بن حنبل أن محمد بن سَعِيد كان كذابا. (المجروحين: ٢ / ٢٤٨) . (٣) تاريخه: ٢ / ٥١٨. (٤) تاريخه الكبير: ١ / الترجمة ٢٥٧، وضعفاؤه الصغ", "تهذيب الكمال", "3722", 10097, "133608", 1], ["عبد الغني بن سعيد المصري الحافظ", "حافظ", "д", "وَقَال عبد الغني بْن سَعِيد المِصْرِي الحافظ: مُحَمَّد بْن سَعِيد الشامي المصلوب في الزندقة، وهو مُحَمَّد الذي نسبه المحاربي إلى ولاء بني هاشم، وهو مُحَمَّد بْن", "تهذيب الكمال", "3722", 10098, "133618", 1], ["وابصة _________ (١) ضعفاؤه، الورقة ١٩١. (٢", "صالح", "д", "قال قائل أنه أَبُو عبد اللَّه مُحَمَّد الأسدي الذي يروي عن وابصة _________ (١) ضعفاؤه، الورقة ١٩١. (٢) قوله: \"وبلغني \"في العقيلي: \"وقد بلغني. (٣) قوله: \"وهو \"في", "تهذيب الكمال", "3722", 10098, "133618", 0], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق يرسل كثير", "تقريب التهذيب", "8609", 315, "3158", 1], ["الذهبي", "وثقه", "ж", "وله مقاطيع وثقه النسائي", "الكاشف / سير أعلام النبلاء", "2171", 22, "5195", 3], ["يحيى بن معين", "ثقة", "д", "قلت فعروة بن رويم فقال ثقة", "تاريخ الدارمي عن ابن معين", "148", "134", "1348", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ضعيف", "itqan", "ضعيف", "تهذيب التهذيب", 0, -1, "", "", ""]], "4365": [["أبو زرعة (١)، والنسائي", "ثقة", "д", "قال أبو زُرْعَة (١)، والنَّسَائي: ثقة. و", "تهذيب الكمال", "3722", -1, "39228", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه النسائي", "الكاشف / سير أعلام النبلاء", "2171", 22, "5195", 1]], "4371": [["ابن حجر", "ضعيف", "ж", "وَقَال ابن حجر في \"التقريب\": ضعيف. (٤) ٧ / الترجمة ١٤٠١. رَوَى عَنه: بشر بْن معاذ العقدي (ت)، وغيره. روى لَهُ التِّرْمِذِيّ. وقد تقدم فِي الأَسماء (١) . ٧٥٢٨ - ", "تهذيب الكمال", "3722", 14746, "182278", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه أحمد", "الكاشف / سير أعلام النبلاء", "2171", 27, "5541", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4366": [["عبد الله بن وهب", "صالح", "д", "وَقَال عبد الله بن وهب: حدثني ابن لَهِيعَة أن عُمَر بن عبد العزيز استعمل عروة بن محمد القيسي من بني سعد بن بكر على اليمن، وكان من صالح عمال عُمَر بْن عبد العزيز", "تهذيب الكمال", "3722", 6901, "101648", 1], ["سماك بن الفضل", "ثبت", "д", "وَقَال سماك بن الفضل: كنت عند عروة بن محمد جالسا وعنده وهب بن منبه فأتي بعامل لعروة، فشكي، فأكثروا عليه، فقالوا: فعل وفعل وثبتت عليه البينة. قال: فلم يملك وهب ن", "تهذيب الكمال", "3722", 6901, "101648", 1], ["", "يخطئ", "ж", "قال (٣): حَدَّثَنَا عَبْد اللَّهِ بْن أَحْمَدَ، قال: حَدَّثني أبي. _________ (١) المعرفة والتاريخ: ٢ / ٣٠. (٢) ٧ / ٢٨٧. وَقَال: يخطئ وكان من خيار الناس.", "تهذيب الكمال", "3722", -1, "101658", 2], ["ابن حجر العسقلاني", "مقبول", "itqan", "مقبول", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "له صحبة", "itqan", "له صحبة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4374": [["علي بن المديني", "صالح", "д", "قال صالح بْن أَحْمَد بْن حنبل (٢)، عَنْ علي بْن المديني: قلت ليحيى بن سَعِيد القطان: من يعرف عزرة صاحب قتادة؟ ف", "تهذيب الكمال", "3722", 6919, "101828", 1], ["يعقوب بن سفيان", "لا بأس به", "д", "وَقَال يعقوب بْن سفيان: لا بأس به (المعرفة والتاريخ ٢ / ٦٦٥)،", "تهذيب الكمال", "3722", 6919, "101828", 1], ["أبو حاتم", "صالح", "д", "وَقَال صالح بن أحمد (١)، عَن أبيه: عزرة روى عنه قتادة، وسُلَيْمان التَّيْمِيّ، وداود بن أَبي هند، وخالد الحذاء.", "تهذيب الكمال", "3722", 6920, "101838", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال عَباس الدُّورِيُّ (٢)، عن يحيى بن مَعِين: عزرة الذي يروي عنه قتادة ثقة.", "تهذيب الكمال", "3722", 6920, "101838", 1], ["علي بن المديني", "ثقة", "д", "وَقَال أَبُو الحسن بْن البراء (٣)، عن علي بن المديني: عزرة بن عبد الرحمن ثقة، روى عنه قتادة، والتَّيْمِيّ، وعبد الكريم الجزري غيرهم، ولم يسمع من البراء (٤) . رو", "تهذيب الكمال", "3722", 6920, "101838", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه ابن معين", "الكاشف / سير أعلام النبلاء", "2171", 27, "5541", 1], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقه", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ليس بذاك", "itqan", "ليس بذاك", "تهذيب التهذيب", 0, -1, "", "", ""]], "4368": [["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبْد اللَّهِ العجلي (٢): كوفي تابعي ثقة.", "تهذيب الكمال", "3722", 6906, "101698", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4377": [["النسائي", "ثقة", "д", "قال النَّسَائي (١): ثقة (٢) . ٤٤٨٣ - م س: عِمْران بن الحارث السلمي (٣)، أَبُو الحكم الكوفي. رَوَى عَن: عَبد اللَّهِ بْن الزبير، وعَبْد اللَّهِ بْن عباس (س)، وعَ", "تهذيب الكمال", "3722", 8304, "115678", 1], ["منه وهو صدوق (الجرح والتعديل", "صدوق", "д", "سمعت منه وهُوَ صدوق (الجرح والتعديل: ٦ / الترجمة ١٦٣٣) .", "تهذيب الكمال", "3722", 8304, "115678", 1], ["مسلمة بن قاسم لا بأس به مات بحمص سنة إحدى", "لا بأس به", "д", "قال مسلمة بن قاسم لا بأس به مات بحمص سنة إحدى وسبعين ومئة (٨ / ١٢٤) .", "تهذيب الكمال", "3722", 8304, "115678", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. (٣) تاريخ البخاري الكبير: ٦ / الترجمة ٢٨١٣، وثقات العجلي الورقة ٤٣، والكنى للدولابي: ١ / ١٥٤، والجرح والتعديل: ٦ / الترجمة ١٦٤", "تهذيب الكمال", "3722", 8304, "115678", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي: كوفي تابعي ثقة (ثقاته، الورقة ٤٣) .", "تهذيب الكمال", "3722", -1, "115578", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "صدوق", "д", "ابن حبانب بوذكره ابن حبان في ?ب الثقات ?بب بتهذيب التهذيب …ا بوذكره ابن حبان في كتاب ?ب الثقات ?بب بتهذيب الكمال …ا بروى عنه محمد بن عوف الحمصي أشياء يغرب عنه ف", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ليس به بأس", "itqan", "ليس به بأس", "تهذيب التهذيب", 0, -1, "", "", ""]], "4375": [["يحيى بن معين", "ضعيف", "ж", "وَقَال إسحاق بن مَنْصُور (٢)، عَنْ يحيى بْن مَعِين: ضعيف. و", "تهذيب الكمال", "3722", 6921, "101848", 1], ["البخاري أيضا", "فيه نظر", "ж", "قَال البُخارِيُّ أيضا في \"التاريخ الكبير\": فيه نظر (٧ / الترجمة ٤١٦) .", "تهذيب الكمال", "3722", 6921, "101848", 1], ["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي: ليس بالقوي", "تهذيب الكمال", "3722", -1, "3268", 1], ["أبو حاتم", "منكر", "ж", "وَقَال أَبُو حاتم (١): منكر الْحَدِيث.", "تهذيب الكمال", "3722", 6922, "101858", 1], ["أبو أحمد بن عدي", "ضعفه", "ж", "وَقَال أَبُو أَحْمَد بن عدي (٢): قليل الحديث، وهو مع ضعفه يكتب حديثه. و", "تهذيب الكمال", "3722", 6922, "101858", 1], ["ابن حبان", "يخطئ", "ж", "ذكره ابنُ حِبَّان في كتاب \"الثقات\" (٣)، وَقَال: يخطئ ويخالف على قلة روايته (٤) . روى له أَبُو دَاوُدَ (٥) حديثا، والتِّرْمِذِيّ آخر، وقد وقع لنا حديثه عاليا. أَ", "تهذيب الكمال", "3722", 6922, "101858", 1], ["يعقوب بن سفيان", "متروك", "ж", "وَقَال يَعْقُوب بْن سفيان: لَيْسَ بمتروك ولا هو حجة (المعرفة والتاريخ: ٣ / ٦٥)، وذَكَره العقيلي في \"الضعفاء\"وَقَال: في حديثه وهم (الورقة ١٧٥) .", "تهذيب الكمال", "3722", 6922, "101858", 1], ["ابن حجر", "ضعيف", "ж", "وَقَال ابن حجر في \"التقريب\": ضعيف. (٥) جاء في حواشي النسخ من تعقبات المؤلف على صاحب \"الكمال\" قوله:", "تهذيب الكمال", "3722", 6922, "101858", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ضعفه", "ж", "ضعفه النسائي", "الكاشف / سير أعلام النبلاء", "2171", 222, "2228", 1], ["ابن حبان", "ذكره في الثقات", "д", "عسل بن سُفْيَان يروي عَنْ عَطاء روى عَنهُ حَمَّاد بن سَلمَة يخطئ وَيُخَالف على قلَّة رِوَايَته", "الثقات لابن حبان", "5816", "2899", "28998", 1], ["ابن أبي حاتم", "منكر الحديث", "itqan", "منكر الحديث", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "متروك", "itqan", "متروك", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "فيه ضعف", "itqan", "فيه ضعف", "الطبقات الكبرى", 0, -1, "", "", ""]], "4380": [["أبو حاتم", "صدوق", "д", "قال أَبُو حاتم (١): صدوق.", "تهذيب الكمال", "3722", -1, "3158", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي (٢): ثقة. و", "تهذيب الكمال", "3722", -1, "3158", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "4385": [["ابن أبي ليلى - وكان عالما بالحج", "حجة", "д", "قال ابن أَبي ليلى - وكان عالما بالحج: قد حج زيادة على سبعين حجة. وَقَال: وكان يوم مات ابن نحو مئة سنة، ورأيته يشرب الماء في رمضان ويقول:", "تهذيب الكمال", "3722", 6946, "102098", 1], ["عمرو بن دينار ومجاهد وغيرهما من أهل مكة", "لين", "ж", "قال عَمْرو بن دينار ومجاهد وغيرهما من أهل مكة: لم يزل شأننا متشابها متناظرين حتى خرج عطاء بن أَبي رباح إلى المدينة فلما رجع إلينا استبان فضله علينا.", "تهذيب الكمال", "3722", 6946, "102098", 1], ["إسماعيل بن أمية", "لين", "ж", "وَقَال سفيان بن عُيَيْنَة (٤)، عَنْ إِسْمَاعِيلَ بْنِ أمية: كان عطاء يطيل الصمت فإذا تكلم يخيل إلينا أنه يؤيد.", "تهذيب الكمال", "3722", 6947, "102108", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة فقيه فاضل لكنه كثير الإرسال وقيل إنه تغير بآخره ولم يكثر ذلك منه", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "من الصحابة", "itqan", "من الصحابة", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "ثقة", "itqan", "ثقة", "الطبقات الكبرى", 0, -1, "", "", ""], ["الذهبي", "لين", "itqan", "لين", "تذكرة الحفاظ", 0, -1, "", "", ""]], "4390": [["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة. و", "تهذيب الكمال", "3722", -1, "2698", 1], ["العجلي", "ثقة", "д", "وَقَال العجلي: تابعي ثقة (ثقاته: الورقة ٣٨) .", "تهذيب الكمال", "3722", -1, "102088", 1], ["يعقوب بن سفيان", "ثقة", "д", "وَقَال يعقوب بن سفيان: ثقة (المعرفة والتاريخ: ٢ / ٤٦٦) .", "تهذيب الكمال", "3722", 6962, "102258", 1], ["الدارقطني", "ثقة", "д", "وَقَال الدَّارَقُطْنِيُّ: ثقة مشهور (السنن: ١ / ٢٥٢) . (٤) تاريخ الدوري: ٢ / ٤٠٤، وابن محرز: ٢٥، ٨٦، وعلل أحمد: ١ / ١٢٧ وتاريخ =", "تهذيب الكمال", "3722", 6962, "102258", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "وثقه", "ж", "وثقه النسائي", "الكاشف / سير أعلام النبلاء", "2171", 22, "5195", 1]], "4394": [["أبو حاتم", "صالح", "д", "وَقَال أَبُو حاتم (١): كان شيخا صالحا يشبه يوسف بن أسباط وكان دفن كتبه فلا يثبت حديثه وليس بقوي.", "تهذيب الكمال", "3722", 6974, "102378", 1], ["أبي داود", "ضعيف", "ж", "وَقَال أَبُو عُبَيد الأجري (٢)، عَن أبي داود: ضعيف. روى حديث خالد 