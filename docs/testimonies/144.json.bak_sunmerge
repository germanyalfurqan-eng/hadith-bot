{"14401": [["", "ثقة", "д", "أبو عوانة الإسفرايينيب بوعنه أبو عوانة وقال هو قدري ثقة في الحديثب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "14407": [["", "حافظ", "д", "محمد بن أحمد بن حماد الكوفيب بقال أبو الحسن بن حماد الحافظ الكوفي مات سنة ثلاث وثلاثمائة وكان الكلام فيه كثيرا وكان في الظاهر يظهر مذهب الإمامية وكان يرمى بغير ", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "لين", "itqan", "لين", "التاريخ الكبير", 0, -1, "", "", ""]], "14408": [["", "مجهول", "ж", "أبو حاتم الرازيب بسألت أبي? عنه فقال هو مجهولب بالجرح والتعديل لابن أبي حاتم …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "مجهول", "itqan", "مجهول", "الجرح والتعديل", 0, -1, "", "", ""]], "14410": [["", "ثقة", "д", "الذهبىب بثقةي سمع جرير بن المسلم وابن أبي غسانيب بتاريخ الإسلام …اااا ب…ن…ب بإثبات سماع الراويب بثقةي سمع جرير بن المسلم وابن أبي غسانيب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "14411": [["", "ثقة", "д", "الدارقطنيب بحدثني علي بن محمد بن نصر الدينوري قال سمعت حمزة بن يوسف السهمي بجرجان يقول سألت الدارقطني عن محمد بن إسحاق بن إبراهيم بن عيسى بن فروخ المقرئ البغداد", "موسوعة الرواة (джарх)", "", ""]], "14423": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …ااا بالدارقطنيب بقال الدارقطني لا بأس بهب بتاريخ الإسلام …ا بأخبرني الأزهري قال قال أبو الحسن الدارقطني وعبد الله بن ا", "موسوعة الرواة (джарх)", "", ""]], "14426": [["", "صالح", "д", "الذهبىب بوكان جليلا صالحا مفتي البلدب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "14429": [["", "صالح", "д", "الذهبىب بسمع صفوان بن صالح المؤذن وغيرهي وعنه ابنه ومحمد بن إبراهيم بن مروان والطبراني وجماعةب بتاريخ الإسلام …اااا ب…ن…ب بإثبات سماع الراويب بسمع صفوان بن صالح", "موسوعة الرواة (джарх)", "", ""]], "14433": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةب بتاريخ بغداد …ا بسمع أبا الحسن المدائني وسريج بن النعمان وعاصم بن علي وعفان بن مسلم وخالد بن أبي يزيد القرنيب بتاريخ بغداد …ااا بالذ", "موسوعة الرواة (джарх)", "", ""], ["ابن حجر العسقلاني", "ضعيف", "itqan", "ضعيف", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "كذاب", "itqan", "كذاب", "تهذيب التهذيب", 0, -1, "", "", ""]], "14438": [["", "ثقة", "д", "الخطيب البغداديب بقال الخطيب ثقةب بتاريخ الإسلام …ا بوكان ثقةب بتاريخ بغداد …اااان", "موسوعة الرواة (джарх)", "", ""]], "14442": [["", "ثقة", "д", "الذهبىب بمحدث ثقة مكثري سمع يونس بن حبيب وأحمد بن معاويةب بتاريخ الإسلام …اااا ب…ن…ب بإثبات سماع الراويب بمحدث ثقة مكثري سمع يونس بن حبيب وأحمد بن معاويةب بتاري", "موسوعة الرواة (джарх)", "", ""]], "14443": [["", "وثقه", "д", "الدارقطنيب بوثقه الدارقطنيب بتاريخ الإسلام …ا بحدثني علي بن محمد بن نصر قال سمعت حمزة بن يوسف يقول سألت الدارقطني عن أبي علي الحسن بن محمد بن سليمان الشطوي فقال", "موسوعة الرواة (джарх)", "", ""]], "14444": [["", "ثقة", "д", "الذهبىب بوكان ثقةب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "14460": [["", "لا بأس به", "д", "الخطيب البغداديب بوكان لا بأس بهب بتاريخ بغداد …ااا بالذهبىب بصدوقب بتاريخ الإسلام …ا بلا بأس بهب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "14469": [["", "وثقه", "д", "الخطيب البغداديب بوثقه الخطيبب بتاريخ الإسلام …ا بوكان ثقةب بتاريخ بغداد …ااا بالذهبىب بوكان موصوفا بالورع في أحكامهب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "14473": [["", "صدوق", "д", "الذهبىب بشيخ صدوق رحالب بتاريخ الإسلام …اااان", "موسوعة الرواة (джарх)", "", ""]], "14481": [["", "ثقة", "д", "الخطيب البغداديب بوكان ثقةيب بتاريخ بغداد …ااا بالدارقطنيب بوقال الدارقطني لا بأس بهيب بتاريخ بغداد …اااان", "موسوعة الرواة (джарх)", "", ""]], "14483": [["", "وثقه", "д", "الدارقطنيب بوثقه الدارقطنييب بتاريخ الإسلام …ا بأخبرني الحسن بن محمد الخلال قال قال أبو الحسن الدارقطني عبد الرحيم بن محمد السكري ثقة بغداديب بتاريخ بغداد …اااا", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "ثقة", "itqan", "ثقة", "التاريخ الكبير", 0, -1, "", "", ""]], "14484": [["", "صالح", "д", "الخطيب البغداديب بسكن بغداد وحدث بها عن عبد الله بن محمد بن أسماء وهدبة بن خالد وأبي الربيع الزهراني ومحمد بن سلام الجمحي وصالح بن حاتم بن ورداني روى عنه عبد ال", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "مجهول", "itqan", "مجهول", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "14487": [["", "وثقه", "ж", "الخطيب البغداديب بوثقه أبو بكر الخطيبب بسير أعلام النبلاء …ا بوثقه الخطيبيب بتاريخ الإسلام …ا بكان أحد الحفاظ الثقات", "موسوعة الرواة (джарх)", "", ""]], "14490": [["", "لا بأس به", "д", "الدارقطنيب بي وكان غزير الحديث حسن الغرائبي وقال الدارقطني لا بأس بهيب بتاريخ بغداد …اااان", "موسوعة الرواة (джарх)", "", ""]], "14494": [["", "مجهول", "ж", "أبو حاتم الرازيب بروى عن أبي الزنادي روى عنه القعنبي سمعت أبي يقول ذلكي وسمعته يقول هو مجهوليب بالجرح والتعديل لابن أبي حاتم …ا بمجهولب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""], ["ابن أبي حاتم", "مجهول", "itqan", "مجهول", "الجرح والتعديل", 0, -1, "", "", ""]], "14495": [["", "وثقه", "д", "الخطيب البغداديب بوثقه الخطيبب بتاريخ الإسلام …ا بوكان ثقةب بتاريخ بغداد …اااان", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "ثقة", "itqan", "ثقة", "التاريخ الكبير", 0, -1, "", "", ""]], "14496": [["", "لا بأس به", "д", "الدارقطنيب بقال الدارقطني لا بأس بهب بتاريخ الإسلام …ا بحدثني علي بن محمد بن نصر قال سمعت حمزة السهمي يقول وسألت الدارقطني عن أبي جعفر محمد بن الحسن بن هارون بن", "موسوعة الرواة (джарх)", "", ""]], "14498": [["", "ليس بالقوي", "ж", "الدارقطنيب بقال الدارقطني ليس بالقويب بلسان الميزان …اااان", "موسوعة الرواة (джарх)", "", ""], ["البخاري", "ليس بالقوي", "itqan", "ليس بالقوي", "التاريخ الكبير", 0, -1, "", "", ""]], "14415": [["ابن عدي", "منكر", "ж", "وللحسن بن عثمان أحاديث غير ما ذكرت منكرة كنا نتهمه بوضع", "الكامل في الضعفاء", "12579", "1209", "12118", 1]], "14493": [["ابن حبان", "ذكره في الثقات", "д", "بلهط بن عباد يروي عَن مُحَمَّد بن الْمُنْكَدر عَن جَابر قَالَ شَكَوْنَا إِلَى رَسُول اللَّهِ ﷺ حر الرمضاء فَلم يشكنا روى عَنهُ عبد الْمجِيد بن عبد الْ", "الثقات لابن حبان", "5816", "2231", "22318", 1], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "14476": [["ابن حجر العسقلاني", "متروك", "itqan", "متروك الحديث", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "منكر الحديث", "itqan", "منكر الحديث", "تهذيب التهذيب", 0, -1, "", "", ""]], "14447": [["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""]], "14430": [["ابن حبان", "مستقيم الحديث", "itqan", "مستقيم الحديث", "الثقات", 0, -1, "", "", ""], ["ابن سعد", "ضعيف", "itqan", "ضعيف", "الطبقات الكبرى", 0, -1, "", "", ""], ["البخاري", "كذاب", "itqan", "كذاب", "التاريخ الكبير", 0, -1, "", "", ""]], "14419": [["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""]], "14420": [["البخاري", "صدوق", "itqan", "صدوق", "التاريخ الكبير", 0, -1, "", "", ""]], "14413": [["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""], ["البخاري", "ثقة", "itqan", "ثقة ثقة", "التاريخ الكبير", 0, -1, "", "", ""]], "14497": [["البخاري", "امام", "itqan", "إمام", "التاريخ الكبير", 0, -1, "", "", ""]], "14451": [["ابن أبي حاتم", "لا أعرفه", "itqan", "لا أعرفه", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["البخاري", "واه", "itqan", "واه", "التاريخ الكبير", 0, -1, "", "", ""]], "14467": [["ابن حبان", "شيخ", "itqan", "شيخ", "الثقات", 0, -1, "", "", ""]], "14400": [["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تقريب التهذيب", 0, -1, "", "", ""], ["ابن أبي حاتم", "صدوق", "itqan", "صدوق", "الجرح والتعديل", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["البخاري", "صحابي", "itqan", "صحابي", "التاريخ الكبير", 0, -1, "", "", ""]], "14448": [["ابن حجر العسقلاني", "ضعيف", "itqan", "ضعيف", "تهذيب التهذيب", 0, -1, "", "", ""]]}