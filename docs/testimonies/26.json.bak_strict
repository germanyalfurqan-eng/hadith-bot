{"2601": [["يحيى بن معين", "ليس بثقة", "ж", "قال عباس الدُّورِيُّ (٢)، عَنْ يحيى بْن مَعِين: روى عنه أَبُو عامر العقدي حديث: \"الهلال\"وليس بثقة.", "تهذيب الكمال", "3722", 5352, "57518", 1], ["يحيى بن معين", "ليس بشيء", "ж", "وَقَال أَبُو بَكْر بْن أَبي خيثمة (٣)، عَنْ يحيى بْن مَعِين: ليس بشيءٍ (٤) .", "تهذيب الكمال", "3722", 3183, "33878", 1], ["أبو حاتم", "ضعيف", "ж", "وَقَال أبو حاتم (١): ضعيف الحديث، يروي عَنِ الثقات أحاديث مناكير.", "تهذيب الكمال", "3722", 5353, "57528", 1], ["عبد الرحمن بن أبي حاتم", "منكر الحديث", "ж", "وَقَال عَبْد الرَّحْمَنِ بْن أَبي حَاتِم (٢): سألت أَبَا زرعة عنه، فقَالَ: منكر الحديث، روى عن عَبد اللَّهِ بْن دينار ثلاثة أحاديث كلها، يعني مناكير - وإذا روى ", "تهذيب الكمال", "3722", 5353, "57528", 1], ["أبو بشر الدولابي", "ليس بثقة", "ж", "وَقَال أَبُو بشر الدولابي: ليس بثقة. و", "تهذيب الكمال", "3722", 4210, "46098", 1], ["ابن حبان", "يخطئ", "ж", "ذكره ابنُ حِبَّان في كتاب \"الثقات\" (٣)، وَقَال: كان يخطئ (٤) . روى له التِّرْمِذِيّ حديثين. ولهم شيخ آخر ي", "تهذيب الكمال", "3722", 5353, "57528", 1], ["ابن حجر العسقلاني", "ضعيف", "ж", "ضعيف", "تقريب التهذيب", "8609", "", "", 0], ["", "ليس بثقة", "д", "إكمال تهذيب الكمال …ااا بابن الجارودب بوفي كتاب ? ابن الجارود ? ليس بثقة", "موسوعة الرواة (джарх)", "", ""], ["النسائي", "ليس بثقة", "ж", "بن سفيان ليس بثقة", "الضعفاء والمتروكون للنسائي", "10805", "38", "388", 1]], "2603": [["يحيى والنسائي", "ليس بثقة", "ж", "قال يحيى والنَّسَائي: ليس بثقة.", "تهذيب الكمال", "3722", "5759", "57598", 1], ["الدارقطني", "ضعيف", "ж", "وَقَال الدَّارَقُطنِيّ: ضعيف، هكذا نقله ابن الجوزي، وكلام الثلاثة في الذي قبل (يعني المدنى) مثل هذا الكلام، فأخاف أن يكون الرجلان واحدًا، والله أعلم. وما ذكر اب", "تهذيب الكمال", "3722", "5759", "57598", 1], ["أبو داود، والنسائي", "ثقة", "д", "قال أَبُو داود، والنَّسَائي (١): ثقة (٢) .", "تهذيب الكمال", "3722", "5759", "36868", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة عابد", "تقريب التهذيب", "8609", "", "", 0]], "2605": [["أحمد بن صالح العجلي", "صالح", "д", "قال أحمد بن صالح العجلي: سُلَيْمان بن سنان المزني مصري تابعي ثقة. ولما", "تهذيب الكمال", "3722", "5770", "57708", 1], ["أبو سعيد بن يونس", "يهم", "ж", "ذكره أبو سَعِيد بن يونس في تاريخ مصر الذين هم أهلها لا الغرباء قال: سُلَيْمان بن سنان المزني، يقال: هو من مواليهم. ولما", "تهذيب الكمال", "3722", "5770", "57708", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "2611": [["_________ (١) انظر مشتبه الذهبي", "صدوق", "д", "سئل _________ (١) انظر مشتبه الذهبي: ٦٦١. (٢) الجرح والتعديل: ٤ / الترجمة ٥٦٦. عنه، فقال: صدوق. قال: و", "تهذيب الكمال", "3722", "5794", "", 0], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "2615": [["محمد بن عبد الملك الحضرمي ووثقه (نقل ذلك م", "وثقه", "д", "قال مُحَمَّد بْن عَبد المَلِك الحضرمي ووثقه (نقل ذلك مغلطاي وابن حجر) .", "تهذيب الكمال", "3722", "5799", "57998", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق.", "تهذيب الكمال", "3722", "5799", "16498", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "صدوق", "д", "ابن حجرب بصدوقب بتقريب التهذيب …ااا بمحمد بن عبد الله مطين الحضرميب بكذا أرخه محمد بن عبد الله الحضرمي وقال ثقةب بتهذيب التهذيب …ا بقال المطين في ? تاريخه ? ثقة", "موسوعة الرواة (джарх)", "", ""]], "2612": [["النسائي", "كذاب", "ж", "قال النَّسَائي (١): كذاب ليس بثقة ولا مأمون (٢) .", "تهذيب الكمال", "3722", "5796", "57978", 1], ["منه بحمص وهو", "صدوق", "д", "سمعت منه بحمص وهو صدوق (٤) . _________ (١) أخرجه ابن عساكر في تاريخه (انظر تهذيب ٦ ٤ / ٢٨٢) . (٢) العجيب أن النَّسَائي لم يذكر في كتابه\"الضعفاء والمتروكون\"مع قو", "تهذيب الكمال", "3722", "5796", "57978", 0], ["ابن حبان", "وثقه", "д", "ذكره ابنُ حِبَّان في كتاب \"الثقات\"، وَقَال: وكان ممن يحفظ الحديث ويتنصب. (١ / الورقة ١٧٥) . ووثقه مسلمة بن قاسم الاندلسي على ما", "تهذيب الكمال", "3722", "5796", "57978", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "كذاب", "д", "إكمال تهذيب الكمال …ااا بالذهبىب بضعفب بالكاشف في معرفة من له رواية في الكتب الستة …ااا بالنسائيب بوقال النسائي كذاب ليس بثقة ولا مأمونب بتهذيب التهذيب …ا بوأفح", "موسوعة الرواة (джарх)", "", ""]], "2620": [["أبو حاتم", "صدوق", "д", "قال أَبُو حاتم (٢): صدوق.", "تهذيب الكمال", "3722", "5809", "3168", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي (٣): ثقة (٤) .", "تهذيب الكمال", "3722", "5809", "3168", 1], ["مسلمة بن قاسم الاندلسي", "لا بأس به", "д", "وَقَال مسلمة بن قاسم الاندلسي: لا بأس به (تهذيب: ٤ / ٢٠٩.", "تهذيب الكمال", "3722", "5809", "58098", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق.", "تهذيب الكمال", "3722", "5809", "16498", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "2619": [["محمد بن علي بن ميمون", "ثقة", "д", "وَقَال مُحَمَّد بْن علي بْن ميمون: ثقة. وسمع منه أَبُو حاتم سنة خمس عشرة ومئتين،", "تهذيب الكمال", "3722", 5405, "58048", 1], ["", "صدوق", "д", "وَقَال (١): صدوق. ما رأينا إِلاَّ خَيْرًا.", "تهذيب الكمال", "3722", 5406, "58058", 1], ["النسائي", "ليس بالقوي", "ж", "وَقَال النَّسَائي: ليس بالقوي. و", "تهذيب الكمال", "3722", 326, "3268", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق ليس بالقوي", "تقريب التهذيب", "8609", 179, "1798", 1], ["الذهبي", "ليس بالقوي", "ж", "قال النسائي ليس بالقوي", "الكاشف / سير أعلام النبلاء", "2171", 186, "1868", 1]], "2618": [["ابن حجر", "لين", "ж", "وَقَال ابن حجر في التقريب: لين الحديث. رواه (١) عَنْ علي بْن ميمون، فوافقناه فيه بعلو.", "تهذيب الكمال", "3722", 5386, "57858", 1], ["ابن حجر العسقلاني", "لين", "ж", "لين الحديث", "تقريب التهذيب", "8609", 8, "148", 1]], "2623": [["أبو زرعة", "منكر", "ж", "وَقَال أَبُو زُرْعَة (١): منكر الْحَدِيث.", "تهذيب الكمال", "3722", "5817", "30338", 1], ["ابن حجر العسقلاني", "منكر الحديث", "ж", "منكر الحديث", "تقريب التهذيب", "8609", 53, "6759", 1], ["الذهبي", "واه", "ж", "واه", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2621": [["أبو حاتم", "صالح", "д", "قال صالح بن أَحْمَدَ بن حنبل (١)، عَن أبيه: لاأعرفه.", "تهذيب الكمال", "3722", "5811", "58128", 1], ["دحيم", "ثقة", "д", "وَقَال عثمان بْن سَعِيد الدارمي، عَنْ دحيم: ثقة، قد روى عنه المشايخ.", "تهذيب الكمال", "3722", "5811", "58128", 1], ["أبو حاتم", "ليس به بأس", "д", "وَقَال أَبُو حاتم (٣): ليس به بأس، وهو محمود عند الدمشقيين.", "تهذيب الكمال", "3722", "5811", "58128", 1], ["أبو زرعة الدمشقي", "ثقة", "д", "وَقَال أَبُو زُرْعَة الدمشقي (٤): قيل له، يعني أبا مسهر: فما تقول فِي سُلَيْمان بْن عتبة؟ قال: ثقة. قلتُ لأَبِي مسهر (٥): إنه يسند أحاديث عَن أبي الدرداء. قال: ", "تهذيب الكمال", "3722", "5811", "58128", 1], ["صالح بن محمد الحافظ", "صالح", "д", "وَقَال صالح بْن مُحَمَّد الحافظ: روى أحاديث مناكير، وكَانَ الهيثم بْن خارجة، وهشام بْن عمار يوثقانه. و", "تهذيب الكمال", "3722", "5811", "58128", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في التقريب: صدوق له غرائب. (٣) مسند أحمد: ٦ / ٤٤١. سُلَيْمان بْنُ عُتْبَةَ، قال:", "تهذيب الكمال", "3722", "5811", "58138", 0], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق له غرائ", "تقريب التهذيب", "8609", 179, "1798", 1], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2629": [["أبو زرعة (٤)، والنسائي", "ثقة", "д", "وَقَال أَبُو زُرْعَة (٤)، والنَّسَائي: ثقة.", "تهذيب الكمال", "3722", "5829", "51598", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة قديم", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2624": [["يحيى بن معين", "ثقة", "д", "قال إسحاق بْن منصور (١)، عَنْ يحيى بْن مَعِين: ثقة.", "تهذيب الكمال", "3722", 782, "7828", 1], ["النسائي", "ليس به بأس", "д", "وَقَال النَّسَائي: ليس به بأس. و", "تهذيب الكمال", "3722", 447, "4478", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. (٣) مسند أحمد: ٣ / ٦٦. رواه مسلم (١) عَنْ عَمْرو بْن مُحَمَّد الناقد، عَنْ يزيد بْن هارون. فوقع لنا بدلا عاليا. ورواه النَّسَا", "تهذيب الكمال", "3722", 5418, "58178", 1], ["ابن عباس يفتي بالصرف", "واه", "ж", "سمعت ابن عباس يفتي بالصرف، قال: فأفتيت به زمانا ثم لقيته فرجع عنه، قال: فقلت له، فقال: إنما هو رأي رأيته، حَدَّثَنِي أَبُو سَعِيد الخُدْرِيّ أن رَسُول اللَّهِ ﷺ", "تهذيب الكمال", "3722", 5418, "58178", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2625": [["أبو حاتم الرازي", "منكر الحديث", "ж", "وَقَال أبو حاتم الرازي: هو منكر الحديث يكتب حديثه (الجرح والتعديل: ٤ / الترجمة ٥٨٠)، وذَكَره العقيلي في \"الضعفاء\"وساق له حديثًا.", "تهذيب الكمال", "3722", 5413, "58128", 1], ["الساجي", "منكر الحديث", "ж", "وَقَال الساجي: منكر الحديث (مغلطاي: ٢ / الورقة ١٣١) .", "تهذيب الكمال", "3722", 5414, "58138", 1], ["", "متهم", "ж", "وَقَال في \"الديوان\": متهم بالوضع واه (الترجمة ١٧٦٥) .", "تهذيب الكمال", "3722", 5414, "58138", 1], ["أبو القاسم", "لين", "ж", "وَقَال أبو الْقَاسِمِ: بلغني أن سُلَيْمان كَانَ مقدما عند أبي العباس، وأَبِي جعفر، وولي البصرة وكور دجلة الأهوازي والبحرين، وكَانَ كريما جوادا مر برجل يسأل قد ت", "تهذيب الكمال", "3722", 5416, "58158", 1]], "2631": [["العجلي", "لا بأس به", "д", "وَقَال العجلي: جائز الحديث لا بأس به (تهذيب: ٤ / ٢١٦) .", "تهذيب الكمال", "3722", 5427, "58268", 1], ["ابن حجر", "لا بأس به", "д", "وَقَال ابن حجر في \"التقريب\": لا بأس به في غير الزُّهْرِيّ. (٢) الجرح والتعديل: ٤ / الترجمة ٦٠١، والكاشف: ١ / الترجمة ٢١٤٧، وتذهيب التهذيب: ٢ / الورقة ٥٥، ونهاية", "تهذيب الكمال", "3722", 5428, "58278", 1], ["ابن حجر", "مجهول", "ж", "وَقَال ابن حجر في \"التقريب\": مجهول الحال. روى له أبو داود حديثا واحدا يأتي في ترجمة عدي بْن زيد أن شاء اللَّه.", "تهذيب الكمال", "3722", 5428, "58278", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول الحال", "تقريب التهذيب", "8609", 13, "895", 1], ["", "مجهول", "ж", "الذهبىب بشيخب بالكاشف في معرفة من له رواية في الكتب الستة …ااا بأبو حاتم الرازيب بسمعت أبي يقول ذلكي وسألته عنه فقال لا أعرفهب بالجرح والتعديل لابن أبي حاتم …ا ", "موسوعة الرواة (джарх)", "", ""]], "2628": [["ابن معين. (٣) ١ / الورقة ١٧٦. و", "وثقه", "д", "قال الدوري (٢ / ٢٣٣) والدارمي (تاريخه ٤٠٧ و٩٣٥) عن ابن مَعِين. (٣) ١ / الورقة ١٧٦. ووثقه يعقوب بن سفيان (المعرفة: ٢ / ٤٣٦) والدارقطني (سؤالات البرقاني، الورقة ٥", "تهذيب الكمال", "3722", "5825", "58258", 1], ["يحيى بن معين", "ضعيف", "ж", "وَقَال عَباس الدُّورِيُّ (٢)، عَن يحيى بْن مَعِين: ضعيف.", "تهذيب الكمال", "3722", "5825", "17558", 1], ["", "ليس بشيء", "ж", "وَقَال فِي موضع آخر (٣): ليس بشيءٍ (٤) .", "تهذيب الكمال", "3722", "5825", "41078", 1], ["النسائي", "ضعيف", "ж", "وَقَال النَّسَائي: ضعيف (٧) . وروى لَهُ أَبُو أَحْمَدَ بْنُ عَدِيٍّ عدة أحاديث فِي \"فضائل أهل البيت\"وغير ذلك،", "تهذيب الكمال", "3722", "5825", "58278", 1], ["", "متروك", "ж", "وَقَال في كتاب الضعفاء والمتروكين: ليس بالقوي (الترجمة ٢٥١) . (٨) الكامل: ١ / الورقة ١٨٢. (٩) ٢ / الورقة ٢. وقد", "تهذيب الكمال", "3722", "5825", "58278", 0]], "2630": [["أحمد بن حنبل", "ثقة", "д", "قال أَبُو حاتم، عن أَحْمَد بْن حنبل (١): حصين بْن عَبْد الرحمن الثقة المأمون من كبار أصحاب الحديث.", "تهذيب الكمال", "3722", 2979, "31838", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال إسحاق بْن مَنْصُور (٢)، عَنْ يحيى بْن مَعِين: ثقة (٣) . _________ (١) الجرح والتعديل: ٣ / الترجمة ٨٣٧. (٢) الجرح والتعديل: ٣ / ٨٣٧. (٣)", "تهذيب الكمال", "3722", "", "", 0], ["يحيى", "اختلط", "ж", "سمعت يحيى يقول: عطاء بن السائب أنكروه بأخرة، وما روى هشيم عن حصين، وسفيان فهو صحيح، ثم إنه اختلط يعني حصينا (رقم ١٣) .", "تهذيب الكمال", "3722", 2979, "31838", 1], ["", "اختلط", "ж", "وَقَال في موضع ثالث: قلت له: عطاء بن السائب وحصين اختلطا؟ قال: نعم. قلت: من أصحهم سماعا؟ قال: سفيان أصحهم يعني الثوري وهشيم في حصين\". (رقم ٣٢٩) . وذكر ابن أَبي ", "تهذيب الكمال", "3722", 2980, "31848", 1], ["أحمد بن عبد الله العجلي", "ثقة", "д", "وَقَال أَحْمَد بْن عَبد اللَّهِ العجلي (١): كوفي ثقة ثبت في الحديث سكن المبارك (٢) بأخرة، والواسطيون أروى الناس عنه.", "تهذيب الكمال", "3722", 2980, "31848", 1], ["عبد الرحمن بن أبي حاتم", "ثقة", "д", "وَقَال عَبْد الرَّحْمَنِ بْن أَبي حَاتِم (٣): سألت أبا زرعة عنه فقال: ثقة. قلت: يحتج بحديثه؟ قال: إي والله.", "تهذيب الكمال", "3722", 2980, "31848", 1], ["أبو حاتم", "صدوق", "д", "وَقَال أَبُو حاتم: صدوق ثقة في الحديث وفي آخر عُمَره ساء حفظه (٥) .", "تهذيب الكمال", "3722", 2980, "31848", 1], ["هشيم", "اختلط", "ж", "وَقَال هشيم (٧): أتى عليه ثلاث وتسعون سنة، وكان أكبر من الأعمش وقريبا من إِبْرَاهِيم. _________ = إلى تغيره بأخرة، على أن ابن حجر قال: وأنكر ذلك ابن المديني في ", "تهذيب الكمال", "3722", 2980, "31848", 2], ["ابن حجر العسقلاني", "لا بأس به", "д", "لا بأس به في غير الزهري", "تقريب التهذيب", "8609", 179, "1798", 1]], "2634": [["النسائي", "ثقة", "д", "قال النَّسَائي: ثقة. و", "تهذيب الكمال", "3722", "5837", "2708", 1], ["ابن حبان", "حافظ", "д", "ذكره ابنُ حِبَّان في كتاب \"الثقات\" (١) . روى له مسلم، وأَبُو داود، والنَّسَائي. أخبرنا أَحْمَد بْن أَبي الخير، قال: أخبرنا أَبُو الحسن الجمال إذنا، قال: أخبرنا ", "تهذيب الكمال", "3722", "5837", "58388", 1], ["القوم", "لين", "ж", "قال القوم (٣): من سره إن ينظر إلى رجل من أهل الجنة فلينظر إلى _________ (١) ١ / الورقة ١٧٦.", "تهذيب الكمال", "3722", "5837", "58388", 0], ["يحيى بن معين", "ثقة", "д", "وَقَال إسحاق بْن منصور عَن يحيى بن مَعِين: ثقة (الجرح والتعديل: ٤ / الترجمة ٦٢٤) . ووثقه العجلي، والذهبي، وابن حجر. (٢) في النسخ: قالا\"وهو وهم، لان الرواية هنا ", "تهذيب الكمال", "3722", "5837", "58388", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2636": [["العجلي", "ثقة", "д", "قال العجلي (٢): مصري، تابعي، ثقة. و", "تهذيب الكمال", "3722", 7083, "103458", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة ثقة ? قاله يحيى بن معين", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثبت", "д", "جليل قال شعبة هو سيد أهل البصرة وقال أحمد ثبت ثبت", "الكاشف / سير أعلام النبلاء", "2171", 455, "4558", 3], ["ابن شاهين", "ثقة", "д", "ن المغيرة ثقة قاله عثمان", "تاريخ أسماء الثقات لابن شاهين", "5818", "76", "768", 1]], "2638": [["ابن عساكر", "ثقة", "д", "وَقَال ابن عساكر: روى عنه النَّسَائي وَقَال: ثقة،", "تهذيب الكمال", "3722", 5445, "58448", 1], ["", "ليس به بأس", "д", "وَقَال فِي موضع آخر: ليس به بأس. (المعجم المشتمل، الترجمة ٤٠٦) .", "تهذيب الكمال", "3722", 5445, "58448", 1], ["مسلمة بن قاسم الاندلسي", "لا بأس به", "д", "وَقَال مسلمة بن قاسم الاندلسي في كتاب الصلة: لا بأس به (إكمال مغلطاي: ٢ / الورقة ١٣٣)", "تهذيب الكمال", "3722", 5445, "58448", 1], ["الذهبي", "صدوق", "д", "وَقَال الذهبي في \"الكاشف\": صدوق.", "تهذيب الكمال", "3722", 2510, "25108", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة حافظ عارف بالقراءات ورع لكنه يدلس", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "حافظ", "д", "الحافظ أحد الأعلام", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["", "صالح", "д", "أبو حاتم الرازيب بوقال أبو حاتم لم يسمع من أبي صالح مولى أم هانئ قيل له إن ابن أبي طيبة يحدث عن الأعمش عن أبي صالح مولى أم هانئ فقال هذا مدلس عن الكلبي", "موسوعة الرواة (джарх)", "", ""], ["أبو حاتم الرازي", "ملاحظة", "note", "أبو حاتم الرازي: الأعمش قليل السماع من مجاهد، وعامة ما يروي عن مجاهد مدلس", "تهذيب الكمال", "3722", 5453, 58538, 1, "Аль-Аʿмаш мало слышал напрямую от Муджахида; бо́льшая часть того, что он передаёт от Муджахида, — мудаллас (через скрытого посредника)."], ["يحيى بن معين", "ملاحظة", "note", "يحيى بن معين: إنما سمع من مجاهد أربعة أحاديث أو خمسة", "تهذيب الكمال", "3722", 5454, 58548, 1, "Он слышал от Муджахида лишь четыре или пять хадисов напрямую."], ["أحمد بن حنبل", "ملاحظة", "note", "أحمد بن حنبل: الأعمش لم يسمع من بشر بن عطية", "تهذيب الكمال", "3722", 5452, 58528, 1, "Аль-Аʿмаш не слышал напрямую от Бишра ибн ‘Атыйи."], ["علي بن المديني", "ملاحظة", "note", "علي بن المديني: له نحو ألف وثلاث مئة حديث", "تهذيب الكمال", "3722", 5457, 58578, 1, "У него около 1300 хадисов."], ["البزار", "ملاحظة", "note", "البزار: لم يسمع من أبي سفيان طلحة شيئا، وقد روى عنه نحوا من مئة حديث", "تهذيب الكمال", "3722", 5453, 58538, 1, "Он ничего не слышал напрямую от Абу Суфьяна Тальхи, хотя передал от него около ста хадисов — это была «сахифа» (записанный лист), а не прямое слышание."], ["أبو نعيم", "ملاحظة", "note", "أبو نعيم: لم يرو الأعمش عن قيس بن أبي حازم شيئا", "تهذيب الكمال", "3722", 5453, 58538, 1, "Аль-Аʿмаш ничего не передавал от Кайса ибн Аби Хазима."], ["سفيان بن عيينة", "من فضائله", "praise", "سفيان بن عيينة: سبق الأعمش أصحابه بأربع خصال: كان أقرأهم للقرآن، وأحفظهم للحديث", "تهذيب الكمال", "3722", 5459, 58598, 1, "Аль-Аʿмаш превзошёл своих сверстников в четырёх вещах: был лучшим из них чтецом Корана и лучшим хранителем хадиса…"]], "2642": [["أحمد حنبل", "ليس به بأس", "д", "قال أحمد حنبل (١): ليس به بأس (٢) . _________ (١) تاريخ بغداد: ١٠ / ٢١٢. (٢)", "تهذيب الكمال", "3722", "", "", 0], ["يحيى بن معين", "ثقة", "д", "وَقَال إسحاق بن منصور (١) وأبو داود (٢)، عَنْ يَحْيَى بْن معين: ثقة (٣) . وكذلك", "تهذيب الكمال", "3722", 5773, "90358", 1], ["ابنه أبو بكر بن أبي داود", "ثقة", "д", "وَقَال ابْنه أبو بكر بْن أَبي داود: ثقة مأمون.", "تهذيب الكمال", "3722", 5773, "90358", 1], ["موسى بن هارون", "ثقة", "д", "وَقَال موسى بن هارون (٨): روى أبو أسامة عَنْ عَبْدِ الرَّحْمَنِ بْن يزيد بن جابر وكان ذلك وهما منه ﵀، هو لم يلق ابن جابرو إنما لقي عبد الرحمن بن يزيد بن تميم فظ", "تهذيب الكمال", "3722", 5773, "90358", 1], ["صفوان بن صالح", "صالح", "д", "وَقَال صفوان بن صالح (٤):", "تهذيب الكمال", "3722", 5774, "90368", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة فاضل أحد الفقهاء السبعة", "تقريب التهذيب", "8609", 181, "1818", 1], ["العجلي", "ثقة", "д", "دني تابعي ثقة وكان فقيها وكان الحسن بن محمد بن الحنفية يقول سليما", "معرفة الثقات للعجلي", "5825", "257", "2578", 1], ["ابن شاهين", "ثقة", "д", "ن بن يسار ثقة قاله يحيى", "تاريخ أسماء الثقات لابن شاهين", "5818", "77", "778", 1]], "2646": [["الحسين بن الحسن الرازي", "ثقة", "д", "قال الْحُسَيْن بْن الحسن الرازي (٣): سألت يحيى بْن مَعِين عنه فقال: ثقة.", "تهذيب الكمال", "3722", "5897", "58978", 1], ["ابن شاهين", "ثقة", "д", "ذكره ابن شاهين في \"الثقات\" وَقَال: ثقة (الترجمة ٥٠٧) ووثقه ابن خلفون (إكمال مغلطاي: ٢ / الورقة ١٣٧)، والذهبي، وابن حجر. (٢) مسند أحمد: ٥ / ٦٢. (٣) نفسه. (٤) في ", "تهذيب الكمال", "3722", "5897", "58988", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة قديم", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["يحيى بن معين", "ثقة", "д", "ثقة", "الجرح والتعديل", "2170", "1865", "", 0]], "2647": [["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة. و", "تهذيب الكمال", "3722", "5899", "3168", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. (٤) أبو داود (١٣٩٥) في الصلاة، باب: تخريب القرآن. (٥) التِّرْمِذِيّ (٢٩٤٧) في القراءآت. (٦) النَّسَائي في سننه الكبرى، كما في ", "تهذيب الكمال", "3722", "5899", "59008", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0]], "2652": [["علي ابن المديني", "مجهول", "ж", "قال علي ابن المديني: مجهول لا أعلم روى عنه غير أبي وائل. و", "تهذيب الكمال", "3722", 5504, "59038", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "سَمُرَة بن سهم يروي عَن أَبِي هَاشم بْن عتبَة من أَصْحَاب النَّبِيَّ ﷺ رَوَى عَنْهُ أَبُو وَائِل شَقِيق بْن سَلمَة", "الثقات لابن حبان", "5816", "1457", "14578", 1]], "2655": [["ابن حجر", "مجهول", "ж", "وَقَال ابن حجر في \"التقريب\": مجهول. (٣) أبو داود (٣٠٦٤) في الخراج والامارة والفئ، باب: في إقطاع الارضين. (٤) التِّرْمِذِيّ (١٣٨٠) في الاحكام، باب: ما جاء في الق", "تهذيب الكمال", "3722", "5914", "59148", 1], ["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "ذكره في الثقات", "д", "سمي بن قيس يروي عَن شمير بن عبد المدان روى عَنهُ ثُمَامَة بن شرَاحِيل", "الثقات لابن حبان", "5816", "2547", "25478", 1]], "2654": [["يحيى بن معين. وأبو زرعة (٣)، وغير واحد", "ثقة", "д", "وَقَال إسحاق بْن منصور (٢) عَن يحيى بْن مَعِين. وأَبُو زُرْعَة (٣)، وغير واحد: الشَّعْبِي ثقة.", "تهذيب الكمال", "3722", "", "", 0], ["يحيى بن معين", "ثقة", "д", "سمعت يحيى بن مَعِين يقول: إذا حدث الشَّعْبِي عَنْ رجل فسماه، فَهُوَ ثقة يحتج بحَدِيثه.", "تهذيب الكمال", "3722", "", "", 0], ["علي.", "واه", "ж", "سئل أبي عن الفرائض، الَّتِي رواها الشَّعْبِي، عَنْ عَلِي. قال: عندي مَا قاسه الشَّعْبِي عَلَى قَوْل عَلِي، ومَا أرى عليا كَانَ يتفرغ لِهَذَا.", "تهذيب الكمال", "3722", "", "", 0], ["يحيى بن معين", "صالح", "д", "وَقَال معاوية بْن صالح (٢)، عَن يَحْيَى بْن مَعِين: عَامِر الشَّعْبِي قضى لعُمَر بْن عَبْد العزيز.", "تهذيب الكمال", "3722", "", "", 0], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "2659": [["العجلي", "ثقة", "д", "وَقَال العجلي: لم يسمع من كعب، وهو ثقة (ثقاته، الورقة ٢٢) .", "تهذيب الكمال", "3722", 5516, "59158", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق. من اسمه سنان", "تهذيب الكمال", "3722", 5516, "59158", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0]], "2661": [["يحيى", "ليس بالقوي", "ж", "قال عَبَّاس الدُّورِيُّ (١)، عَنْ يحيى: ليس بالقوي (٢) .", "تهذيب الكمال", "3722", 1156, "11568", 1], ["أبو حاتم", "مضطرب", "ж", "وَقَال أَبُو حاتم (٣): شيخ مضطرب الحديث. و", "تهذيب الكمال", "3722", 5517, "59168", 1], ["أبو أحمد بن عدي", "لا بأس به", "д", "وَقَال أَبُو أَحْمَد بْن عدي (٥): له أحاديث قليلة، وأرجو أنه لا بأس به (٦) . روى له البخاري فِي \"الجامع\"حديثا واحدا مقرونا بغيره، وفي\"الأدب\"، وأَبُو داود، والتّ", "تهذيب الكمال", "3722", 5517, "59168", 1], ["ابن معين", "ليس به بأس", "д", "وَقَال الدارمي عن ابن مَعِين: ليس به بأس (تاريخه، رقم ٩٥) وَقَال: سمع السهمي من سنان بن ربيعة بعدما خرف (تاريخ البخاري الكبير: ٤ / الترجمة ٢٣٤١) . (٣) الجرح وال", "تهذيب الكمال", "3722", 5517, "59168", 1], ["النسائي", "ليس بالقوي", "ж", "ذكره النَّسَائي في \"الضعفاء\" (الترجمة ٢٦٣) وَقَال: ليس بالقوي. وكذلك", "تهذيب الكمال", "3722", 5517, "59168", 1], ["ابن شساهين", "صالح", "д", "ذكره ابن شساهين في الثقات (الترجمة ٤٩٠) وَقَال: صالح.", "تهذيب الكمال", "3722", 5517, "59168", 1], ["ابن حجر", "صدوق", "д", "وَقَال ابن حجر في \"التقريب\": صدوق فيه لين. وذكر مغلطاي أن ابن الجارود والساجي ذكراه في جملة الضعفاء (إكمال: ٢ / الورقة ١٣٩) فهو إلى الضعف أقرب لاضطراب حديثه كما", "تهذيب الكمال", "3722", 5517, "59168", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق فيه لين", "تقريب التهذيب", "8609", 21, "2051", 1], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["أبو حاتم الرازي", "شيخ", "д", "شيخ مضطرب الحديث", "الجرح والتعديل", "2170", "1835", "18368", 1], ["أبو حاتم الرازي", "شيخ", "д", "عن سنان بن ربيعة فقال: شيخ مضطرب الحديث", "الجرح والتعديل", "2170", "1835", "18368", 1], ["النسائي", "ليس بالقوي", "ж", "بن ربيعة ليس بالقوي", "الضعفاء والمتروكون للنسائي", "10805", "41", "418", 1]], "2662": [["بعضهم", "يهم", "ж", "وَقَال بعضهم: أشجع. وهو وهم ليس فِي بني ليث أشجع، إنما فيهم شجع،", "تهذيب الكمال", "3722", 5188, "55878", 1]], "2665": [["يحيى بن معين", "ثقة", "д", "وَقَال أَبُو بكر بْن أَبي خيثمة (١)، عَن يحيى بْن مَعِين: ثقة.", "تهذيب الكمال", "3722", 837, "8378", 1], ["ابن صاعد", "واه", "ж", "سمعت ابن صاعد يقول: يكنى أبا هانئ\" (٢ / الورقة: ١٦٨) . (٣) أَحْمَد بْن علي بْن المثنى. (٤) رواه ابن عدي عنه (الكامل: ٢ / الورقة: ١٦٨) . (٥) الكامل: ٢ / الورقة: ", "تهذيب الكمال", "3722", 1292, "12928", 1], ["الأنصاري", "كذاب", "ж", "سمعت الأَنْصارِيّ يقول: من لم يزعم من أصحاب الاشعث ممن كان يلزم الاشعث أنه كان يراني إلى جنبه فهو من الكذابين. سَعِيد يجئ إِلَى الأشعث فيجلس فِي ناحية، وما يسأل", "تهذيب الكمال", "3722", 1292, "12928", 1], ["يحيى بن سعيد", "ثقة", "д", "وَقَال صَالِح بْن أَحْمَد بْن حنبل (٤)، عن علي ابن المديني، عَن يحيى بْن سَعِيد: أشعث بْن عَبد المَلِك هُوَ عندي ثقة مأمون.", "تهذيب الكمال", "3722", 1293, "12938", 1], ["ابن حجر العسقلاني", "صدوق", "д", "صدوق فيه لين", "تقريب التهذيب", "8609", 21, "2051", 1], ["الذهبي", "ضعفه", "ж", "ضعفه النسائي", "الكاشف / سير أعلام النبلاء", "2171", 222, "2228", 1]], "2657": [["عمار بن ياسر", "ضعيف", "ж", "وَقَال همام بْن الحارث عن عمار بْن ياسر: رأيت رَسُول اللَّهِ ﷺ وما معه إلا خمسة أعبد وامرأتان وأبو بكر. _________ (١) طبقات ابن سعد: ٣ / ٢٥٦ - ٢٥٧. (٢) الروم: ٢", "تهذيب الكمال", "3722", 7597, "108598", 3]], "2600": [["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0]], "2602": [["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أ