{"742": [["سليمان بن المغيرة", "لين", "ж", "سمعت سُلَيْمان بْن المغيرة يقول: قدم علينا البصرة سُفْيَان الثوري فأرسل إلي فقال: بلغني عنك أحاديث وأنا على ما ترى من الحال فأتني إن خف عليك، فأتيته فسمع مني. _", "تهذيب الكمال", "3722", 5445, "58458", 3], ["أحمد بن حنبل", "ثبت", "д", "وَقَال أبو طالب (٢)، عَن أحمد بْن حنبل: ثبت ثبت.", "تهذيب الكمال", "3722", 5446, "58468", 1], ["يحيى بن معين", "ثقة", "д", "وَقَال إسحاق بْن مَنْصُور (٣)، عَنْ يحيى بْن مَعِين: ثقة ثقة (٤) .", "تهذيب الكمال", "3722", 5446, "58468", 1], ["علي ابن المديني", "ثبت", "д", "وَقَال علي ابن المديني (٥): لم يكن في أصحاب ثابت أثبت من حماد بن سلمة ثم بعده سُلَيْمان بْن المغيرة ثم بعده حماد بْن زيد.", "تهذيب الكمال", "3722", 5446, "58468", 1], ["محمد بن سعد", "ثقة", "д", "وَقَال مُحَمَّد بْن سعد (٦): كَانَ ثقة ثبتا.", "تهذيب الكمال", "3722", 5446, "58468", 1], ["النسائي", "ثقة", "д", "وَقَال النَّسَائي: ثقة. _________ (١) وقع في نسخة ابن المهندس) \"البَصْرِيّ\". وما أثبتناه من النسخ الاخرى، وهو منسوب إلى الخريبة محلة بالبصرة، توفي سنة إحدى عشرة", "تهذيب الكمال", "3722", -1, "", 0], ["أبو حاتم", "ثبت", "д", "وَقَال عَبد الله بن أحمد بن حنبل، عَن أبيه: سُلَيْمان بن المغيرة أثبت في حميد من أيوب (العلل: ١ / ١٧٠) .", "تهذيب الكمال", "3722", 5447, "58478", 1], ["أبو زرعة الدمشقي", "ثقة", "д", "وَقَال أبو زُرْعَة الدمشقي: حدثني سُلَيْمان بن حرب، قال: حَدَّثَنَا سُلَيْمان بن المغيرة الثقة المأمون (تاريخه: ١ / ٦٧٠) .", "تهذيب الكمال", "3722", 5447, "58478", 1], ["ابن حبان", "ثقة", "д", "ذكره ابنُ حِبَّان في \"الثقات\" (١ / الورقة ١٧٦)، وكذلك ابن شاهين، وَقَال: ثقة، قاله عثمان بن أَبي شَيْبَة (الترجمة ٤٦٢) .", "تهذيب الكمال", "3722", 5447, "58478", 1], ["أبو سعيد، أخرج له مسلم واستشهد به البخاري", "ثقة", "д", "قال أبو سَعِيد، أخرج له مسلم واستشهد به البخاري وهو عندهم ثقة، قاله ابن مسعدة، وابن نمير، وأحمد بن صالح وغيرهم\" (إكمال: ٢ / الورقة ١٣٣) .", "تهذيب الكمال", "3722", 5447, "58478", 1], ["النسايي", "ثقه", "jarh", "النَّسَائي (١): ثقة", "تهذيب الكمال", "3722", -1, "153678", 1]], "758": [["أحمد بن عبد الله العجلي", "ثقة", "д", "قال أَحْمَد بْن عَبد اللَّهِ العِجْلِيّ (٣): تابعية، ثقة (٤) . روى لها ابن ماجه. ٧٩٥٦ - د: أم جحدر العامرية، حماة أم يونس بنت شداد، حديثها في أهل البصرة . روت ع", "تهذيب الكمال", "3722", 15453, "189348", 1], ["بشار", "حافظ", "д", "قال بشار: لكن أخرجه أبو داود أيضا (٢٩٣)، وهو مما استدركه عليه الحافظ ابن حجر في \" النكت الظراف\" كما في حاشية التحفة: ١٢ / حديث ١٧٩٧٦. (٢) ابن ماجة (٣١٣٩) . (٣) ", "تهذيب الكمال", "3722", 15453, "189348", 1], ["ابن حجر", "ثقة", "д", "وَقَال ابن حجر في \"التقريب\": ثقة. وذكرها الذهبي في المجهولات من الميزان\"، وَقَال: لا تعرف، لكن وثقها العجلي (٤ / الترجمة ١١٠٠٨) .", "تهذيب الكمال", "3722", 15453, "189348", 1], ["ابن حجر العسقلاني", "ثقة", "д", "ثقة ويقال لها صحبة", "تقريب التهذيب", "8609", 277, "2778", 3], ["الذهبي", "وثقه", "ж", "وثقها العجلي", "الكاشف / سير أعلام النبلاء", "2171", 1204, "12058", 1], ["العجلي", "ثقه", "jarh", "أَحْمَد بْن عَبد اللَّهِ العِجْلِيّ (٣): تابعية، ثقة (٤)", "تهذيب الكمال", "3722", 15453, "189348", 1]], "757": [["", "مجهول", "ж", "قال فِي الْمَرْأَةِ: تَرَى مَا يُرِيبُهَا بَعْدَ الطُّهْرِ إِنَّمَا هُوَ عرق أو عروق. _________ (١) ذكرها الذهبي في المجهولات من\" الميزان\" (٤ / الترجمة ١١٠٠٦)،", "تهذيب الكمال", "3722", 15452, "189338", 0], ["ابن حجر", "حافظ", "д", "وَقَال ابن حجر في \"التقريب\": مقبولة. (٢) انظر العلل لابن أَبي حاتم: ١ / ٥١. (٣) جهلها الحافظان: الذهبي، وابن حجر. (٤) مسند أحمد: ٦ / ٢١٥. أَخْرَجَهُ (١) مِنْ حَ", "تهذيب الكمال", "3722", 15452, "189338", 0]], "771": [["محمد بن سعد", "حافظ", "д", "وَقَال محمد بن سعد (٤): غزية بنت جابر بن حكيم، ويُقال: هي التي وهبت نفسها للنبي ﷺ. روت عَن: النبي ﷺ (خ م ت س ق) . روى عنها: جابر بن عَبد الله (م ت)، وسَعِيد بن ", "تهذيب الكمال", "3722", 15486, "189678", 1]], "701": [["ابن حجر العسقلاني", "مجهول", "ж", "مجهول", "تقريب التهذيب", "8609", "", "", 0], ["ابن حبان", "له صحبة", "itqan", "له صحبة", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "لا يعرف", "itqan", "لا يعرف", "تهذيب التهذيب", 0, -1, "", "", ""], ["ابن سعد", "حجة", "itqan", "حجة", "الطبقات الكبرى", 0, -1, "", "", ""]], "703": [["ابن حجر العسقلاني", "صدوق", "д", "صدوق", "تقريب التهذيب", "8609", "", "", 0], ["", "صدوق", "д", "ابن حبانب بوذكره في الثقاتب بتهذيب التهذيب …ا بذكره أبو حاتم ابن حبان في ? جملة الثقات ? وخرج حديثه في ? صحيحه ?يب بإكمال تهذيب الكمال …ااا بابن حجرب بصدوقب بتق", "موسوعة الرواة (джарх)", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "مجهول", "itqan", "مجهول الحال", "تهذيب التهذيب", 0, -1, "", "", ""]], "704": [["ابن حجر العسقلاني", "ثقة", "д", "ثقة عابد", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "ثقة", "д", "ثقة", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقة", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "705": [["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["ابن أبي حاتم", "ثقة", "itqan", "ثقة", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""], ["البخاري", "واه", "itqan", "واه", "التاريخ الكبير", 0, -1, "", "", ""], ["الذهبي", "ثقة", "itqan", "ثقه", "تذكرة الحفاظ", 0, -1, "", "", ""]], "707": [["ابن حجر العسقلاني", "ثقة", "д", "ثقة", "تقريب التهذيب", "8609", "", "", 0], ["الذهبي", "صدوق", "д", "صدوق", "الكاشف / سير أعلام النبلاء", "2171", "", "", 0], ["ابن أبي حاتم", "ليس بذاك", "itqan", "ليس بذاك", "الجرح والتعديل", 0, -1, "", "", ""], ["ابن حبان", "ثقة", "itqan", "ذكره ابن حبان في الثقات", "الثقات", 0, -1, "", "", ""], ["الذهبي", "صدوق", "itqan", "صدوق", "الكاشف", 0, -1, "", "", ""], ["ابن حجر العسقلاني", "ثقة", "itqan", "ثقة", "تهذيب التهذيب", 0, -1, "", "", ""]], "708": [["ابن حجر العسقلاني"