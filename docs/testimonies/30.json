{"3017":[["","صدوق","д","قال (١): وحدث عُمَر بْن شبة قال: حَدَّثَنِي عَبد اللَّهِ بْن مُحَمَّد التوزي الصدوق العفيف مَا علمت، قال:","تهذيب الكمال","3722",""],["ابن أبي إسحاق وعلمه","يهم","ж","سمعت رجلا يسأل يُونُس عَنْ ابْن أَبي إِسْحَاق وعلمه، قال: هُوَ والنحو سواء، أي: هُوَ الغاية. قال: فأين علمه من علم النَّاس اليوم؟ قال: لو كَانَ فِي النَّاس اليو","تهذيب الكمال","3722",""],["الفرزدق","لين","ж","قال الفرزدق فِي قصيدة يمدح فِيهَا يَزِيد بْن عَبد المَلِك: مستقبلين شمال الشام تضربنا • بحاصب كنديف القطن منثور عَلَى عمائمنا تلقى وأرحلنا • عَلَى زواحف تزجى مخ","تهذيب الكمال","3722",""],["أبو حاتم","مجهول","ж","قال أبو حاتم (٦): مجهول. _________ (١) أخبار النحويين: ٢٢. (٢) في المطبوع: أشد الناس تسليما. (٣) ٥ / ٦١. (٤)","تهذيب الكمال","3722",""],["ابن حجر العسقلاني","ثقة","д","ثقة فاضل","تقريب التهذيب","",""],["الذهبي","ثقة","д","ثقة","الكاشف / سير أعلام النبلاء","",""]],"3080":[["يحيى بن معين","ثقة","д","وَقَال إسحاق بْن منصور (١)، عَن يحيى بْن مَعِين: ثقة. و","تهذيب الكمال","3722",""],["ابن سعد","ثقة","д","وَقَال ابن سعد: كان ثقة له أحاديث (طبقاته: ٦ / ١٨٢) .","تهذيب الكمال","3722",""],["العجلي","ثقة","д","وَقَال العجلي: كوفي تابعي ثقة (ثقاته، الورقة ٤٣) .","تهذيب الكمال","3722",""],["أبو بكر الخطيب","ثقة","д","وَقَال أبو بكر الخطيب: حضر النهروان مع علي، وكان ثقة (تاريخه: ١٢ / ٢٩٠) .","تهذيب الكمال","3722",""],["ابن حجر","ثبت","д","وَقَال ابن حجر في \"التهذيب \"بعد أن ساق قول الخطيب هذا: فإن ثبت ذلك فلا يدفع سماعه من علي والله أعلم. وَقَال:","تهذيب الكمال","3722",""],["النسائي","ثقة","д","قال النَّسَائي في \"الكنى \": كوفي ثقة (٨ / ١٦٩) .","تهذيب الكمال","3722",""],["ابن حجر","ثقة","д","وَقَال ابن حجر في \"التقريب\": ثقة. من اسمه عون ٤٥٤٩ - ع: عون بن أَبي جحيفة (١)، واسمه وهب بْن عَبد اللَّه السوائي الكوفي. رَوَى عَن: عَبْد الرحمن بْن سمير (د)، و","تهذيب الكمال","3722",""],["ابن حجر العسقلاني","ثقة","д","ثقة","تقريب التهذيب","",""]],"3066":[["أبو زرعة (١)، ومحمد بن سعد","ثقة","д","قال أبو زُرْعَة (١)، ومحمد بْن سعد (٢): ثقة. و","تهذيب الكمال","3722","18433"],["ابن حجر 