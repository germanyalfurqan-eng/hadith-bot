pid": 509, "bid": "8609", "bk": "تقريب التهذيب"}], "6820": [{"q": "قال ابو القاسم البغوي، عن احمد بن حنبل: ثقة الحديث جدا.", "pid": 16654, "bid": "3722", "bk": "تهذيب الكمال"}], "6827": [{"q": "قال علي بن المديني: عبد الله بن الوليد، الذي كان يكون في بني عجل. روى عنه ابو نعيم، مجهول، لا اعرفه.", "pid": 8263, "bid": "3722", "bk": "تهذيب الكمال"}], "6825": [{"q": "صدوق يخطئ", "pid": 378, "bid": "8609", "bk": "تقريب التهذيب"}], "6830": [{"q": "مقبول", "pid": 509, "bid": "8609", "bk": "تقريب التهذيب"}], "6829": [{"q": "ثقة", "pid": 1041, "bid": "2171", "bk": "الكاشف / سير أعلام النبلاء"}], "6832": [{"q": "ثقة ثبت قال النسائي كان لا يخطئ ولا يدلس", "pid": 509, "bid": "8609", "bk": "تقريب التهذيب"}, {"q": "ثقة", "pid": 1042, "bid": "2171", "bk": "الكاشف / سير أعلام النبلاء"}], "6834": [{"q": "ثقة", "pid": 384, "bid": "8609", "bk": "تقريب التهذيب"}], "6879": [{"q": "وقال المفضل بن غسان الغلابي، عن يحيى بن معين: صالح بن ابي الاخضر ليس بالقوي، قدم البصرة وليس منهم.", "pid": 6395, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال معاوية بن صالح ٢ ، عن يحيى بن معين: صالح بن ابي الاخضر بصري ضعيف، زمعة بن صالح اصلح منه.", "pid": 6395, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال عباس الدوري ٣ ، عن يحيى بن معين: صالح بن ابي الاخضر ليس بشيء قدم عليهم البصرة وكان يماميا.", "pid": 16274, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "قال يحيى ٤ : لم يكن زمعة بالقوي وهو اصلح من صالح بن ابي الاخضر. قال: و", "pid": 6395, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "سمعت يحيى يقول: قد روى عكرمة بن عمار عن صالح بن ابي الاخضر.", "pid": 6395, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "قال يحيى ٥ : ومحمد بن ابي حفصة احب الي من صالح بن ابي الاخضر.", "pid": 13223, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "قال الدارمي عن يحيى: ليس بشيء في الزهري. تاريخه: الترجمة ١١ ،", "pid": 6395, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال ابن طهمان عنه، ليس بشيء سؤالاته: الترجمة ١٧٣ ،", "pid": 6395, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال في موضع اخر ٧ : لين.", "pid": 16475, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال في موضع اخر ٨ : ليس بشيء عن الزهري. ١ ثقاته، الورقة ٢٥. ٢ احوال الرجال: الترجمة ١٨٢. ٣ تاريخه: ٧٥٩ - ٧٦٠، و", "pid": 15424, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال الترمذي ١ : يضعف في الحديث، ضعفه يحيى القطان وغيره.", "pid": 13794, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال ابو احمد بن عدي ٣ : وفي بعض احاديثه ما ينكر وهو في الضعفاء الذين يكتب حديثهم ٤ . روى له الاربعة. ١ الجامع: ٥ / ٣٢٠", "pid": 17001, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال محمود بن غيلان: حدثنا وهب بن جرير، وسالته عن صالح بن ابي الاخضر فقال: كان سمع وقرا فلا يخلص بعضه من بعض. الجرح والت", "pid": 6397, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال ابن حبان: يروي عن الزهري اشياء مقلوبة، اختلط عليه ما سمع من الزهري بما وجد عنده مكتوبا، فلم يكن يميز هذا من ذاك،", "pid": 6397, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال البزار: ليس بالقوي. كشف الاستار: ١٣٧٩ .", "pid": 6397, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "وقال ابن حجر في التقريب : ضعيف، يعتبر به. ٢٧٩٦ - ت: صالح بن بشير ١ بن وادع ٢ بن ابي بن ابي الاقعس القارئ، ابو بشر البصري", "pid": 6397, "bid": "3722", "bk": "تهذيب الكمال"}, {"q": "مجهول", "pid": 646, "bid": "8609", "bk": "تقريب التهذيب"}], "6872": [{"q": "صدوقي", "pid": 523, "bid": "8609", "bk": "تقريب التهذيب"}, {"q": "ثقةي", "pid": 1063, "bid": "2171", "bk": "الكاشف / سير أعلام النبلاء"}], "6803": [{"q": "ثقة", "pid": 1038, "bid": "2171", "bk": "الكاشف / سير أعلام النبلاء"}], "6804": [{"q": "صدوق", "pid": 508, "bid": "8609", "bk": "تقريب التهذيب"}, {"q": "ثقة", "pid": 1038, "bid": "2171", "bk": "الكاشف / سير أعلام النبلاء"}], "6806": [{"q": "ثقة", "pid": 508, "bid": "8609", "bk": "تقريب التهذيب"}, {"q": "صدوق", "pid": 1165, "bid": "2171", "bk": "الكاشف / سير أعلام النبلاء"}], "6812": [{"q": "ثقة", "pid": 485, "bid": "8609", "bk": "تقريب التهذيب"}], "6818": [{"q": "ثقة", "pid": 307, "bid": "8609", "bk": "تقريب التهذيب"}], "6823": [{"q": "صدوق", "pid": 567, "bid": "8609", "bk": "تقريب التهذيب"}, {"q": "ثقة", "